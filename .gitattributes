# Byte-exact fixtures the tests compare as text.
# Shell scripts run under Linux from a Windows checkout too.
*.sh text eol=lf
*.trace text eol=lf
*.sht text eol=lf
*.hex text eol=lf
# The web stylesheet ships byte-for-byte; the golden pages stay as delivered.
net/qsweb/assets/** -text
net/httpadmin/tests/golden/** -text

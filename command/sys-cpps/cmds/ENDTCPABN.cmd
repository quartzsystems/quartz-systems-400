/* ENDTCPABN: end TCP/IP at once, without ending servers in order. */
             CMD        PROMPT('End TCP/IP Abnormal') ALLOW(*ALL) +
                          HLPPNLGRP(QHTOCCMD) HLPID(ENDTCPABN)

/* ENDSELECT: close a SELECT group. */
             CMD        PROMPT('End Select') +
                          ALLOW(*BPGM *IPGM *BMOD *IMOD) +
                          HLPPNLGRP(QHCLCMD) HLPID(ENDSELECT)

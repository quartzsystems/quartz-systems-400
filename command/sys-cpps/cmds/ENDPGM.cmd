/* ENDPGM: close a CL procedure. */
             CMD        PROMPT('End Program') +
                          ALLOW(*BPGM *IPGM *BMOD *IMOD) +
                          HLPPNLGRP(QHCLCMD) HLPID(ENDPGM)

# qs.user.oc: the user schema: RFC 4519, 4524, 2798, 2307, 2079.

objectClasses: ( 0.9.2342.19200300.100.4.3 NAME 'pilotObject' DESC 'An object (pilot)' SUP top
  STRUCTURAL MUST cn MAY ( audio $ ditRedirect $ info $ jpegPhoto $ manager $ photo $
  uniqueIdentifier ) )
objectClasses: ( 0.9.2342.19200300.100.4.4 NAME 'newPilotPerson' DESC 'A person (pilot)' SUP person
  STRUCTURAL MAY ( businessCategory $ drink $ homePhone $ homePostalAddress $ janetMailbox $ mail $
  mailPreferenceOption $ mobile $ organizationalStatus $ otherMailbox $ pager $ personalSignature $
  personalTitle $ preferredDeliveryMethod $ roomNumber $ secretary $ textEncodedOrAddress $ uid $
  userClass ) )
objectClasses: ( 0.9.2342.19200300.100.4.5 NAME 'account' DESC 'A computer account' SUP top
  STRUCTURAL MUST uid MAY ( description $ host $ l $ o $ ou $ seeAlso ) )
objectClasses: ( 0.9.2342.19200300.100.4.6 NAME 'document' DESC 'A document' SUP pilotObject
  STRUCTURAL MUST documentIdentifier MAY ( abstract $ cn $ description $ documentAuthor $
  documentAuthorCommonName $ documentAuthorSurName $ documentLocation $ documentPublisher $
  documentStore $ documentTitle $ documentVersion $ keywords $ l $ o $ obsoletedByDocument $
  obsoletesDocument $ ou $ seeAlso $ subject $ updatedByDocument $ updatesDocument ) )
objectClasses: ( 0.9.2342.19200300.100.4.7 NAME 'room' DESC 'A room' SUP top STRUCTURAL MUST cn MAY
  ( description $ roomNumber $ seeAlso $ telephoneNumber ) )
objectClasses: ( 0.9.2342.19200300.100.4.9 NAME 'documentSeries' DESC 'A series of documents' SUP
  top STRUCTURAL MUST cn MAY ( description $ l $ o $ ou $ seeAlso $ telephoneNumber ) )
objectClasses: ( 0.9.2342.19200300.100.4.13 NAME 'domain' DESC 'A DNS domain' SUP top STRUCTURAL
  MUST dc MAY ( associatedName $ businessCategory $ description $ destinationIndicator $
  facsimileTelephoneNumber $ internationalISDNNumber $ l $ o $ physicalDeliveryOfficeName $
  postalAddress $ postalCode $ postOfficeBox $ preferredDeliveryMethod $ registeredAddress $
  searchGuide $ seeAlso $ st $ street $ telephoneNumber $ teletexTerminalIdentifier $ telexNumber $
  userPassword $ x121Address ) )
objectClasses: ( 0.9.2342.19200300.100.4.14 NAME 'rFC822LocalPart' DESC 'The local part of an email
  address' SUP domain STRUCTURAL MAY ( cn $ sn ) )
objectClasses: ( 0.9.2342.19200300.100.4.15 NAME 'dNSDomain' DESC 'A DNS domain with records' SUP
  domain STRUCTURAL MAY dnsRecord )
objectClasses: ( 0.9.2342.19200300.100.4.17 NAME 'domainRelatedObject' DESC 'An object with an
  associated domain' SUP top STRUCTURAL MUST associatedDomain )
objectClasses: ( 0.9.2342.19200300.100.4.18 NAME 'friendlyCountry' DESC 'A country with its name'
  SUP country STRUCTURAL MUST co )
objectClasses: ( 0.9.2342.19200300.100.4.20 NAME 'pilotOrganization' DESC 'An organization (pilot)'
  SUP top STRUCTURAL MUST ( o $ ou ) MAY ( buildingName $ businessCategory $ description $
  destinationIndicator $ facsimileTelephoneNumber $ internationalISDNNumber $ l $
  physicalDeliveryOfficeName $ postalAddress $ postalCode $ postOfficeBox $ preferredDeliveryMethod $
  registeredAddress $ searchGuide $ seeAlso $ st $ street $ telephoneNumber $
  teletexTerminalIdentifier $ telexNumber $ userPassword $ x121Address ) )
objectClasses: ( 0.9.2342.19200300.100.4.21 NAME 'pilotDSA' DESC 'A directory system agent (pilot)'
  SUP top STRUCTURAL MUST dsAQuality )
objectClasses: ( 0.9.2342.19200300.100.4.22 NAME 'qualityLabelledData' DESC 'Data with a quality
  label' SUP top STRUCTURAL MUST singleLevelQuality MAY ( subtreeMaximumQuality $
  subtreeMinimumQuality ) )
objectClasses: ( 1.3.6.1.1.1.2.0 NAME 'posixAccount' DESC 'A POSIX account' SUP top AUXILIARY MUST (
  cn $ gidNumber $ homeDirectory $ uid $ uidNumber ) MAY ( description $ gecos $ loginShell $
  userPassword ) )
objectClasses: ( 1.3.6.1.1.1.2.1 NAME 'shadowAccount' DESC 'Shadow password attributes' SUP top
  AUXILIARY MUST uid MAY ( description $ shadowExpire $ shadowFlag $ shadowInactive $
  shadowLastChange $ shadowMax $ shadowMin $ shadowWarning $ userPassword ) )
objectClasses: ( 1.3.6.1.1.1.2.2 NAME 'posixGroup' DESC 'A POSIX group' SUP top STRUCTURAL MUST ( cn
  $ gidNumber ) MAY ( description $ memberUid $ userPassword ) )
objectClasses: ( 1.3.6.1.1.1.2.3 NAME 'ipService' DESC 'An IP service' SUP top STRUCTURAL MUST ( cn
  $ ipServicePort $ ipServiceProtocol ) MAY description )
objectClasses: ( 1.3.6.1.1.1.2.4 NAME 'ipProtocol' DESC 'An IP protocol' SUP top STRUCTURAL MUST (
  cn $ description $ ipProtocolNumber ) MAY description )
objectClasses: ( 1.3.6.1.1.1.2.5 NAME 'oncRpc' DESC 'An ONC RPC program' SUP top STRUCTURAL MUST (
  cn $ description $ oncRpcNumber ) MAY description )
objectClasses: ( 1.3.6.1.1.1.2.6 NAME 'ipHost' DESC 'A host with an IP address' SUP top AUXILIARY
  MUST ( cn $ ipHostNumber ) MAY ( description $ l $ manager ) )
objectClasses: ( 1.3.6.1.1.1.2.7 NAME 'ipNetwork' DESC 'An IP network' SUP top STRUCTURAL MUST ( cn
  $ ipNetworkNumber ) MAY ( description $ ipNetmaskNumber $ l $ manager ) )
objectClasses: ( 1.3.6.1.1.1.2.8 NAME 'nisNetgroup' DESC 'A netgroup' SUP top STRUCTURAL MUST cn MAY
  ( description $ memberNisNetgroup $ nisNetgroupTriple ) )
objectClasses: ( 1.3.6.1.1.1.2.9 NAME 'nisMap' DESC 'A NIS map' SUP top STRUCTURAL MUST nisMapName
  MAY description )
objectClasses: ( 1.3.6.1.1.1.2.10 NAME 'nisObject' DESC 'An entry of a NIS map' SUP top STRUCTURAL
  MUST ( cn $ nisMapEntry $ nisMapName ) MAY description )
objectClasses: ( 1.3.6.1.1.1.2.11 NAME 'ieee802Device' DESC 'A device with a MAC address' SUP top
  AUXILIARY MAY macAddress )
objectClasses: ( 1.3.6.1.1.1.2.12 NAME 'bootableDevice' DESC 'A device that boots over the network'
  SUP top AUXILIARY MAY ( bootFile $ bootParameter ) )
objectClasses: ( 1.3.6.1.1.3.1 NAME 'uidObject' DESC 'Lets an entry be named by uid' SUP top
  AUXILIARY MUST uid )
objectClasses: ( 1.3.6.1.4.1.250.3.15 NAME 'labeledURIObject' DESC 'Lets an entry hold labeled URIs'
  SUP top AUXILIARY MAY labeledURI )
objectClasses: ( 1.3.6.1.4.1.1466.344 NAME 'dcObject' DESC 'Lets an entry be named by domain
  component' SUP top AUXILIARY MUST dc )
objectClasses: ( 2.5.6.2 NAME 'country' DESC 'A country' SUP top STRUCTURAL MUST c MAY ( description
  $ searchGuide ) )
objectClasses: ( 2.5.6.3 NAME 'locality' DESC 'A place' SUP top STRUCTURAL MAY ( description $ l $
  searchGuide $ seeAlso $ st $ street ) )
objectClasses: ( 2.5.6.4 NAME 'organization' DESC 'An organization' SUP top STRUCTURAL MUST o MAY (
  businessCategory $ description $ destinationIndicator $ facsimileTelephoneNumber $
  internationalISDNNumber $ l $ physicalDeliveryOfficeName $ postalAddress $ postalCode $
  postOfficeBox $ preferredDeliveryMethod $ registeredAddress $ searchGuide $ seeAlso $ st $ street $
  telephoneNumber $ teletexTerminalIdentifier $ telexNumber $ userPassword $ x121Address ) )
objectClasses: ( 2.5.6.5 NAME 'organizationalUnit' DESC 'A part of an organization' SUP top
  STRUCTURAL MUST ou MAY ( businessCategory $ description $ destinationIndicator $
  facsimileTelephoneNumber $ internationalISDNNumber $ l $ physicalDeliveryOfficeName $ postalAddress
  $ postalCode $ postOfficeBox $ preferredDeliveryMethod $ registeredAddress $ searchGuide $ seeAlso
  $ st $ street $ telephoneNumber $ teletexTerminalIdentifier $ telexNumber $ userPassword $
  x121Address ) )
objectClasses: ( 2.5.6.6 NAME 'person' DESC 'A person' SUP top STRUCTURAL MUST ( cn $ sn ) MAY (
  description $ seeAlso $ telephoneNumber $ userPassword ) )
objectClasses: ( 2.5.6.7 NAME 'organizationalPerson' DESC 'A person in an organization' SUP person
  STRUCTURAL MAY ( destinationIndicator $ facsimileTelephoneNumber $ internationalISDNNumber $ l $ ou
  $ physicalDeliveryOfficeName $ postalAddress $ postalCode $ postOfficeBox $ preferredDeliveryMethod
  $ registeredAddress $ st $ street $ teletexTerminalIdentifier $ telexNumber $ title $ x121Address )
  )
objectClasses: ( 2.5.6.8 NAME 'organizationalRole' DESC 'A role in an organization' SUP top
  STRUCTURAL MUST cn MAY ( description $ destinationIndicator $ facsimileTelephoneNumber $
  internationalISDNNumber $ l $ ou $ physicalDeliveryOfficeName $ postalAddress $ postalCode $
  postOfficeBox $ preferredDeliveryMethod $ registeredAddress $ roleOccupant $ seeAlso $ st $ street
  $ telephoneNumber $ teletexTerminalIdentifier $ telexNumber $ x121Address ) )
objectClasses: ( 2.5.6.9 NAME 'groupOfNames' DESC 'A group with members by DN' SUP top STRUCTURAL
  MUST ( cn $ member ) MAY ( businessCategory $ description $ o $ ou $ owner $ seeAlso ) )
objectClasses: ( 2.5.6.10 NAME 'residentialPerson' DESC 'A person at home' SUP person STRUCTURAL
  MUST l MAY ( businessCategory $ destinationIndicator $ facsimileTelephoneNumber $
  internationalISDNNumber $ physicalDeliveryOfficeName $ postalAddress $ postalCode $ postOfficeBox $
  preferredDeliveryMethod $ registeredAddress $ st $ street $ teletexTerminalIdentifier $ telexNumber
  $ x121Address ) )
objectClasses: ( 2.5.6.11 NAME 'applicationProcess' DESC 'An application' SUP top STRUCTURAL MUST cn
  MAY ( description $ l $ ou $ seeAlso ) )
objectClasses: ( 2.5.6.12 NAME 'applicationEntity' DESC 'An OSI application entity' SUP top
  STRUCTURAL MUST ( cn $ presentationAddress ) MAY ( description $ l $ o $ ou $ seeAlso $
  supportedApplicationContext ) )
objectClasses: ( 2.5.6.13 NAME 'dSA' DESC 'An OSI directory system agent' SUP applicationEntity
  STRUCTURAL MAY knowledgeInformation )
objectClasses: ( 2.5.6.14 NAME 'device' DESC 'A device' SUP top STRUCTURAL MUST cn MAY ( description
  $ l $ o $ ou $ owner $ seeAlso $ serialNumber ) )
objectClasses: ( 2.5.6.15 NAME 'strongAuthenticationUser' DESC 'A user with a certificate' SUP top
  AUXILIARY MUST userCertificate )
objectClasses: ( 2.5.6.16 NAME 'certificationAuthority' DESC 'A certification authority' SUP top
  AUXILIARY MUST ( authorityRevocationList $ caCertificate $ certificateRevocationList ) MAY
  crossCertificatePair )
objectClasses: ( 2.5.6.16.2 NAME 'certificationAuthority-V2' DESC 'A certification authority with
  cross certificates' SUP certificationAuthority AUXILIARY MAY deltaRevocationList )
objectClasses: ( 2.5.6.17 NAME 'groupOfUniqueNames' DESC 'A group with members by DN and identifier'
  SUP top STRUCTURAL MUST ( cn $ uniqueMember ) MAY ( businessCategory $ description $ o $ ou $ owner
  $ seeAlso ) )
objectClasses: ( 2.5.6.18 NAME 'userSecurityInformation' DESC 'Algorithms a user supports' SUP top
  AUXILIARY MAY supportedAlgorithms )
objectClasses: ( 2.5.6.19 NAME 'cRLDistributionPoint' DESC 'Where revocation lists are published'
  SUP top STRUCTURAL MUST cn MAY ( authorityRevocationList $ certificateRevocationList $
  deltaRevocationList ) )
objectClasses: ( 2.5.6.20 NAME 'dmd' DESC 'A directory management domain' SUP top STRUCTURAL MUST
  dmdName MAY ( businessCategory $ description $ destinationIndicator $ facsimileTelephoneNumber $
  internationalISDNNumber $ l $ physicalDeliveryOfficeName $ postalAddress $ postalCode $
  postOfficeBox $ preferredDeliveryMethod $ registeredAddress $ searchGuide $ seeAlso $ st $ street $
  telephoneNumber $ teletexTerminalIdentifier $ telexNumber $ userPassword $ x121Address ) )
objectClasses: ( 2.5.6.21 NAME 'pkiUser' DESC 'A PKI user' SUP top AUXILIARY MAY userCertificate )
objectClasses: ( 2.5.6.22 NAME 'pkiCA' DESC 'A PKI certification authority' SUP top AUXILIARY MAY (
  authorityRevocationList $ caCertificate $ certificateRevocationList $ crossCertificatePair ) )
objectClasses: ( 2.5.6.23 NAME 'deltaCRL' DESC 'A holder of delta revocation lists' SUP top
  AUXILIARY MAY deltaRevocationList )
objectClasses: ( 2.5.6.24 NAME 'pmiUser' DESC 'A privilege management user' SUP top AUXILIARY MAY
  attributeCertificate )
objectClasses: ( 2.16.840.1.113730.3.2.2 NAME 'inetOrgPerson' DESC 'A person in an Internet
  organization' SUP organizationalPerson STRUCTURAL MAY ( audio $ businessCategory $ carLicense $
  departmentNumber $ displayName $ employeeNumber $ employeeType $ givenName $ homePhone $
  homePostalAddress $ initials $ jpegPhoto $ labeledURI $ mail $ manager $ mobile $ o $ pager $ photo
  $ preferredLanguage $ roomNumber $ secretary $ uid $ userCertificate $ userPKCS12 $
  userSMIMECertificate $ x500UniqueIdentifier ) )

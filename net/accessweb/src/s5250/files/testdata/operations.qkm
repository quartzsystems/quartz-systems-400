# A keyboard map as an operations team might pass round: Enter on the main
# Enter key and on Ctrl+Enter, Field Exit on Enter of the keypad, Help on F1
# shifted to Ctrl+F1 so that F1 stays F1, and Clear taken off Pause.
[qsaccess]
kind = "keymap"
version = 1

[keys]
"Ctrl+Enter" = "Enter"
"Ctrl+F1" = "Help"
"Ctrl+Home" = "Home"
"Ctrl+R" = "Reset"
"Delete" = "Delete"
"Backspace" = "Backspace"
"Down" = "Down"
"Enter" = "Enter"
"Esc" = "Attention"
"F1" = "F:1"
"F2" = "F:2"
"F3" = "F:3"
"F4" = "F:4"
"F5" = "F:5"
"F6" = "F:6"
"F7" = "F:7"
"F8" = "F:8"
"F9" = "F:9"
"F10" = "F:10"
"F11" = "F:11"
"F12" = "F:12"
"Shift+F1" = "F:13"
"Shift+F12" = "F:24"
"Insert" = "Insert"
"Keypad Enter" = "FieldExit"
"Keypad +" = "FieldPlus"
"Keypad -" = "FieldMinus"
"Left" = "Left"
"Page Down" = "PageDown"
"Page Up" = "PageUp"
"Right" = "Right"
"Right Ctrl" = "FieldExit"
"Shift+Esc" = "SysReq"
"Shift+Tab" = "BackTab"
"Tab" = "Tab"
"Up" = "Up"

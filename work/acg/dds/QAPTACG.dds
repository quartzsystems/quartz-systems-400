     A            JATIME         6S 0
     A            JARES         95A
     A            JAJOB         10A
     A            JAUSER        10A
     A            JANBR          6S 0
     A            JACDE         15A
     A            JADFN         10A
     A            JADFNL        10A
     A            JADEVN        10A
     A            JADEVT         4A
     A            JADEVM         4A
     A            JATPAG        11P 0
     A            JATLIN        11P 0
     A            JASPFN        10A
     A            JASPNB         4A
     A            JAOPTY         1A
     A            JAFMTP        10A
     A            JABYTE        15P 0
     A            JAUSRD        10A

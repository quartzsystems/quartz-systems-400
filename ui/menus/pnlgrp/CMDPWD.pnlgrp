:PANEL NAME=CMDPWD HELP=HLPCMDPWD KEYL=MENUKEYS ENTER='RETURN 1' PANELID=PANELID.Password Commands
:MENU DEPTH='*' SCROLL=YES OPTIONS=OPTION.Select one of the following:
:MENUGRP.Commands
:MENUI OPTION=1 ACTION='CMD ?ANZDFTPWD' HELP=ANZDFTPWD.Analyze Default Passwords  ANZDFTPWD
:MENUI OPTION=2 ACTION='CMD ?CHGDSTPWD' HELP=CHGDSTPWD.Change IBM Service Tools Pwd  CHGDSTPWD

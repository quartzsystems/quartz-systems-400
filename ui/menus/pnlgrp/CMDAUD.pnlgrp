:KEYI KEY=F9 ACTION=RETRIEVE.F9=Retrieve
:KEYI KEY=F12 ACTION=CANCEL.F12=Cancel
:KEYI KEY=F16 ACTION='MENU MAJOR'.F16=Major menu
:EKEYL.
:PANEL NAME=CMDAUD HELP=HLPCMDAUD KEYL=MENUKEYS ENTER='RETURN 1' PANELID=PANELID.Auditing Commands
:MENU DEPTH='*' SCROLL=YES OPTIONS=OPTION.Select one of the following:
:MENUGRP.Commands
:MENUI OPTION=1 ACTION='CMD ?CHGAUD'.
:MENUI OPTION=2 ACTION='CMD ?CHGDLOAUD'.
:MENUI OPTION=3 ACTION='CMD ?CHGOBJAUD'.Change Object Auditing  CHGOBJAUD
:MENUI OPTION=4 ACTION='CMD ?CHGSECAUD'.Change Security Auditing  CHGSECAUD
:MENUI OPTION=5 ACTION='CMD ?CHGUSRAUD'.Change User Auditing  CHGUSRAUD
:MENUI OPTION=6 ACTION='CMD ?CPYAUDJRNE'.Copy Audit Journal Entries  CPYAUDJRNE

:VAR NAME=PANELID CLASS=NAMECL VALUE='CMDHLD'.
:IMPORT NAME=HLDJOB PNLGRP=QHWMCMD.
:IMPORT NAME=HLDJOBQ PNLGRP=QHWMCMD.
:IMPORT NAME=HLDJOBSCDE PNLGRP=QHWMCMD.
:IMPORT NAME=HLDOUTQ PNLGRP=QHSPCMD.

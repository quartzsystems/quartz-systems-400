:MENUI OPTION=6 ACTION='CMD ?HLDOUTQ' HELP=HLDOUTQ.Hold Output Queue  HLDOUTQ
:MENUI OPTION=7 ACTION='CMD ?HLDPTF'.
:MENUI OPTION=8 ACTION='CMD ?HLDRDR'.
:MENUI OPTION=9 ACTION='CMD ?HLDSBMCRQA'.
:MENUI OPTION=10 ACTION='CMD ?HLDSPLF' HELP=HLDSPLF.Hold Spooled File  HLDSPLF

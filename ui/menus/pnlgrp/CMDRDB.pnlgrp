:PANEL NAME=CMDRDB HELP=HLPCMDRDB KEYL=MENUKEYS ENTER='RETURN 1' PANELID=PANELID.Relational Database Commands
:MENU DEPTH='*' SCROLL=YES OPTIONS=OPTION.Select one of the following:
:MENUGRP.Commands
:MENUI OPTION=1 ACTION='CMD ?ADDRDBDIRE' HELP=ADDRDBDIRE.Add RDB Directory Entry  ADDRDBDIRE
:MENUI OPTION=2 ACTION='CMD ?CHGRDBDIRE' HELP=CHGRDBDIRE.Change RDB Directory Entry  CHGRDBDIRE

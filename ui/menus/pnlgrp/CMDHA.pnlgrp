:EKEYL.
:PANEL NAME=CMDHA HELP=HLPCMDHA KEYL=MENUKEYS ENTER='RETURN 1' PANELID=PANELID.High Availability Commands
:MENU DEPTH='*' SCROLL=YES OPTIONS=OPTION.Select one of the following:
:MENUGRP.Commands
:MENUI OPTION=1 ACTION='CMD ?ADDHACFGD'.
:MENUI OPTION=2 ACTION='CMD ?ADDHAPCY'.
:MENUI OPTION=3 ACTION='CMD ?CHGHACFGD'.
:MENUI OPTION=4 ACTION='CMD ?CHGHAPCY'.

:PANEL NAME=CMDGDF HELP=HLPCMDGDF KEYL=MENUKEYS ENTER='RETURN 1' PANELID=PANELID.Graphics Data Format Commands
:MENU DEPTH='*' SCROLL=YES OPTIONS=OPTION.Select one of the following:

:MENUI OPTION=9 ACTION='CMD ?CPYVPNCFGF'.
:MENUI OPTION=10 ACTION='CMD ?DCLF' HELP=DCLF.Declare File  DCLF
:MENUI OPTION=11 ACTION='CMD ?DLTF' HELP=DLTF.Delete File  DLTF

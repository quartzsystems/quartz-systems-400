:CLASS NAME=OPTCL BASETYPE='CHAR 3'.
:ECLASS.
:CLASS NAME=NAMECL BASETYPE='CHAR 10'.
:ECLASS.
:VAR NAME=OPTION CLASS=OPTCL.
:VAR NAME=PANELID CLASS=NAMECL VALUE='CMDFILE'.
:IMPORT NAME=CLOF PNLGRP=QHDBCMD.
:IMPORT NAME=CPYF PNLGRP=QHDBCMD.
:IMPORT NAME=CPYFRMIMPF PNLGRP=QHDBCMD.
:IMPORT NAME=CPYFRMSTMF PNLGRP=QHP0LCMD.
:IMPORT NAME=CPYTOIMPF PNLGRP=QHDBCMD.
:IMPORT NAME=CPYTOSTMF PNLGRP=QHP0LCMD.
:IMPORT NAME=DCLF PNLGRP=QHCLCMD.
:IMPORT NAME=DLTF PNLGRP=QHDBCMD.
:IMPORT NAME=DLTOVR PNLGRP=QHDBCMD.
:IMPORT NAME=DSPF PNLGRP=QHZRUCMD.
:IMPORT NAME=DSPFD PNLGRP=QHDBCMD.
:IMPORT NAME=DSPFFD PNLGRP=QHDBCMD.
:IMPORT NAME=DSPOVR PNLGRP=QHDBCMD.
:IMPORT NAME=EDTF PNLGRP=QHZRUCMD.
:IMPORT NAME=RCVF PNLGRP=QHCLCMD.
:IMPORT NAME=SNDF PNLGRP=QHCLCMD.
:IMPORT NAME=SNDRCVF PNLGRP=QHCLCMD.
:IMPORT NAME=STRTCPFTP PNLGRP=QHTMCMD.
:IMPORT NAME=WRKF PNLGRP=QHLICMD.
:KEYL NAME=MENUKEYS HELP='KEYS/MENUKEYS'.
:KEYI KEY=ENTER ACTION=ENTER.
:KEYI KEY=HELP ACTION=HELP.
:KEYI KEY=F1 ACTION=HELP.
:KEYI KEY=F3 ACTION=EXIT.F3=Exit
:KEYI KEY=F4 ACTION='RETURN 4'.F4=Prompt
:KEYI KEY=F9 ACTION=RETRIEVE.F9=Retrieve
:KEYI KEY=F12 ACTION=CANCEL.F12=Cancel
:KEYI KEY=F16 ACTION='MENU MAJOR'.F16=Major menu
:EKEYL.
:PANEL NAME=CMDFILE HELP=HLPCMDFILE KEYL=MENUKEYS ENTER='RETURN 1' PANELID=PANELID.File Commands
:MENU DEPTH='*' SCROLL=YES OPTIONS=OPTION.Select one of the following:
:MENUGRP.Commands
:MENUI OPTION=1 ACTION='CMD ?CLOF' HELP=CLOF.Close File  CLOF
:MENUI OPTION=2 ACTION='CMD ?CPYF' HELP=CPYF.Copy File  CPYF
:MENUI OPTION=3 ACTION='CMD ?CPYFRMARCF'.
:MENUI OPTION=4 ACTION='CMD ?CPYFRMIMPF' HELP=CPYFRMIMPF.Copy From Import File  CPYFRMIMPF

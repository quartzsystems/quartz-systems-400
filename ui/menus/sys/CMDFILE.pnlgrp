.* CMDFILE: File Commands, a group of the major command menu.
:PNLGRP.
:COPYR.(C) COPYRIGHT QUARTZ SYSTEMS 2026.
:CLASS NAME=OPTCL BASETYPE='CHAR 3'.
:ECLASS.
:CLASS NAME=NAMECL BASETYPE='CHAR 10'.
:ECLASS.
:VAR NAME=OPTION CLASS=OPTCL.
:VAR NAME=PANELID CLASS=NAMECL VALUE='CMDFILE'.
:KEYL NAME=MENUKEYS.
:KEYI KEY=ENTER ACTION=ENTER.
:KEYI KEY=HELP ACTION=HELP.
:KEYI KEY=F1 ACTION=HELP.
:KEYI KEY=F3 ACTION=EXIT.F3=Exit
:KEYI KEY=F4 ACTION='RETURN 4'.F4=Prompt
:KEYI KEY=F9 ACTION=RETRIEVE.F9=Retrieve
:KEYI KEY=F12 ACTION=CANCEL.F12=Cancel
:KEYI KEY=F16 ACTION='MENU MAJOR'.F16=Major menu
:EKEYL.
:PANEL NAME=CMDFILE HELP=HLPCMDFILE KEYL=MENUKEYS ENTER='RETURN 1' PANELID=PANELID.File Commands
:MENU DEPTH='*' SCROLL=YES OPTIONS=OPTION.Select one of the following:
:MENUGRP.Commands
:MENUI OPTION=1 ACTION='CMD ?CLOF'.Close File  CLOF
:MENUI OPTION=2 ACTION='CMD ?CPYF'.Copy File  CPYF
:MENUI OPTION=3 ACTION='CMD ?CPYFRMARCF'.
:MENUI OPTION=4 ACTION='CMD ?CPYFRMIMPF'.Copy From Import File  CPYFRMIMPF
:MENUI OPTION=5 ACTION='CMD ?CPYFRMSTMF'.Copy From Stream File  CPYFRMSTMF
:MENUI OPTION=6 ACTION='CMD ?CPYTOARCF'.
:MENUI OPTION=7 ACTION='CMD ?CPYTOIMPF'.Copy To Import File  CPYTOIMPF
:MENUI OPTION=8 ACTION='CMD ?CPYTOSTMF'.Copy To Stream File  CPYTOSTMF
:MENUI OPTION=9 ACTION='CMD ?CPYVPNCFGF'.
:MENUI OPTION=10 ACTION='CMD ?DCLF'.Declare File  DCLF
:MENUI OPTION=11 ACTION='CMD ?DLTF'.Delete File  DLTF
:MENUI OPTION=12 ACTION='CMD ?DLTOVR'.Delete Override  DLTOVR
:MENUI OPTION=13 ACTION='CMD ?DMPDNSJRNF'.
:MENUI OPTION=14 ACTION='CMD ?DSPF'.Display File  DSPF
:MENUI OPTION=15 ACTION='CMD ?DSPFD'.Display File Description  DSPFD
:MENUI OPTION=16 ACTION='CMD ?DSPFFD'.Display File Field Description  DSPFFD
:MENUI OPTION=17 ACTION='CMD ?DSPOVR'.Display Override  DSPOVR
:MENUI OPTION=18 ACTION='CMD ?EDTF'.Edit File  EDTF
:MENUI OPTION=19 ACTION='CMD ?FTP'.Start TCP/IP File Transfer  FTP
:MENUI OPTION=20 ACTION='CMD ?RCVF'.Receive File  RCVF
:MENUI OPTION=21 ACTION='CMD ?RSTS36F'.
:MENUI OPTION=22 ACTION='CMD ?SAVS36F'.
:MENUI OPTION=23 ACTION='CMD ?SNDF'.Send File  SNDF
:MENUI OPTION=24 ACTION='CMD ?SNDRCVF'.Send/Receive File  SNDRCVF
:MENUI OPTION=25 ACTION='CMD ?STRTCPFTP'.Start TCP/IP File Transfer  STRTCPFTP
:MENUI OPTION=26 ACTION='CMD ?WRKF'.Work with Files  WRKF
:EMENUGRP.
:MENUGRP.Related Command Menus
:MENUI OPTION=27 ACTION='MENU CMDBSCF'.BSC File Commands  CMDBSCF
:MENUI OPTION=28 ACTION='MENU CMDCMNF'.Communications File Commands  CMDCMNF
:MENUI OPTION=29 ACTION='MENU CMDCRTF'.Create File Commands  CMDCRTF
:MENUI OPTION=30 ACTION='MENU CMDCST'.Constraint/Customization Cmds  CMDCST
:MENUI OPTION=31 ACTION='MENU CMDDBF'.Database File Commands  CMDDBF
:MENUI OPTION=32 ACTION='MENU CMDDSPF'.Display File Commands  CMDDSPF
:MENUI OPTION=33 ACTION='MENU CMDICF'.ICF Commands  CMDICF
:MENUI OPTION=34 ACTION='MENU CMDICFF'.ICF File Commands  CMDICFF
:MENUI OPTION=35 ACTION='MENU CMDLF'.Logical File Commands  CMDLF
:MENUI OPTION=36 ACTION='MENU CMDMSGF'.Message File Commands  CMDMSGF
:MENUI OPTION=37 ACTION='MENU CMDNETF'.Network File Commands  CMDNETF
:MENUI OPTION=38 ACTION='MENU CMDOVR'.Override Commands  CMDOVR

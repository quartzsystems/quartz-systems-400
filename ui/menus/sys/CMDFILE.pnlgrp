:MENUI OPTION=15 ACTION='CMD ?DSPFD' HELP=DSPFD.Display File Description  DSPFD
:MENUI OPTION=16 ACTION='CMD ?DSPFFD' HELP=DSPFFD.Display File Field Description  DSPFFD
:MENUI OPTION=17 ACTION='CMD ?DSPOVR' HELP=DSPOVR.Display Override  DSPOVR
:MENUI OPTION=18 ACTION='CMD ?EDTF' HELP=EDTF.Edit File  EDTF
:MENUI OPTION=19 ACTION='CMD ?FTP' HELP=STRTCPFTP.Start TCP/IP File Transfer  FTP
:MENUI OPTION=20 ACTION='CMD ?RCVF' HELP=RCVF.Receive File  RCVF
:MENUI OPTION=21 ACTION='CMD ?RSTS36F'.
:MENUI OPTION=22 ACTION='CMD ?SAVS36F'.
:MENUI OPTION=23 ACTION='CMD ?SNDF' HELP=SNDF.Send File  SNDF
:MENUI OPTION=24 ACTION='CMD ?SNDRCVF' HELP=SNDRCVF.Send/Receive File  SNDRCVF
:MENUI OPTION=25 ACTION='CMD ?STRTCPFTP' HELP=STRTCPFTP.Start TCP/IP File Transfer  STRTCPFTP
:MENUI OPTION=26 ACTION='CMD ?WRKF' HELP=WRKF.Work with Files  WRKF

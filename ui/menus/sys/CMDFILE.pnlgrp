:MENUI HELP=RCVF OPTION=20 ACTION='CMD ?RCVF'.Receive File  RCVF
:MENUI OPTION=21 ACTION='CMD ?RSTS36F'.
:MENUI OPTION=22 ACTION='CMD ?SAVS36F'.
:MENUI HELP=SNDF OPTION=23 ACTION='CMD ?SNDF'.Send File  SNDF
:MENUI HELP=SNDRCVF OPTION=24 ACTION='CMD ?SNDRCVF'.Send/Receive File  SNDRCVF
:MENUI HELP=STRTCPFTP OPTION=25 ACTION='CMD ?STRTCPFTP'.Start TCP/IP File Transfer  STRTCPFTP
:MENUI HELP=WRKF OPTION=26 ACTION='CMD ?WRKF'.Work with Files  WRKF

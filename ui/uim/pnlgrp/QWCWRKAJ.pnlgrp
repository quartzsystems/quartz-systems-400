:LISTCOL VAR=STATUS USAGE=OUTPUT HELP='FLD/STATUS'.Status
:LISTCOL VAR=POOL USAGE=OUTPUT HELP='FLD/POOL'.Pool
:LISTCOL VAR=PTY USAGE=OUTPUT HELP='FLD/PTY'.Pty
:LISTCOL VAR=CPUSEC USAGE=OUTPUT HELP='FLD/CPUSEC'.CPU
:LISTGRP COL=ELAPSED.--------Elapsed---------
:LISTCOL VAR=INT USAGE=OUTPUT HELP='FLD/INT'.Int
:LISTCOL VAR=RSP USAGE=OUTPUT HELP='FLD/RSP'.Rsp
:LISTCOL VAR=AUXIO USAGE=OUTPUT HELP='FLD/AUXIO'.AuxIO
:LISTCOL VAR=ECPU USAGE=OUTPUT HELP='FLD/ECPU'.CPU %
:ELISTGRP.
:LISTCOL VAR=THREADS USAGE=OUTPUT HELP='FLD/THREADS'.Threads
:LISTCOL VAR=TMPSTG USAGE=OUTPUT HELP='FLD/TMPSTG'.Temporary Storage
:LISTVIEW COLS='OPT JOB CURUSER TYPE CPU FUNCTION STATUS'.
:LISTVIEW COLS='OPT JOB TYPE POOL PTY CPUSEC ELAPSED'.
:LISTVIEW COLS='OPT JOB USER NUMBER TYPE CPU THREADS TMPSTG'.
:ELIST.

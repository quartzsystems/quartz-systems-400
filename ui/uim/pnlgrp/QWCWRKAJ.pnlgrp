.* root directory of this project.
.*
.* WRKACTJOB: the active jobs in three views (status, elapsed data,
.* threads and storage); WRKACTJ1 shows the first options, WRKACTJ2
.* the others (F23).
:PNLGRP.
:CLASS NAME=OPTCL BASETYPE=ACTION.
:ECLASS.
:CLASS NAME=JOBCL BASETYPE='CHAR 13'.
:ECLASS.
:CLASS NAME=NAMECL BASETYPE='CHAR 10'.
:ECLASS.
:CLASS NAME=NBRCL BASETYPE='CHAR 6'.
:ECLASS.
:CLASS NAME=TYPECL BASETYPE='CHAR 4'.
:ECLASS.
:CLASS NAME=STSCL BASETYPE='CHAR 5'.
:ECLASS.
:CLASS NAME=FUNCL BASETYPE='CHAR 14'.
:ECLASS.
:CLASS NAME=TIMECL BASETYPE='CHAR 8'.
:ECLASS.
:CLASS NAME=COUNTCL BASETYPE='CHAR 5'.
:ECLASS.
:CLASS NAME=VIEWCL BASETYPE='CHAR 1'.
:ECLASS.
:CLASS NAME=PCTCL BASETYPE='ZONED 3 1'.
:ECLASS.
:CLASS NAME=POOLCL BASETYPE='ZONED 2 0'.
:ECLASS.
:CLASS NAME=PTYCL BASETYPE='ZONED 1 0'.
:ECLASS.
:CLASS NAME=CPUCL BASETYPE='ZONED 5 1'.
:ECLASS.
:CLASS NAME=INTCL BASETYPE='ZONED 2 0'.
:ECLASS.
:CLASS NAME=AUXCL BASETYPE='ZONED 4 0'.
:ECLASS.
:CLASS NAME=THDCL BASETYPE='ZONED 6 0'.
:ECLASS.
:CLASS NAME=STGCL BASETYPE='ZONED 7 0'.
:ECLASS.
:VAR NAME=OPT CLASS=OPTCL.
:VAR NAME=JOB CLASS=JOBCL.
:VAR NAME=JOBNM CLASS=NAMECL.
:VAR NAME=USER CLASS=NAMECL.
:VAR NAME=CURUSER CLASS=NAMECL.
:VAR NAME=NUMBER CLASS=NBRCL.
:VAR NAME=TYPE CLASS=TYPECL.
:VAR NAME=CPU CLASS=PCTCL.
:VAR NAME=FUNCTION CLASS=FUNCL.
:VAR NAME=STATUS CLASS=STSCL.
:VAR NAME=POOL CLASS=POOLCL.
:VAR NAME=PTY CLASS=PTYCL.
:VAR NAME=CPUSEC CLASS=CPUCL.
:VAR NAME=INT CLASS=INTCL.
:VAR NAME=RSP CLASS=PCTCL.
:VAR NAME=AUXIO CLASS=AUXCL.
:VAR NAME=ECPU CLASS=PCTCL.
:VAR NAME=THREADS CLASS=THDCL.
:VAR NAME=TMPSTG CLASS=STGCL.
:VAR NAME=SYSCPU CLASS=PCTCL.
:VAR NAME=ELAPSED CLASS=TIMECL.
:VAR NAME=ACTJOBS CLASS=COUNTCL.
:VAR NAME=VIEW CLASS=VIEWCL VALUE='1'.
:LISTDEF NAME=JOBS VARS='OPT JOB JOBNM USER CURUSER NUMBER TYPE CPU FUNCTION STATUS POOL PTY CPUSEC INT RSP AUXIO ECPU THREADS TMPSTG'.
:COND NAME=VIEW1 EXPR='&VIEW. EQ "1"'.
:COND NAME=VIEW2 EXPR='&VIEW. EQ "2"'.
:COND NAME=VIEW3 EXPR='&VIEW. EQ "3"'.
:COND NAME=NOTVIEW3 EXPR='&VIEW. NE "3"'.
:KEYL NAME=AJKEYS HELP=AJKEYS.
:KEYI KEY=ENTER ACTION=ENTER.
:KEYI KEY=HELP ACTION=HELP.
:KEYI KEY=PAGEUP ACTION=PAGEUP.
:KEYI KEY=PAGEDOWN ACTION=PAGEDOWN.
:KEYI KEY=F3 ACTION=EXIT.F3=Exit
:KEYI KEY=F5 ACTION='RETURN 5'.F5=Refresh
:KEYI KEY=F7 ACTION='RETURN 7'.F7=Find
:KEYI KEY=F10 ACTION='RETURN 10'.F10=Restart statistics
:KEYI KEY=F11 ACTION='RETURN 11' COND=VIEW1.F11=Display elapsed data
:KEYI KEY=F11 ACTION='RETURN 11' COND=VIEW2.F11=Display thread data
:KEYI KEY=F11 ACTION='RETURN 11' COND=VIEW3.F11=Display status
:KEYI KEY=F12 ACTION=CANCEL.F12=Cancel
:KEYI KEY=F17 ACTION=TOP COND=VIEW3.F17=Top
:KEYI KEY=F18 ACTION=BOTTOM COND=VIEW3.F18=Bottom
:KEYI KEY=F23 ACTION='RETURN 23'.F23=More options
:KEYI KEY=F24 ACTION=MOREKEYS.F24=More keys
:KEYI KEY=F4 ACTION='RETURN 4'.F4=Prompt
:KEYI KEY=F8 ACTION='RETURN 8'.F8=Repeat find
:KEYI KEY=F9 ACTION=RETRIEVE.F9=Retrieve
:KEYI KEY=F13 ACTION='RETURN 13'.F13=Reset statistics
:KEYI KEY=F14 ACTION='RETURN 14'.F14=Include
:KEYI KEY=F15 ACTION='CMD WRKSYSSTS' COND=VIEW3.F15=Work with system status
:KEYI KEY=F16 ACTION='RETURN 16'.F16=Resequence
:KEYI KEY=F17 ACTION=TOP COND=NOTVIEW3.F17=Top
:KEYI KEY=F18 ACTION=BOTTOM COND=NOTVIEW3.F18=Bottom
:KEYI KEY=F20 ACTION='RETURN 20'.F20=Subset
:EKEYL.
:PANEL NAME=WRKACTJ1 KEYL=AJKEYS HELP=WRKACTJ ENTER='RETURN 1' TOPSEP=DATETIME.Work with Active Jobs
:DATA DEPTH=2 COMPACT.
:DATAI VAR=SYSCPU USAGE=OUTPUT.CPU %
:DATAIX VAR=ELAPSED USAGE=OUTPUT.
:DATAIXT.Elapsed time
:DATAIX VAR=ACTJOBS USAGE=OUTPUT.
:DATAIXT.Active jobs
:EDATA.
:TOPINST.Type options, press Enter.
:LIST DEPTH='*' LISTDEF=JOBS VIEWS=3 COMPACT.
:LISTACT OPTION=2 ENTER='CMD ?CHGJOB JOB(&NUMBER./&USER./&JOBNM.)'.2=Change
:LISTACT OPTION=3 ENTER='CMD HLDJOB JOB(&NUMBER./&USER./&JOBNM.)'.3=Hold
:LISTACT OPTION=4 ENTER='CMD ?ENDJOB JOB(&NUMBER./&USER./&JOBNM.)'.4=End
:LISTACT OPTION=5 ENTER='CMD WRKJOB JOB(&NUMBER./&USER./&JOBNM.)'.5=Work with
:LISTACT OPTION=6 ENTER='CMD RLSJOB JOB(&NUMBER./&USER./&JOBNM.)'.6=Release
:LISTACT OPTION=7 ENTER='CMD DSPJOBLOG JOB(&NUMBER./&USER./&JOBNM.)'.7=Display message
:LISTACT OPTION=8 ENTER='CMD WRKJOB JOB(&NUMBER./&USER./&JOBNM.) OPTION(*SPLF)'.8=Work with spooled files
:LISTACT OPTION=13 ENTER='CMD DSCJOB JOB(&NUMBER./&USER./&JOBNM.)'.13=Disconnect ...
:LISTACT OPTION=9 ENTER='RETURN 9'.
:LISTACT OPTION=10 ENTER='CMD WRKJOB JOB(&NUMBER./&USER./&JOBNM.) OPTION(*PGMSTK)'.
:LISTACT OPTION=11 ENTER='CMD WRKJOB JOB(&NUMBER./&USER./&JOBNM.) OPTION(*JOBLCK)'.
:LISTACT OPTION=12 ENTER='CMD WRKJOB JOB(&NUMBER./&USER./&JOBNM.) OPTION(*THREAD)'.
:LISTACT OPTION=14 ENTER='CMD WRKJOB JOB(&NUMBER./&USER./&JOBNM.) OPTION(*MUTEX)'.
:LISTCOL VAR=OPT USAGE=INPUT.Opt
:LISTCOL VAR=JOB USAGE=OUTPUT.Subsystem/Job
:LISTCOL VAR=CURUSER USAGE=OUTPUT.Current User
:LISTCOL VAR=USER USAGE=OUTPUT.User
:LISTCOL VAR=NUMBER USAGE=OUTPUT.Number
:LISTCOL VAR=TYPE USAGE=OUTPUT.Type
:LISTCOL VAR=CPU USAGE=OUTPUT.CPU %
:LISTCOL VAR=FUNCTION USAGE=OUTPUT.Function
:LISTCOL VAR=STATUS USAGE=OUTPUT.Status
:LISTCOL VAR=POOL USAGE=OUTPUT.Pool
:LISTCOL VAR=PTY USAGE=OUTPUT.Pty
:LISTCOL VAR=CPUSEC USAGE=OUTPUT.CPU
:LISTGRP COL=ELAPSED.--------Elapsed---------
:LISTCOL VAR=INT USAGE=OUTPUT.Int
:LISTCOL VAR=RSP USAGE=OUTPUT.Rsp
:LISTCOL VAR=AUXIO USAGE=OUTPUT.AuxIO
:LISTCOL VAR=ECPU USAGE=OUTPUT.CPU %
:ELISTGRP.
:LISTCOL VAR=THREADS USAGE=OUTPUT.Threads
:LISTCOL VAR=TMPSTG USAGE=OUTPUT.Temporary Storage
:LISTVIEW COLS='OPT JOB CURUSER TYPE CPU FUNCTION STATUS'.
:LISTVIEW COLS='OPT JOB TYPE POOL PTY CPUSEC ELAPSED'.
:LISTVIEW COLS='OPT JOB USER NUMBER TYPE CPU THREADS TMPSTG'.
:ELIST.
:CMDLINE SIZE=SHORT.
:EPANEL.
:PANEL NAME=WRKACTJ2 KEYL=AJKEYS HELP=WRKACTJ ENTER='RETURN 1' TOPSEP=DATETIME.Work with Active Jobs
:DATA DEPTH=2 COMPACT.
:DATAI VAR=SYSCPU USAGE=OUTPUT.CPU %
:DATAIX VAR=ELAPSED USAGE=OUTPUT.
:DATAIXT.Elapsed time
:DATAIX VAR=ACTJOBS USAGE=OUTPUT.
:DATAIXT.Active jobs
:EDATA.
:TOPINST.Type options, press Enter.
:LIST DEPTH='*' LISTDEF=JOBS VIEWS=3 COMPACT.
:LISTACT OPTION=2 ENTER='CMD ?CHGJOB JOB(&NUMBER./&USER./&JOBNM.)'.
:LISTACT OPTION=3 ENTER='CMD HLDJOB JOB(&NUMBER./&USER./&JOBNM.)'.
:LISTACT OPTION=4 ENTER='CMD ?ENDJOB JOB(&NUMBER./&USER./&JOBNM.)'.
:LISTACT OPTION=5 ENTER='CMD WRKJOB JOB(&NUMBER./&USER./&JOBNM.)'.
:LISTACT OPTION=6 ENTER='CMD RLSJOB JOB(&NUMBER./&USER./&JOBNM.)'.
:LISTACT OPTION=7 ENTER='CMD DSPJOBLOG JOB(&NUMBER./&USER./&JOBNM.)'.
:LISTACT OPTION=8 ENTER='CMD WRKJOB JOB(&NUMBER./&USER./&JOBNM.) OPTION(*SPLF)'.
:LISTACT OPTION=9 ENTER='RETURN 9'.9=Exclude
:LISTACT OPTION=10 ENTER='CMD WRKJOB JOB(&NUMBER./&USER./&JOBNM.) OPTION(*PGMSTK)'.10=Display call stack
:LISTACT OPTION=11 ENTER='CMD WRKJOB JOB(&NUMBER./&USER./&JOBNM.) OPTION(*JOBLCK)'.11=Work with locks
:LISTACT OPTION=12 ENTER='CMD WRKJOB JOB(&NUMBER./&USER./&JOBNM.) OPTION(*THREAD)'.12=Work with threads
:LISTACT OPTION=14 ENTER='CMD WRKJOB JOB(&NUMBER./&USER./&JOBNM.) OPTION(*MUTEX)'.14=Work with mutexes ...
:LISTACT OPTION=13 ENTER='CMD DSCJOB JOB(&NUMBER./&USER./&JOBNM.)'.
:LISTCOL VAR=OPT USAGE=INPUT.Opt
:LISTCOL VAR=JOB USAGE=OUTPUT.Subsystem/Job
:LISTCOL VAR=CURUSER USAGE=OUTPUT.Current User
:LISTCOL VAR=USER USAGE=OUTPUT.User
:LISTCOL VAR=NUMBER USAGE=OUTPUT.Number
:LISTCOL VAR=TYPE USAGE=OUTPUT.Type
:LISTCOL VAR=CPU USAGE=OUTPUT.CPU %
:LISTCOL VAR=FUNCTION USAGE=OUTPUT.Function
:LISTCOL VAR=STATUS USAGE=OUTPUT.Status
:LISTCOL VAR=POOL USAGE=OUTPUT.Pool
:LISTCOL VAR=PTY USAGE=OUTPUT.Pty
:LISTCOL VAR=CPUSEC USAGE=OUTPUT.CPU
:LISTGRP COL=ELAPSED.--------Elapsed---------
:LISTCOL VAR=INT USAGE=OUTPUT.Int
:LISTCOL VAR=RSP USAGE=OUTPUT.Rsp
:LISTCOL VAR=AUXIO USAGE=OUTPUT.AuxIO
:LISTCOL VAR=ECPU USAGE=OUTPUT.CPU %
:ELISTGRP.
:LISTCOL VAR=THREADS USAGE=OUTPUT.Threads
:LISTCOL VAR=TMPSTG USAGE=OUTPUT.Temporary Storage
:LISTVIEW COLS='OPT JOB CURUSER TYPE CPU FUNCTION STATUS'.
:LISTVIEW COLS='OPT JOB TYPE POOL PTY CPUSEC ELAPSED'.
:LISTVIEW COLS='OPT JOB USER NUMBER TYPE CPU THREADS TMPSTG'.
:ELIST.
:CMDLINE SIZE=SHORT.
:EPANEL.
:HELP NAME=WRKACTJ.Work with Active Jobs - Help
:P.Every job active on the system, under the subsystem it runs in.
Type an option next to a job to act on it, or a command on the
command line. F11 changes the columns shown; F5 measures again from
the last look; F10 starts the measurement over.
:EHELP.
:HELP NAME=AJKEYS.Function keys
:P.F3 leaves the display, F5 refreshes it, F11 shows the next view and
F23 the other options. F24 shows the remaining keys.
:EHELP.
:EPNLGRP.

:VAR NAME=LVLCHK CLASS=VALCL.
:VAR NAME=SIZECUR CLASS=VALCL.
:VAR NAME=SIZEMAX CLASS=VALCL.
:VAR NAME=MODCUR CLASS=VALCL.
:VAR NAME=MODMAX CLASS=VALCL.
:VAR NAME=SRVCUR CLASS=VALCL.
:VAR NAME=SRVMAX CLASS=VALCL.
:VAR NAME=STCCUR CLASS=VALCL.
:VAR NAME=STCMAX CLASS=VALCL.
:VAR NAME=EXPHEAD CLASS=HEADCL.
:VAR NAME=EXPEMPTY CLASS=HEADCL.
:VAR NAME=OPT CLASS=OPTCL.
:VAR NAME=MODNAME CLASS=NAMECL.
:VAR NAME=MODLIB CLASS=NAMECL.
:VAR NAME=MODATTR CLASS=NAMECL.
:VAR NAME=MODDATE CLASS=DATECL.
:VAR NAME=MODOPT CLASS=LVLCL.
:VAR NAME=MODDBG CLASS=DBGCL.
:VAR NAME=SRVNAME CLASS=NAMECL.
:VAR NAME=SRVLIB CLASS=NAMECL.
:VAR NAME=SRVACT CLASS=NAMECL.
:VAR NAME=SRVSIG CLASS=SIGCL.
:VAR NAME=PROCNAME CLASS=EXPCL.
:VAR NAME=ARGOPT CLASS=ARGCL.
:VAR NAME=DATANAME CLASS=EXPCL.
:VAR NAME=DATASIZE CLASS=SIZECL.
:VAR NAME=SRCF CLASS=VALCL.
:VAR NAME=SRCFLIB CLASS=VALCL.
:VAR NAME=SRCMBR CLASS=VALCL.
:VAR NAME=COMPILER CLASS=VALCL.
:VAR NAME=OPTIONS CLASS=VALCL.
:VAR NAME=DBGVIEW CLASS=VALCL.
:VAR NAME=DBGDATA CLASS=VALCL.
:VAR NAME=MODACTGRP CLASS=VALCL.
:VAR NAME=PEP CLASS=VALCL.
:VAR NAME=NBRPROC CLASS=VALCL.
:VAR NAME=STCSIZE CLASS=VALCL.
:VAR NAME=CODESIZE CLASS=VALCL.
:VAR NAME=CODEGEN CLASS=VALCL.
:VAR NAME=PROCSCOPE CLASS=NAMECL.
:VAR NAME=PROCPEP CLASS=NAMECL.
:LISTDEF NAME=MODS VARS='OPT MODNAME MODLIB MODATTR MODDATE MODOPT MODDBG'.
:LISTDEF NAME=SRVS VARS='OPT SRVNAME SRVLIB SRVACT SRVSIG'.
:LISTDEF NAME=EXPS VARS='PROCNAME ARGOPT DATANAME DATASIZE'.
:LISTDEF NAME=PROCS VARS='PROCNAME PROCSCOPE PROCPEP'.
:KEYL NAME=KEYS HELP=KEYSHLP.
:KEYI KEY=ENTER ACTION=ENTER.
:KEYI KEY=HELP ACTION=HELP.
:KEYI KEY=F1 ACTION=HELP.
:KEYI KEY=F3 ACTION=EXIT.F3=Exit
:KEYI KEY=F12 ACTION=CANCEL.F12=Cancel
:KEYI KEY=PAGEUP ACTION=PAGEUP.
:KEYI KEY=PAGEDOWN ACTION=PAGEDOWN.
:EKEYL.
:KEYL NAME=SIGKEYS HELP=KEYSHLP.
:KEYI KEY=ENTER ACTION=ENTER.
:KEYI KEY=HELP ACTION=HELP.
:KEYI KEY=F1 ACTION=HELP.
:KEYI KEY=F3 ACTION=EXIT.F3=Exit
:KEYI KEY=F11 ACTION='RETURN 11'.F11=Display character signature
:KEYI KEY=F12 ACTION=CANCEL.F12=Cancel
:KEYI KEY=PAGEUP ACTION=PAGEUP.
:KEYI KEY=PAGEDOWN ACTION=PAGEDOWN.
:EKEYL.
:KEYL NAME=LISTKEYS HELP=KEYSHLP.
:KEYI KEY=ENTER ACTION=ENTER.
:KEYI KEY=HELP ACTION=HELP.
:KEYI KEY=F1 ACTION=HELP.
:KEYI KEY=F3 ACTION=EXIT.F3=Exit
:KEYI KEY=F12 ACTION=CANCEL.F12=Cancel
:KEYI KEY=F17 ACTION=TOP.F17=Top
:KEYI KEY=F18 ACTION=BOTTOM.F18=Bottom
:KEYI KEY=PAGEUP ACTION=PAGEUP.
:KEYI KEY=PAGEDOWN ACTION=PAGEDOWN.
:EKEYL.
:KEYL NAME=SRVKEYS HELP=KEYSHLP.
:KEYI KEY=ENTER ACTION=ENTER.
:KEYI KEY=HELP ACTION=HELP.
:KEYI KEY=F1 ACTION=HELP.
:KEYI KEY=F3 ACTION=EXIT.F3=Exit
:KEYI KEY=F4 ACTION='RETURN 4'.F4=Prompt
:KEYI KEY=F11 ACTION='RETURN 11'.F11=Display character signature
:KEYI KEY=F12 ACTION=CANCEL.F12=Cancel
:KEYI KEY=F17 ACTION=TOP.F17=Top
:KEYI KEY=F18 ACTION=BOTTOM.F18=Bottom
:KEYI KEY=PAGEUP ACTION=PAGEUP.
:KEYI KEY=PAGEDOWN ACTION=PAGEDOWN.
:EKEYL.
.* --- the program's displays
:PANEL NAME=PGMBASIC KEYL=KEYS HELP=DSPPGMH ENTER='RETURN 0' TOPSEP=NONE.Display Program Information
:DATA DEPTH=1.
:DATACOL WIDTH=63.
:DATAC.
:DATACOL WIDTH=15.
:DATAC.&DSPPOS.
:EDATA.
:DATA DEPTH=6.
:DATACOL WIDTH=24.
:DATACOL WIDTH=41.
:DATAI VAR=PGM USAGE=OUTPUT.Program
:DATAI VAR=OWNER USAGE=OUTPUT.Owner
:DATAI VAR=PGMATTR USAGE=OUTPUT.Program attribute
:DATAI VAR=DETAIL USAGE=OUTPUT.Detail
:DATACOL WIDTH=24.
:DATACOL WIDTH=37.
:DATAI VAR=PGMLIB USAGE=OUTPUT.Library
:EDATA.
:DATA DEPTH='*' SCROLL=YES.
:DATACOL WIDTH=50.
:DATACOL WIDTH=78.
:DATAGRP GRPSEP=NONE.Program creation information
:DATAI VAR=CRTDT USAGE=OUTPUT.Program creation date/time
:DATAI VAR=PGMTYPE USAGE=OUTPUT.Type of program
:DATAI VAR=PEPMOD USAGE=OUTPUT.Program entry procedure module
:DATAGRP GRPSEP=NONE.
:DATAI VAR=PEPMODL USAGE=OUTPUT.Library
:EDATAGRP.
:DATAI VAR=ACTGRP USAGE=OUTPUT.Activation group attribute
:DATAI VAR=SHRACTGRP USAGE=OUTPUT.Shared activation group
:DATAI VAR=USRPRF USAGE=OUTPUT.User profile
:DATAI VAR=USEADPAUT USAGE=OUTPUT.Use adopted authority
:DATAI VAR=CCSID USAGE=OUTPUT.Coded character set identifier
:DATAI VAR=NBRMOD USAGE=OUTPUT.Number of modules
:DATAI VAR=NBRSRV USAGE=OUTPUT.Number of service programs
:DATAI VAR=NBRUNRES USAGE=OUTPUT.Number of unresolved references
:DATAI VAR=NBRCPYR USAGE=OUTPUT.Number of copyrights
:DATAI VAR=ALLCRTDTA USAGE=OUTPUT.All creation data
:DATAI VAR=OBSCMPR USAGE=OUTPUT.Observable information compressed
:DATAI VAR=RUNCMPR USAGE=OUTPUT.Run time information compressed
:DATAI VAR=ALWUPD USAGE=OUTPUT.Allow update
:DATAI VAR=ALWLIBUPD USAGE=OUTPUT.Allow bound *SRVPGM library name update
:DATAI VAR=PRFDTA USAGE=OUTPUT.Profiling data
:DATAI VAR=TSPEP USAGE=OUTPUT.Teraspace storage enabled PEP
:DATAI VAR=TSMOD USAGE=OUTPUT.Teraspace storage enabled modules
:DATAI VAR=STGMDL USAGE=OUTPUT.Storage model
:DATAI VAR=PGMSTATE USAGE=OUTPUT.Program state
:DATAI VAR=PGMDOMAIN USAGE=OUTPUT.Program domain
:DATAI VAR=OBSERV USAGE=OUTPUT.Observable information
:DATAI VAR=TGTRLS USAGE=OUTPUT.Earliest release program can run
:EDATAGRP.
:EDATA.
:BOTINST.Press Enter to continue.
:EPANEL.

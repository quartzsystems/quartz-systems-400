.*
.* QUIDSPPGM: DSPPGM, DSPSRVPGM and DSPMOD, one display per detail (basic,
.* size, modules, service programs, exports and the other lists). The
.* PGM panels carry the program's header, the SRV panels the service
.* program's; the bodies are the same. DSPPOS is `Display n of m`
.* right-aligned in 15.
:PNLGRP.
:COPYR.(C) COPYRIGHT QUARTZ SYSTEMS 2026.
:CLASS NAME=NAMECL BASETYPE='CHAR 10'.
:ECLASS.
:CLASS NAME=VALCL BASETYPE='CHAR 24'.
:ECLASS.
:CLASS NAME=POSCL BASETYPE='CHAR 15'.
:ECLASS.
:CLASS NAME=HEADCL BASETYPE='CHAR 78'.
:ECLASS.
:CLASS NAME=OPTCL BASETYPE=ACTION.
:ECLASS.
:CLASS NAME=DATECL BASETYPE='CHAR 8'.
:ECLASS.
:CLASS NAME=LVLCL BASETYPE='CHAR 2'.
:ECLASS.
:CLASS NAME=DBGCL BASETYPE='CHAR 5'.
:ECLASS.
:CLASS NAME=SIGCL BASETYPE='CHAR 32'.
:ECLASS.
:CLASS NAME=EXPCL BASETYPE='CHAR 70'.
:ECLASS.
:CLASS NAME=ARGCL BASETYPE='CHAR 6'.
:ECLASS.
:CLASS NAME=PTYPECL BASETYPE='CHAR 17'.
:ECLASS.
:CLASS NAME=SIZECL BASETYPE='PACKED 2 0'.
:ECLASS.
:VAR NAME=DSPPOS CLASS=POSCL.
:VAR NAME=PGM CLASS=NAMECL.
:VAR NAME=PGMLIB CLASS=NAMECL.
:VAR NAME=OWNER CLASS=NAMECL.
:VAR NAME=PGMATTR CLASS=NAMECL.
:VAR NAME=DETAIL CLASS=NAMECL.
:VAR NAME=CRTDT CLASS=VALCL.
:VAR NAME=PGMTYPE CLASS=VALCL.
:VAR NAME=PEPMOD CLASS=VALCL.
:VAR NAME=PEPMODL CLASS=VALCL.
:VAR NAME=EXPSRCF CLASS=VALCL.
:VAR NAME=EXPSRCFL CLASS=VALCL.
:VAR NAME=EXPMBR CLASS=VALCL.
:VAR NAME=EXPSTMF CLASS=VALCL.
:VAR NAME=ACTGRP CLASS=VALCL.
:VAR NAME=SHRACTGRP CLASS=VALCL.
:VAR NAME=CURSIG CLASS=SIGCL.
:VAR NAME=USRPRF CLASS=VALCL.
:VAR NAME=USEADPAUT CLASS=VALCL.
:VAR NAME=CCSID CLASS=VALCL.
:VAR NAME=NBRMOD CLASS=VALCL.
:VAR NAME=NBRSRV CLASS=VALCL.
:VAR NAME=NBRUNRES CLASS=VALCL.
:VAR NAME=NBRCPYR CLASS=VALCL.
:VAR NAME=ALLCRTDTA CLASS=VALCL.
:VAR NAME=OBSCMPR CLASS=VALCL.
:VAR NAME=RUNCMPR CLASS=VALCL.
:VAR NAME=ALWUPD CLASS=VALCL.
:VAR NAME=ALWLIBUPD CLASS=VALCL.
:VAR NAME=PRFDTA CLASS=VALCL.
:VAR NAME=TSPEP CLASS=VALCL.
:VAR NAME=TSMOD CLASS=VALCL.
:VAR NAME=STGMDL CLASS=VALCL.
:VAR NAME=PGMSTATE CLASS=VALCL.
:VAR NAME=PGMDOMAIN CLASS=VALCL.
:VAR NAME=TGTRLS CLASS=VALCL.
:VAR NAME=OBSERV CLASS=VALCL.
:VAR NAME=LVLCHK CLASS=VALCL.
:VAR NAME=SIZECUR CLASS=VALCL.
:VAR NAME=SIZEMAX CLASS=VALCL.
:VAR NAME=MODCUR CLASS=VALCL.
:VAR NAME=MODMAX CLASS=VALCL.
:VAR NAME=SRVCUR CLASS=VALCL.
:VAR NAME=SRVMAX CLASS=VALCL.
:VAR NAME=STCCUR CLASS=VALCL.
:VAR NAME=STCMAX CLASS=VALCL.
:VAR NAME=EXPHEAD CLASS=HEADCL.
:VAR NAME=EXPEMPTY CLASS=HEADCL.
:VAR NAME=OPT CLASS=OPTCL.
:VAR NAME=MODNAME CLASS=NAMECL.
:VAR NAME=MODLIB CLASS=NAMECL.
:VAR NAME=MODATTR CLASS=NAMECL.
:VAR NAME=MODDATE CLASS=DATECL.
:VAR NAME=MODOPT CLASS=LVLCL.
:VAR NAME=MODDBG CLASS=DBGCL.
:VAR NAME=SRVNAME CLASS=NAMECL.
:VAR NAME=SRVLIB CLASS=NAMECL.
:VAR NAME=SRVACT CLASS=NAMECL.
:VAR NAME=SRVSIG CLASS=SIGCL.
:VAR NAME=PROCNAME CLASS=EXPCL.
:VAR NAME=ARGOPT CLASS=ARGCL.
:VAR NAME=DATANAME CLASS=EXPCL.
:VAR NAME=DATASIZE CLASS=SIZECL.
:VAR NAME=SRCF CLASS=VALCL.
:VAR NAME=SRCFLIB CLASS=VALCL.
:VAR NAME=SRCMBR CLASS=VALCL.
:VAR NAME=COMPILER CLASS=VALCL.
:VAR NAME=OPTIONS CLASS=VALCL.
:VAR NAME=DBGVIEW CLASS=VALCL.
:VAR NAME=DBGDATA CLASS=VALCL.
:VAR NAME=MODACTGRP CLASS=VALCL.
:VAR NAME=PEP CLASS=VALCL.
:VAR NAME=NBRPROC CLASS=VALCL.
:VAR NAME=STCSIZE CLASS=VALCL.
:VAR NAME=CODESIZE CLASS=VALCL.
:VAR NAME=CODEGEN CLASS=VALCL.
:VAR NAME=PROCSCOPE CLASS=NAMECL.
:VAR NAME=PROCPEP CLASS=NAMECL.
:VAR NAME=SIGVIEW CLASS=LVLCL VALUE='H'.
:COND NAME=SIGHEX EXPR='&SIGVIEW. EQ "H"'.
:COND NAME=SIGCHR EXPR='&SIGVIEW. EQ "C"'.
:COND NAME=SIGNONE EXPR='&SIGVIEW. EQ "N"'.
:VAR NAME=PROCTYPE CLASS=PTYPECL.
:VAR NAME=SRCCHG CLASS=VALCL.
:VAR NAME=MODTEXT CLASS=EXPCL.
:VAR NAME=CRTDTA CLASS=VALCL VALUE='*YES'.
:VAR NAME=ILDATA CLASS=VALCL VALUE='*NO'.
:VAR NAME=PROCHEAD CLASS=HEADCL VALUE='                               Procedure list:'.
:LISTDEF NAME=MODS VARS='OPT MODNAME MODLIB MODATTR MODDATE MODOPT MODDBG'.
:LISTDEF NAME=SRVS VARS='OPT SRVNAME SRVLIB SRVACT SRVSIG'.
:LISTDEF NAME=EXPS VARS='PROCNAME ARGOPT DATANAME DATASIZE'.
:LISTDEF NAME=PROCS VARS='PROCNAME PROCTYPE ARGOPT PROCSCOPE PROCPEP'.
:KEYL NAME=KEYS HELP=KEYSHLP.
:KEYI KEY=ENTER ACTION=ENTER.
:KEYI KEY=HELP ACTION=HELP.
:KEYI KEY=F1 ACTION=HELP.
:KEYI KEY=F3 ACTION=EXIT.F3=Exit
:KEYI KEY=F12 ACTION=CANCEL.F12=Cancel
:KEYI KEY=PAGEUP ACTION=PAGEUP.
:KEYI KEY=PAGEDOWN ACTION=PAGEDOWN.
:EKEYL.
:KEYL NAME=SIGKEYS HELP=KEYSHLP.
:KEYI KEY=ENTER ACTION=ENTER.
:KEYI KEY=HELP ACTION=HELP.
:KEYI KEY=F1 ACTION=HELP.
:KEYI KEY=F3 ACTION=EXIT.F3=Exit
:KEYI KEY=F11 ACTION='RETURN 11' COND=SIGHEX.F11=Display character signature
:KEYI KEY=F11 ACTION='RETURN 11' COND=SIGCHR.F11=Display hexadecimal signature
:KEYI KEY=F12 ACTION=CANCEL.F12=Cancel
:KEYI KEY=PAGEUP ACTION=PAGEUP.
:KEYI KEY=PAGEDOWN ACTION=PAGEDOWN.
:EKEYL.
.* The size display keeps the two key rows of the first (IBM does).
:KEYL NAME=SIZEKEYS HELP=KEYSHLP.
:KEYI KEY=ENTER ACTION=ENTER.
:KEYI KEY=HELP ACTION=HELP.
:KEYI KEY=F1 ACTION=HELP.
:KEYI KEY=F3 ACTION=EXIT.F3=Exit
:KEYI KEY=F11 ACTION='RETURN 11' COND=SIGNONE.F11=Display character signature
:KEYI KEY=F11 ACTION='RETURN 11' COND=SIGNONE.F11=Display hexadecimal signature
:KEYI KEY=F12 ACTION=CANCEL.F12=Cancel
:KEYI KEY=PAGEUP ACTION=PAGEUP.
:KEYI KEY=PAGEDOWN ACTION=PAGEDOWN.
:EKEYL.
:KEYL NAME=LISTKEYS HELP=KEYSHLP.
:KEYI KEY=ENTER ACTION=ENTER.
:KEYI KEY=HELP ACTION=HELP.
:KEYI KEY=F1 ACTION=HELP.
:KEYI KEY=F3 ACTION=EXIT.F3=Exit
:KEYI KEY=F12 ACTION=CANCEL.F12=Cancel
:KEYI KEY=F17 ACTION=TOP.F17=Top
:KEYI KEY=F18 ACTION=BOTTOM.F18=Bottom
:KEYI KEY=PAGEUP ACTION=PAGEUP.
:KEYI KEY=PAGEDOWN ACTION=PAGEDOWN.
:EKEYL.
:KEYL NAME=SRVKEYS HELP=KEYSHLP.
:KEYI KEY=ENTER ACTION=ENTER.
:KEYI KEY=HELP ACTION=HELP.
:KEYI KEY=F1 ACTION=HELP.
:KEYI KEY=F3 ACTION=EXIT.F3=Exit
:KEYI KEY=F4 ACTION='RETURN 4'.F4=Prompt
:KEYI KEY=F11 ACTION='RETURN 11'.F11=Display character signature
:KEYI KEY=F12 ACTION=CANCEL.F12=Cancel
:KEYI KEY=F17 ACTION=TOP.F17=Top
:KEYI KEY=F18 ACTION=BOTTOM.F18=Bottom
:KEYI KEY=PAGEUP ACTION=PAGEUP.
:KEYI KEY=PAGEDOWN ACTION=PAGEDOWN.
:EKEYL.
.* --- the program's displays
:PANEL NAME=PGMBASIC KEYL=KEYS HELP=DSPPGMH ENTER='RETURN 0' TOPSEP=NONE.Display Program Information
:DATA DEPTH=1.
:DATACOL WIDTH=63.
:DATAC.
:DATACOL WIDTH=15.
:DATAC.&DSPPOS.
:EDATA.
:DATA DEPTH=6.
:DATACOL WIDTH=24.
:DATACOL WIDTH=41.
:DATAI HELP='FLD/PGM' VAR=PGM USAGE=OUTPUT.Program
:DATAI HELP='FLD/OWNER' VAR=OWNER USAGE=OUTPUT.Owner
:DATAI HELP='FLD/PGMATTR' VAR=PGMATTR USAGE=OUTPUT.Program attribute
:DATAI HELP='FLD/DETAIL' VAR=DETAIL USAGE=OUTPUT.Detail
:DATACOL WIDTH=24.
:DATACOL WIDTH=37.
:DATAI HELP='FLD/PGMLIB' VAR=PGMLIB USAGE=OUTPUT.Library
:EDATA.
:DATA DEPTH='*' SCROLL=YES.
:DATACOL WIDTH=50.
:DATACOL WIDTH=78.
:DATAGRP GRPSEP=NONE.Program creation information
:DATAI HELP='FLD/CRTDT' VAR=CRTDT USAGE=OUTPUT.Program creation date/time
:DATAI HELP='FLD/PGMTYPE' VAR=PGMTYPE USAGE=OUTPUT.Type of program
:DATAI HELP='FLD/PEPMOD' VAR=PEPMOD USAGE=OUTPUT.Program entry procedure module
:DATAGRP GRPSEP=NONE.
:DATAI HELP='FLD/PEPMODL' VAR=PEPMODL USAGE=OUTPUT.Library
:EDATAGRP.
:DATAI HELP='FLD/ACTGRP' VAR=ACTGRP USAGE=OUTPUT.Activation group attribute
:DATAI HELP='FLD/SHRACTGRP' VAR=SHRACTGRP USAGE=OUTPUT.Shared activation group
:DATAI HELP='FLD/USRPRF' VAR=USRPRF USAGE=OUTPUT.User profile
:DATAI HELP='FLD/USEADPAUT' VAR=USEADPAUT USAGE=OUTPUT.Use adopted authority
:DATAI HELP='FLD/CCSID' VAR=CCSID USAGE=OUTPUT.Coded character set identifier
:DATAI HELP='FLD/NBRMOD' VAR=NBRMOD USAGE=OUTPUT.Number of modules
:DATAI HELP='FLD/NBRSRV' VAR=NBRSRV USAGE=OUTPUT.Number of service programs
:DATAI HELP='FLD/NBRUNRES' VAR=NBRUNRES USAGE=OUTPUT.Number of unresolved references
:DATAI HELP='FLD/NBRCPYR' VAR=NBRCPYR USAGE=OUTPUT.Number of copyrights
:DATAI HELP='FLD/ALLCRTDTA' VAR=ALLCRTDTA USAGE=OUTPUT.All creation data
:DATAI HELP='FLD/OBSCMPR' VAR=OBSCMPR USAGE=OUTPUT.Observable information compressed
:DATAI HELP='FLD/RUNCMPR' VAR=RUNCMPR USAGE=OUTPUT.Run time information compressed
:DATAI HELP='FLD/ALWUPD' VAR=ALWUPD USAGE=OUTPUT.Allow update
:DATAI HELP='FLD/ALWLIBUPD' VAR=ALWLIBUPD USAGE=OUTPUT.Allow bound *SRVPGM library name update
:DATAI HELP='FLD/PRFDTA' VAR=PRFDTA USAGE=OUTPUT.Profiling data
:DATAI HELP='FLD/TSPEP' VAR=TSPEP USAGE=OUTPUT.Teraspace storage enabled PEP
:DATAI HELP='FLD/TSMOD' VAR=TSMOD USAGE=OUTPUT.Teraspace storage enabled modules
:DATAI HELP='FLD/STGMDL' VAR=STGMDL USAGE=OUTPUT.Storage model
:DATAI HELP='FLD/PGMSTATE' VAR=PGMSTATE USAGE=OUTPUT.Program state
:DATAI HELP='FLD/PGMDOMAIN' VAR=PGMDOMAIN USAGE=OUTPUT.Program domain
:DATAI HELP='FLD/OBSERV' VAR=OBSERV USAGE=OUTPUT.Observable information
:DATAI HELP='FLD/TGTRLS' VAR=TGTRLS USAGE=OUTPUT.Earliest release program can run
:EDATAGRP.
:EDATA.
:BOTINST.Press Enter to continue.
:EPANEL.
:PANEL NAME=PGMSIZE KEYL=KEYS HELP=DSPPGMH ENTER='RETURN 0' TOPSEP=NONE.Display Program Information
:DATA DEPTH=1.
:DATACOL WIDTH=63.
:DATAC.
:DATACOL WIDTH=15.
:DATAC.&DSPPOS.
:EDATA.
:DATA DEPTH=6.
:DATACOL WIDTH=24.
:DATACOL WIDTH=41.
:DATAI HELP='FLD/PGM' VAR=PGM USAGE=OUTPUT.Program
:DATAI HELP='FLD/OWNER' VAR=OWNER USAGE=OUTPUT.Owner
:DATAI HELP='FLD/PGMATTR' VAR=PGMATTR USAGE=OUTPUT.Program attribute
:DATAI HELP='FLD/DETAIL' VAR=DETAIL USAGE=OUTPUT.Detail
:DATACOL WIDTH=24.
:DATACOL WIDTH=37.
:DATAI HELP='FLD/PGMLIB' VAR=PGMLIB USAGE=OUTPUT.Library
:EDATA.
:DATA DEPTH='*' SCROLL=YES.
:DATACOL WIDTH=50.
:DATACOL WIDTH=78.
:DATAGRP GRPSEP=NONE.Program size (decompressed) and limit information
:DATAGRP GRPSEP=NONE.Total program size (KB)
:DATAI HELP='FLD/SIZECUR' VAR=SIZECUR USAGE=OUTPUT.Current
:DATAI HELP='FLD/SIZEMAX' VAR=SIZEMAX USAGE=OUTPUT.Maximum
:EDATAGRP.
:DATAGRP GRPSEP=NONE.Number of modules
:DATAI HELP='FLD/MODCUR' VAR=MODCUR USAGE=OUTPUT.Current
:DATAI HELP='FLD/MODMAX' VAR=MODMAX USAGE=OUTPUT.Maximum
:EDATAGRP.
:DATAGRP GRPSEP=NONE.Number of service programs
:DATAI HELP='FLD/SRVCUR' VAR=SRVCUR USAGE=OUTPUT.Current
:DATAI HELP='FLD/SRVMAX' VAR=SRVMAX USAGE=OUTPUT.Maximum
:EDATAGRP.
:DATAGRP GRPSEP=SPACE.Static storage (KB)
:DATAI HELP='FLD/STCCUR' VAR=STCCUR USAGE=OUTPUT.Current
:DATAI HELP='FLD/STCMAX' VAR=STCMAX USAGE=OUTPUT.Maximum
:EDATAGRP.
:EDATAGRP.
:EDATA.
:BOTINST.Press Enter to continue.
:EPANEL.
:PANEL NAME=PGMMOD BOTSEP=NONE KEYL=LISTKEYS HELP=DSPPGMH ENTER='RETURN 0' TOPSEP=NONE.Display Program Information
:DATA DEPTH=1.
:DATACOL WIDTH=63.
:DATAC.
:DATACOL WIDTH=15.
:DATAC.&DSPPOS.
:EDATA.
:DATA DEPTH=6.
:DATACOL WIDTH=24.
:DATACOL WIDTH=41.
:DATAI HELP='FLD/PGM' VAR=PGM USAGE=OUTPUT.Program
:DATAI HELP='FLD/OWNER' VAR=OWNER USAGE=OUTPUT.Owner
:DATAI HELP='FLD/PGMATTR' VAR=PGMATTR USAGE=OUTPUT.Program attribute
:DATAI HELP='FLD/DETAIL' VAR=DETAIL USAGE=OUTPUT.Detail
:DATACOL WIDTH=24.
:DATACOL WIDTH=37.
:DATAI HELP='FLD/PGMLIB' VAR=PGMLIB USAGE=OUTPUT.Library
:EDATA.
:TOPINST.Type options, press Enter.
:LIST DEPTH='*' LISTDEF=MODS SCROLL=YES.
:LISTACT HELP='PGMMOD/OPTIONS' OPTION=5 ENTER='RETURN 5'.5=Display description
:LISTACT HELP='PGMMOD/OPTIONS' OPTION=6 ENTER='RETURN 6'.6=Print description
:LISTCOL HELP='PGMMOD/OPT' VAR=OPT USAGE=INPUT.Opt
:LISTCOL HELP='FLD/MODNAME' VAR=MODNAME USAGE=OUTPUT.Module
:LISTCOL HELP='FLD/MODLIB' VAR=MODLIB USAGE=OUTPUT.Library
:LISTCOL HELP='FLD/MODATTR' VAR=MODATTR USAGE=OUTPUT.Attribute
:LISTCOL HELP='FLD/MODDATE' VAR=MODDATE USAGE=OUTPUT.Creation Date
:LISTCOL HELP='FLD/MODOPT' VAR=MODOPT USAGE=OUTPUT.Optimization Level
:LISTCOL HELP='FLD/MODDBG' VAR=MODDBG USAGE=OUTPUT.Debug Data
:ELIST.
:EPANEL.
:PANEL NAME=PGMSRV BOTSEP=NONE KEYL=SRVKEYS HELP=DSPPGMH ENTER='RETURN 0' TOPSEP=NONE.Display Program Information
:DATA DEPTH=1.
:DATACOL WIDTH=63.
:DATAC.
:DATACOL WIDTH=15.
:DATAC.&DSPPOS.
:EDATA.
:DATA DEPTH=6.
:DATACOL WIDTH=24.
:DATACOL WIDTH=41.
:DATAI HELP='FLD/PGM' VAR=PGM USAGE=OUTPUT.Program
:DATAI HELP='FLD/OWNER' VAR=OWNER USAGE=OUTPUT.Owner
:DATAI HELP='FLD/PGMATTR' VAR=PGMATTR USAGE=OUTPUT.Program attribute
:DATAI HELP='FLD/DETAIL' VAR=DETAIL USAGE=OUTPUT.Detail
:DATACOL WIDTH=24.
:DATACOL WIDTH=37.
:DATAI HELP='FLD/PGMLIB' VAR=PGMLIB USAGE=OUTPUT.Library
:EDATA.
:TOPINST.Type options, press Enter.
:LIST DEPTH='*' LISTDEF=SRVS SCROLL=YES.
:LISTACT HELP='PGMSRV/OPTIONS' OPTION=5 ENTER='RETURN 5'.5=Display
:LISTCOL HELP='PGMSRV/OPT' VAR=OPT USAGE=INPUT.Opt
:LISTCOL HELP='FLD/SRVNAME' VAR=SRVNAME USAGE=OUTPUT.Service Program
:LISTCOL HELP='FLD/SRVLIB' VAR=SRVLIB USAGE=OUTPUT.Library
:LISTCOL HELP='FLD/SRVACT' VAR=SRVACT USAGE=OUTPUT.Activation
:LISTCOL HELP='FLD/SRVSIG' VAR=SRVSIG USAGE=OUTPUT.Signature
:ELIST.
:EPANEL.
:PANEL NAME=PGMEXP BOTSEP=NONE KEYL=LISTKEYS HELP=DSPPGMH ENTER='RETURN 0' TOPSEP=NONE.Display Program Information
:DATA DEPTH=1.
:DATACOL WIDTH=63.
:DATAC.
:DATACOL WIDTH=15.
:DATAC.&DSPPOS.
:EDATA.
:DATA DEPTH=6.
:DATACOL WIDTH=24.
:DATACOL WIDTH=41.
:DATAI HELP='FLD/PGM' VAR=PGM USAGE=OUTPUT.Program
:DATAI HELP='FLD/OWNER' VAR=OWNER USAGE=OUTPUT.Owner
:DATAI HELP='FLD/PGMATTR' VAR=PGMATTR USAGE=OUTPUT.Program attribute
:DATAI HELP='FLD/DETAIL' VAR=DETAIL USAGE=OUTPUT.Detail
:DATACOL WIDTH=24.
:DATACOL WIDTH=37.
:DATAI HELP='FLD/PGMLIB' VAR=PGMLIB USAGE=OUTPUT.Library
:EDATA.
:DATA DEPTH=2.
:DATAC.&EXPHEAD.
:EDATA.
:LIST DEPTH='*' LISTDEF=EXPS VIEWS=2 SCROLL=YES.&EXPEMPTY.
:LISTCOL HELP='FLD/PROCNAME' VAR=PROCNAME USAGE=OUTPUT.Procedure Name
:LISTCOL HELP='FLD/ARGOPT' VAR=ARGOPT USAGE=OUTPUT.ARGOPT
:LISTCOL HELP='FLD/DATANAME' VAR=DATANAME USAGE=OUTPUT.Data Item
:LISTCOL HELP='FLD/DATASIZE' VAR=DATASIZE USAGE=OUTPUT.Size
:LISTVIEW COLS='PROCNAME ARGOPT'.
:LISTVIEW COLS='DATANAME DATASIZE'.
:ELIST.
:EPANEL.
.* --- the service program's displays

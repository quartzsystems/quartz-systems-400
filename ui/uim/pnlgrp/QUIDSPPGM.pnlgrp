:EDATA.
:BOTINST.Press Enter to continue.
:EPANEL.
:PANEL NAME=PGMMOD BOTSEP=NONE KEYL=LISTKEYS HELP=DSPPGMH ENTER='RETURN 0' TOPSEP=NONE.Display Program Information
:DATA DEPTH=1.
:DATACOL WIDTH=63.
:DATAC.
:DATACOL WIDTH=15.
:DATAC.&DSPPOS.
:EDATA.
:DATA DEPTH=6.
:DATACOL WIDTH=24.
:DATACOL WIDTH=41.
:DATAI VAR=PGM USAGE=OUTPUT.Program
:DATAI VAR=OWNER USAGE=OUTPUT.Owner
:DATAI VAR=PGMATTR USAGE=OUTPUT.Program attribute
:DATAI VAR=DETAIL USAGE=OUTPUT.Detail
:DATACOL WIDTH=24.
:DATACOL WIDTH=37.
:DATAI VAR=PGMLIB USAGE=OUTPUT.Library
:EDATA.
:TOPINST.Type options, press Enter.
:LIST DEPTH='*' LISTDEF=MODS SCROLL=YES.
:LISTACT OPTION=5 ENTER='RETURN 5'.5=Display description
:LISTACT OPTION=6 ENTER='RETURN 6'.6=Print description
:LISTCOL VAR=OPT USAGE=INPUT.Opt
:LISTCOL VAR=MODNAME USAGE=OUTPUT.Module
:LISTCOL VAR=MODLIB USAGE=OUTPUT.Library
:LISTCOL VAR=MODATTR USAGE=OUTPUT.Attribute
:LISTCOL VAR=MODDATE USAGE=OUTPUT.Creation Date
:LISTCOL VAR=MODOPT USAGE=OUTPUT.Optimization Level
:LISTCOL VAR=MODDBG USAGE=OUTPUT.Debug Data
:ELIST.
:EPANEL.
:PANEL NAME=PGMSRV BOTSEP=NONE KEYL=SRVKEYS HELP=DSPPGMH ENTER='RETURN 0' TOPSEP=NONE.Display Program Information
:DATA DEPTH=1.
:DATACOL WIDTH=63.
:DATAC.
:DATACOL WIDTH=15.
:DATAC.&DSPPOS.
:EDATA.
:DATA DEPTH=6.
:DATACOL WIDTH=24.
:DATACOL WIDTH=41.
:DATAI VAR=PGM USAGE=OUTPUT.Program
:DATAI VAR=OWNER USAGE=OUTPUT.Owner
:DATAI VAR=PGMATTR USAGE=OUTPUT.Program attribute
:DATAI VAR=DETAIL USAGE=OUTPUT.Detail
:DATACOL WIDTH=24.
:DATACOL WIDTH=37.
:DATAI VAR=PGMLIB USAGE=OUTPUT.Library
:EDATA.
:TOPINST.Type options, press Enter.
:LIST DEPTH='*' LISTDEF=SRVS SCROLL=YES.
:LISTACT OPTION=5 ENTER='RETURN 5'.5=Display
:LISTCOL VAR=OPT USAGE=INPUT.Opt
:LISTCOL VAR=SRVNAME USAGE=OUTPUT.Service Program
:LISTCOL VAR=SRVLIB USAGE=OUTPUT.Library
:LISTCOL VAR=SRVACT USAGE=OUTPUT.Activation
:LISTCOL VAR=SRVSIG USAGE=OUTPUT.Signature
:ELIST.
:EPANEL.
:PANEL NAME=PGMEXP BOTSEP=NONE KEYL=LISTKEYS HELP=DSPPGMH ENTER='RETURN 0' TOPSEP=NONE.Display Program Information
:DATA DEPTH=1.
:DATACOL WIDTH=63.
:DATAC.
:DATACOL WIDTH=15.
:DATAC.&DSPPOS.
:EDATA.
:DATA DEPTH=6.
:DATACOL WIDTH=24.
:DATACOL WIDTH=41.
:DATAI VAR=PGM USAGE=OUTPUT.Program
:DATAI VAR=OWNER USAGE=OUTPUT.Owner
:DATAI VAR=PGMATTR USAGE=OUTPUT.Program attribute
:DATAI VAR=DETAIL USAGE=OUTPUT.Detail
:DATACOL WIDTH=24.
:DATACOL WIDTH=37.
:DATAI VAR=PGMLIB USAGE=OUTPUT.Library
:EDATA.
:DATA DEPTH=2.
:DATAC.&EXPHEAD.
:EDATA.
:LIST DEPTH='*' LISTDEF=EXPS VIEWS=2 SCROLL=YES.&EXPEMPTY.
:LISTCOL VAR=PROCNAME USAGE=OUTPUT.Procedure Name
:LISTCOL VAR=ARGOPT USAGE=OUTPUT.ARGOPT
:LISTCOL VAR=DATANAME USAGE=OUTPUT.Data Item
:LISTCOL VAR=DATASIZE USAGE=OUTPUT.Size
:LISTVIEW COLS='PROCNAME ARGOPT'.
:LISTVIEW COLS='DATANAME DATASIZE'.
:ELIST.
:EPANEL.

:VAR NAME=TSMOD CLASS=VALCL.
:VAR NAME=STGMDL CLASS=VALCL.
:VAR NAME=PGMSTATE CLASS=VALCL.
:VAR NAME=PGMDOMAIN CLASS=VALCL.
:VAR NAME=TGTRLS CLASS=VALCL.

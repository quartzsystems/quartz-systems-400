:EPANEL.
:PANEL NAME=PGMMOD BOTSEP=NONE KEYL=LISTKEYS HELP=DSPPGMH ENTER='RETURN 0' TOPSEP=NONE.Display Program Information
:DATA DEPTH=1.
:DATACOL WIDTH=63.
:DATAC.
:DATACOL WIDTH=15.
:DATAC.&DSPPOS.
:EDATA.
:DATA DEPTH=6.
:DATACOL WIDTH=24.
:DATACOL WIDTH=41.
:DATAI VAR=PGM USAGE=OUTPUT HELP='FLD/PGM'.Program
:DATAI VAR=OWNER USAGE=OUTPUT HELP='FLD/OWNER'.Owner
:DATAI VAR=PGMATTR USAGE=OUTPUT HELP='FLD/PGMATTR'.Program attribute
:DATAI VAR=DETAIL USAGE=OUTPUT HELP='FLD/DETAIL'.Detail
:DATACOL WIDTH=24.
:DATACOL WIDTH=37.
:DATAI VAR=PGMLIB USAGE=OUTPUT HELP='FLD/PGMLIB'.Library
:EDATA.
:TOPINST.Type options, press Enter.
:LIST DEPTH='*' LISTDEF=MODS SCROLL=YES.
:LISTACT OPTION=5 ENTER='RETURN 5' HELP='PGMMOD/OPTIONS'.5=Display description
:LISTACT OPTION=6 ENTER='RETURN 6' HELP='PGMMOD/OPTIONS'.6=Print description
:LISTCOL VAR=OPT USAGE=INPUT HELP='PGMMOD/OPT'.Opt
:LISTCOL VAR=MODNAME USAGE=OUTPUT HELP='FLD/MODNAME'.Module
:LISTCOL VAR=MODLIB USAGE=OUTPUT HELP='FLD/MODLIB'.Library
:LISTCOL VAR=MODATTR USAGE=OUTPUT HELP='FLD/MODATTR'.Attribute
:LISTCOL VAR=MODDATE USAGE=OUTPUT HELP='FLD/MODDATE'.Creation Date
:LISTCOL VAR=MODOPT USAGE=OUTPUT HELP='FLD/MODOPT'.Optimization Level
:LISTCOL VAR=MODDBG USAGE=OUTPUT HELP='FLD/MODDBG'.Debug Data
:ELIST.
:EPANEL.
:PANEL NAME=PGMSRV BOTSEP=NONE KEYL=SRVKEYS HELP=DSPPGMH ENTER='RETURN 0' TOPSEP=NONE.Display Program Information
:DATA DEPTH=1.
:DATACOL WIDTH=63.
:DATAC.
:DATACOL WIDTH=15.
:DATAC.&DSPPOS.
:EDATA.
:DATA DEPTH=6.
:DATACOL WIDTH=24.
:DATACOL WIDTH=41.
:DATAI VAR=PGM USAGE=OUTPUT HELP='FLD/PGM'.Program
:DATAI VAR=OWNER USAGE=OUTPUT HELP='FLD/OWNER'.Owner
:DATAI VAR=PGMATTR USAGE=OUTPUT HELP='FLD/PGMATTR'.Program attribute
:DATAI VAR=DETAIL USAGE=OUTPUT HELP='FLD/DETAIL'.Detail
:DATACOL WIDTH=24.
:DATACOL WIDTH=37.
:DATAI VAR=PGMLIB USAGE=OUTPUT HELP='FLD/PGMLIB'.Library
:EDATA.
:TOPINST.Type options, press Enter.
:LIST DEPTH='*' LISTDEF=SRVS SCROLL=YES.
:LISTACT OPTION=5 ENTER='RETURN 5' HELP='PGMSRV/OPTIONS'.5=Display
:LISTCOL VAR=OPT USAGE=INPUT HELP='PGMSRV/OPT'.Opt
:LISTCOL VAR=SRVNAME USAGE=OUTPUT HELP='FLD/SRVNAME'.Service Program
:LISTCOL VAR=SRVLIB USAGE=OUTPUT HELP='FLD/SRVLIB'.Library
:LISTCOL VAR=SRVACT USAGE=OUTPUT HELP='FLD/SRVACT'.Activation
:LISTCOL VAR=SRVSIG USAGE=OUTPUT HELP='FLD/SRVSIG'.Signature
:ELIST.
:EPANEL.
:PANEL NAME=PGMEXP BOTSEP=NONE KEYL=LISTKEYS HELP=DSPPGMH ENTER='RETURN 0' TOPSEP=NONE.Display Program Information
:DATA DEPTH=1.
:DATACOL WIDTH=63.
:DATAC.
:DATACOL WIDTH=15.
:DATAC.&DSPPOS.
:EDATA.
:DATA DEPTH=6.
:DATACOL WIDTH=24.
:DATACOL WIDTH=41.
:DATAI VAR=PGM USAGE=OUTPUT HELP='FLD/PGM'.Program
:DATAI VAR=OWNER USAGE=OUTPUT HELP='FLD/OWNER'.Owner
:DATAI VAR=PGMATTR USAGE=OUTPUT HELP='FLD/PGMATTR'.Program attribute
:DATAI VAR=DETAIL USAGE=OUTPUT HELP='FLD/DETAIL'.Detail
:DATACOL WIDTH=24.
:DATACOL WIDTH=37.
:DATAI VAR=PGMLIB USAGE=OUTPUT HELP='FLD/PGMLIB'.Library
:EDATA.
:DATA DEPTH=2.
:DATAC.&EXPHEAD.
:EDATA.
:LIST DEPTH='*' LISTDEF=EXPS VIEWS=2 SCROLL=YES.&EXPEMPTY.
:LISTCOL VAR=PROCNAME USAGE=OUTPUT HELP='FLD/PROCNAME'.Procedure Name
:LISTCOL VAR=ARGOPT USAGE=OUTPUT HELP='FLD/ARGOPT'.ARGOPT
:LISTCOL VAR=DATANAME USAGE=OUTPUT HELP='FLD/DATANAME'.Data Item
:LISTCOL VAR=DATASIZE USAGE=OUTPUT HELP='FLD/DATASIZE'.Size
:LISTVIEW COLS='PROCNAME ARGOPT'.
:LISTVIEW COLS='DATANAME DATASIZE'.
:ELIST.
:EPANEL.

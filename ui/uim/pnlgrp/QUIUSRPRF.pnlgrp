:VAR NAME=WUPCLS CLASS=CLSCL.
:VAR NAME=WUPTEXT CLASS=TEXTCL.
:LISTDEF NAME=USERS VARS='OPT WUPNAME WUPCLS WUPTEXT'.
:KEYL NAME=DSPKEYS.
:KEYI KEY=ENTER ACTION=ENTER.
:KEYI KEY=HELP ACTION=HELP.
:KEYI KEY=F1 ACTION=HELP.
:KEYI KEY=F3 ACTION=EXIT.F3=Exit
:KEYI KEY=F12 ACTION=CANCEL.F12=Cancel
:KEYI KEY=PAGEUP ACTION=PAGEUP.
:KEYI KEY=PAGEDOWN ACTION=PAGEDOWN.
:EKEYL.
:KEYL NAME=WRKKEYS.
:KEYI KEY=ENTER ACTION=ENTER.
:KEYI KEY=HELP ACTION=HELP.
:KEYI KEY=F1 ACTION=HELP.
:KEYI KEY=F3 ACTION=EXIT.F3=Exit
:KEYI KEY=F5 ACTION='RETURN 5'.F5=Refresh
:KEYI KEY=F6 ACTION='CMD ?CRTUSRPRF'.F6=Create
:KEYI KEY=F12 ACTION=CANCEL.F12=Cancel
:KEYI KEY=PAGEUP ACTION=PAGEUP.
:KEYI KEY=PAGEDOWN ACTION=PAGEDOWN.
:EKEYL.
:PANEL NAME=DSPUSRPRF HELP=HLPDSP KEYL=DSPKEYS.Display User Profile - Basic
:DATA DEPTH=2.
:DATAI VAR=UPNAME USAGE=OUTPUT.User profile
:EDATA.
:DATA DEPTH='*' SCROLL=YES.
:DATAI VAR=UPPRVSGN USAGE=OUTPUT.Previous sign-on

:BOTINST.Press Enter to continue.
:DATA DEPTH='*'.
:DATACOL WIDTH=32.
:DATACOL WIDTH=78.
:DATAI VAR=ZONE USAGE=OUTPUT HELP='FLD/TIMZON'.Time zone
:DATAC.
:DATAI VAR=ZOFFSET USAGE=OUTPUT HELP='FLD/OFFSET'.Offset
:DATAC.
:DATAGRP GRPSEP=NONE.Standard Time
:DATAI VAR=STDFULL USAGE=OUTPUT HELP='FLD/FULL'.Full name
:DATAC.
:DATAI VAR=STDABBR USAGE=OUTPUT HELP='FLD/ABBR'.Abbreviated name
:DATAI VAR=STDMSG USAGE=OUTPUT HELP='FLD/MSG'.Message
:EDATAGRP.
:DATAC.
:DATAGRP GRPSEP=NONE.Daylight Saving Time (DST)
:DATAI VAR=DSTFULL USAGE=OUTPUT HELP='FLD/DFULL'.Full name
:DATAC.
:DATAI VAR=DSTABBR USAGE=OUTPUT HELP='FLD/DABBR'.Abbreviated name
:DATAI VAR=DSTMSG USAGE=OUTPUT HELP='FLD/MSG'.Message
:EDATAGRP.
:DATAC.
:DATAC.
:DATAI VAR=MSGF USAGE=OUTPUT HELP='FLD/MSGF'.Message file
:DATAGRP GRPSEP=NONE.
:DATAI VAR=MSGFLIB USAGE=OUTPUT HELP='FLD/MSGF'.Library
:EDATAGRP.
:DATAC.
:DATAGRP GRPSEP=NONE.Daylight Saving Time start
:DATAI VAR=SMONTH USAGE=OUTPUT HELP='FLD/EDGE'.Month
:DATAI VAR=SDAY USAGE=OUTPUT HELP='FLD/EDGE'.Day
:DATAI VAR=SREL USAGE=OUTPUT HELP='FLD/EDGE'.Relative day of month
:DATAI VAR=STIME USAGE=OUTPUT HELP='FLD/EDGE'.Time
:EDATAGRP.
:DATAC.
:DATAGRP GRPSEP=NONE.Daylight Saving Time end
:DATAI VAR=EMONTH USAGE=OUTPUT HELP='FLD/EDGE'.Month
:DATAI VAR=EDAY USAGE=OUTPUT HELP='FLD/EDGE'.Day
:DATAI VAR=EREL USAGE=OUTPUT HELP='FLD/EDGE'.Relative day of month
:DATAI VAR=ETIME USAGE=OUTPUT HELP='FLD/EDGE'.Time
:EDATAGRP.
:DATAC.
:DATAI VAR=SHIFT USAGE=OUTPUT HELP='FLD/SHIFT'.Daylight Saving Time shift
:DATAC.
:DATAI VAR=YEAROFS USAGE=OUTPUT HELP='FLD/YEAROFS'.Year offset
:DATAC.
:DATAI VAR=ALTNAME USAGE=OUTPUT HELP='FLD/ALT'.Alternate name
:DATAC.
:DATAC.
:DATAC.
:DATAI VAR=ZTEXT USAGE=OUTPUT HELP='FLD/TEXT'.Text

:VAR NAME=ALTNAME CLASS=ALTCL.
:VAR NAME=ZTEXT CLASS=LONGCL.
:LISTDEF NAME=ZONES VARS='OPT OFFSET MARK TIMZON ABBR FULL DABBR DFULL ALT TEXT'.

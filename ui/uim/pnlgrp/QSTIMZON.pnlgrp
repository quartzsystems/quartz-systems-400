:PANEL NAME=WRKTIMZON KEYL=STDKEYS HELP=WRKTIMZON ENTER='RETURN 1' TOPSEP=DATETIME BOTSEP=NONE.Work with Time Zone Descriptions
:TOPINST.Type options, press Enter.
:LIST DEPTH='*' LISTDEF=ZONES.(No time zone descriptions)
:LISTACT OPTION=2 ENTER='CMD ?CHGTIMZON TIMZON(&TIMZON.)' HELP='WRKTIMZON/OPTIONS'.2=Change
:LISTACT OPTION=4 ENTER='CMD DLTTIMZON TIMZON(&TIMZON.)' HELP='WRKTIMZON/OPTIONS'.4=Delete
:LISTACT OPTION=5 ENTER='RETURN 5' HELP='WRKTIMZON/OPTIONS'.5=Display details
:LISTACT OPTION=6 ENTER='RETURN 6' HELP='WRKTIMZON/OPTIONS'.6=Print
:LISTACT OPTION=8 ENTER='CMD CHGSYSVAL SYSVAL(QTIMZON) VALUE(&TIMZON.)' HELP='WRKTIMZON/OPTIONS'.8=Update system value
:LISTCOL VAR=OPT USAGE=INPUT HELP='WRKTIMZON/OPT'.Opt
:LISTCOL VAR=OFFSET USAGE=OUTPUT HELP='FLD/OFFSET'.Offset
:LISTCOL VAR=MARK USAGE=OUTPUT HELP='FLD/MARK'.
:LISTGRP COL=TZGRP.Time
:LISTCOL VAR=TIMZON USAGE=OUTPUT ATCOL=17 HELP='FLD/TIMZON'.Zone
:ELISTGRP.
:LISTGRP COL=STDGRP.------------------Standard Time-------------------
:LISTCOL VAR=ABBR USAGE=OUTPUT HELP='FLD/ABBR'.Abbr
:LISTCOL VAR=FULL USAGE=OUTPUT ATCOL=40 MAXWIDTH=39 HELP='FLD/FULL'.Full
:ELISTGRP.
:ELIST.
:CMDLINE SIZE=SHORT.Parameters or command
:EPANEL.

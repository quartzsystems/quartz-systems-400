.* QUILIND: WRKLIND and DSPLIND, the line descriptions (net/cmncfg).
.* DSPLIND's values carry their keyword in front ("RSRCNAME    CMN04")
.* until F11 takes it away.
:PNLGRP.
:COPYR.(C) COPYRIGHT QUARTZ SYSTEMS 2026.
:CLASS NAME=OPTCL BASETYPE=ACTION.
:ECLASS.
:CLASS NAME=NAMECL BASETYPE='CHAR 10'.
:ECLASS.
:CLASS NAME=HINTCL BASETYPE='CHAR 19'.
:ECLASS.
:CLASS NAME=TEXTCL BASETYPE='CHAR 50'.
:ECLASS.
:CLASS NAME=STSCL BASETYPE='CHAR 20'.
:ECLASS.
:CLASS NAME=VALCL BASETYPE='CHAR 40'.
:ECLASS.
:VAR NAME=POSTO CLASS=NAMECL.
:VAR NAME=POSHINT CLASS=HINTCL VALUE='Starting characters'.
:VAR NAME=OPT CLASS=OPTCL.
:VAR NAME=LIND CLASS=NAMECL.
:VAR NAME=LINTYPE CLASS=NAMECL.
:VAR NAME=LINTEXT CLASS=TEXTCL.
:VAR NAME=LINRSC CLASS=NAMECL.
:VAR NAME=LINSTS CLASS=STSCL.
:VAR NAME=DLIND CLASS=VALCL.
:VAR NAME=DOPTION CLASS=VALCL.
:VAR NAME=DCAT CLASS=VALCL.
:VAR NAME=DRSRC CLASS=VALCL.
:VAR NAME=DAGGPCY CLASS=VALCL.
:VAR NAME=DAGGRSCL CLASS=VALCL.
:VAR NAME=DBRIDGE CLASS=VALCL.
:VAR NAME=DONLINE CLASS=VALCL.
:VAR NAME=DVRYWAIT CLASS=VALCL.
:VAR NAME=DNETCTL CLASS=VALCL.
:VAR NAME=DADPTADR CLASS=VALCL.
:VAR NAME=DEXCHID CLASS=VALCL.
:VAR NAME=DETHSTD CLASS=VALCL.
:VAR NAME=DSPEED CLASS=VALCL.
:VAR NAME=DCURSPD CLASS=VALCL.
:VAR NAME=DDUPLEX CLASS=VALCL.
:VAR NAME=DCURDPX CLASS=VALCL.
:VAR NAME=DSRVOPT CLASS=VALCL.
:VAR NAME=DMAXFRM CLASS=VALCL.
:VAR NAME=DMAXCTL CLASS=VALCL.
:VAR NAME=DTHRESH CLASS=VALCL.
:VAR NAME=DGENTST CLASS=VALCL.
:VAR NAME=DMSGQ CLASS=VALCL.
:VAR NAME=DCURMSGQ CLASS=VALCL.
:VAR NAME=DCURMSGL CLASS=VALCL.
:VAR NAME=DTEXT CLASS=VALCL.
:LISTDEF NAME=LINES VARS='OPT LIND LINTYPE LINTEXT LINRSC LINSTS'.
:KEYL NAME=WRKKEYS HELP=KEYSHLP.
:KEYI KEY=ENTER ACTION=ENTER.
:KEYI KEY=HELP ACTION=HELP.
:KEYI KEY=F1 ACTION=HELP.
:KEYI KEY=F3 ACTION=EXIT.F3=Exit
:KEYI KEY=F4 ACTION='RETURN 4'.F4=Prompt
:KEYI KEY=F5 ACTION='RETURN 5'.F5=Refresh
:KEYI KEY=F6 ACTION='RETURN 6'.F6=Create
:KEYI KEY=F9 ACTION=RETRIEVE.F9=Retrieve
:KEYI KEY=F11 ACTION='RETURN 11'.F11=Display details
:KEYI KEY=F12 ACTION=CANCEL.F12=Cancel
:KEYI KEY=F14 ACTION='RETURN 14'.F14=Work with status
:KEYI KEY=PAGEUP ACTION=PAGEUP.
:KEYI KEY=PAGEDOWN ACTION=PAGEDOWN.
:EKEYL.
:KEYL NAME=DSPKEYS HELP=KEYSHLP.
:KEYI KEY=ENTER ACTION=ENTER.
:KEYI KEY=HELP ACTION=HELP.
:KEYI KEY=F1 ACTION=HELP.
:KEYI KEY=F3 ACTION=EXIT.F3=Exit
:KEYI KEY=F11 ACTION='RETURN 11'.F11=Nondisplay keywords
:KEYI KEY=F12 ACTION=CANCEL.F12=Cancel
:KEYI KEY=PAGEUP ACTION=PAGEUP.
:KEYI KEY=PAGEDOWN ACTION=PAGEDOWN.
:EKEYL.
:PANEL NAME=WRKLIND KEYL=WRKKEYS HELP=WRKLINDH ENTER='RETURN 0' TOPSEP=SYSNAM.Work with Line Descriptions
:DATA DEPTH=2.
:DATACOL WIDTH=22.
:DATACOL WIDTH=78.
:DATAI HELP='FLD/POSTO' VAR=POSTO USAGE=INPUT.Position to
:DATAIX VAR=POSHINT USAGE=OUTPUT.
:EDATA.
:TOPINST.Type options, press Enter.
:LIST DEPTH='*' LISTDEF=LINES VIEWS=2 MAXHEAD=2 SCROLL=YES.(No line descriptions)
:LISTACT HELP='WRKLIND/OPTIONS' OPTION=2 ENTER='CMD ?CHGLINETH LIND(&LIND.)'.2=Change
:LISTACT HELP='WRKLIND/OPTIONS' OPTION=3 ENTER='CMD ?CRTLINETH'.3=Copy
:LISTACT HELP='WRKLIND/OPTIONS' OPTION=4 ENTER='CMD DLTLIND LIND(&LIND.)'.4=Delete
:LISTACT HELP='WRKLIND/OPTIONS' OPTION=5 ENTER='CMD DSPLIND LIND(&LIND.)'.5=Display
:LISTACT HELP='WRKLIND/OPTIONS' OPTION=6 ENTER='CMD DSPLIND LIND(&LIND.) OUTPUT(*PRINT)'.6=Print
:LISTACT HELP='WRKLIND/OPTIONS' OPTION=7 ENTER='CMD ?RNMOBJ OBJ(QSYS/&LIND.) OBJTYPE(*LIND)'.7=Rename
:LISTACT HELP='WRKLIND/OPTIONS' OPTION=8 ENTER='CMD WRKCFGSTS CFGTYPE(*LIN) CFGD(&LIND.)'.8=Work with status
:LISTACT HELP='WRKLIND/OPTIONS' OPTION=9 ENTER='RETURN 109'.9=Retrieve source
:LISTCOL HELP='WRKLIND/OPT' VAR=OPT USAGE=INPUT.Opt
:LISTCOL HELP='FLD/LIND' VAR=LIND USAGE=OUTPUT.Line
:LISTCOL HELP='FLD/LINTYPE' VAR=LINTYPE USAGE=OUTPUT.Type
:LISTCOL HELP='FLD/LINTEXT' VAR=LINTEXT USAGE=OUTPUT.Text
:LISTCOL HELP='FLD/LINRSC' VAR=LINRSC USAGE=OUTPUT.Resource
:LISTCOL HELP='FLD/LINSTS' VAR=LINSTS USAGE=OUTPUT.Status
:LISTVIEW COLS='OPT LIND LINTYPE LINTEXT'.
:LISTVIEW COLS='OPT LIND LINTYPE LINRSC LINSTS'.
:ELIST.
:CMDLINE SIZE=SHORT.Parameters or command
:EPANEL.
:PANEL NAME=DSPLIND KEYL=DSPKEYS HELP=DSPLINDH ENTER='RETURN 0' TOPSEP=DATETIME.Display Line Description
:DATA DEPTH=4.
:DATACOL WIDTH=36.
:DATACOL WIDTH=78.
:DATAI HELP='FLD/DLIND' VAR=DLIND USAGE=OUTPUT.Line description
:DATAI HELP='FLD/DOPTION' VAR=DOPTION USAGE=OUTPUT.Option
:DATAI HELP='FLD/DCAT' VAR=DCAT USAGE=OUTPUT.Category of line
:EDATA.
:DATA DEPTH='*' SCROLL=YES.
:DATACOL WIDTH=36.
:DATACOL WIDTH=78.
:DATAI HELP='FLD/DRSRC' VAR=DRSRC USAGE=OUTPUT.Resource name
:DATAI HELP='FLD/DBRIDGE' VAR=DBRIDGE USAGE=OUTPUT.Bridge identifier
:DATAI HELP='FLD/DONLINE' VAR=DONLINE USAGE=OUTPUT.Online at IPL
:DATAI HELP='FLD/DVRYWAIT' VAR=DVRYWAIT USAGE=OUTPUT.Vary on wait
:DATAI HELP='FLD/DNETCTL' VAR=DNETCTL USAGE=OUTPUT.Network controller
:DATAI HELP='FLD/DADPTADR' VAR=DADPTADR USAGE=OUTPUT.Local adapter address
:DATAI HELP='FLD/DEXCHID' VAR=DEXCHID USAGE=OUTPUT.Exchange identifier
:DATAI HELP='FLD/DETHSTD' VAR=DETHSTD USAGE=OUTPUT.Ethernet standard
:DATAI HELP='FLD/DSPEED' VAR=DSPEED USAGE=OUTPUT.Line speed
:DATAI HELP='FLD/DCURSPD' VAR=DCURSPD USAGE=OUTPUT.Current line speed
:DATAI HELP='FLD/DDUPLEX' VAR=DDUPLEX USAGE=OUTPUT.Duplex
:DATAI HELP='FLD/DCURDPX' VAR=DCURDPX USAGE=OUTPUT.Current duplex
:DATAI HELP='FLD/DSRVOPT' VAR=DSRVOPT USAGE=OUTPUT.Serviceability options
:DATAI HELP='FLD/DMAXFRM' VAR=DMAXFRM USAGE=OUTPUT.Maximum frame size
:DATAI HELP='FLD/DMAXCTL' VAR=DMAXCTL USAGE=OUTPUT.Maximum controllers
:DATAI HELP='FLD/DTHRESH' VAR=DTHRESH USAGE=OUTPUT.Error threshold level
:DATAI HELP='FLD/DGENTST' VAR=DGENTST USAGE=OUTPUT.Generate test frame
:DATAI HELP='FLD/DMSGQ' VAR=DMSGQ USAGE=OUTPUT.Message queue
:DATAI HELP='FLD/DCURMSGQ' VAR=DCURMSGQ USAGE=OUTPUT.Current message queue
:DATAGRP GRPSEP=NONE.
:DATAI HELP='FLD/DCURMSGL' VAR=DCURMSGL USAGE=OUTPUT.Library
:EDATAGRP.
:DATAI HELP='FLD/DTEXT' VAR=DTEXT USAGE=OUTPUT.Text
:EDATA.
:BOTINST.Press Enter to continue.
:EPANEL.
.* DSPLIND of an aggregated line: its policy and ports after the resource.
:PANEL NAME=DSPLINDA KEYL=DSPKEYS HELP=DSPLINDH ENTER='RETURN 0' TOPSEP=DATETIME.Display Line Description
:DATA DEPTH=4.
:DATACOL WIDTH=36.
:DATACOL WIDTH=78.
:DATAI HELP='FLD/DLIND' VAR=DLIND USAGE=OUTPUT.Line description
:DATAI HELP='FLD/DOPTION' VAR=DOPTION USAGE=OUTPUT.Option
:DATAI HELP='FLD/DCAT' VAR=DCAT USAGE=OUTPUT.Category of line
:EDATA.
:DATA DEPTH='*' SCROLL=YES.
:DATACOL WIDTH=36.
:DATACOL WIDTH=78.
:DATAI HELP='FLD/DRSRC' VAR=DRSRC USAGE=OUTPUT.Resource name
:DATAI HELP='FLD/DAGGPCY' VAR=DAGGPCY USAGE=OUTPUT.Aggregate policy
:DATAI HELP='FLD/DAGGRSCL' VAR=DAGGRSCL USAGE=OUTPUT.Aggregated resource list
:DATAI HELP='FLD/DBRIDGE' VAR=DBRIDGE USAGE=OUTPUT.Bridge identifier
:DATAI HELP='FLD/DONLINE' VAR=DONLINE USAGE=OUTPUT.Online at IPL
:DATAI HELP='FLD/DVRYWAIT' VAR=DVRYWAIT USAGE=OUTPUT.Vary on wait
:DATAI HELP='FLD/DNETCTL' VAR=DNETCTL USAGE=OUTPUT.Network controller
:DATAI HELP='FLD/DADPTADR' VAR=DADPTADR USAGE=OUTPUT.Local adapter address
:DATAI HELP='FLD/DEXCHID' VAR=DEXCHID USAGE=OUTPUT.Exchange identifier
:DATAI HELP='FLD/DETHSTD' VAR=DETHSTD USAGE=OUTPUT.Ethernet standard
:DATAI HELP='FLD/DSPEED' VAR=DSPEED USAGE=OUTPUT.Line speed
:DATAI HELP='FLD/DCURSPD' VAR=DCURSPD USAGE=OUTPUT.Current line speed
:DATAI HELP='FLD/DDUPLEX' VAR=DDUPLEX USAGE=OUTPUT.Duplex
:DATAI HELP='FLD/DCURDPX' VAR=DCURDPX USAGE=OUTPUT.Current duplex
:DATAI HELP='FLD/DSRVOPT' VAR=DSRVOPT USAGE=OUTPUT.Serviceability options
:DATAI HELP='FLD/DMAXFRM' VAR=DMAXFRM USAGE=OUTPUT.Maximum frame size
:DATAI HELP='FLD/DMAXCTL' VAR=DMAXCTL USAGE=OUTPUT.Maximum controllers
:DATAI HELP='FLD/DTHRESH' VAR=DTHRESH USAGE=OUTPUT.Error threshold level
:DATAI HELP='FLD/DGENTST' VAR=DGENTST USAGE=OUTPUT.Generate test frame
:DATAI HELP='FLD/DMSGQ' VAR=DMSGQ USAGE=OUTPUT.Message queue
:DATAI HELP='FLD/DCURMSGQ' VAR=DCURMSGQ USAGE=OUTPUT.Current message queue
:DATAGRP GRPSEP=NONE.
:DATAI HELP='FLD/DCURMSGL' VAR=DCURMSGL USAGE=OUTPUT.Library
:EDATAGRP.
:DATAI HELP='FLD/DTEXT' VAR=DTEXT USAGE=OUTPUT.Text
:EDATA.
:BOTINST.Press Enter to continue.
:EPANEL.
:HELP NAME=WRKLINDH.Work with Line Descriptions - Help
:P.The line descriptions in name order, with their type and text; F11
shows each line's resource and status instead. Type an option next to
a line to change, copy, delete, display, print or rename it, or to see
its status, and press Enter. Type a name in Position to and press
Enter to start the list there.
:EHELP.
:HELP NAME=DSPLINDH.Display Line Description - Help
:P.What a line description says, each value after the keyword that
sets it; F11 shows the values alone. The current speed and duplex are
the port's own when the line is varied on. CHGLINETH changes the line.
:EHELP.
:HELP NAME=KEYSHLP.Function keys - Help
:P.F5 shows the list again, F6 creates an Ethernet line, F14 shows the
status of every line, F9 brings back the last command, F3 and F12
leave.
:EHELP.
.* Item, key and option help.
:HELP NAME='FLD/POSTO'.Position to
:P.Type the position to.
:EHELP.
:HELP NAME='WRKLIND/OPT'.Option
:P.Type the number of an option next to an entry and press Enter. The
options the list allows are shown above it; F1 on one of them explains
it.
:EHELP.
:HELP NAME='FLD/LIND'.Line
:P.The line description.
:EHELP.
:HELP NAME='FLD/LINTYPE'.Type
:P.The type of each entry in the list.
:EHELP.
:HELP NAME='FLD/LINTEXT'.Text
:P.The text of each entry in the list.
:EHELP.
:HELP NAME='FLD/LINRSC'.Resource
:P.The resource of each entry in the list.
:EHELP.
:HELP NAME='FLD/LINSTS'.Status
:P.The status of each entry in the list.
:EHELP.
:HELP NAME='WRKLIND/OPTIONS'.Options
:P.Type an option number next to one or more entries and press Enter.
The option runs for each entry it is typed next to, in order.
:PARML.
:PT.2=Change
:PD.Type 2 next to an entry and press Enter to change it. The Change
Line Desc (Ethernet) (CHGLINETH) command is prompted for the entry.
:PT.3=Copy
:PD.Type 3 next to an entry and press Enter to copy it. The Create Line
Desc (Ethernet) (CRTLINETH) command is prompted for the entry.
:PT.4=Delete
:PD.Type 4 next to an entry and press Enter to delete it. The Delete
Line Description (DLTLIND) command runs for the entry.
:PT.5=Display
:PD.Type 5 next to an entry and press Enter to display it. The Display
Line Description (DSPLIND) command runs for the entry.
:PT.6=Print
:PD.Type 6 next to an entry and press Enter to print it. The Display
Line Description (DSPLIND) command runs for the entry.
:PT.7=Rename
:PD.Type 7 next to an entry and press Enter to rename it. The Rename
Object (RNMOBJ) command is prompted for the entry.
:PT.8=Work with status
:PD.Type 8 next to an entry and press Enter to work with status it. The
Work with Configuration Status (WRKCFGSTS) command runs for the entry.
:PT.9=Retrieve source
:PD.Type 9 next to an entry and press Enter to retrieve source it.
:EPARML.
:EHELP.
:HELP NAME='FLD/DLIND'.Line description
:P.The line description.
:EHELP.
:HELP NAME='FLD/DOPTION'.Option
:P.The option shown for what the display is about.
:EHELP.
:HELP NAME='FLD/DCAT'.Category of line
:P.The category of line shown for what the display is about.
:EHELP.
:HELP NAME='FLD/DRSRC'.Resource name
:P.The hardware resource name, as WRKHDWRSC shows it.
:EHELP.
:HELP NAME='FLD/DBRIDGE'.Bridge identifier
:P.The bridge identifier shown for what the display is about.
:EHELP.
:HELP NAME='FLD/DONLINE'.Online at IPL
:P.Whether the device or line is varied on when the system starts (IPL).
:EHELP.
:HELP NAME='FLD/DVRYWAIT'.Vary on wait
:P.The vary on wait shown for what the display is about.
:EHELP.
:HELP NAME='FLD/DNETCTL'.Network controller
:P.The network controller shown for what the display is about.
:EHELP.
:HELP NAME='FLD/DADPTADR'.Local adapter address
:P.The local adapter address shown for what the display is about.
:EHELP.
:HELP NAME='FLD/DEXCHID'.Exchange identifier
:P.The exchange identifier shown for what the display is about.
:EHELP.
:HELP NAME='FLD/DETHSTD'.Ethernet standard
:P.The ethernet standard shown for what the display is about.
:EHELP.
:HELP NAME='FLD/DSPEED'.Line speed
:P.The line speed shown for what the display is about.
:EHELP.
:HELP NAME='FLD/DCURSPD'.Current line speed
:P.The current line speed shown for what the display is about.
:EHELP.
:HELP NAME='FLD/DDUPLEX'.Duplex
:P.Whether the output prints on both sides of the paper.
:EHELP.
:HELP NAME='FLD/DCURDPX'.Current duplex
:P.The current duplex shown for what the display is about.
:EHELP.
:HELP NAME='FLD/DSRVOPT'.Serviceability options
:P.The serviceability options shown for what the display is about.
:EHELP.
:HELP NAME='FLD/DMAXFRM'.Maximum frame size
:P.The maximum frame size shown for what the display is about.
:EHELP.
:HELP NAME='FLD/DMAXCTL'.Maximum controllers
:P.The maximum controllers shown for what the display is about.
:EHELP.
:HELP NAME='FLD/DTHRESH'.Error threshold level
:P.The error threshold level shown for what the display is about.
:EHELP.
:HELP NAME='FLD/DGENTST'.Generate test frame
:P.The generate test frame shown for what the display is about.
:EHELP.
:HELP NAME='FLD/DMSGQ'.Message queue
:P.The message queue shown for what the display is about.
:EHELP.
:HELP NAME='FLD/DCURMSGQ'.Current message queue
:P.The current message queue shown for what the display is about.
:EHELP.
:HELP NAME='FLD/DCURMSGL'.Library
:P.The library shown for what the display is about.
:EHELP.
:HELP NAME='FLD/DTEXT'.Text
:P.The text shown for what the display is about.
:EHELP.
:HELP NAME='FLD/DAGGPCY'.Aggregate policy
:P.The aggregate policy shown for what the display is about.
:EHELP.
:HELP NAME='FLD/DAGGRSCL'.Aggregated resource list
:P.The aggregated resource list shown for what the display is about.
:EHELP.
:EPNLGRP.

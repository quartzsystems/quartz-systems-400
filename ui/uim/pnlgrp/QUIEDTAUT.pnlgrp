.* QUIEDTAUT: the authority editors. EDTOBJAUT edits an object's
.* private and public authorities, EDTAUTL an authorization list's;
.* ADDUSERS and ADDAUTLE take new users. AUTVIEW picks the columns
.* (OBJ the authority names, DTL the object authorities one by one,
.* DTA the data authorities); OBJHEAD and DTAHEAD are the groups'
.* headings, dashed to their width.
:PNLGRP.
:COPYR.(C) COPYRIGHT QUARTZ SYSTEMS 2026.
:CLASS NAME=NAMECL BASETYPE='CHAR 10'.
:ECLASS.
:CLASS NAME=AUTCL BASETYPE='CHAR 8'.
:ECLASS.
:CLASS NAME=BITCL BASETYPE='CHAR 1'.
:ECLASS.
:CLASS NAME=VIEWCL BASETYPE='CHAR 3'.
:ECLASS.
:CLASS NAME=HEADCL BASETYPE='CHAR 40'.
:ECLASS.
:VAR NAME=AUTVIEW CLASS=VIEWCL VALUE='OBJ'.
:VAR NAME=OBJ CLASS=NAMECL.
:VAR NAME=OBJLIB CLASS=NAMECL.
:VAR NAME=OBJTYPE CLASS=NAMECL.
:VAR NAME=OWNER CLASS=NAMECL.
:VAR NAME=PGP CLASS=NAMECL VALUE='*NONE'.
:VAR NAME=ASPDEV CLASS=NAMECL VALUE='*SYSBAS'.
:VAR NAME=AUTL CLASS=NAMECL VALUE='*NONE'.
:VAR NAME=OBJHEAD CLASS=HEADCL.
:VAR NAME=DTAHEAD CLASS=HEADCL.
:VAR NAME=USER CLASS=NAMECL.
:VAR NAME=GROUP CLASS=NAMECL.
:VAR NAME=AUT CLASS=AUTCL.
:VAR NAME=OPR CLASS=BITCL.
:VAR NAME=MGT CLASS=BITCL.
:VAR NAME=EXIST CLASS=BITCL.
:VAR NAME=ALTER CLASS=BITCL.
:VAR NAME=REF CLASS=BITCL.
:VAR NAME=READ CLASS=BITCL.
:VAR NAME=ADD CLASS=BITCL.
:VAR NAME=UPD CLASS=BITCL.
:VAR NAME=DLT CLASS=BITCL.
:VAR NAME=EXE CLASS=BITCL.
:VAR NAME=LSTMGT CLASS=BITCL.
:COND NAME=OBJVIEW EXPR='&AUTVIEW. EQ "OBJ"'.
:COND NAME=DTLVIEW EXPR='&AUTVIEW. EQ "DTL"'.
:COND NAME=DTAVIEW EXPR='&AUTVIEW. EQ "DTA"'.
:LISTDEF NAME=AUTS VARS='USER GROUP AUT OPR MGT EXIST ALTER REF READ ADD UPD DLT EXE LSTMGT'.
:KEYL NAME=EDTKEYS HELP=KEYSHLP.
:KEYI KEY=ENTER ACTION=ENTER.
:KEYI KEY=HELP ACTION=HELP.
:KEYI KEY=F1 ACTION=HELP.
:KEYI KEY=F3 ACTION=EXIT.F3=Exit
:KEYI KEY=F5 ACTION='RETURN 5'.F5=Refresh
:KEYI KEY=F6 ACTION='RETURN 6'.F6=Add new users
:KEYI KEY=F10 ACTION='RETURN 10'.F10=Grant with reference object
:KEYI KEY=F11 ACTION='RETURN 11' COND=OBJVIEW.F11=Display detail object authorities
:KEYI KEY=F11 ACTION='RETURN 11' COND=DTLVIEW.F11=Display data authorities
:KEYI KEY=F11 ACTION='RETURN 11' COND=DTAVIEW.F11=Display object authorities
:KEYI KEY=F12 ACTION=CANCEL.F12=Cancel
:KEYI KEY=F17 ACTION=TOP.F17=Top
:KEYI KEY=F18 ACTION=BOTTOM.F18=Bottom
:KEYI KEY=PAGEUP ACTION=PAGEUP.
:KEYI KEY=PAGEDOWN ACTION=PAGEDOWN.
:EKEYL.
:KEYL NAME=ADDKEYS HELP=KEYSHLP.
:KEYI KEY=ENTER ACTION=ENTER.
:KEYI KEY=HELP ACTION=HELP.
:KEYI KEY=F1 ACTION=HELP.
:KEYI KEY=F3 ACTION=EXIT.F3=Exit
:KEYI KEY=F11 ACTION='RETURN 11' COND=DTLVIEW.F11=Display data authorities
:KEYI KEY=F11 ACTION='RETURN 11' COND=DTAVIEW.F11=Display object authorities
:KEYI KEY=F12 ACTION=CANCEL.F12=Cancel
:KEYI KEY=F17 ACTION=TOP.F17=Top
:KEYI KEY=F18 ACTION=BOTTOM.F18=Bottom
:KEYI KEY=PAGEUP ACTION=PAGEUP.
:KEYI KEY=PAGEDOWN ACTION=PAGEDOWN.
:EKEYL.
:KEYL NAME=AUTLKEYS HELP=KEYSHLP.
:KEYI KEY=ENTER ACTION=ENTER.
:KEYI KEY=HELP ACTION=HELP.
:KEYI KEY=F1 ACTION=HELP.
:KEYI KEY=F3 ACTION=EXIT.F3=Exit
:KEYI KEY=F5 ACTION='RETURN 5'.F5=Refresh
:KEYI KEY=F6 ACTION='RETURN 6'.F6=Add new users
:KEYI KEY=F11 ACTION='RETURN 11' COND=OBJVIEW.F11=Display detail object authorities
:KEYI KEY=F11 ACTION='RETURN 11' COND=DTLVIEW.F11=Display data authorities
:KEYI KEY=F11 ACTION='RETURN 11' COND=DTAVIEW.F11=Display object authorities
:KEYI KEY=F12 ACTION=CANCEL.F12=Cancel
:KEYI KEY=F24 ACTION=MOREKEYS.F24=More keys
:KEYI KEY=F17 ACTION=TOP.F17=Top
:KEYI KEY=F18 ACTION=BOTTOM.F18=Bottom
:KEYI KEY=PAGEUP ACTION=PAGEUP.
:KEYI KEY=PAGEDOWN ACTION=PAGEDOWN.
:EKEYL.
:PANEL NAME=EDTOBJAUT KEYL=EDTKEYS HELP=EDTOAUTH ENTER='RETURN 0' TOPSEP=SPACE BOTSEP=NONE.Edit Object Authority
:DATA DEPTH=4.
:DATACOL WIDTH=22.
:DATACOL WIDTH=41.
:DATAI VAR=OBJ USAGE=OUTPUT HELP='FLD/OBJ'.Object
:DATAGRP GRPSEP=NONE.
:DATAI VAR=OBJLIB USAGE=OUTPUT HELP='FLD/OBJLIB'.Library
:EDATAGRP.
:DATAI VAR=OBJTYPE USAGE=OUTPUT HELP='FLD/OBJTYPE'.Object type
:DATACOL WIDTH=22.
:DATACOL WIDTH=37.
:DATAI VAR=OWNER USAGE=OUTPUT HELP='FLD/OWNER'.Owner
:DATAI VAR=PGP USAGE=OUTPUT HELP='FLD/PGP'.Primary group
:DATAI VAR=ASPDEV USAGE=OUTPUT HELP='FLD/ASPDEV'.ASP device
:EDATA.
:TOPINST.Type changes to current authorities, press Enter.
:DATA DEPTH=3.
:DATACOL WIDTH=2.
:DATAC.
:DATACOL WIDTH=61.
:DATACOL WIDTH=76.
:DATAC.
:DATAI VAR=AUTL USAGE=INOUT HELP='FLD/AUTL'.Object secured by authorization list
:EDATA.
:LIST DEPTH='*' LISTDEF=AUTS VIEWS=3 SCROLL=YES.
:LISTCOL VAR=USER USAGE=OUTPUT HELP='FLD/USER'.User
:LISTCOL VAR=GROUP USAGE=OUTPUT HELP='FLD/GROUP'.Group
:LISTCOL VAR=AUT USAGE=INOUT HELP='FLD/AUT'.Object Authority
:LISTGRP COL=OBJAUTS.&OBJHEAD.
:LISTCOL VAR=OPR USAGE=INOUT HELP='FLD/OPR'.Opr
:LISTCOL VAR=MGT USAGE=INOUT HELP='FLD/MGT'.Mgt
:LISTCOL VAR=EXIST USAGE=INOUT HELP='FLD/EXIST'.Exist
:LISTCOL VAR=ALTER USAGE=INOUT HELP='FLD/ALTER'.Alter
:LISTCOL VAR=REF USAGE=INOUT HELP='FLD/REF'.Ref
:ELISTGRP.
:LISTGRP COL=DTAAUTS.&DTAHEAD.
:LISTCOL VAR=READ USAGE=INOUT HELP='FLD/READ'.Read
:LISTCOL VAR=ADD USAGE=INOUT HELP='FLD/ADD'.Add
:LISTCOL VAR=UPD USAGE=INOUT HELP='FLD/UPD'.Update
:LISTCOL VAR=DLT USAGE=INOUT HELP='FLD/DLT'.Delete
:LISTCOL VAR=EXE USAGE=INOUT HELP='FLD/EXE'.Execute
:ELISTGRP.
:LISTVIEW COLS='USER GROUP AUT'.
:LISTVIEW COLS='USER GROUP AUT OBJAUTS'.
:LISTVIEW COLS='USER GROUP AUT DTAAUTS'.
:ELIST.
:EPANEL.
:PANEL NAME=ADDUSERS KEYL=ADDKEYS HELP=ADDUSRH ENTER='RETURN 0' TOPSEP=SPACE BOTSEP=NONE.Add New Users
:DATA DEPTH=4.
:DATACOL WIDTH=22.
:DATACOL WIDTH=41.
:DATAI VAR=OBJ USAGE=OUTPUT HELP='FLD/OBJ'.Object
:DATAGRP GRPSEP=NONE.
:DATAI VAR=OBJLIB USAGE=OUTPUT HELP='FLD/OBJLIB'.Library
:EDATAGRP.
:DATAI VAR=OBJTYPE USAGE=OUTPUT HELP='FLD/OBJTYPE'.Object type
:DATACOL WIDTH=22.
:DATACOL WIDTH=37.
:DATAI VAR=OWNER USAGE=OUTPUT HELP='FLD/OWNER'.Owner
:DATAI VAR=PGP USAGE=OUTPUT HELP='FLD/PGP'.Primary group
:DATAI VAR=ASPDEV USAGE=OUTPUT HELP='FLD/ASPDEV'.ASP device
:EDATA.
:TOPINST.Type new users, press Enter.
:DATA DEPTH=1.
:DATAC.
:EDATA.
:LIST DEPTH='*' LISTDEF=AUTS VIEWS=2 SCROLL=YES.
:LISTCOL VAR=USER USAGE=INOUT HELP='FLD/USER'.User
:LISTCOL VAR=AUT USAGE=INOUT HELP='FLD/AUT'.Object Authority
:LISTGRP COL=OBJAUTS.&OBJHEAD.
:LISTCOL VAR=OPR USAGE=INOUT HELP='FLD/OPR'.Opr
:LISTCOL VAR=MGT USAGE=INOUT HELP='FLD/MGT'.Mgt
:LISTCOL VAR=EXIST USAGE=INOUT HELP='FLD/EXIST'.Exist
:LISTCOL VAR=ALTER USAGE=INOUT HELP='FLD/ALTER'.Alter
:LISTCOL VAR=REF USAGE=INOUT HELP='FLD/REF'.Ref
:ELISTGRP.
:LISTGRP COL=DTAAUTS.&DTAHEAD.
:LISTCOL VAR=READ USAGE=INOUT HELP='FLD/READ'.Read
:LISTCOL VAR=ADD USAGE=INOUT HELP='FLD/ADD'.Add
:LISTCOL VAR=UPD USAGE=INOUT HELP='FLD/UPD'.Update
:LISTCOL VAR=DLT USAGE=INOUT HELP='FLD/DLT'.Delete
:LISTCOL VAR=EXE USAGE=INOUT HELP='FLD/EXE'.Execute
:ELISTGRP.
:LISTVIEW COLS='USER AUT OBJAUTS'.
:LISTVIEW COLS='USER AUT DTAAUTS'.
:ELIST.
:EPANEL.
:PANEL NAME=EDTAUTL KEYL=AUTLKEYS HELP=EDTAUTLH ENTER='RETURN 0' TOPSEP=SPACE BOTSEP=NONE.Edit Authorization List
:DATA DEPTH=3.
:DATACOL WIDTH=22.
:DATACOL WIDTH=41.
:DATAI VAR=OBJ USAGE=OUTPUT HELP='FLD/OBJ'.Object
:DATAGRP GRPSEP=NONE.
:DATAI VAR=OBJLIB USAGE=OUTPUT HELP='FLD/OBJLIB'.Library
:EDATAGRP.
:DATACOL WIDTH=22.
:DATACOL WIDTH=37.
:DATAI VAR=OWNER USAGE=OUTPUT HELP='FLD/OWNER'.Owner
:DATAI VAR=PGP USAGE=OUTPUT HELP='FLD/PGP'.Primary group
:EDATA.
:TOPINST.Type changes to current authorities, press Enter.
:DATA DEPTH=1.
:DATAC.
:EDATA.
:LIST DEPTH='*' LISTDEF=AUTS VIEWS=3 SCROLL=YES.
:LISTCOL VAR=USER USAGE=OUTPUT HELP='FLD/USER'.User
:LISTCOL VAR=AUT USAGE=INOUT HELP='FLD/AUT'.Object Authority
:LISTCOL VAR=LSTMGT USAGE=INOUT HELP='FLD/LSTMGT'.List Mgt
:LISTGRP COL=OBJAUTS.&OBJHEAD.
:LISTCOL VAR=OPR USAGE=INOUT HELP='FLD/OPR'.Opr
:LISTCOL VAR=MGT USAGE=INOUT HELP='FLD/MGT'.Mgt
:LISTCOL VAR=EXIST USAGE=INOUT HELP='FLD/EXIST'.Exist
:LISTCOL VAR=ALTER USAGE=INOUT HELP='FLD/ALTER'.Alter
:LISTCOL VAR=REF USAGE=INOUT HELP='FLD/REF'.Ref
:ELISTGRP.
:LISTGRP COL=DTAAUTS.&DTAHEAD.
:LISTCOL VAR=READ USAGE=INOUT HELP='FLD/READ'.Read
:LISTCOL VAR=ADD USAGE=INOUT HELP='FLD/ADD'.Add
:LISTCOL VAR=UPD USAGE=INOUT HELP='FLD/UPD'.Update
:LISTCOL VAR=DLT USAGE=INOUT HELP='FLD/DLT'.Delete
:LISTCOL VAR=EXE USAGE=INOUT HELP='FLD/EXE'.Execute
:ELISTGRP.
:LISTVIEW COLS='USER AUT LSTMGT'.
:LISTVIEW COLS='USER AUT LSTMGT OBJAUTS'.
:LISTVIEW COLS='USER AUT LSTMGT DTAAUTS'.
:ELIST.
:EPANEL.
:HELP NAME=EDTOAUTH.Edit Object Authority - Help
:P.Who may use the object and how. Type a new authority over a user's
(*ALL, *CHANGE, *USE, *EXCLUDE, *AUTL or blank to take the private
authority away), or with F11 type or blank the X under single
authorities; press Enter to grant and revoke. Type an authorization
list name to secure the object with it. F6 adds users.
:EHELP.
:HELP NAME=ADDUSRH.Add New Users - Help
:P.Type a user profile and the authority to give it, or the single
authorities with F11, then press Enter. Every user typed is granted
the authority; the editor then shows the new list.
:EHELP.
:HELP NAME=EDTAUTLH.Edit Authorization List - Help
:P.The users on the authorization list and their authority to the
objects it secures. Type a new authority over a user's, an X under
List Mgt to let the user manage the list, or blank the authority to
take the user off the list; F6 adds users.
:EHELP.
:HELP NAME=KEYSHLP.Function keys - Help
:P.F5 shows the authorities as they are now; F6 adds users; F10
grants the authorities of another object; F11 switches between the
authority names, the object authorities and the data authorities; F3
and F12 leave without changing anything typed since the last Enter.
:EHELP.
.* Item, key and option help.
:HELP NAME='FLD/OBJ'.Object
:P.The object shown for what the display is about.
:EHELP.
:HELP NAME='FLD/OBJLIB'.Library
:P.The library shown for what the display is about.
:EHELP.
:HELP NAME='FLD/OBJTYPE'.Object type
:P.The object type shown for what the display is about.
:EHELP.
:HELP NAME='FLD/OWNER'.Owner
:P.The owner of the objects created.
:EHELP.
:HELP NAME='FLD/PGP'.Primary group
:P.The primary group shown for what the display is about.
:EHELP.
:HELP NAME='FLD/ASPDEV'.ASP device
:P.The ASP device shown for what the display is about.
:EHELP.
:HELP NAME='FLD/AUTL'.Object secured by authorization list
:P.Type the object secured by authorization list.
:EHELP.
:HELP NAME='FLD/USER'.User
:P.The user of each entry in the list.
:EHELP.
:HELP NAME='FLD/GROUP'.Group
:P.The group of each entry in the list.
:EHELP.
:HELP NAME='FLD/AUT'.Object Authority
:P.Type the object Authority for the entry on the line.
:EHELP.
:HELP NAME='FLD/OPR'.&amp.OBJHEAD opr
:P.Type the &amp.OBJHEAD opr for the entry on the line.
:EHELP.
:HELP NAME='FLD/MGT'.&amp.OBJHEAD mgt
:P.Type the &amp.OBJHEAD mgt for the entry on the line.
:EHELP.
:HELP NAME='FLD/EXIST'.&amp.OBJHEAD exist
:P.Type the &amp.OBJHEAD exist for the entry on the line.
:EHELP.
:HELP NAME='FLD/ALTER'.&amp.OBJHEAD alter
:P.Type the &amp.OBJHEAD alter for the entry on the line.
:EHELP.
:HELP NAME='FLD/REF'.&amp.OBJHEAD ref
:P.Type the &amp.OBJHEAD ref for the entry on the line.
:EHELP.
:HELP NAME='FLD/READ'.&amp.DTAHEAD read
:P.Type the &amp.DTAHEAD read for the entry on the line.
:EHELP.
:HELP NAME='FLD/ADD'.&amp.DTAHEAD add
:P.Type the &amp.DTAHEAD add for the entry on the line.
:EHELP.
:HELP NAME='FLD/UPD'.&amp.DTAHEAD update
:P.Type the &amp.DTAHEAD update for the entry on the line.
:EHELP.
:HELP NAME='FLD/DLT'.&amp.DTAHEAD delete
:P.Type the &amp.DTAHEAD delete for the entry on the line.
:EHELP.
:HELP NAME='FLD/EXE'.&amp.DTAHEAD execute
:P.Type the &amp.DTAHEAD execute for the entry on the line.
:EHELP.
:HELP NAME='FLD/LSTMGT'.List Mgt
:P.Type the list Mgt for the entry on the line.
:EHELP.
:EPNLGRP.

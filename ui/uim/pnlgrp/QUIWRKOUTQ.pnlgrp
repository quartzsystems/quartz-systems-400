.* WRKOUTQ: every output queue, or the spooled files on one.
:PNLGRP.
:CLASS NAME=OPTCL BASETYPE=ACTION.
:ECLASS.
:CLASS NAME=NAMECL BASETYPE='CHAR 10'.
:ECLASS.
:CLASS NAME=NBRCL BASETYPE='CHAR 6'.
:ECLASS.
:CLASS NAME=STSCL BASETYPE='CHAR 4'.
:ECLASS.
:CLASS NAME=CNTCL BASETYPE='ZONED 5 0'.
:ECLASS.
:CLASS NAME=TEXTCL BASETYPE='CHAR 30'.
:ECLASS.
:VAR NAME=OPT CLASS=OPTCL.
:VAR NAME=QUEUE CLASS=NAMECL.
:VAR NAME=LIB CLASS=NAMECL.
:VAR NAME=FILES CLASS=CNTCL.
:VAR NAME=WRITER CLASS=NAMECL.
:VAR NAME=STATUS CLASS=STSCL.
:VAR NAME=FILE CLASS=NAMECL.
:VAR NAME=USER CLASS=NAMECL.
:VAR NAME=USRDTA CLASS=NAMECL.
:VAR NAME=STS CLASS=STSCL.
:VAR NAME=PAGES CLASS=CNTCL.
:VAR NAME=COPIES CLASS=CNTCL.
:VAR NAME=JOB CLASS=NAMECL.
:VAR NAME=NUMBER CLASS=NBRCL.
:VAR NAME=SPLNBR CLASS=NBRCL.
:VAR NAME=QSTS CLASS=STSCL.
:LISTDEF NAME=QUEUES VARS='OPT QUEUE LIB FILES WRITER STATUS'.
:LISTDEF NAME=FILES VARS='OPT FILE USER USRDTA STS PAGES COPIES JOB NUMBER SPLNBR'.
:KEYL NAME=OQKEYS.
:KEYI KEY=ENTER ACTION=ENTER.
:KEYI KEY=HELP ACTION=HELP.
:KEYI KEY=PAGEUP ACTION=PAGEUP.
:KEYI KEY=PAGEDOWN ACTION=PAGEDOWN.
:KEYI KEY=F3 ACTION=EXIT.F3=Exit
:KEYI KEY=F4 ACTION='RETURN 4'.F4=Prompt
:KEYI KEY=F5 ACTION='RETURN 5'.F5=Refresh
:KEYI KEY=F9 ACTION=RETRIEVE.F9=Retrieve
:KEYI KEY=F12 ACTION=CANCEL.F12=Cancel
:KEYI KEY=F22 ACTION='CMD WRKWTR'.F22=Printers
:EKEYL.
:PANEL NAME=QUEUES KEYL=OQKEYS HELP=WRKOUTQ ENTER='RETURN 1' TOPSEP=SYSNAM.Work with All Output Queues
:TOPINST.Type options, press Enter.
:LIST DEPTH='*' LISTDEF=QUEUES.(No output queues)
:LISTACT OPTION=2 ENTER='CMD ?CHGOUTQ OUTQ(&LIB./&QUEUE.)'.2=Change
:LISTACT OPTION=3 ENTER='CMD HLDOUTQ OUTQ(&LIB./&QUEUE.)'.3=Hold
:LISTACT OPTION=4 ENTER='CMD ?DLTOUTQ OUTQ(&LIB./&QUEUE.)'.4=Delete
:LISTACT OPTION=5 ENTER='CMD WRKOUTQ OUTQ(&LIB./&QUEUE.)'.5=Work with
:LISTACT OPTION=6 ENTER='CMD RLSOUTQ OUTQ(&LIB./&QUEUE.)'.6=Release
:LISTACT OPTION=9 ENTER='CMD WRKWTR'.9=Work with Writers
:LISTACT OPTION=14 ENTER='CMD CLROUTQ OUTQ(&LIB./&QUEUE.)'.14=Clear
:LISTCOL VAR=OPT USAGE=INPUT.Opt
:LISTCOL VAR=QUEUE USAGE=OUTPUT.Queue
:LISTCOL VAR=LIB USAGE=OUTPUT.Library
:LISTCOL VAR=FILES USAGE=OUTPUT.Files
:LISTCOL VAR=WRITER USAGE=OUTPUT.Writer
:LISTCOL VAR=STATUS USAGE=OUTPUT.Status
:ELIST.
:CMDLINE SIZE=SHORT.
:EPANEL.
:PANEL NAME=FILES KEYL=OQKEYS HELP=WRKOUTQ ENTER='RETURN 1' TOPSEP=SYSNAM.Work with Output Queue
:DATA DEPTH=2 COMPACT.
:DATAI VAR=QUEUE USAGE=OUTPUT.Queue
:DATAIX VAR=LIB USAGE=OUTPUT.
:DATAIXT.Library
:DATAIX VAR=QSTS USAGE=OUTPUT.
:DATAIXT.Status
:EDATA.
:TOPINST.Type options, press Enter.
:LIST DEPTH='*' LISTDEF=FILES.(No spooled files)
:LISTACT OPTION=2 ENTER='CMD ?CHGSPLFA FILE(&FILE.) JOB(&NUMBER./&USER./&JOB.) SPLNBR(&SPLNBR.)'.2=Change
:LISTACT OPTION=3 ENTER='CMD HLDSPLF FILE(&FILE.) JOB(&NUMBER./&USER./&JOB.) SPLNBR(&SPLNBR.)'.3=Hold
:LISTACT OPTION=4 ENTER='CMD DLTSPLF FILE(&FILE.) JOB(&NUMBER./&USER./&JOB.) SPLNBR(&SPLNBR.)'.4=Delete
:LISTACT OPTION=5 ENTER='CMD DSPSPLF FILE(&FILE.) JOB(&NUMBER./&USER./&JOB.) SPLNBR(&SPLNBR.)'.5=Display
:LISTACT OPTION=6 ENTER='CMD RLSSPLF FILE(&FILE.) JOB(&NUMBER./&USER./&JOB.) SPLNBR(&SPLNBR.)'.6=Release
:LISTACT OPTION=8 ENTER='CMD WRKSPLFA FILE(&FILE.) JOB(&NUMBER./&USER./&JOB.) SPLNBR(&SPLNBR.)'.8=Attributes
:LISTCOL VAR=OPT USAGE=INPUT.Opt
:LISTCOL VAR=FILE USAGE=OUTPUT.File
:LISTCOL VAR=USER USAGE=OUTPUT.User
:LISTCOL VAR=USRDTA USAGE=OUTPUT.User Data
:LISTCOL VAR=STS USAGE=OUTPUT.Sts
:LISTCOL VAR=PAGES USAGE=OUTPUT.Pages
:LISTCOL VAR=COPIES USAGE=OUTPUT.Copies
:LISTCOL VAR=JOB USAGE=OUTPUT.Job
:LISTCOL VAR=NUMBER USAGE=OUTPUT.Number
:ELIST.
:CMDLINE SIZE=SHORT.
:EPANEL.
:HELP NAME=WRKOUTQ.Work with Output Queues - Help
:P.Output queues with the files waiting on them and the writer that
prints them; option 5 shows a queue's files.
:EHELP.
:EPNLGRP.

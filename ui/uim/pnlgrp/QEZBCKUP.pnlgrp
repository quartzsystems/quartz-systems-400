:PANEL NAME=DSPBCKSTS HELP=HLPSTS KEYL=STSKEYS ENTER='RETURN 0' TOPSEP=DATETIME.Display Backup Status
:DATA DEPTH=3.
:DATACOL WIDTH=45.
:DATAC.
:DATAC.
:DATAC.What Was Backed Up
:DATACOL WIDTH=15.
:DATAC.Last
:DATAC.Backup
:DATAC.Date
:DATACOL WIDTH=18.
:DATAC.
:DATAC.Tape
:DATAC.Set
:EDATA.
:DATA DEPTH='*' SCROLL=YES.
:DATACOL WIDTH=42.
:DATACOL WIDTH=78.
:DATAGRP GRPSEP=NONE.User libraries
:DATAI VAR=ULALLD USAGE=OUTPUT.All
:DATAIX VAR=ULALLT USAGE=OUTPUT.
:DATAI VAR=ULALLCD USAGE=OUTPUT.All (changes only)
:DATAIX VAR=ULALLCT USAGE=OUTPUT.
:DATAI VAR=ULLISTD USAGE=OUTPUT.From list
:DATAIX VAR=ULLISTT USAGE=OUTPUT.
:DATAI VAR=ULLISTCD USAGE=OUTPUT.From list (changes only)
:DATAIX VAR=ULLISTCT USAGE=OUTPUT.
:EDATAGRP.

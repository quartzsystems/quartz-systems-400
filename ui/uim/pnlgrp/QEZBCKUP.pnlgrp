:DATAIX VAR=SECDTAT USAGE=OUTPUT.
:DATAI VAR=CFGDTAD USAGE=OUTPUT.Configuration
:DATAIX VAR=CFGDTAT USAGE=OUTPUT.
:DATAI VAR=OVCALD USAGE=OUTPUT.OfficeVision calendars
:DATAIX VAR=OVCALT USAGE=OUTPUT.
:DATAI VAR=OVMAILD USAGE=OUTPUT.OfficeVision mail
:DATAIX VAR=OVMAILT USAGE=OUTPUT.

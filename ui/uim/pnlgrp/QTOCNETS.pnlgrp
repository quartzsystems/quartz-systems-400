:VAR NAME=DTYPE CLASS=VALCL.
:VAR NAME=DSRC CLASS=VALCL.
:VAR NAME=DDUP CLASS=VALCL.
:VAR NAME=DIFC CLASS=VALCL.
:VAR NAME=DRHOST CLASS=VALCL.
:VAR NAME=DRADR CLASS=VALCL.
:VAR NAME=DRPORT CLASS=VALCL.
:VAR NAME=DLHOST CLASS=VALCL.
:VAR NAME=DLADR CLASS=VALCL.
:VAR NAME=DLPORT CLASS=VALCL.
:VAR NAME=DUSER CLASS=VALCL.

:DATAI HELP='FLD/S6' VAR=S6 USAGE=OUTPUT.IPv6 stack status
:DATAI HELP='FLD/SLMT' VAR=SLMT USAGE=OUTPUT.Limited mode
:DATAI HELP='FLD/SACT' VAR=SACT USAGE=OUTPUT.How long active
:DATAI HELP='FLD/SSTR' VAR=SSTR USAGE=OUTPUT.When last started
:DATAI HELP='FLD/SEND' VAR=SEND USAGE=OUTPUT.When last ended
:DATAI HELP='FLD/SWSJ' VAR=SWSJ USAGE=OUTPUT.Who last started - job name
:DATAI HELP='FLD/SWSU' VAR=SWSU USAGE=OUTPUT.Who last started - job user
:DATAI HELP='FLD/SWSN' VAR=SWSN USAGE=OUTPUT.Who last started - job number

:VAR NAME=DUSNDNXT CLASS=VALCL.
:VAR NAME=DSNDNXT CLASS=VALCL.
:VAR NAME=DSNDUNA CLASS=VALCL.
:VAR NAME=DOPUSH CLASS=VALCL.
:VAR NAME=DOURG CLASS=VALCL.
:VAR NAME=DOWIN CLASS=VALCL.
:VAR NAME=DBIN CLASS=VALCL.
:VAR NAME=DIBUF CLASS=VALCL.
:VAR NAME=DRCVNXT CLASS=VALCL.
:VAR NAME=DURCVNXT CLASS=VALCL.

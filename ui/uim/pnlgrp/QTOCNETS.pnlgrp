:LISTCOL HELP='FLD/RMASK' VAR=RMASK USAGE=OUTPUT.Subnet          Mask
:LISTCOL HELP='FLD/RHOP' VAR=RHOP USAGE=OUTPUT.Next            Hop
:LISTCOL HELP='FLD/RAVAIL' VAR=RAVAIL USAGE=OUTPUT.Route Available
:LISTCOL HELP='FLD/RTOS' VAR=RTOS USAGE=OUTPUT.Type of Service
:LISTCOL HELP='FLD/RMTU' VAR=RMTU USAGE=OUTPUT MAXWIDTH=5.Route MTU 
:LISTCOL HELP='FLD/RTYPE' VAR=RTYPE USAGE=OUTPUT.Route Type
:LISTCOL HELP='FLD/RSRC' VAR=RSRC USAGE=OUTPUT.Route Source

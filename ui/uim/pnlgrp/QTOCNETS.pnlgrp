:EPANEL.
.* --- option 2 and 5
:PANEL NAME=RTEINF HELP=HLPRTE KEYL=RTEKEYS ENTER='RETURN 0' TOPSEP=SYSNAM BOTSEP=NONE.Display TCP/IP Route Information
:TOPINST.Type options, press Enter.
:LIST DEPTH='*' LISTDEF=RTES SCROLL=YES VIEWS=2 MAXHEAD=2.(No routes)
:LISTACT OPTION=5 ENTER='RETURN 105'.5=Display details
:LISTCOL VAR=OPT USAGE=INPUT.Opt
:LISTCOL VAR=RDEST USAGE=OUTPUT.Route Destination
:LISTCOL VAR=RMASK USAGE=OUTPUT.Subnet          Mask
:LISTCOL VAR=RHOP USAGE=OUTPUT.Next            Hop
:LISTCOL VAR=RAVAIL USAGE=OUTPUT.Route Available
:LISTCOL VAR=RTOS USAGE=OUTPUT.Type of Service
:LISTCOL VAR=RMTU USAGE=OUTPUT MAXWIDTH=5.Route MTU 
:LISTCOL VAR=RTYPE USAGE=OUTPUT.Route Type
:LISTCOL VAR=RSRC USAGE=OUTPUT.Route Source
:LISTVIEW COLS='OPT RDEST RMASK RHOP RAVAIL'.
:LISTVIEW COLS='OPT RDEST RTOS RMTU RTYPE RSRC'.
:ELIST.
:EPANEL.
:PANEL NAME=RTE6INF HELP=HLPRTE KEYL=RTE6KEYS ENTER='RETURN 0' TOPSEP=SYSNAM BOTSEP=NONE.Display IPv6 Route Information
:TOPINST.Type options, press Enter.
:LIST DEPTH='*' LISTDEF=RTE6S SCROLL=YES VIEWS=2 MAXHEAD=2.(No routes)
:LISTACT OPTION=5 ENTER='RETURN 105'.5=Display details
:LISTCOL VAR=OPT USAGE=INPUT.Opt
:LISTCOL VAR=YDEST USAGE=OUTPUT MAXWIDTH=20.Route                Destination
:LISTCOL VAR=YMASK USAGE=OUTPUT MAXWIDTH=6.Prefix Length
:LISTCOL VAR=YHOP USAGE=OUTPUT MAXWIDTH=20.Next                 Hop
:LISTCOL VAR=YSTS USAGE=OUTPUT.Route       Status
:LISTCOL VAR=YTOS USAGE=OUTPUT.Type of Service
:LISTCOL VAR=YMTU USAGE=OUTPUT MAXWIDTH=5.Route MTU 
:LISTCOL VAR=YTYPE USAGE=OUTPUT.Route Type
:LISTVIEW COLS='OPT YDEST YMASK YHOP YSTS'.
:LISTVIEW COLS='OPT YDEST YTOS YMTU YTYPE'.
:ELIST.
:EPANEL.

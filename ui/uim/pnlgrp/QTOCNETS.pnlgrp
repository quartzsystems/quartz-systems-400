.* --- the menu
:PANEL NAME=NETSTAT HELP=HLPMENU KEYL=MENUKEYS ENTER='RETURN 1' TOPSEP=SYSNAM.Work with TCP/IP Network Status
:MENU DEPTH='*' SCROLL=YES OPTIONS=OPTION.Select one of the following:
:MENUI OPTION=1 ACTION='RETURN 101'.Work with IPv4 interface status
:MENUI OPTION=2 ACTION='RETURN 102'.Display IPv4 route information
:MENUI OPTION=3 ACTION='RETURN 103'.Work with IPv4 connection status
:MENUI OPTION=4 ACTION='RETURN 104'.Work with IPv6 interface status
:MENUI OPTION=5 ACTION='RETURN 105'.Display IPv6 route information
:MENUI OPTION=6 ACTION='RETURN 106'.Work with IPv6 connection status
:MENUI OPTION=10 ACTION='RETURN 110'.Display TCP/IP stack status
:EMENU.
:CMDLINE SIZE=LONG.Selection or command
:EPANEL.
.* --- option 1
:PANEL NAME=IFCSTS HELP=HLPIFC KEYL=IFCKEYS ENTER='RETURN 0' TOPSEP=SYSNAM BOTSEP=NONE.Work with TCP/IP Interface Status
:TOPINST.Type options, press Enter.
:LIST DEPTH='*' LISTDEF=IFCS SCROLL=YES VIEWS=2 MAXHEAD=3.(No interfaces)
:LISTACT OPTION=5 ENTER='RETURN 105'.5=Display details
:LISTACT OPTION=8 ENTER='RETURN 108'.8=Display associated routes              
:LISTACT OPTION=9 ENTER='CMD STRTCPIFC INTNETADR(''&IADR.'')'.9=Start
:LISTACT OPTION=10 ENTER='CMD ENDTCPIFC INTNETADR(''&IADR.'')'.10=End
:LISTACT OPTION=12 ENTER='RETURN 112'.12=Work with configuration status
:LISTACT OPTION=14 ENTER='RETURN 114'.14=Display multicast groups
:LISTCOL VAR=OPT USAGE=INPUT.Opt
:LISTCOL VAR=IADR USAGE=OUTPUT.Internet Address
:LISTCOL VAR=INET USAGE=OUTPUT.Network         Address
:LISTCOL VAR=ILIND USAGE=OUTPUT.Line Description
:LISTCOL VAR=ISTS USAGE=OUTPUT.Interface Status
:LISTCOL VAR=IVLAN USAGE=OUTPUT.Virtual LAN     ID
:LISTVIEW COLS='OPT IADR INET ILIND ISTS'.
:LISTVIEW COLS='OPT IADR INET ILIND IVLAN'.
:ELIST.
:EPANEL.
:PANEL NAME=IFCSTSD HELP=HLPIFC KEYL=IFCKEYS ENTER='RETURN 0' TOPSEP=SYSNAM BOTSEP=NONE.Work with TCP/IP Interface Status
:TOPINST.Type options, press Enter.
:LIST DEPTH='*' LISTDEF=IFCS SCROLL=YES VIEWS=2 MAXHEAD=3.(No interfaces)
:LISTACT OPTION=5 ENTER='RETURN 105'.5=Display details
:LISTACT OPTION=8 ENTER='RETURN 108'.8=Display associated routes              
:LISTACT OPTION=12 ENTER='RETURN 112'.12=Work with configuration status
:LISTACT OPTION=14 ENTER='RETURN 114'.14=Display multicast groups
:LISTCOL VAR=OPT USAGE=INPUT.Opt
:LISTCOL VAR=IADR USAGE=OUTPUT.Internet Address
:LISTCOL VAR=INET USAGE=OUTPUT.Network         Address
:LISTCOL VAR=ILIND USAGE=OUTPUT.Line Description
:LISTCOL VAR=ISTS USAGE=OUTPUT.Interface Status
:LISTCOL VAR=IVLAN USAGE=OUTPUT.Virtual LAN     ID
:LISTVIEW COLS='OPT IADR INET ILIND ISTS'.
:LISTVIEW COLS='OPT IADR INET ILIND IVLAN'.
:ELIST.
:EPANEL.
.* --- option 4
:PANEL NAME=IFC6STS HELP=HLPIFC KEYL=IFC6KEYS ENTER='RETURN 0' TOPSEP=SYSNAM BOTSEP=NONE.Work with IPv6 Interface Status
:TOPINST.Type options, press Enter.
:LIST DEPTH='*' LISTDEF=IFC6S SCROLL=YES VIEWS=2 MAXHEAD=3.(No interfaces)
:LISTACT OPTION=5 ENTER='RETURN 105'.5=Display details
:LISTACT OPTION=8 ENTER='RETURN 108'.8=Display associated IPv6 routes         
:LISTACT OPTION=9 ENTER='CMD STRTCPIFC INTNETADR(''&XADR.'')'.9=Start
:LISTACT OPTION=10 ENTER='CMD ENDTCPIFC INTNETADR(''&XADR.'')'.10=End
:LISTACT OPTION=12 ENTER='RETURN 112'.12=Work with configuration status
:LISTACT OPTION=14 ENTER='RETURN 114'.14=Display multicast groups
:LISTCOL VAR=OPT USAGE=INPUT.Opt
:LISTCOL VAR=XADR USAGE=OUTPUT MAXWIDTH=32.Internet                         Address
:LISTCOL VAR=XPFX USAGE=OUTPUT MAXWIDTH=6.Prefix Length
:LISTCOL VAR=XLIND USAGE=OUTPUT.Line Description
:LISTCOL VAR=XSTS USAGE=OUTPUT.Interface Status
:LISTCOL VAR=XVLAN USAGE=OUTPUT.Virtual LAN     ID
:LISTVIEW COLS='OPT XADR XPFX XLIND XSTS'.
:LISTVIEW COLS='OPT XADR XPFX XLIND XVLAN'.
:ELIST.
:EPANEL.
:PANEL NAME=IFC6STSD HELP=HLPIFC KEYL=IFC6KEYS ENTER='RETURN 0' TOPSEP=SYSNAM BOTSEP=NONE.Work with IPv6 Interface Status
:TOPINST.Type options, press Enter.
:LIST DEPTH='*' LISTDEF=IFC6S SCROLL=YES VIEWS=2 MAXHEAD=3.(No interfaces)
:LISTACT OPTION=5 ENTER='RETURN 105'.5=Display details
:LISTACT OPTION=8 ENTER='RETURN 108'.8=Display associated IPv6 routes         
:LISTACT OPTION=12 ENTER='RETURN 112'.12=Work with configuration status
:LISTACT OPTION=14 ENTER='RETURN 114'.14=Display multicast groups
:LISTCOL VAR=OPT USAGE=INPUT.Opt
:LISTCOL VAR=XADR USAGE=OUTPUT MAXWIDTH=32.Internet                         Address
:LISTCOL VAR=XPFX USAGE=OUTPUT MAXWIDTH=6.Prefix Length
:LISTCOL VAR=XLIND USAGE=OUTPUT.Line Description
:LISTCOL VAR=XSTS USAGE=OUTPUT.Interface Status
:LISTCOL VAR=XVLAN USAGE=OUTPUT.Virtual LAN     ID
:LISTVIEW COLS='OPT XADR XPFX XLIND XSTS'.
:LISTVIEW COLS='OPT XADR XPFX XLIND XVLAN'.
:ELIST.
:EPANEL.
.* --- option 5 on an interface
:PANEL NAME=DSPIFC HELP=HLPIFC5 KEYL=DSPKEYS ENTER='RETURN 0' TOPSEP=SYSNAM.Display TCP/IP Interface Status
:DATA DEPTH='*' SCROLL=IND.
:DATACOL WIDTH=33.
:DATACOL WIDTH=78.
:DATAI VAR=DHOST USAGE=OUTPUT.Interface host name
:DATAI VAR=DADR USAGE=OUTPUT.Internet address
:DATAGRP GRPSEP=NONE.
:DATAI VAR=DMASK USAGE=OUTPUT.Subnet mask
:DATAI VAR=DNET USAGE=OUTPUT.Network address
:DATAI VAR=DHOSTA USAGE=OUTPUT.Host address
:DATAI VAR=DBCAST USAGE=OUTPUT.Directed broadcast address
:EDATAGRP.
:DATAI VAR=DSTS USAGE=OUTPUT.Interface status
:DATAI VAR=DCHG USAGE=OUTPUT.Change date/time
:DATAI VAR=DLIND USAGE=OUTPUT.Line description
:DATAGRP GRPSEP=NONE.
:DATAI VAR=DVLAN USAGE=OUTPUT.Virtual LAN ID
:EDATAGRP.

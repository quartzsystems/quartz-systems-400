:VAR NAME=DSWACK CLASS=VALCL.
:VAR NAME=DCWND CLASS=VALCL.
:VAR NAME=DSSTH CLASS=VALCL.
:VAR NAME=DMSS CLASS=VALCL.
:VAR NAME=DPREC CLASS=VALCL.
:VAR NAME=DISS CLASS=VALCL.
:VAR NAME=DIRS CLASS=VALCL.
:VAR NAME=S4 CLASS=VALCL.
:VAR NAME=S6 CLASS=VALCL.
:VAR NAME=SLMT CLASS=VALCL.
:VAR NAME=SACT CLASS=VALCL.
:VAR NAME=SSTR CLASS=VALCL.
:VAR NAME=SEND CLASS=VALCL.

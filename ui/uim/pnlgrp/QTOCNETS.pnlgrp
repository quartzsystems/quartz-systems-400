.* QTOCNETS: NETSTAT. The menu, the IPv4 and IPv6 lists of interfaces,
.* routes and connections with their option 5 displays, the jobs of a
.* connection (option 8) and the stack status (option 10). A list's
.* panel without the D suffix has the options that change something
.* (*IOSYSCFG); with it, the display options only. The driver is
.* work/qsjob/src/panels/netstat.rs. A non-breaking blank in a key or
.* heading text holds the next item at the column the system shows.
:PNLGRP.
:COPYR.(C) COPYRIGHT QUARTZ SYSTEMS 2026.
:CLASS NAME=OPTCL BASETYPE=ACTION.
:ECLASS.
:CLASS NAME=MOPTCL BASETYPE='CHAR 2'.
:ECLASS.
:CLASS NAME=ADRCL BASETYPE='CHAR 15'.
:ECLASS.
:CLASS NAME=ADR6CL BASETYPE='CHAR 45'.
:ECLASS.
:CLASS NAME=NAMECL BASETYPE='CHAR 10'.
:ECLASS.
:CLASS NAME=STSCL BASETYPE='CHAR 12'.
:ECLASS.
:CLASS NAME=VLANCL BASETYPE='CHAR 7'.
:ECLASS.
:CLASS NAME=YNCL BASETYPE='CHAR 6'.
:ECLASS.
:CLASS NAME=TOSCL BASETYPE='CHAR 14'.
:ECLASS.
:CLASS NAME=TYPECL BASETYPE='CHAR 9'.
:ECLASS.
:CLASS NAME=PORTCL BASETYPE='CHAR 9'.
:ECLASS.
:CLASS NAME=PORT6CL BASETYPE='CHAR 7'.
:ECLASS.
:CLASS NAME=NUMCL BASETYPE='ZONED 11 0'.
:ECLASS.
:CLASS NAME=TIMECL BASETYPE='CHAR 9'.
:ECLASS.
:CLASS NAME=KEYCL BASETYPE='CHAR 120'.
:ECLASS.
:CLASS NAME=VALCL BASETYPE='CHAR 40'.
:ECLASS.
:CLASS NAME=VIEWCL BASETYPE='CHAR 1'.
:ECLASS.
:CLASS NAME=JPADCL BASETYPE='CHAR 1'.
:ECLASS.
:VAR NAME=OPTION CLASS=MOPTCL.
:VAR NAME=VIEW CLASS=VIEWCL VALUE='1'.
:VAR NAME=OPT CLASS=OPTCL.
.* Option 1 and 4: the interfaces.
:VAR NAME=IADR CLASS=ADRCL.
:VAR NAME=INET CLASS=ADRCL.
:VAR NAME=ILIND CLASS=NAMECL.
:VAR NAME=ISTS CLASS=STSCL.
:VAR NAME=IVLAN CLASS=VLANCL.
:VAR NAME=XADR CLASS=ADR6CL.
:VAR NAME=XPFX CLASS=NUMCL.
:VAR NAME=XLIND CLASS=NAMECL.
:VAR NAME=XSTS CLASS=STSCL.
:VAR NAME=XVLAN CLASS=VLANCL.
:LISTDEF NAME=IFCS VARS='OPT IADR INET ILIND ISTS IVLAN'.
:LISTDEF NAME=IFC6S VARS='OPT XADR XPFX XLIND XSTS XVLAN'.
.* Option 2 and 5: the routes.
:VAR NAME=RDEST CLASS=ADRCL.
:VAR NAME=RMASK CLASS=ADRCL.
:VAR NAME=RHOP CLASS=ADRCL.
:VAR NAME=RAVAIL CLASS=YNCL.
:VAR NAME=RTOS CLASS=TOSCL.
:VAR NAME=RMTU CLASS=NUMCL.
:VAR NAME=RTYPE CLASS=TYPECL.
:VAR NAME=RSRC CLASS=NAMECL.
:VAR NAME=RKEY CLASS=KEYCL.
:VAR NAME=YDEST CLASS=ADR6CL.
:VAR NAME=YMASK CLASS=NUMCL.
:VAR NAME=YHOP CLASS=ADR6CL.
:VAR NAME=YSTS CLASS=STSCL.
:VAR NAME=YTOS CLASS=TOSCL.
:VAR NAME=YMTU CLASS=NUMCL.
:VAR NAME=YTYPE CLASS=TYPECL.
:VAR NAME=YKEY CLASS=KEYCL.
:LISTDEF NAME=RTES VARS='OPT RDEST RMASK RHOP RAVAIL RTOS RMTU RTYPE RSRC RKEY'.
:LISTDEF NAME=RTE6S VARS='OPT YDEST YMASK YHOP YSTS YTOS YMTU YTYPE YKEY'.
.* Option 3 and 6: the connections.
:VAR NAME=CRADR CLASS=ADRCL.
:VAR NAME=CRPORT CLASS=PORTCL.
:VAR NAME=CLPORT CLASS=PORTCL.
:VAR NAME=CIDLE CLASS=TIMECL.
:VAR NAME=CSTATE CLASS=STSCL.
:VAR NAME=CUSER CLASS=NAMECL.
:VAR NAME=COUT CLASS=NUMCL.
:VAR NAME=CIN CLASS=NUMCL.
:VAR NAME=CLADR CLASS=ADRCL.
:VAR NAME=CRPORTN CLASS=NUMCL.
:VAR NAME=CLPORTN CLASS=NUMCL.
:VAR NAME=CTYPE CLASS=NAMECL.
:VAR NAME=CKEY CLASS=KEYCL.
:VAR NAME=ZRADR CLASS=ADR6CL.
:VAR NAME=ZRPORT CLASS=PORT6CL.
:VAR NAME=ZLPORT CLASS=PORT6CL.
:VAR NAME=ZIDLE CLASS=NUMCL.
:VAR NAME=ZSTATE CLASS=STSCL.
:VAR NAME=ZUSER CLASS=NAMECL.
:VAR NAME=ZOUT CLASS=NUMCL.
:VAR NAME=ZIN CLASS=NUMCL.
:VAR NAME=ZLADR CLASS=ADR6CL.
:VAR NAME=ZRPORTN CLASS=NUMCL.
:VAR NAME=ZLPORTN CLASS=NUMCL.
:VAR NAME=ZTYPE CLASS=NAMECL.
:VAR NAME=ZKEY CLASS=KEYCL.
:LISTDEF NAME=CNNS VARS='OPT CRADR CRPORT CLPORT CIDLE CSTATE CUSER COUT CIN CLADR CRPORTN CLPORTN CTYPE CKEY'.
:LISTDEF NAME=CNN6S VARS='OPT ZRADR ZRPORT ZLPORT ZIDLE ZSTATE ZUSER ZOUT ZIN ZLADR ZRPORTN ZLPORTN ZTYPE ZKEY'.
.* Option 8: the jobs of a connection.
:VAR NAME=JCTYPE CLASS=VALCL.
:VAR NAME=JLADR CLASS=VALCL.
:VAR NAME=JLPORT CLASS=VALCL.
:VAR NAME=JRADR CLASS=VALCL.
:VAR NAME=JRPORT CLASS=VALCL.
:VAR NAME=JNAME CLASS=NAMECL.
:VAR NAME=JUSER CLASS=NAMECL.
:VAR NAME=JNBR CLASS=NAMECL.
:VAR NAME=JTYPE CLASS=NAMECL.
:VAR NAME=JCUR CLASS=NAMECL.
:VAR NAME=JPAD CLASS=JPADCL.
:LISTDEF NAME=JOBS VARS='OPT JPAD JNAME JUSER JNBR JTYPE JCUR'.
.* The option 5 displays and option 10.
:VAR NAME=DHOST CLASS=VALCL.
:VAR NAME=DADR CLASS=VALCL.

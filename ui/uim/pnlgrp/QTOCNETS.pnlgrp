:DATAI HELP='FLD/DOPEN' VAR=DOPEN USAGE=OUTPUT.Connection open type
:EDATAGRP.
:DATAGRP GRPSEP=NONE.Timing information
:DATAI HELP='FLD/DIDLE' VAR=DIDLE USAGE=OUTPUT.Idle time
:DATAGRP GRPSEP=NONE.
:DATAI HELP='FLD/DLAST' VAR=DLAST USAGE=OUTPUT.Last activity date/time
:EDATAGRP.
:DATAI HELP='FLD/DRTT' VAR=DRTT USAGE=OUTPUT.Round-trip time
:DATAI HELP='FLD/DRTTV' VAR=DRTTV USAGE=OUTPUT.Round-trip variance
:EDATAGRP.
:DATAC.
:DATAI HELP='FLD/DBOUT' VAR=DBOUT USAGE=OUTPUT.Bytes out
:DATAGRP GRPSEP=NONE.
:DATAI HELP='FLD/DOBUF' VAR=DOBUF USAGE=OUTPUT.Outgoing bytes buffered
:DATAI HELP='FLD/DUSNDNXT' VAR=DUSNDNXT USAGE=OUTPUT.User send next
:DATAI HELP='FLD/DSNDNXT' VAR=DSNDNXT USAGE=OUTPUT.Send next
:DATAI HELP='FLD/DSNDUNA' VAR=DSNDUNA USAGE=OUTPUT.Send unacknowledged
:DATAI HELP='FLD/DOPUSH' VAR=DOPUSH USAGE=OUTPUT.Outgoing push number
:DATAI HELP='FLD/DOURG' VAR=DOURG USAGE=OUTPUT.Outgoing urgency number
:DATAI HELP='FLD/DOWIN' VAR=DOWIN USAGE=OUTPUT.Outgoing window number
:EDATAGRP.
:DATAI HELP='FLD/DBIN' VAR=DBIN USAGE=OUTPUT.Bytes in
:DATAGRP GRPSEP=NONE.
:DATAI HELP='FLD/DIBUF' VAR=DIBUF USAGE=OUTPUT.Incoming bytes buffered
:DATAI HELP='FLD/DRCVNXT' VAR=DRCVNXT USAGE=OUTPUT.Receive next
:DATAI HELP='FLD/DURCVNXT' VAR=DURCVNXT USAGE=OUTPUT.User receive next
:DATAI HELP='FLD/DIPUSH' VAR=DIPUSH USAGE=OUTPUT.Incoming push number
:DATAI HELP='FLD/DIURG' VAR=DIURG USAGE=OUTPUT.Incoming urgency number
:DATAI HELP='FLD/DIWIN' VAR=DIWIN USAGE=OUTPUT.Incoming window number
:EDATAGRP.
:DATAC.
:DATAC.
:DATAGRP GRPSEP=NONE.Retransmission information
:DATAI HELP='FLD/DRETR' VAR=DRETR USAGE=OUTPUT.Total retransmissions
:DATAI HELP='FLD/DCRETR' VAR=DCRETR USAGE=OUTPUT.Current retransmissions
:EDATAGRP.

:LISTDEF NAME=POOLS VARS='POOLID POOLSIZE ACTLVL'.
:LISTDEF NAME=AJES VARS='AJEJOB AJEJOBD AJELIB'.
:LISTDEF NAME=WSES VARS='OPT WSNAME WSJOBD WSJOBDL WSMAX'.
:LISTDEF NAME=JOBQES VARS='SEQ JOBQ JOBQLIB MAXACT M1 M2 M3 M4 M5 M6 M7 M8 M9'.
:LISTDEF NAME=RTGES VARS='OPT RTSEQ PGM PGMLIB CMPVAL STARTPOS'.
:LISTDEF NAME=CMNES VARS='DEV MODE CMNJOBD MAXACT'.
:LISTDEF NAME=PJES VARS='PJEPGM PJELIB PJEUSER PJEJOB'.
:KEYL HELP='KEYS/MENUKEYS' NAME=MENUKEYS.
:KEYI KEY=ENTER ACTION=ENTER.
:KEYI KEY=HELP ACTION=HELP.
:KEYI KEY=PAGEUP ACTION=PAGEUP.
:KEYI KEY=PAGEDOWN ACTION=PAGEDOWN.
:KEYI KEY=F3 ACTION=EXIT.F3=Exit
:KEYI KEY=F4 ACTION='RETURN 4'.F4=Prompt
:KEYI KEY=F9 ACTION=RETRIEVE.F9=Retrieve
:KEYI KEY=F12 ACTION=CANCEL.F12=Cancel
:EKEYL.
:KEYL HELP='KEYS/DSPKEYS' NAME=DSPKEYS.
:KEYI KEY=ENTER ACTION=ENTER.
:KEYI KEY=HELP ACTION=HELP.
:KEYI KEY=PAGEUP ACTION=PAGEUP.
:KEYI KEY=PAGEDOWN ACTION=PAGEDOWN.
:KEYI KEY=F3 ACTION=EXIT.F3=Exit
:KEYI KEY=F12 ACTION=CANCEL.F12=Cancel
:EKEYL.
:KEYL HELP='KEYS/DTLKEYS' NAME=DTLKEYS.
:KEYI KEY=ENTER ACTION=ENTER.
:KEYI KEY=HELP ACTION=HELP.
:KEYI KEY=PAGEUP ACTION=PAGEUP.
:KEYI KEY=PAGEDOWN ACTION=PAGEDOWN.
:KEYI KEY=F3 ACTION=EXIT.F3=Exit
:KEYI KEY=F9 ACTION='RETURN 9'.F9=Display all detailed descriptions
:KEYI KEY=F12 ACTION=CANCEL.F12=Cancel
:EKEYL.
:PANEL NAME=DSPSBSD KEYL=MENUKEYS HELP=DSPSBSD ENTER='RETURN 0' TOPSEP=SYSNAM.Display Subsystem Description
:DATA DEPTH=3 COMPACT.
:DATAI HELP='FLD/SBS' VAR=SBS USAGE=OUTPUT.Subsystem description
:DATAIX VAR=SBSLIB USAGE=OUTPUT.
:DATAIXT.Library
:DATAI HELP='FLD/STATUS' VAR=STATUS USAGE=OUTPUT.Status
:EDATA.
:MENU DEPTH='*' SCROLL=YES.Select one of the following:
:MENUI HELP='DSPSBSD/OPT1' OPTION=1 ACTION='RETURN 101'.Operational attributes
:MENUI HELP='DSPSBSD/OPT2' OPTION=2 ACTION='RETURN 102'.Pool definitions
:MENUI HELP='DSPSBSD/OPT3' OPTION=3 ACTION='RETURN 103'.Autostart job entries
:MENUI HELP='DSPSBSD/OPT4' OPTION=4 ACTION='RETURN 104'.Work station name entries
:MENUI HELP='DSPSBSD/OPT5' OPTION=5 ACTION='RETURN 105'.Work station type entries
:MENUI HELP='DSPSBSD/OPT6' OPTION=6 ACTION='RETURN 106'.Job queue entries
:MENUI HELP='DSPSBSD/OPT7' OPTION=7 ACTION='RETURN 107'.Routing entries
:MENUI HELP='DSPSBSD/OPT8' OPTION=8 ACTION='RETURN 108'.Communications entries
:MENUI HELP='DSPSBSD/OPT9' OPTION=9 ACTION='RETURN 109'.Remote location name entries
:MENUI HELP='DSPSBSD/OPT10' OPTION=10 ACTION='RETURN 110'.Prestart job entries
:MENUI HELP='DSPSBSD/OPT20' OPTION=20 ACTION='RETURN 120'.Every entry, one display after another
:MENUI HELP='DSPSBSD/OPT21' OPTION=21 ACTION='RETURN 121'.Work with the subsystem's jobs
:EMENU.
:CMDLINE SIZE=LONG.
:EPANEL.
.* The heading every entry display shares.
:PANEL NAME=OPRATR KEYL=DSPKEYS HELP=DSPSBSD ENTER='RETURN 1' TOPSEP=SYSNAM.Display Operational Attributes
:DATA DEPTH=2 COMPACT.
:DATAI HELP='FLD/SBS' VAR=SBS USAGE=OUTPUT.Subsystem description
:DATAIX VAR=STATUS USAGE=OUTPUT.
:DATAIXT.Status
:EDATA.
:DATA DEPTH='*' SCROLL=YES.
:DATAI HELP='FLD/SBS' VAR=SBS USAGE=OUTPUT.Subsystem description
:DATAGRP GRPSEP=NONE.
:DATAI HELP='FLD/SBSLIB' VAR=SBSLIB USAGE=OUTPUT.Library
:EDATAGRP.
:DATAI HELP='FLD/MAXJOBS' VAR=MAXJOBS USAGE=OUTPUT.Maximum jobs in subsystem
:DATAI HELP='FLD/SGNDSPF' VAR=SGNDSPF USAGE=OUTPUT.Sign-on display file
:DATAGRP GRPSEP=NONE.
:DATAI HELP='FLD/SGNLIB' VAR=SGNLIB USAGE=OUTPUT.Library
:EDATAGRP.
:DATAI HELP='FLD/SYSLIBLE' VAR=SYSLIBLE USAGE=OUTPUT.System library list entry
:DATAI HELP='FLD/ASPGRP' VAR=ASPGRP USAGE=OUTPUT.Auxiliary storage pool group
:DATAI HELP='FLD/WLGRP' VAR=WLGRP USAGE=OUTPUT.Workload group
:EDATA.
:BOTINST.Press Enter to continue.
:EPANEL.
:PANEL NAME=POOLS KEYL=DSPKEYS HELP=DSPSBSD ENTER='RETURN 1' TOPSEP=SYSNAM.Display Pool Definitions
:DATA DEPTH=2 COMPACT.
:DATAI HELP='FLD/SBS' VAR=SBS USAGE=OUTPUT.Subsystem description
:DATAIX VAR=STATUS USAGE=OUTPUT.
:DATAIXT.Status
:EDATA.
:LIST DEPTH='*' LISTDEF=POOLS.(No pool definitions)
:LISTCOL HELP='FLD/POOLID' VAR=POOLID USAGE=OUTPUT.Pool ID
:LISTCOL HELP='FLD/POOLSIZE' VAR=POOLSIZE USAGE=OUTPUT.Storage Size (M)
:LISTCOL HELP='FLD/ACTLVL' VAR=ACTLVL USAGE=OUTPUT.Activity Level
:ELIST.
:BOTINST.Press Enter to continue.
:EPANEL.
:PANEL NAME=AJES KEYL=DSPKEYS HELP=DSPSBSD ENTER='RETURN 1' TOPSEP=SYSNAM.Display Autostart Job Entries
:DATA DEPTH=2 COMPACT.
:DATAI HELP='FLD/SBS' VAR=SBS USAGE=OUTPUT.Subsystem description
:DATAIX VAR=STATUS USAGE=OUTPUT.
:DATAIXT.Status
:EDATA.
:LIST DEPTH='*' LISTDEF=AJES.(No autostart job entries)
:LISTCOL HELP='FLD/AJEJOB' VAR=AJEJOB USAGE=OUTPUT.Job
:LISTCOL HELP='FLD/AJEJOBD' VAR=AJEJOBD USAGE=OUTPUT.Job Description
:LISTCOL HELP='FLD/AJELIB' VAR=AJELIB USAGE=OUTPUT.Library
:ELIST.
:BOTINST.Press Enter to continue.
:EPANEL.
:PANEL NAME=WSNES KEYL=DTLKEYS HELP=DSPSBSD ENTER='RETURN 1' TOPSEP=SYSNAM BOTSEP=NONE.Display Work Station Name Entries
:DATA DEPTH=2 COMPACT.
:DATAI HELP='FLD/SBS' VAR=SBS USAGE=OUTPUT.Subsystem description
:DATAIX VAR=STATUS USAGE=OUTPUT.
:DATAIXT.Status
:EDATA.
:TOPINST.Type options, press Enter.
:LIST DEPTH='*' LISTDEF=WSES.(No work station name entries)
:LISTACT HELP='WSNES/OPTIONS' OPTION=5 ENTER='RETURN 5'.5=Display work station name details
:LISTCOL HELP='WSNES/OPT' VAR=OPT USAGE=INPUT.Opt
:LISTCOL HELP='FLD/WSNAME' VAR=WSNAME USAGE=OUTPUT.Name
:LISTCOL HELP='FLD/WSJOBD' VAR=WSJOBD USAGE=OUTPUT.Job Description
:LISTCOL HELP='FLD/WSJOBDL' VAR=WSJOBDL USAGE=OUTPUT.Library
:LISTCOL HELP='FLD/WSMAX' VAR=WSMAX USAGE=OUTPUT.Max Active
:ELIST.
:EPANEL.

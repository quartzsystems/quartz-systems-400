:VAR NAME=PJELIB CLASS=NAMECL.
:VAR NAME=PJEUSER CLASS=NAMECL.
:VAR NAME=PJEJOB CLASS=NAMECL.
:LISTDEF NAME=POOLS VARS='POOLID POOLSIZE ACTLVL'.
:LISTDEF NAME=AJES VARS='AJEJOB AJEJOBD AJELIB'.
:LISTDEF NAME=WSES VARS='OPT WSNAME WSJOBD WSJOBDL WSMAX'.
:LISTDEF NAME=JOBQES VARS='SEQ JOBQ JOBQLIB MAXACT M1 M2 M3 M4 M5 M6 M7 M8 M9'.
:LISTDEF NAME=RTGES VARS='OPT RTSEQ PGM PGMLIB CMPVAL STARTPOS'.
:LISTDEF NAME=CMNES VARS='DEV MODE CMNJOBD MAXACT'.
:LISTDEF NAME=PJES VARS='PJEPGM PJELIB PJEUSER PJEJOB'.
:KEYL NAME=MENUKEYS HELP='KEYS/MENUKEYS'.
:KEYI KEY=ENTER ACTION=ENTER.
:KEYI KEY=HELP ACTION=HELP.
:KEYI KEY=PAGEUP ACTION=PAGEUP.
:KEYI KEY=PAGEDOWN ACTION=PAGEDOWN.
:KEYI KEY=F3 ACTION=EXIT.F3=Exit
:KEYI KEY=F4 ACTION='RETURN 4'.F4=Prompt
:KEYI KEY=F9 ACTION=RETRIEVE.F9=Retrieve
:KEYI KEY=F12 ACTION=CANCEL.F12=Cancel
:EKEYL.
:KEYL NAME=DSPKEYS HELP='KEYS/DSPKEYS'.
:KEYI KEY=ENTER ACTION=ENTER.
:KEYI KEY=HELP ACTION=HELP.
:KEYI KEY=PAGEUP ACTION=PAGEUP.
:KEYI KEY=PAGEDOWN ACTION=PAGEDOWN.
:KEYI KEY=F3 ACTION=EXIT.F3=Exit
:KEYI KEY=F12 ACTION=CANCEL.F12=Cancel
:EKEYL.
:KEYL NAME=DTLKEYS HELP='KEYS/DTLKEYS'.
:KEYI KEY=ENTER ACTION=ENTER.
:KEYI KEY=HELP ACTION=HELP.
:KEYI KEY=PAGEUP ACTION=PAGEUP.
:KEYI KEY=PAGEDOWN ACTION=PAGEDOWN.
:KEYI KEY=F3 ACTION=EXIT.F3=Exit
:KEYI KEY=F9 ACTION='RETURN 9'.F9=Display all detailed descriptions
:KEYI KEY=F12 ACTION=CANCEL.F12=Cancel
:EKEYL.
:PANEL NAME=DSPSBSD KEYL=MENUKEYS HELP=DSPSBSD ENTER='RETURN 0' TOPSEP=SYSNAM.Display Subsystem Description
:DATA DEPTH=3 COMPACT.
:DATAI VAR=SBS USAGE=OUTPUT HELP='FLD/SBS'.Subsystem description
:DATAIX VAR=SBSLIB USAGE=OUTPUT.
:DATAIXT.Library
:DATAI VAR=STATUS USAGE=OUTPUT HELP='FLD/STATUS'.Status
:EDATA.
:MENU DEPTH='*' SCROLL=YES.Select one of the following:
:MENUI OPTION=1 ACTION='RETURN 101' HELP='DSPSBSD/OPT1'.Operational attributes
:MENUI OPTION=2 ACTION='RETURN 102' HELP='DSPSBSD/OPT2'.Pool definitions
:MENUI OPTION=3 ACTION='RETURN 103' HELP='DSPSBSD/OPT3'.Autostart job entries
:MENUI OPTION=4 ACTION='RETURN 104' HELP='DSPSBSD/OPT4'.Work station name entries
:MENUI OPTION=5 ACTION='RETURN 105' HELP='DSPSBSD/OPT5'.Work station type entries
:MENUI OPTION=6 ACTION='RETURN 106' HELP='DSPSBSD/OPT6'.Job queue entries
:MENUI OPTION=7 ACTION='RETURN 107' HELP='DSPSBSD/OPT7'.Routing entries
:MENUI OPTION=8 ACTION='RETURN 108' HELP='DSPSBSD/OPT8'.Communications entries
:MENUI OPTION=9 ACTION='RETURN 109' HELP='DSPSBSD/OPT9'.Remote location name entries
:MENUI OPTION=10 ACTION='RETURN 110' HELP='DSPSBSD/OPT10'.Prestart job entries
:MENUI OPTION=20 ACTION='RETURN 120' HELP='DSPSBSD/OPT20'.Every entry, one display after another
:MENUI OPTION=21 ACTION='RETURN 121' HELP='DSPSBSD/OPT21'.Work with the subsystem's jobs
:EMENU.
:CMDLINE SIZE=LONG.
:EPANEL.
.* The heading every entry display shares.
:PANEL NAME=OPRATR KEYL=DSPKEYS HELP=DSPSBSD ENTER='RETURN 1' TOPSEP=SYSNAM.Display Operational Attributes
:DATA DEPTH=2 COMPACT.
:DATAI VAR=SBS USAGE=OUTPUT HELP='FLD/SBS'.Subsystem description
:DATAIX VAR=STATUS USAGE=OUTPUT.
:DATAIXT.Status
:EDATA.
:DATA DEPTH='*' SCROLL=YES.
:DATAI VAR=SBS USAGE=OUTPUT HELP='FLD/SBS'.Subsystem description
:DATAGRP GRPSEP=NONE.
:DATAI VAR=SBSLIB USAGE=OUTPUT HELP='FLD/SBSLIB'.Library
:EDATAGRP.
:DATAI VAR=MAXJOBS USAGE=OUTPUT HELP='FLD/MAXJOBS'.Maximum jobs in subsystem
:DATAI VAR=SGNDSPF USAGE=OUTPUT HELP='FLD/SGNDSPF'.Sign-on display file
:DATAGRP GRPSEP=NONE.
:DATAI VAR=SGNLIB USAGE=OUTPUT HELP='FLD/SGNLIB'.Library
:EDATAGRP.
:DATAI VAR=SYSLIBLE USAGE=OUTPUT HELP='FLD/SYSLIBLE'.System library list entry
:DATAI VAR=ASPGRP USAGE=OUTPUT HELP='FLD/ASPGRP'.Auxiliary storage pool group
:DATAI VAR=WLGRP USAGE=OUTPUT HELP='FLD/WLGRP'.Workload group
:EDATA.
:BOTINST.Press Enter to continue.
:EPANEL.
:PANEL NAME=POOLS KEYL=DSPKEYS HELP=DSPSBSD ENTER='RETURN 1' TOPSEP=SYSNAM.Display Pool Definitions
:DATA DEPTH=2 COMPACT.
:DATAI VAR=SBS USAGE=OUTPUT HELP='FLD/SBS'.Subsystem description
:DATAIX VAR=STATUS USAGE=OUTPUT.
:DATAIXT.Status
:EDATA.
:LIST DEPTH='*' LISTDEF=POOLS.(No pool definitions)
:LISTCOL VAR=POOLID USAGE=OUTPUT HELP='FLD/POOLID'.Pool ID
:LISTCOL VAR=POOLSIZE USAGE=OUTPUT HELP='FLD/POOLSIZE'.Storage Size (M)
:LISTCOL VAR=ACTLVL USAGE=OUTPUT HELP='FLD/ACTLVL'.Activity Level
:ELIST.
:BOTINST.Press Enter to continue.
:EPANEL.
:PANEL NAME=AJES KEYL=DSPKEYS HELP=DSPSBSD ENTER='RETURN 1' TOPSEP=SYSNAM.Display Autostart Job Entries
:DATA DEPTH=2 COMPACT.
:DATAI VAR=SBS USAGE=OUTPUT HELP='FLD/SBS'.Subsystem description
:DATAIX VAR=STATUS USAGE=OUTPUT.
:DATAIXT.Status
:EDATA.
:LIST DEPTH='*' LISTDEF=AJES.(No autostart job entries)
:LISTCOL VAR=AJEJOB USAGE=OUTPUT HELP='FLD/AJEJOB'.Job
:LISTCOL VAR=AJEJOBD USAGE=OUTPUT HELP='FLD/AJEJOBD'.Job Description
:LISTCOL VAR=AJELIB USAGE=OUTPUT HELP='FLD/AJELIB'.Library
:ELIST.
:BOTINST.Press Enter to continue.
:EPANEL.
:PANEL NAME=WSNES KEYL=DTLKEYS HELP=DSPSBSD ENTER='RETURN 1' TOPSEP=SYSNAM BOTSEP=NONE.Display Work Station Name Entries
:DATA DEPTH=2 COMPACT.
:DATAI VAR=SBS USAGE=OUTPUT HELP='FLD/SBS'.Subsystem description
:DATAIX VAR=STATUS USAGE=OUTPUT.
:DATAIXT.Status
:EDATA.
:TOPINST.Type options, press Enter.
:LIST DEPTH='*' LISTDEF=WSES.(No work station name entries)
:LISTACT OPTION=5 ENTER='RETURN 5' HELP='WSNES/OPTIONS'.5=Display work station name details
:LISTCOL VAR=OPT USAGE=INPUT HELP='WSNES/OPT'.Opt
:LISTCOL VAR=WSNAME USAGE=OUTPUT HELP='FLD/WSNAME'.Name
:LISTCOL VAR=WSJOBD USAGE=OUTPUT HELP='FLD/WSJOBD'.Job Description
:LISTCOL VAR=WSJOBDL USAGE=OUTPUT HELP='FLD/WSJOBDL'.Library
:LISTCOL VAR=WSMAX USAGE=OUTPUT HELP='FLD/WSMAX'.Max Active
:ELIST.
:EPANEL.

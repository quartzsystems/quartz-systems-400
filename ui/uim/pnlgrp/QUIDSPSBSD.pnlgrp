:DATAIX VAR=STATUS USAGE=OUTPUT.
:DATAIXT.Status
:EDATA.
:TOPINST.Type options, press Enter.
:LIST DEPTH='*' LISTDEF=WSES.(No work station type entries)
:LISTACT HELP='WSTES/OPTIONS' OPTION=5 ENTER='RETURN 5'.5=Display work station type details
:LISTCOL HELP='WSTES/OPT' VAR=OPT USAGE=INPUT.Opt
:LISTCOL HELP='FLD/WSNAME' VAR=WSNAME USAGE=OUTPUT.Type
:LISTCOL HELP='FLD/WSJOBD' VAR=WSJOBD USAGE=OUTPUT.Job Description
:LISTCOL HELP='FLD/WSJOBDL' VAR=WSJOBDL USAGE=OUTPUT.Library
:LISTCOL HELP='FLD/WSMAX' VAR=WSMAX USAGE=OUTPUT.Max Active
:ELIST.
:EPANEL.
:PANEL NAME=JOBQES KEYL=DSPKEYS HELP=DSPSBSD ENTER='RETURN 1' TOPSEP=SYSNAM.Display Job Queue Entries
:DATA DEPTH=2 COMPACT.
:DATAI HELP='FLD/SBS' VAR=SBS USAGE=OUTPUT.Subsystem description
:DATAIX VAR=STATUS USAGE=OUTPUT.
:DATAIXT.Status
:EDATA.
:LIST DEPTH='*' LISTDEF=JOBQES.(No job queue entries)
:LISTCOL HELP='FLD/SEQ' VAR=SEQ USAGE=OUTPUT.Seq Nbr
:LISTCOL HELP='FLD/JOBQ' VAR=JOBQ USAGE=OUTPUT.Job Queue
:LISTCOL HELP='FLD/JOBQLIB' VAR=JOBQLIB USAGE=OUTPUT.Library
:LISTCOL HELP='FLD/MAXACT' VAR=MAXACT USAGE=OUTPUT.Max Active
:LISTGRP.---------Max by Priority----------
:LISTCOL HELP='FLD/M1' VAR=M1 USAGE=OUTPUT.1
:LISTCOL HELP='FLD/M2' VAR=M2 USAGE=OUTPUT.2

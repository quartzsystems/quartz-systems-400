:VAR NAME=DFTCNNLST CLASS=VALCL.
:VAR NAME=ALWANYNET CLASS=VALCL.
:VAR NAME=NWSDOMAIN CLASS=VALCL.
:VAR NAME=ALWVRTIP CLASS=VALCL.
:VAR NAME=ALWHPRTWR CLASS=VALCL.
:VAR NAME=VRTAUTODEV CLASS=VALCL.
:VAR NAME=HPRPTHTMR CLASS=VALCL.
:VAR NAME=ALWADDCLU CLASS=VALCL.
:VAR NAME=MDMCNTRYID CLASS=VALCL.
:VAR NAME=NETSRVID CLASS=NETIDCL.
:VAR NAME=NETSRVCP CLASS=CPCL.
:KEYL NAME=DSPKEYS HELP='KEYS/DSPKEYS'.
:KEYI KEY=ENTER ACTION=ENTER.
:KEYI KEY=HELP ACTION=HELP.
:KEYI KEY=F1 ACTION=HELP.
:KEYI KEY=F3 ACTION=EXIT.F3=Exit
:KEYI KEY=F12 ACTION=CANCEL.F12=Cancel
:KEYI KEY=PAGEUP ACTION=PAGEUP.
:KEYI KEY=PAGEDOWN ACTION=PAGEDOWN.
:EKEYL.
:PANEL NAME=DSPNETA HELP=HLPNETA KEYL=DSPKEYS TOPSEP=SYSNAM.Display Network Attributes
:DATA DEPTH='*' SCROLL=YES.
:DATACOL WIDTH=50.
:DATACOL WIDTH=78.
:DATAI VAR=SYSNAME USAGE=OUTPUT HELP='FLD/SYSNAME'.Current system name
:DATAGRP GRPSEP=NONE.
:DATAI VAR=PNDSYSNAME USAGE=OUTPUT HELP='FLD/PNDSYSNAME'.Pending system name
:EDATAGRP.
:DATAI VAR=LCLNETID USAGE=OUTPUT HELP='FLD/LCLNETID'.Local network ID
:DATAI VAR=LCLCPNAME USAGE=OUTPUT HELP='FLD/LCLCPNAME'.Local control point name
:DATAI VAR=LCLLOCNAME USAGE=OUTPUT HELP='FLD/LCLLOCNAME'.Default local location
:DATAI VAR=DFTMODE USAGE=OUTPUT HELP='FLD/DFTMODE'.Default mode
:DATAI VAR=NODETYPE USAGE=OUTPUT HELP='FLD/NODETYPE'.APPN node type
:DATAI VAR=DTACPR USAGE=OUTPUT HELP='FLD/DTACPR'.Data compression
:DATAI VAR=DTACPRINM USAGE=OUTPUT HELP='FLD/DTACPRINM'.Intermediate data compression
:DATAI VAR=MAXINTSSN USAGE=OUTPUT HELP='FLD/MAXINTSSN'.Maximum number of intermediate sessions
:DATAI VAR=RAR USAGE=OUTPUT HELP='FLD/RAR'.Route addition resistance
:DATAI VAR=NETSRVID USAGE=OUTPUT HELP='FLD/NETSRVID'.Server network ID/control point name
:DATAIX VAR=NETSRVCP USAGE=OUTPUT.
:DATAC.
:DATAC.
:DATAC.
:DATAC.
:DATAC.
:DATAI VAR=ALRSTS USAGE=OUTPUT HELP='FLD/ALRSTS'.Alert status
:DATAI VAR=ALRLOGSTS USAGE=OUTPUT HELP='FLD/ALRLOGSTS'.Alert logging status

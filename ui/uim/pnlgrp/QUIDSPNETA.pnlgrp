:VAR NAME=ALRLOGSTS CLASS=VALCL.
:VAR NAME=ALRPRIFP CLASS=VALCL.
:VAR NAME=ALRDFTFP CLASS=VALCL.
:VAR NAME=ALRBCKFP CLASS=VALCL.

:CLASS NAME=OTXTCL BASETYPE='CHAR 20'.
:ECLASS.
:CLASS NAME=STAMPCL BASETYPE='CHAR 18'.
:ECLASS.
:CLASS NAME=PATHCL BASETYPE='CHAR 40'.
:ECLASS.
:CLASS NAME=FPATHCL BASETYPE='CHAR 60'.
:ECLASS.
:VAR NAME=DEV CLASS=NAMECL.
:VAR NAME=WDEV CLASS=NAMECL.
:VAR NAME=CSI CLASS=NAMECL.
:VAR NAME=VOLID CLASS=VIDCL.
:VAR NAME=VOL CLASS=WVOLCL.
:VAR NAME=OWNER CLASS=OWNCL.
:VAR NAME=VOLTYPE CLASS=NAMECL.
:VAR NAME=MEDTYPE CLASS=SEQCL.
:VAR NAME=AUTL CLASS=NAMECL.
:VAR NAME=CODE CLASS=NAMECL.
:VAR NAME=FSEQ CLASS=SEQCL.
:VAR NAME=FLABEL CLASS=LBLCL.
:VAR NAME=FVSEQ CLASS=SEQCL.
:VAR NAME=FCRT CLASS=DATECL.
:VAR NAME=FEXP CLASS=DATECL.
:VAR NAME=FBLK CLASS=SEQCL.
:VAR NAME=FEND CLASS=ENDCL.
:VAR NAME=OSEQ CLASS=SEQCL.
:VAR NAME=OFILE CLASS=LBLCL.
:VAR NAME=OBJ CLASS=NAMECL.
:VAR NAME=OTYPE CLASS=NAMECL.
:VAR NAME=OLIB CLASS=NAMECL.
:VAR NAME=OATTR CLASS=NAMECL.
:VAR NAME=OSIZE CLASS=SIZECL.
:VAR NAME=OTEXT CLASS=OTXTCL.
:VAR NAME=CTGSYS CLASS=NAMECL.
:VAR NAME=CTGHOME CLASS=LOCCL.
:VAR NAME=MEDFMT CLASS=NAMECL.
:VAR NAME=VOLTEXT CLASS=TEXTCL.
:VAR NAME=CRTDTS CLASS=STAMPCL.
:VAR NAME=CHGDTS CLASS=STAMPCL.
:VAR NAME=VOLCAP CLASS=SIZECL.
:VAR NAME=VOLUSED CLASS=SIZECL.
:VAR NAME=VOLFREE CLASS=SIZECL.
:VAR NAME=BLKSIZ CLASS=SEQCL.
:VAR NAME=VOLSET CLASS=VIDCL.
:VAR NAME=SETSIZE CLASS=SEQCL.

:KEYI KEY=HELP ACTION=HELP.
:KEYI KEY=PAGEUP ACTION=PAGEUP.
:KEYI KEY=PAGEDOWN ACTION=PAGEDOWN.
:KEYI KEY=F3 ACTION=EXIT.F3=Exit
:KEYI KEY=F5 ACTION='RETURN 5'.F5=Refresh
:KEYI KEY=F11 ACTION='RETURN 11' COND=STSVIEW.F11=View descriptions
:KEYI KEY=F11 ACTION='RETURN 11' COND=TXTVIEW.F11=View status and devices
:KEYI KEY=F12 ACTION=CANCEL.F12=Cancel

:VAR NAME=CTG CLASS=CTGCL.
:VAR NAME=CTGVOL CLASS=CVOLCL.
:VAR NAME=CTGCGY CLASS=NAMECL.
:VAR NAME=CTGSTS CLASS=STSCL.
:VAR NAME=CTGLOC CLASS=LOCCL.
:VAR NAME=RSRC CLASS=RSRCCL.
:VAR NAME=RSRCSTS CLASS=DSTSCL.
:VAR NAME=ALLOC CLASS=ALLOCCL.
:VAR NAME=RSRCCTG CLASS=CTGCL.
:VAR NAME=RSRCLIB CLASS=NAMECL.
:VAR NAME=RSRCJOB CLASS=NAMECL.
:CLASS NAME=VIDCL BASETYPE='CHAR 32'.

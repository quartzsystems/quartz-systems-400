:COND NAME=STSVIEW EXPR='&CLGVIEW. EQ "STATUS"'.
:COND NAME=TXTVIEW EXPR='&CLGVIEW. NE "STATUS"'.
:LISTDEF NAME=CLGS VARS='OPT CLG CLGSTS CLGTYPE CLGASP CLGDEV DEVSTS CLGTEXT'.
:LISTDEF NAME=ENTS VARS='OPT IDX ENTSTS WRTPTC VOLNAM IMGFILE'.
:LISTDEF NAME=CTGS VARS='OPT CTG CTGVOL CTGCGY CTGSTS CTGLOC'.
:LISTDEF NAME=RSRCS VARS='OPT RSRC RSRCSTS ALLOC RSRCCTG RSRCLIB RSRCJOB'.
:LISTDEF NAME=FILES VARS='FSEQ FLABEL FVSEQ FCRT FEXP FBLK FEND'.
:LISTDEF NAME=OBJS VARS='OPT OBJ OTYPE OLIB OATTR OOWN OSIZK ODATA OTEXT OSEQ'.
:LISTDEF NAME=OSAVS VARS='OFILE OBJ OTYPE OLIB OATTR OSIZE OTEXT'.
:LISTDEF NAME=DIRS VARS='DPATH DFILES DDIRS DBYTES'.
:LISTDEF NAME=OFILES VARS='FPATH FSIZE'.
:LISTDEF NAME=VOLS VARS='OPT VOL DEV VOLTYPE MEDTYPE AUTL CLG'.
:KEYL NAME=CLGKEYS HELP='KEYS/CLGKEYS'.

:EKEYL.
:PANEL NAME=WRKIMGCLG KEYL=CLGKEYS HELP=WRKIMGCLG ENTER='RETURN 1' TOPSEP=SYSNAM BOTSEP=NONE.Work with Image Catalogs
:TOPINST.Type options, press Enter.
:LIST DEPTH='*' LISTDEF=CLGS EXTACT=YES.(No image catalogs)
:LISTACT OPTION=1 ACTFOR=EXTACT ENTER='CMD ?CRTIMGCLG IMGCLG(&CLG.)' HELP='WRKIMGCLG/OPTIONS'.1=Create
:LISTACT OPTION=2 ACTFOR=LISTE ENTER='RETURN 2' HELP='WRKIMGCLG/OPTIONS'.2=Change
:LISTACT OPTION=4 ACTFOR=LISTE ENTER='CMD DLTIMGCLG IMGCLG(&CLG.)' HELP='WRKIMGCLG/OPTIONS'.4=Delete
:LISTACT OPTION=8 ACTFOR=LISTE ENTER='CMD ?LODIMGCLG IMGCLG(&CLG.) OPTION(*LOAD)' HELP='WRKIMGCLG/OPTIONS'.8=Load
:LISTACT OPTION=9 ACTFOR=LISTE ENTER='CMD LODIMGCLG IMGCLG(&CLG.) OPTION(*UNLOAD)' HELP='WRKIMGCLG/OPTIONS'.9=Unload
:LISTACT OPTION=10 ACTFOR=LISTE ENTER='CMD ?VFYIMGCLG IMGCLG(&CLG.)' HELP='WRKIMGCLG/OPTIONS'.10=Verify
:LISTACT OPTION=12 ACTFOR=LISTE ENTER='RETURN 12' HELP='WRKIMGCLG/OPTIONS'.12=Work with entries
:LISTCOL VAR=OPT USAGE=INPUT HELP='WRKIMGCLG/OPT'.Opt
:LISTCOL VAR=CLG USAGE=OUTPUT EXTACT=YES HELP='FLD/CLG'.Image Catalog
:LISTCOL VAR=CLGSTS USAGE=OUTPUT HELP='FLD/CLGSTS'.Status
:LISTCOL VAR=CLGTYPE USAGE=OUTPUT HELP='FLD/CLGTYPE'.Type
:LISTCOL VAR=CLGASP USAGE=OUTPUT HELP='FLD/CLGASP'.ASP Threshold
:LISTCOL VAR=CLGDEV USAGE=OUTPUT HELP='FLD/CLGDEV'.Device
:LISTCOL VAR=DEVSTS USAGE=OUTPUT HELP='FLD/DEVSTS'.Device Status
:ELIST.
:EPANEL.
:PANEL NAME=WRKIMGCLG2 KEYL=CLGKEYS HELP=WRKIMGCLG ENTER='RETURN 1' TOPSEP=SYSNAM BOTSEP=NONE.Work with Image Catalogs
:TOPINST.Type options, press Enter.
:LIST DEPTH='*' LISTDEF=CLGS EXTACT=YES.(No image catalogs)
:LISTACT OPTION=1 ACTFOR=EXTACT ENTER='CMD ?CRTIMGCLG IMGCLG(&CLG.)' HELP='WRKIMGCLG2/OPTIONS'.1=Create
:LISTACT OPTION=2 ACTFOR=LISTE ENTER='RETURN 2' HELP='WRKIMGCLG2/OPTIONS'.2=Change
:LISTACT OPTION=4 ACTFOR=LISTE ENTER='CMD DLTIMGCLG IMGCLG(&CLG.)' HELP='WRKIMGCLG2/OPTIONS'.4=Delete
:LISTACT OPTION=8 ACTFOR=LISTE ENTER='CMD ?LODIMGCLG IMGCLG(&CLG.) OPTION(*LOAD)' HELP='WRKIMGCLG2/OPTIONS'.8=Load
:LISTACT OPTION=9 ACTFOR=LISTE ENTER='CMD LODIMGCLG IMGCLG(&CLG.) OPTION(*UNLOAD)' HELP='WRKIMGCLG2/OPTIONS'.9=Unload
:LISTACT OPTION=10 ACTFOR=LISTE ENTER='CMD ?VFYIMGCLG IMGCLG(&CLG.)' HELP='WRKIMGCLG2/OPTIONS'.10=Verify
:LISTACT OPTION=12 ACTFOR=LISTE ENTER='RETURN 12' HELP='WRKIMGCLG2/OPTIONS'.12=Work with entries
:LISTCOL VAR=OPT USAGE=INPUT HELP='WRKIMGCLG2/OPT'.Opt
:LISTCOL VAR=CLG USAGE=OUTPUT EXTACT=YES HELP='FLD/CLG'.Image Catalog
:LISTCOL VAR=CLGTEXT USAGE=OUTPUT HELP='FLD/CLGTEXT'.Text
:ELIST.
:EPANEL.
:PANEL NAME=WRKIMGCLGE KEYL=ENTKEYS HELP=WRKIMGCLGE ENTER='RETURN 1' TOPSEP=SYSNAM BOTSEP=NONE.Work with Image Catalog Entries
:DATA DEPTH=4.
:DATACOL WIDTH=14.
:DATACOL WIDTH=41.
:DATAI VAR=CLG USAGE=OUTPUT HELP='FLD/CLG'.Catalog
:DATAI VAR=CLGTYPE USAGE=OUTPUT HELP='FLD/CLGTYPE'.Type
:DATAI VAR=CLGDIR USAGE=OUTPUT HELP='FLD/CLGDIR'.Directory
:DATACOL WIDTH=14.
:DATACOL WIDTH=78.
:DATAI VAR=CLGSTS USAGE=OUTPUT HELP='FLD/CLGSTS'.Status
:DATAI VAR=CLGDEV USAGE=OUTPUT HELP='FLD/CLGDEV'.Device
:EDATA.
:TOPINST.Type options, press Enter.
:LIST DEPTH='*' LISTDEF=ENTS EXTACT=YES.(No entries)
:LISTACT OPTION=1 ACTFOR=EXTACT ENTER='CMD ?ADDIMGCLGE IMGCLG(&CLG.) IMGCLGIDX(&IDX.)' HELP='WRKIMGCLGE/OPTIONS'.1=Add
:LISTACT OPTION=2 ACTFOR=LISTE ENTER='CMD ?CHGIMGCLGE IMGCLG(&CLG.) IMGCLGIDX(&IDX.)' HELP='WRKIMGCLGE/OPTIONS'.2=Change    
:LISTACT OPTION=4 ACTFOR=LISTE ENTER='CMD RMVIMGCLGE IMGCLG(&CLG.) IMGCLGIDX(&IDX.)' HELP='WRKIMGCLGE/OPTIONS'.4=Remove
:LISTACT OPTION=6 ACTFOR=LISTE ENTER='CMD LODIMGCLGE IMGCLG(&CLG.) IMGCLGIDX(&IDX.) OPTION(*MOUNT)' HELP='WRKIMGCLGE/OPTIONS'.6=Mount
:LISTACT OPTION=8 ACTFOR=LISTE ENTER='CMD LODIMGCLGE IMGCLG(&CLG.) IMGCLGIDX(&IDX.) OPTION(*LOAD)' HELP='WRKIMGCLGE/OPTIONS'.8=Load
:LISTACT OPTION=9 ACTFOR=LISTE ENTER='CMD LODIMGCLGE IMGCLG(&CLG.) IMGCLGIDX(&IDX.) OPTION(*UNLOAD)' HELP='WRKIMGCLGE/OPTIONS'.9=Unload 
:LISTACT OPTION=10 ACTFOR=LISTE ENTER='RETURN 10' HELP='WRKIMGCLGE/OPTIONS'.10=Initialize volume
:LISTACT OPTION=12 ACTFOR=LISTE ENTER='RETURN 12' HELP='WRKIMGCLGE/OPTIONS'.12=Work with volume
:LISTCOL VAR=OPT USAGE=INPUT HELP='WRKIMGCLGE/OPT'.Opt
:LISTCOL VAR=IDX USAGE=OUTPUT EXTACT=YES HELP='FLD/IDX'.Index
:LISTCOL VAR=ENTSTS USAGE=OUTPUT HELP='FLD/ENTSTS'.Status
:LISTCOL VAR=IMGFILE USAGE=OUTPUT HELP='FLD/IMGFILE'.Image File Name
:ELIST.
:EPANEL.
:PANEL NAME=WRKTAPCTG KEYL=CTGKEYS HELP=WRKTAPCTG ENTER='RETURN 1' TOPSEP=SYSNAM.Work with Tape Cartridges
:DATA DEPTH=1.
:DATAI VAR=MLBDEV USAGE=OUTPUT HELP='FLD/MLBDEV'.Library device
:EDATA.
:TOPINST.Type options, press Enter.
:LIST DEPTH='*' LISTDEF=CTGS.(No cartridges)
:LISTACT OPTION=1 ENTER='CMD ?ADDTAPCTG DEV(&MLBDEV.) CTG(&CTG.)' HELP='WRKTAPCTG/OPTIONS'.1=Add
:LISTACT OPTION=2 ENTER='CMD ?CHGTAPCTG DEV(&MLBDEV.) CTG(&CTG.)' HELP='WRKTAPCTG/OPTIONS'.2=Change
:LISTACT OPTION=4 ENTER='CMD RMVTAPCTG DEV(&MLBDEV.) CTG(&CTG.)' HELP='WRKTAPCTG/OPTIONS'.4=Remove
:LISTACT OPTION=5 ENTER='CMD DSPTAPCTG DEV(&MLBDEV.) CTG(&CTG.)' HELP='WRKTAPCTG/OPTIONS'.5=Display
:LISTACT OPTION=6 ENTER='RETURN 6' HELP='WRKTAPCTG/OPTIONS'.6=Mount
:LISTACT OPTION=8 ENTER='RETURN 8' HELP='WRKTAPCTG/OPTIONS'.8=Demount
:LISTCOL VAR=OPT USAGE=INPUT HELP='WRKTAPCTG/OPT'.Opt
:LISTCOL VAR=CTG USAGE=OUTPUT HELP='FLD/CTG'.Cartridge ID
:LISTCOL VAR=CTGVOL USAGE=OUTPUT HELP='FLD/CTGVOL'.Volume ID
:LISTCOL VAR=CTGCGY USAGE=OUTPUT HELP='FLD/CTGCGY'.Category
:LISTCOL VAR=CTGSTS USAGE=OUTPUT HELP='FLD/CTGSTS'.Status
:LISTCOL VAR=CTGLOC USAGE=OUTPUT HELP='FLD/CTGLOC'.Location
:ELIST.
:EPANEL.
:PANEL NAME=WRKMLBSTS KEYL=MLBKEYS HELP=WRKMLBSTS ENTER='RETURN 1' TOPSEP=SYSNAM BOTSEP=NONE.Work with Media Library Status
:TOPINST.Type options, press Enter.
:LIST DEPTH='*' LISTDEF=RSRCS.(No media libraries)
:LISTACT OPTION=1 ENTER='CMD VRYCFG CFGOBJ(&RSRCLIB.) CFGTYPE(*DEV) STATUS(*ON)' HELP='WRKMLBSTS/OPTIONS'.1=Vary on
:LISTACT OPTION=2 ENTER='CMD VRYCFG CFGOBJ(&RSRCLIB.) CFGTYPE(*DEV) STATUS(*OFF)' HELP='WRKMLBSTS/OPTIONS'.2=Vary off
:LISTACT OPTION=3 ENTER='RETURN 3' HELP='WRKMLBSTS/OPTIONS'.3=Reset resource    
:LISTACT OPTION=4 ENTER='RETURN 4' HELP='WRKMLBSTS/OPTIONS'.4=Allocate resource
:LISTACT OPTION=5 ENTER='RETURN 5' HELP='WRKMLBSTS/OPTIONS'.5=Allocate unprotected
:LISTACT OPTION=6 ENTER='RETURN 6' HELP='WRKMLBSTS/OPTIONS'.6=Deallocate resource
:LISTACT OPTION=8 ENTER='CMD WRKDEVD DEVD(&RSRCLIB.)' HELP='WRKMLBSTS/OPTIONS'.8=Work with description
:LISTCOL VAR=OPT USAGE=INPUT HELP='WRKMLBSTS/OPT'.Opt
:LISTCOL VAR=RSRC USAGE=OUTPUT ATCOL=7 HELP='FLD/RSRC'. Device/    Resource
:LISTCOL VAR=RSRCSTS USAGE=OUTPUT ATCOL=23 HELP='FLD/RSRCSTS'.Status
:LISTCOL VAR=ALLOC USAGE=OUTPUT ATCOL=46 HELP='FLD/ALLOC'.Allocation
:LISTCOL VAR=RSRCJOB USAGE=OUTPUT ATCOL=69 HELP='FLD/RSRCJOB'.Job         name       
:ELIST.
:CMDLINE SIZE=SHORT.Parameters or command
:EPANEL.
:PANEL NAME=DSPTAP KEYL=LBLKEYS HELP=DSPTAP ENTER='RETURN 0' TOPSEP=SPACE.Display Tape Volume Information
:DATA DEPTH=5.
:DATACOL WIDTH=20.
:DATACOL WIDTH=41.
:DATAI VAR=DEV USAGE=OUTPUT HELP='FLD/DEV'.Device
:DATAI VAR=OWNER USAGE=OUTPUT HELP='FLD/OWNER'.Owner ID
:DATAI VAR=VOLTYPE USAGE=OUTPUT HELP='FLD/VOLTYPE'.Type
:DATACOL WIDTH=20.
:DATACOL WIDTH=37.
:DATAI VAR=VOLID USAGE=OUTPUT HELP='FLD/VOLID'.Volume ID
:DATAI VAR=DENS USAGE=OUTPUT HELP='FLD/DENS'.Density
:DATAI VAR=CODE USAGE=OUTPUT HELP='FLD/CODE'.Code
:EDATA.
:DATA DEPTH=11 SCROLL=IND.
:DATACOL WIDTH=36.
:DATACOL WIDTH=78.
:DATAI VAR=FLABEL USAGE=OUTPUT HELP='FLD/FLABEL'.Data file label
:DATAI VAR=FSEQ USAGE=OUTPUT HELP='FLD/FSEQ'.File sequence
:DATAC.
:DATAI VAR=RECFMT USAGE=OUTPUT HELP='FLD/RECFMT'.Record format
:DATAI VAR=BLKATR USAGE=OUTPUT HELP='FLD/BLKATR'.Block attribute
:DATAI VAR=RECLEN USAGE=OUTPUT HELP='FLD/RECLEN'.Record length
:DATAI VAR=BLKLEN USAGE=OUTPUT HELP='FLD/BLKLEN'.Block length
:DATAI VAR=FLEN USAGE=OUTPUT HELP='FLD/FLEN'.File length
:DATAI VAR=BUFOFF USAGE=OUTPUT HELP='FLD/BUFOFF'.Buffer offset
:DATAI VAR=CTLCHR USAGE=OUTPUT HELP='FLD/CTLCHR'.Control character
:DATAI VAR=MVIND USAGE=OUTPUT HELP='FLD/MVIND'.Multivolume indicator
:DATAI VAR=FVSEQ USAGE=OUTPUT HELP='FLD/FVSEQ'.Multivolume sequence
:DATAC.
:DATAI VAR=FCRT USAGE=OUTPUT HELP='FLD/FCRT'.Date created
:DATAI VAR=FEXP USAGE=OUTPUT HELP='FLD/FEXP'.Expiration date
:DATAC.
:DATAI VAR=FILTYP USAGE=OUTPUT HELP='FLD/FILTYP'.File type
:DATAI VAR=CMPACT USAGE=OUTPUT HELP='FLD/CMPACT'.Data compacted
:DATAI VAR=SYSCOD USAGE=OUTPUT HELP='FLD/SYSCOD'.System where created
:EDATA.
:BOTINST.Press Enter to continue.
:EPANEL.

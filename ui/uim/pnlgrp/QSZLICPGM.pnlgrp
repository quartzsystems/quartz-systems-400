:COPYR.(C) COPYRIGHT QUARTZ SYSTEMS 2026.
:CLASS NAME=OPTCL BASETYPE=ACTION.
:ECLASS.
:CLASS NAME=IDCL BASETYPE='CHAR 7'.
:ECLASS.
:CLASS NAME=SHORTCL BASETYPE='CHAR 10'.
:ECLASS.
:CLASS NAME=STSCL BASETYPE='CHAR 11'.
:ECLASS.
:CLASS NAME=RLSCL BASETYPE='CHAR 6'.
:ECLASS.
:CLASS NAME=TEXTCL BASETYPE='CHAR 50'.
:ECLASS.
:CLASS NAME=LINECL BASETYPE='CHAR 76'.
:ECLASS.
:CLASS NAME=DEVCL BASETYPE='CHAR 21'.
:ECLASS.
:CLASS NAME=ONECL BASETYPE='CHAR 1'.
:ECLASS.
:VAR NAME=OPT CLASS=OPTCL.
:VAR NAME=LPID CLASS=IDCL.
:VAR NAME=LPOPT CLASS=SHORTCL.
:VAR NAME=STATUS CLASS=STSCL.
:VAR NAME=LPTEXT CLASS=TEXTCL.
:VAR NAME=LPRLS CLASS=RLSCL.
:VAR NAME=LPTYPE CLASS=SHORTCL.
:VAR NAME=INSDEV CLASS=DEVCL.
:VAR NAME=INSOBJ CLASS=ONECL.
:VAR NAME=INSIPL CLASS=ONECL.
:VAR NAME=PRILNG CLASS=SHORTCL.
:VAR NAME=PRILNGT CLASS=TEXTCL.
:VAR NAME=LNGID CLASS=SHORTCL.
:VAR NAME=LNGTEXT CLASS=TEXTCL.
:VAR NAME=AGRLINE CLASS=LINECL.
:VAR NAME=AGRSTS CLASS=SHORTCL.
:VAR NAME=LICTRM CLASS=RLSCL.
:VAR NAME=LICFTR CLASS=SHORTCL.
:VAR NAME=LICCMP CLASS=SHORTCL.
:VAR NAME=LICLMT CLASS=SHORTCL.
:VAR NAME=LICCNT CLASS=SHORTCL.
:LISTDEF NAME=INSTALLED VARS='LPID LPOPT STATUS LPTEXT LPRLS'.
:LISTDEF NAME=PROGRAMS VARS='OPT LPID LPOPT STATUS LPTEXT LPRLS'.
:LISTDEF NAME=LANGS VARS='OPT LNGID LNGTEXT'.
:LISTDEF NAME=AGRTEXT VARS='AGRLINE'.
:LISTDEF NAME=AGRS VARS='OPT LPID LPRLS AGRSTS LPTEXT'.
:LISTDEF NAME=LICS VARS='OPT LPID LICTRM LICFTR LICCMP LICLMT LICCNT'.
:KEYL NAME=DSPKEYS HELP='KEYS/DSPKEYS'.
:KEYI KEY=ENTER ACTION=ENTER.
:KEYI KEY=HELP ACTION=HELP.
:KEYI KEY=F1 ACTION=HELP.
:KEYI KEY=F3 ACTION=EXIT.F3=Exit

.*
.* WRKJOB and DSPJOB: the job menus and the displays their options
.* show (status, definition and run attributes, spooled files, the job
.* log, the call stack, the library list, the open files). DSPJOBLOG
.* shows the job log panels too.
:PNLGRP.
:CLASS NAME=OPTCL BASETYPE=ACTION.
:ECLASS.
:CLASS NAME=NAMECL BASETYPE='CHAR 10'.
:ECLASS.
:CLASS NAME=NBRCL BASETYPE='CHAR 6'.
:ECLASS.
:CLASS NAME=VALCL BASETYPE='CHAR 20'.
:ECLASS.
:CLASS NAME=SHORTCL BASETYPE='CHAR 8'.
:ECLASS.
:CLASS NAME=TEXTCL BASETYPE='CHAR 50'.
:ECLASS.
:CLASS NAME=LINECL BASETYPE='CHAR 78'.
:ECLASS.
:CLASS NAME=FLAGCL BASETYPE='CHAR 1'.
:ECLASS.
:CLASS NAME=STSCL BASETYPE='CHAR 6'.
:ECLASS.
:CLASS NAME=TYPECL BASETYPE='CHAR 4'.
:ECLASS.
:CLASS NAME=PAGECL BASETYPE='ZONED 4 0'.
:ECLASS.
:CLASS NAME=CURPCL BASETYPE='ZONED 6 0'.
:ECLASS.
:CLASS NAME=COPYCL BASETYPE='ZONED 5 0'.
:ECLASS.
:CLASS NAME=STMTCL BASETYPE='CHAR 9'.
:ECLASS.
:CLASS NAME=AGCL BASETYPE='CHAR 30'.
:ECLASS.
.* The job and the menus.
:VAR NAME=JOB CLASS=NAMECL.
:VAR NAME=USER CLASS=NAMECL.
:VAR NAME=NUMBER CLASS=NBRCL.
:VAR NAME=JOBHDR CLASS=LINECL.
:VAR NAME=CANCHG CLASS=FLAGCL VALUE='N'.
.* Status attributes.
:VAR NAME=STATUS CLASS=VALCL.
:VAR NAME=CURUSER CLASS=NAMECL.
:VAR NAME=IDENTITY CLASS=NAMECL.
:VAR NAME=SETBY CLASS=VALCL.
:VAR NAME=ENTDATE CLASS=SHORTCL.
:VAR NAME=ENTTIME CLASS=SHORTCL.
:VAR NAME=STRDATE CLASS=SHORTCL.
:VAR NAME=STRTIME CLASS=SHORTCL.
:VAR NAME=SBS CLASS=NAMECL.
:VAR NAME=SBSPOOL CLASS=VALCL.
:VAR NAME=TYPE CLASS=VALCL.
:VAR NAME=SPCENV CLASS=VALCL.
:VAR NAME=RTNCODE CLASS=VALCL.
:VAR NAME=CNTRLD CLASS=VALCL.
:VAR NAME=SYSPOOL CLASS=VALCL.
:VAR NAME=CPUMS CLASS=VALCL.
:VAR NAME=AUXIO CLASS=VALCL.
.* Definition attributes.
:VAR NAME=JOBD CLASS=NAMECL.
:VAR NAME=JOBDLIB CLASS=NAMECL.
:VAR NAME=JOBQ CLASS=NAMECL.
:VAR NAME=JOBQLIB CLASS=NAMECL.
:VAR NAME=JOBPTY CLASS=VALCL.
:VAR NAME=OUTPTY CLASS=VALCL.
:VAR NAME=ENDSEV CLASS=VALCL.
:VAR NAME=LOGLVL CLASS=VALCL.
:VAR NAME=LOGSEV CLASS=VALCL.
:VAR NAME=LOGTXT CLASS=VALCL.
:VAR NAME=LOGCLPGM CLASS=VALCL.
:VAR NAME=LOGOUT CLASS=VALCL.
:VAR NAME=PRTDEV CLASS=NAMECL.
:VAR NAME=OUTQ CLASS=NAMECL.
:VAR NAME=OUTQLIB CLASS=NAMECL.
:VAR NAME=PRTTXT CLASS=TEXTCL.
:VAR NAME=DATFMT CLASS=VALCL.
:VAR NAME=DATSEP CLASS=VALCL.
:VAR NAME=TIMSEP CLASS=VALCL.
:VAR NAME=DECFMT CLASS=VALCL.
:VAR NAME=SWS CLASS=VALCL.
:VAR NAME=INQMSG CLASS=VALCL.
:VAR NAME=BRKMSG CLASS=VALCL.
:VAR NAME=STSMSG CLASS=VALCL.
:VAR NAME=DEVRCY CLASS=VALCL.
:VAR NAME=CCSID CLASS=VALCL.
:VAR NAME=DFTCCSID CLASS=VALCL.
:VAR NAME=LANGID CLASS=VALCL.
:VAR NAME=CNTRYID CLASS=VALCL.
:VAR NAME=SRTSEQ CLASS=VALCL.
:VAR NAME=MSGQMX CLASS=VALCL.
:VAR NAME=MSGQFL CLASS=VALCL.
:VAR NAME=ALWMLT CLASS=VALCL.
:VAR NAME=SPLFACN CLASS=VALCL.
.* Run attributes.
:VAR NAME=RUNPTY CLASS=VALCL.
:VAR NAME=TIMESLICE CLASS=VALCL.
:VAR NAME=PURGE CLASS=VALCL.
:VAR NAME=DFTWAIT CLASS=VALCL.
:VAR NAME=CPUTIME CLASS=VALCL.
:VAR NAME=CPUUSED CLASS=VALCL.
:VAR NAME=MAXTMP CLASS=VALCL.
:VAR NAME=TMPUSED CLASS=VALCL.
:VAR NAME=TMPPEAK CLASS=VALCL.
:VAR NAME=MAXTHD CLASS=VALCL.
:VAR NAME=THREADS CLASS=VALCL.
:VAR NAME=AFFGRP CLASS=VALCL.
:VAR NAME=AFFLVL CLASS=VALCL.
:VAR NAME=RSCAFF CLASS=VALCL.
:VAR NAME=CPUTHD CLASS=VALCL.
.* The lists.
:VAR NAME=OPT CLASS=OPTCL.
:VAR NAME=FILE CLASS=NAMECL.
:VAR NAME=DEVQ CLASS=NAMECL.
:VAR NAME=USRDTA CLASS=NAMECL.
:VAR NAME=SPLSTS CLASS=STSCL.
:VAR NAME=PAGES CLASS=PAGECL.
:VAR NAME=CURPAGE CLASS=CURPCL.
:VAR NAME=COPIES CLASS=COPYCL.
:VAR NAME=SPLNBR CLASS=NBRCL.
:VAR NAME=MSGLINE CLASS=LINECL.
:VAR NAME=THREAD CLASS=SHORTCL.
:VAR NAME=RQSLVL CLASS=TYPECL.
:VAR NAME=PGM CLASS=NAMECL.
:VAR NAME=PGMLIB CLASS=NAMECL.
:VAR NAME=STMT CLASS=STMTCL.
:VAR NAME=PROC CLASS=AGCL.
:VAR NAME=LIB CLASS=NAMECL.
:VAR NAME=LIBTYPE CLASS=SHORTCL.
:VAR NAME=ASPDEV CLASS=NAMECL.
:VAR NAME=LIBTEXT CLASS=TEXTCL.
:VAR NAME=ODPS CLASS=VALCL.
:VAR NAME=OFILE CLASS=NAMECL.
:VAR NAME=OLIB CLASS=NAMECL.
:VAR NAME=OMBR CLASS=NAMECL.
:VAR NAME=OSCOPE CLASS=NAMECL.
:VAR NAME=OACTGRP CLASS=AGCL.
:LISTDEF NAME=SPLF VARS='OPT FILE DEVQ USRDTA SPLSTS PAGES CURPAGE COPIES SPLNBR'.
:LISTDEF NAME=MSGS VARS='MSGLINE'.
:LISTDEF NAME=STACK VARS='RQSLVL PGM PGMLIB STMT PROC'.
:LISTDEF NAME=LIBL VARS='OPT LIB LIBTYPE ASPDEV LIBTEXT'.
:LISTDEF NAME=OPNF VARS='OFILE OLIB OMBR OSCOPE OACTGRP'.
:COND NAME=CHANGE EXPR='&CANCHG. EQ "Y"'.
.* Keys.
:KEYL NAME=WJKEYS.
:KEYI KEY=ENTER ACTION=ENTER.
:KEYI KEY=HELP ACTION=HELP.
:KEYI KEY=PAGEUP ACTION=PAGEUP.
:KEYI KEY=PAGEDOWN ACTION=PAGEDOWN.
:KEYI KEY=F3 ACTION=EXIT.F3=Exit
:KEYI KEY=F4 ACTION='RETURN 4'.F4=Prompt
:KEYI KEY=F9 ACTION=RETRIEVE.F9=Retrieve
:KEYI KEY=F12 ACTION=CANCEL.F12=Cancel
:EKEYL.
:KEYL NAME=DJKEYS.
:KEYI KEY=ENTER ACTION=ENTER.
:KEYI KEY=HELP ACTION=HELP.
:KEYI KEY=PAGEUP ACTION=PAGEUP.
:KEYI KEY=PAGEDOWN ACTION=PAGEDOWN.
:KEYI KEY=F3 ACTION=EXIT.F3=Exit
:KEYI KEY=F12 ACTION=CANCEL.F12=Cancel
:EKEYL.
:KEYL NAME=ATTRKEYS.
:KEYI KEY=ENTER ACTION=ENTER.
:KEYI KEY=HELP ACTION=HELP.
:KEYI KEY=PAGEUP ACTION=PAGEUP.
:KEYI KEY=PAGEDOWN ACTION=PAGEDOWN.
:KEYI KEY=F3 ACTION=EXIT.F3=Exit
:KEYI KEY=F5 ACTION='RETURN 5'.F5=Refresh
:KEYI KEY=F9 ACTION='RETURN 9' COND=CHANGE.F9=Change job
:KEYI KEY=F12 ACTION=CANCEL.F12=Cancel
:KEYI KEY=F16 ACTION='RETURN 16'.F16=Job menu
:EKEYL.
:KEYL NAME=SPLFKEYS.
:KEYI KEY=ENTER ACTION=ENTER.
:KEYI KEY=HELP ACTION=HELP.
:KEYI KEY=PAGEUP ACTION=PAGEUP.
:KEYI KEY=PAGEDOWN ACTION=PAGEDOWN.
:KEYI KEY=F3 ACTION=EXIT.F3=Exit
:KEYI KEY=F10 ACTION='RETURN 10'.F10=View 3
:KEYI KEY=F11 ACTION='RETURN 11'.F11=View 2
:KEYI KEY=F12 ACTION=CANCEL.F12=Cancel
:KEYI KEY=F22 ACTION='CMD WRKWTR'.F22=Printers
:KEYI KEY=F24 ACTION=MOREKEYS.F24=More keys
:KEYI KEY=F4 ACTION='RETURN 4'.F4=Prompt
:KEYI KEY=F5 ACTION='RETURN 5'.F5=Refresh
:KEYI KEY=F9 ACTION=RETRIEVE.F9=Retrieve
:KEYI KEY=F16 ACTION='RETURN 16'.F16=Job menu
:EKEYL.
:KEYL NAME=LOGKEYS.
:KEYI KEY=ENTER ACTION=ENTER.
:KEYI KEY=HELP ACTION=HELP.
:KEYI KEY=PAGEUP ACTION=PAGEUP.
:KEYI KEY=PAGEDOWN ACTION=PAGEDOWN.
:KEYI KEY=F3 ACTION=EXIT.F3=Exit
:KEYI KEY=F5 ACTION='RETURN 5'.F5=Refresh
:KEYI KEY=F10 ACTION='RETURN 10'.F10=Display detailed messages
:KEYI KEY=F12 ACTION=CANCEL.F12=Cancel
:KEYI KEY=F16 ACTION='RETURN 16' COND=CHANGE.F16=Job menu
:KEYI KEY=F17 ACTION=TOP COND=NOTCHG.F17=Top
:KEYI KEY=F18 ACTION=BOTTOM COND=NOTCHG.F18=Bottom
:KEYI KEY=F24 ACTION=MOREKEYS COND=CHANGE.F24=More keys
:KEYI KEY=F17 ACTION=TOP COND=CHANGE.F17=Top
:KEYI KEY=F18 ACTION=BOTTOM COND=CHANGE.F18=Bottom
:EKEYL.
:KEYL NAME=ALLKEYS.
:KEYI KEY=ENTER ACTION=ENTER.
:KEYI KEY=HELP ACTION=HELP.
:KEYI KEY=PAGEUP ACTION=PAGEUP.
:KEYI KEY=PAGEDOWN ACTION=PAGEDOWN.
:KEYI KEY=F3 ACTION=EXIT.F3=Exit
:KEYI KEY=F5 ACTION='RETURN 5'.F5=Refresh
:KEYI KEY=F12 ACTION=CANCEL.F12=Cancel
:KEYI KEY=F16 ACTION='RETURN 16' COND=CHANGE.F16=Job menu
:KEYI KEY=F17 ACTION=TOP.F17=Top
:KEYI KEY=F18 ACTION=BOTTOM.F18=Bottom
:EKEYL.
:KEYL NAME=STKKEYS.
:KEYI KEY=ENTER ACTION=ENTER.
:KEYI KEY=HELP ACTION=HELP.
:KEYI KEY=PAGEUP ACTION=PAGEUP.
:KEYI KEY=PAGEDOWN ACTION=PAGEDOWN.
:KEYI KEY=F3 ACTION=EXIT.F3=Exit
:KEYI KEY=F5 ACTION='RETURN 5'.F5=Refresh
:KEYI KEY=F11 ACTION='RETURN 11'.F11=Display activation group

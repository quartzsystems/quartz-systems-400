.* QUICFG: WRKCFGSTS (lines, controllers and devices with what hangs
.* off each, indented by the driver) and DSPDEVD.
:PNLGRP.
:COPYR.(C) COPYRIGHT QUARTZ SYSTEMS 2026.
:CLASS NAME=NAMECL BASETYPE='CHAR 10'.
:ECLASS.
:CLASS NAME=DVCL BASETYPE='CHAR 30'.
:ECLASS.
:CLASS NAME=DESCCL BASETYPE='CHAR 16'.
:ECLASS.
:CLASS NAME=HINTCL BASETYPE='CHAR 19'.
:ECLASS.
:CLASS NAME=STSCL BASETYPE='CHAR 20'.
:ECLASS.
:CLASS NAME=JOBCL BASETYPE='CHAR 30'.
:ECLASS.
:CLASS NAME=TEXTCL BASETYPE='CHAR 50'.
:ECLASS.
:CLASS NAME=OPTCL BASETYPE=ACTION.
:ECLASS.
:VAR NAME=POSTO CLASS=NAMECL.
:VAR NAME=POSHINT CLASS=HINTCL VALUE='Starting characters'.
:VAR NAME=OPT CLASS=OPTCL.
:VAR NAME=CFNAME CLASS=DESCCL.
:VAR NAME=CFOBJ CLASS=NAMECL.
:VAR NAME=CFSTS CLASS=STSCL.
:VAR NAME=CFJOB CLASS=JOBCL.
:VAR NAME=CFTYPE CLASS=NAMECL.
:VAR NAME=DVNAME CLASS=DVCL.
:VAR NAME=DVCLS CLASS=DVCL.
:VAR NAME=DVTYPE CLASS=DVCL.
:VAR NAME=DVMODEL CLASS=DVCL.
:VAR NAME=DVONLINE CLASS=DVCL.
:VAR NAME=DVSTATUS CLASS=STSCL.
:VAR NAME=DVCTL CLASS=DVCL.
:VAR NAME=DVKBD CLASS=DVCL.
:VAR NAME=DVMSGQ CLASS=DVCL.
:VAR NAME=DVMSGQL CLASS=DVCL.
:VAR NAME=DVOUTQ CLASS=DVCL.
:VAR NAME=DVOUTQL CLASS=DVCL.
:VAR NAME=DVTEXT CLASS=TEXTCL.
:VAR NAME=DVOPTION CLASS=DVCL VALUE='*BASIC'.
:VAR NAME=DVCAT CLASS=DVCL.
:VAR NAME=DVEMLDEV CLASS=DVCL.
:VAR NAME=DVPRTDEV CLASS=DVCL VALUE='*SYSVAL'.
:VAR NAME=DVPRTF CLASS=DVCL VALUE='QSYSPRT'.
:VAR NAME=DVPRTFL CLASS=DVCL VALUE='*LIBL'.
:VAR NAME=DVLOCNAM CLASS=DVCL VALUE='*NONE'.
:VAR NAME=DVVIEW CLASS=NAMECL VALUE='1'.
:COND NAME=DEVTEXT EXPR='&DVVIEW. EQ "1"'.
:COND NAME=DEVKWD EXPR='&DVVIEW. EQ "2"'.
:COND NAME=DEVROWS EXPR='&DVVIEW. EQ "X"'.
:LISTDEF NAME=CFGS VARS='OPT CFNAME CFOBJ CFSTS CFJOB CFTYPE'.
:VAR NAME=KEYSET CLASS=NAMECL VALUE='1'.
:COND NAME=KEYS1 EXPR='&KEYSET. EQ "1"'.
:COND NAME=KEYS2 EXPR='&KEYSET. EQ "2"'.
.* Two sets of keys the driver switches with F24, as the condition
.* KEYSET says; the area keeps its two rows.
:KEYL NAME=WRKKEYS HELP=KEYSHLP.
:KEYI KEY=ENTER ACTION=ENTER.
:KEYI KEY=HELP ACTION=HELP.
:KEYI KEY=F1 ACTION=HELP.
:KEYI KEY=F3 ACTION=EXIT COND=KEYS1.F3=Exit
:KEYI KEY=F4 ACTION='RETURN 4' COND=KEYS1.F4=Prompt
:KEYI KEY=F12 ACTION=CANCEL COND=KEYS1.F12=Cancel
:KEYI KEY=F23 ACTION='RETURN 23' COND=KEYS1.F23=More options
:KEYI KEY=F5 ACTION='RETURN 5' COND=KEYS2.F5=Refresh
:KEYI KEY=F9 ACTION=RETRIEVE COND=KEYS2.F9=Retrieve
:KEYI KEY=F11 ACTION='RETURN 11' COND=KEYS2.F11=Display types
:KEYI KEY=F14 ACTION='RETURN 14' COND=KEYS2.F14=Work with lines
:KEYI KEY=F24 ACTION='RETURN 24'.F24=More keys
:KEYI KEY=PAGEUP ACTION=PAGEUP.
:KEYI KEY=PAGEDOWN ACTION=PAGEDOWN.
:EKEYL.
:KEYL NAME=DEVKEYS HELP='KEYS/DEVKEYS'.
:KEYI KEY=ENTER ACTION=ENTER.
:KEYI KEY=HELP ACTION=HELP.
:KEYI KEY=F1 ACTION=HELP.
:KEYI KEY=F3 ACTION=EXIT.F3=Exit
:KEYI KEY=F11 ACTION='RETURN 11' COND=DEVTEXT.F11=Display keywords
:KEYI KEY=F11 ACTION='RETURN 11' COND=DEVKWD.F11=Nondisplay keywords
.* Never shown: it holds the second key row the system keeps here.
:KEYI KEY=F11 ACTION='RETURN 11' COND=DEVROWS.F11=Display keywords
:KEYI KEY=F12 ACTION=CANCEL.F12=Cancel
:KEYI KEY=PAGEUP ACTION=PAGEUP.
:KEYI KEY=PAGEDOWN ACTION=PAGEDOWN.
:EKEYL.
:KEYL NAME=DSPKEYS.
:KEYI KEY=ENTER ACTION=ENTER.
:KEYI KEY=HELP ACTION=HELP.
:KEYI KEY=F1 ACTION=HELP.
:KEYI KEY=F3 ACTION=EXIT.F3=Exit
:KEYI KEY=F12 ACTION=CANCEL.F12=Cancel
:EKEYL.
:PANEL NAME=WRKCFGSTS HELP=HLPCFG KEYL=WRKKEYS ENTER='RETURN 0' TOPSEP=DATETIME.Work with Configuration Status
:DATA DEPTH=2.
:DATACOL WIDTH=22.
:DATACOL WIDTH=78.
:DATAI VAR=POSTO USAGE=INPUT HELP='FLD/POSTO'.Position to
:DATAIX VAR=POSHINT USAGE=OUTPUT.
:EDATA.
:TOPINST.Type options, press Enter.
:LIST DEPTH='*' LISTDEF=CFGS VIEWS=2 SCROLL=YES.(No configuration descriptions)
:LISTACT OPTION=1 ENTER='CMD VRYCFG CFGOBJ(&CFOBJ.) CFGTYPE(&CFTYPE.) STATUS(*ON)' HELP='WRKCFGSTS/OPTIONS'.1=Vary on
:LISTACT OPTION=2 ENTER='CMD VRYCFG CFGOBJ(&CFOBJ.) CFGTYPE(&CFTYPE.) STATUS(*OFF)' HELP='WRKCFGSTS/OPTIONS'.2=Vary off
:LISTACT OPTION=5 ENTER='RETURN 105' HELP='WRKCFGSTS/OPTIONS'.5=Work with job
:LISTACT OPTION=8 ENTER='RETURN 108' HELP='WRKCFGSTS/OPTIONS'.8=Work with description
:LISTACT OPTION=9 ENTER='RETURN 109' HELP='WRKCFGSTS/OPTIONS'.9=Display mode status
:LISTACT OPTION=13 ENTER='RETURN 113' HELP='WRKCFGSTS/OPTIONS'.13=Work with APPN status...
:LISTCOL VAR=OPT USAGE=INPUT HELP='WRKCFGSTS/OPT'.Opt
:LISTCOL VAR=CFNAME USAGE=OUTPUT HELP='FLD/CFNAME'.Description
:LISTCOL VAR=CFSTS USAGE=OUTPUT HELP='FLD/CFSTS'.Status
:LISTCOL VAR=CFJOB USAGE=OUTPUT HELP='FLD/CFJOB'.-------------Job--------------
:LISTCOL VAR=CFTYPE USAGE=OUTPUT HELP='FLD/CFTYPE'.Type
:LISTVIEW COLS='OPT CFNAME CFSTS CFJOB'.
:LISTVIEW COLS='OPT CFNAME CFSTS CFTYPE'.
:ELIST.
:CMDLINE SIZE=SHORT.Parameters or command
:EPANEL.
:PANEL NAME=DSPDEVD HELP=HLPDEVD KEYL=DEVKEYS TOPSEP=DATETIME.Display Device Description
:DATA DEPTH='*' SCROLL=YES.
:DATACOL WIDTH=36.
:DATACOL WIDTH=78.
:DATAI VAR=DVNAME USAGE=OUTPUT HELP='FLD/DVNAME'.Device description
:DATAI VAR=DVOPTION USAGE=OUTPUT HELP='FLD/DVOPTION'.Option
:DATAI VAR=DVCAT USAGE=OUTPUT HELP='FLD/DVCAT'.Category of device
:DATAC.
:DATAI VAR=DVCLS USAGE=OUTPUT HELP='FLD/DVCLS'.Device class
:DATAI VAR=DVTYPE USAGE=OUTPUT HELP='FLD/DVTYPE'.Device type
:DATAI VAR=DVMODEL USAGE=OUTPUT HELP='FLD/DVMODEL'.Device model
:DATAI VAR=DVEMLDEV USAGE=OUTPUT HELP='FLD/DVEMLDEV'.Emulated twinaxial device
:DATAI VAR=DVONLINE USAGE=OUTPUT HELP='FLD/DVONLINE'.Online at IPL
:DATAI VAR=DVCTL USAGE=OUTPUT HELP='FLD/DVCTL'.Attached controller
:DATAI VAR=DVKBD USAGE=OUTPUT HELP='FLD/DVKBD'.Keyboard language type
:DATAI VAR=DVPRTDEV USAGE=OUTPUT HELP='FLD/DVPRTDEV'.Print device
:DATAI VAR=DVOUTQ USAGE=OUTPUT HELP='FLD/DVOUTQ'.Output queue
:DATAI VAR=DVPRTF USAGE=OUTPUT HELP='FLD/DVPRTF'.Printer file
:DATAGRP GRPSEP=NONE.
:DATAI VAR=DVPRTFL USAGE=OUTPUT HELP='FLD/DVPRTFL'.Library
:EDATAGRP.
:DATAI VAR=DVLOCNAM USAGE=OUTPUT HELP='FLD/DVLOCNAM'.Dependent location name
:DATAI VAR=DVMSGQ USAGE=OUTPUT HELP='FLD/DVMSGQ'.Message queue
:DATAGRP GRPSEP=NONE.
:DATAI VAR=DVMSGQL USAGE=OUTPUT HELP='FLD/DVMSGQL'.Library
:EDATAGRP.
:DATAI VAR=DVSTATUS USAGE=OUTPUT HELP='FLD/DVSTATUS'.Status
:DATAI VAR=DVTEXT USAGE=OUTPUT HELP='FLD/DVTEXT'.Text
:EDATA.
:BOTINST.Press Enter to continue
:EPANEL.
:HELP NAME=HLPCFG.Work with Configuration Status - Help
:P.The lines, controllers or devices asked for, each with what is
attached to it indented beneath, and their status. Type 1 to vary one
on, 2 to vary it off, 8 to work with its description, and press Enter.
F11 shows the type of each object instead of its job; F24 shows the
other keys.
:EHELP.
:HELP NAME=KEYSHLP.Function keys - Help
:P.F5 reads the status again, F11 switches between jobs and types,
F14 lists the line descriptions, F9 brings back the last command, F3
and F12 leave.
:EHELP.
:HELP NAME=HLPDEVD.Display Device Description - Help
:P.This display shows a device description: what kind of device it is,
whether it is varied on at IPL and now, and where its messages and
printed output go. CHGDEVD changes it.
:EHELP.
.* Item, key and option help.
:HELP NAME='FLD/POSTO'.Position to
:P.Type the position to.
:EHELP.
:HELP NAME='WRKCFGSTS/OPT'.Option
:P.Type the number of an option next to an entry and press Enter. The
options the list allows are shown above it; F1 on one of them explains
it.
:EHELP.
:HELP NAME='FLD/CFNAME'.Description
:P.The description of each entry in the list.
:EHELP.
:HELP NAME='FLD/CFSTS'.Status
:P.The status of each entry in the list.
:EHELP.
:HELP NAME='FLD/CFJOB'.-------------Job--------------
:P.The -------------Job-------------- of each entry in the list.
:EHELP.
:HELP NAME='FLD/CFTYPE'.Type
:P.The type of each entry in the list.
:EHELP.
:HELP NAME='WRKCFGSTS/OPTIONS'.Options
:P.Type an option number next to one or more entries and press Enter.
The option runs for each entry it is typed next to, in order.
:PARML.
:PT.1=Vary on
:PD.Type 1 next to an entry and press Enter to vary on it. The Vary
Configuration (VRYCFG) command runs for the entry.
:PT.2=Vary off
:PD.Type 2 next to an entry and press Enter to vary off it. The Vary
Configuration (VRYCFG) command runs for the entry.
:PT.5=Work with job
:PD.Type 5 next to an entry and press Enter to work with job it.
:PT.8=Work with description
:PD.Type 8 next to an entry and press Enter to work with description it.
:PT.9=Display mode status
:PD.Type 9 next to an entry and press Enter to display mode status it.
:PT.13=Work with APPN status...
:PD.Type 13 next to an entry and press Enter to work with APPN status...
it.
:EPARML.
:EHELP.
:HELP NAME='KEYS/DEVKEYS'.Function keys
:PARML.
:PT.F3=Exit
:PD.Ends the display and returns to where it was started from.
:PT.F11=Display keywords
:PD.Display keywords.
:PT.F11=Nondisplay keywords
:PD.Nondisplay keywords.
:PT.F11=Display keywords
:PD.Display keywords.
:PT.F12=Cancel
:PD.Returns to the previous display without acting on what was typed.
:EPARML.
:EHELP.
:HELP NAME='FLD/DVNAME'.Device description
:P.The device description.
:EHELP.
:HELP NAME='FLD/DVOPTION'.Option
:P.The option shown for what the display is about.
:EHELP.
:HELP NAME='FLD/DVCAT'.Category of device
:P.The category of device shown for what the display is about.
:EHELP.
:HELP NAME='FLD/DVCLS'.Device class
:P.The device class shown for what the display is about.
:EHELP.
:HELP NAME='FLD/DVTYPE'.Device type
:P.The device type.
:EHELP.
:HELP NAME='FLD/DVMODEL'.Device model
:P.The device model shown for what the display is about.
:EHELP.
:HELP NAME='FLD/DVEMLDEV'.Emulated twinaxial device
:P.The emulated twinaxial device shown for what the display is about.
:EHELP.
:HELP NAME='FLD/DVONLINE'.Online at IPL
:P.Whether the device or line is varied on when the system starts (IPL).
:EHELP.
:HELP NAME='FLD/DVCTL'.Attached controller
:P.The attached controller shown for what the display is about.
:EHELP.
:HELP NAME='FLD/DVKBD'.Keyboard language type
:P.The keyboard language type shown for what the display is about.
:EHELP.
:HELP NAME='FLD/DVPRTDEV'.Print device
:P.The printer device the spooled output prints on.
:EHELP.
:HELP NAME='FLD/DVOUTQ'.Output queue
:P.The output queue the spooled files go to.
:EHELP.
:HELP NAME='FLD/DVPRTF'.Printer file
:P.The printer file shown for what the display is about.
:EHELP.
:HELP NAME='FLD/DVPRTFL'.Library
:P.The library shown for what the display is about.
:EHELP.
:HELP NAME='FLD/DVLOCNAM'.Dependent location name
:P.The dependent location name shown for what the display is about.
:EHELP.
:HELP NAME='FLD/DVMSGQ'.Message queue
:P.The message queue shown for what the display is about.
:EHELP.
:HELP NAME='FLD/DVMSGQL'.Library
:P.The library shown for what the display is about.
:EHELP.
:HELP NAME='FLD/DVSTATUS'.Status
:P.The status shown for what the display is about.
:EHELP.
:HELP NAME='FLD/DVTEXT'.Text
:P.The text shown for what the display is about.
:EHELP.
:EPNLGRP.

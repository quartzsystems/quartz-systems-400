.*
.* WRKJOBQ: every job queue, or the jobs waiting on one.
:PNLGRP.
:CLASS NAME=OPTCL BASETYPE=ACTION.
:ECLASS.
:CLASS NAME=NAMECL BASETYPE='CHAR 10'.
:ECLASS.
:CLASS NAME=NBRCL BASETYPE='CHAR 6'.
:ECLASS.
:CLASS NAME=STSCL BASETYPE='CHAR 4'.
:ECLASS.
:CLASS NAME=CNTCL BASETYPE='ZONED 5 0'.
:ECLASS.
:CLASS NAME=PTYCL BASETYPE='ZONED 1 0'.
:ECLASS.
:VAR NAME=OPT CLASS=OPTCL.
:VAR NAME=QUEUE CLASS=NAMECL.
:VAR NAME=LIB CLASS=NAMECL.
:VAR NAME=JOBS CLASS=CNTCL.
:VAR NAME=SBS CLASS=NAMECL.
:VAR NAME=STATUS CLASS=STSCL.
:VAR NAME=QSTS CLASS=STSCL.
:VAR NAME=JOB CLASS=NAMECL.
:VAR NAME=USER CLASS=NAMECL.
:VAR NAME=NUMBER CLASS=NBRCL.
:VAR NAME=PTY CLASS=PTYCL.
:VAR NAME=JSTS CLASS=STSCL.
:LISTDEF NAME=QUEUES VARS='OPT QUEUE LIB JOBS SBS STATUS'.
:LISTDEF NAME=JOBS VARS='OPT JOB USER NUMBER PTY JSTS'.
:KEYL NAME=JQKEYS.
:KEYI KEY=ENTER ACTION=ENTER.
:KEYI KEY=HELP ACTION=HELP.
:KEYI KEY=PAGEUP ACTION=PAGEUP.
:KEYI KEY=PAGEDOWN ACTION=PAGEDOWN.
:KEYI KEY=F3 ACTION=EXIT.F3=Exit
:KEYI KEY=F4 ACTION='RETURN 4'.F4=Prompt
:KEYI KEY=F5 ACTION='RETURN 5'.F5=Refresh
:KEYI KEY=F9 ACTION=RETRIEVE.F9=Retrieve
:KEYI KEY=F12 ACTION=CANCEL.F12=Cancel
:EKEYL.
:PANEL NAME=QUEUES KEYL=JQKEYS HELP=WRKJOBQ ENTER='RETURN 1' TOPSEP=SYSNAM.Work with All Job Queues
:TOPINST.Type options, press Enter.
:LIST DEPTH='*' LISTDEF=QUEUES.(No job queues)
:LISTACT OPTION=2 ENTER='CMD ?CHGJOBQ JOBQ(&LIB./&QUEUE.)'.2=Change
:LISTACT OPTION=3 ENTER='CMD HLDJOBQ JOBQ(&LIB./&QUEUE.)'.3=Hold
:LISTACT OPTION=4 ENTER='CMD ?DLTJOBQ JOBQ(&LIB./&QUEUE.)'.4=Delete
:LISTACT OPTION=5 ENTER='CMD WRKJOBQ JOBQ(&LIB./&QUEUE.)'.5=Work with
:LISTACT OPTION=6 ENTER='CMD RLSJOBQ JOBQ(&LIB./&QUEUE.)'.6=Release
:LISTACT OPTION=14 ENTER='CMD CLRJOBQ JOBQ(&LIB./&QUEUE.)'.14=Clear
:LISTCOL VAR=OPT USAGE=INPUT.Opt
:LISTCOL VAR=QUEUE USAGE=OUTPUT.Queue
:LISTCOL VAR=LIB USAGE=OUTPUT.Library
:LISTCOL VAR=JOBS USAGE=OUTPUT.Jobs
:LISTCOL VAR=SBS USAGE=OUTPUT.Subsystem
:LISTCOL VAR=STATUS USAGE=OUTPUT.Status
:ELIST.
:CMDLINE SIZE=SHORT.
:EPANEL.
:PANEL NAME=JOBS KEYL=JQKEYS HELP=WRKJOBQ ENTER='RETURN 1' TOPSEP=SYSNAM.Work with Job Queue
:DATA DEPTH=2 COMPACT.
:DATAI VAR=QUEUE USAGE=OUTPUT.Queue
:DATAIX VAR=LIB USAGE=OUTPUT.
:DATAIXT.Library
:DATAIX VAR=QSTS USAGE=OUTPUT.
:DATAIXT.Status
:EDATA.
:TOPINST.Type options, press Enter.
:LIST DEPTH='*' LISTDEF=JOBS.(No jobs on the queue)
:LISTACT OPTION=2 ENTER='CMD ?CHGJOB JOB(&NUMBER./&USER./&JOB.)'.2=Change
:LISTACT OPTION=3 ENTER='CMD HLDJOB JOB(&NUMBER./&USER./&JOB.)'.3=Hold
:LISTACT OPTION=4 ENTER='CMD ?ENDJOB JOB(&NUMBER./&USER./&JOB.)'.4=End
:LISTACT OPTION=5 ENTER='CMD WRKJOB JOB(&NUMBER./&USER./&JOB.)'.5=Work with
:LISTACT OPTION=6 ENTER='CMD RLSJOB JOB(&NUMBER./&USER./&JOB.)'.6=Release
:LISTCOL VAR=OPT USAGE=INPUT.Opt
:LISTCOL VAR=JOB USAGE=OUTPUT.Job
:LISTCOL VAR=USER USAGE=OUTPUT.User
:LISTCOL VAR=NUMBER USAGE=OUTPUT.Number
:LISTCOL VAR=PTY USAGE=OUTPUT.Pty
:LISTCOL VAR=JSTS USAGE=OUTPUT.Status
:ELIST.
:CMDLINE SIZE=SHORT.
:EPANEL.
:HELP NAME=WRKJOBQ.Work with Job Queues - Help
:P.Job queues with the jobs waiting on them and the subsystem that
takes them; option 5 shows a queue's jobs.
:EHELP.
:EPNLGRP.

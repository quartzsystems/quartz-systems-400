.* Imports from IMPORTS_A: a named help module, everything by *, and one it does not export.
:PNLGRP.
:IMPORT NAME=HLPSHARED PNLGRP=QGPL/IMPORTS_A.
:IMPORT NAME=* PNLGRP=IMPORTS_A.
:IMPORT NAME=HLPMISSING PNLGRP=IMPORTS_A.
:CLASS NAME=NAMECL BASETYPE='CHAR 10'.
:ECLASS.
:VAR NAME=NAME CLASS=NAMECL.
:KEYL NAME=KEYS HELP=HLPKEYS.
:KEYI KEY=ENTER ACTION=ENTER.
:KEYI KEY=F3 ACTION=EXIT.F3=Exit
:EKEYL.
:PANEL NAME=SHOW KEYL=KEYS HELP=HLPSHARED.Show a Name
:DATA DEPTH=4.
:DATAI VAR=NAME USAGE=OUTPUT HELP=HLPUNKNOWN.Name
:EDATA.
:EPANEL.
:EPNLGRP.

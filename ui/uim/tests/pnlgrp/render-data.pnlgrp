.* Rendering: data panels with leaders, groups, a compact row, a selection field, two columns.
:PNLGRP.
:CLASS NAME=NAMECL BASETYPE='CHAR 10'.
:ECLASS.
:CLASS NAME=TEXTCL BASETYPE='CHAR 50'.
:ECLASS.
:CLASS NAME=NUMCL BASETYPE='PACKED 5 0'.
:ECLASS.
:CLASS NAME=DATECL BASETYPE=DATE.
:ECLASS.
:CLASS NAME=TIMECL BASETYPE=TIME.
:ECLASS.
:CLASS NAME=YNCL BASETYPE='CHAR 1'.
:TL.
:TI VALUE='Y'.*YES
:TI VALUE='N'.*NO
:ETL.
:ECLASS.
:CLASS NAME=CODECL BASETYPE='CHAR 1'.
:ECLASS.
:VAR NAME=WNAME CLASS=NAMECL.
:VAR NAME=WLIB CLASS=NAMECL.
:VAR NAME=OWNER CLASS=NAMECL.
:VAR NAME=WTEXT CLASS=TEXTCL.
:VAR NAME=QTY CLASS=NUMCL.
:VAR NAME=PRIO CLASS=NUMCL.
:VAR NAME=OUTQ CLASS=NAMECL.
:VAR NAME=OUTQLIB CLASS=NAMECL.
:VAR NAME=SDATE CLASS=DATECL.
:VAR NAME=STIME CLASS=TIMECL.
:VAR NAME=ACTIVE CLASS=YNCL VALUE='Y'.
:VAR NAME=SHARED CLASS=YNCL VALUE='N'.
:VAR NAME=COLOR CLASS=CODECL VALUE='B'.
:VAR NAME=NOTE CLASS=TEXTCL.
:VAR NAME=KIND CLASS=NAMECL.
:VAR NAME=SIZE CLASS=NUMCL.
:VAR NAME=UNITS CLASS=NAMECL.
:VAR NAME=HOLDS CLASS=YNCL VALUE='Y'.
:COND NAME=ISACTIVE EXPR='&ACTIVE. EQ "Y"'.
:KEYL NAME=DSPKEYS.
:KEYI KEY=ENTER ACTION=ENTER.
:KEYI KEY=F3 ACTION=EXIT.F3=Exit
:KEYI KEY=F12 ACTION=CANCEL.F12=Cancel
:KEYI KEY=HELP ACTION=HELP.
:EKEYL.
:PANEL NAME=DSPWDG KEYL=DSPKEYS TOPSEP=SYSNAME.Display Widget
:DATA DEPTH='*'.
:DATAGRP GRPSEP=NONE COMPACT.
:DATAI VAR=WNAME USAGE=OUTPUT.Widget
:DATAIX VAR=WLIB USAGE=OUTPUT.
:DATAIXT.Library
:EDATAGRP.
:DATAC.
:DATAI VAR=OWNER USAGE=OUTPUT.Owner
:DATAI VAR=KIND USAGE=OUTPUT.Kind of widget
:DATAI VAR=QTY USAGE=OUTPUT.Quantity on hand
:DATAI VAR=PRIO USAGE=OUTPUT.Priority (on the queue)
:DATAI VAR=OUTQ USAGE=OUTPUT.Output queue
:DATAGRP GRPSEP=NONE.
:DATAI VAR=OUTQLIB USAGE=OUTPUT.Library
:EDATAGRP.
:DATAI VAR=ACTIVE USAGE=OUTPUT.Active
:DATAI VAR=SHARED USAGE=OUTPUT.Shared with every user
:DATAGRP.Started
:DATAI VAR=SDATE USAGE=OUTPUT.Date
:DATAI VAR=STIME USAGE=OUTPUT.Time
:EDATAGRP.
:DATAI VAR=SIZE USAGE=OUTPUT.Size
:DATAIX VAR=UNITS USAGE=OUTPUT.
:DATAIXT.Units
:DATAI VAR=HOLDS USAGE=OUTPUT.Holds other widgets
:DATAI VAR=WTEXT USAGE=OUTPUT.Text
:DATAC.
:DATAC.Values below come from the last save.
:DATAI VAR=NOTE USAGE=OUTPUT.Note
:DATAI VAR=OWNER USAGE=OUTPUT.Saved by
:EDATA.
:BOTINST.Press Enter to go back.
:EPANEL.
:PANEL NAME=CHGWDG KEYL=DSPKEYS TOPSEP=SPACE.Change Widget
:TOPINST.Type the new values, press Enter.
:DATA DEPTH='*' LAYOUT=2.
:DATACOL WIDTH=40.
:DATAI VAR=WNAME USAGE=INPUT REQUIRED CSRLOC.Widget
:DATAI VAR=WLIB USAGE=INPUT.Library
:DATAI VAR=QTY USAGE=INPUT.Quantity
:DATASLT VAR=COLOR USAGE=INPUT.Color
:DATASLTC VALUE='R'.Red
:DATASLTC VALUE='B'.Blue
:DATASLTC VALUE='G' COND=ISACTIVE.Green
:EDATASLT.
:DATACOL WIDTH=38.
:DATAI VAR=OWNER USAGE=OUTPUT.Owner
:DATAI VAR=ACTIVE USAGE=INPUT.Active
:DATAI VAR=NOTE USAGE=INPUT MAXWIDTH=20.Note
:EDATA.
:EPANEL.
:EPNLGRP.

### pax -i is refused
pax -r -i -f /tmp/a.tar
--- err
pax: Option -i is not supported: there is no terminal to ask.
--- status
2

### pax -t -o -X are taken
pax -w -t -X -o nodir -f /tmp/a.tar data/fruits.txt && pax -f /tmp/a.tar
--- out
data/fruits.txt

### pax missing operand on write
pax -w -f /tmp/a.tar data/nosuch data/fruits.txt; echo "status $?"; pax -f /tmp/a.tar
--- out
status 1
data/fruits.txt
--- err
pax: data/nosuch: No such path or directory.

### pax a file that cannot be read
chmod 0 data/fruits.txt && pax -w -f /tmp/a.tar data/fruits.txt data/nums.txt; echo "status $?"; pax -f /tmp/a.tar
--- out
status 1
data/nums.txt
--- err
pax: data/fruits.txt: Permission is denied.

### pax archive file is not archived
cd data && pax -w -f arch.tar . && pax -f arch.tar | grep -c arch
--- out
0
--- status
1

### pax not an archive
echo hello | pax; echo "status $?"
--- out
status 1
--- err
pax: The input is not an archive in a known format.

### pax empty input
pax < /dev/null; echo "status $?"
--- out
status 1
--- err
pax: The archive is empty.

### pax missing archive file
pax -f /tmp/nosuch.tar; echo "status $?"
--- out
status 1
--- err
pax: /tmp/nosuch.tar: No such path or directory.

### pax damaged header
pax -w -f /tmp/a.tar data/fruits.txt && sed 's/fruits/frXits/' /tmp/a.tar > /tmp/b.tar && pax -f /tmp/b.tar; echo "status $?"
--- out
status 1
--- err
pax: The input is not an archive in a known format.

### pax truncated archive
pax -w -f /tmp/a.tar data/fruits.txt && head -c 520 /tmp/a.tar > /tmp/b.tar && pax -f /tmp/b.tar; echo "status $?"
--- out
status 1
--- err
pax: The archive ends inside a member.

### pax truncated cpio
pax -w -x cpio -f /tmp/a.cpio data/fruits.txt && head -c 80 /tmp/a.cpio > /tmp/b.cpio && pax -f /tmp/b.cpio; echo "status $?"
--- out
status 1
--- err
pax: The archive has a damaged header.

### pax long names use the prefix field
mkdir -p data/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb/cccccccccc && echo x > data/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb/cccccccccc/file.txt && pax -w -f /tmp/a.tar data/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa && pax -f /tmp/a.tar | tail -1 | wc -c
--- out
     127

### pax a name too long for old tar
mkdir -p data/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb && echo x > data/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb/f && pax -w -x tar -f /tmp/a.tar data/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa 2>&1 | sed 's/a\{50\}/A/; s/b\{50\}/B/'; pax -f /tmp/a.tar | sed 's/a\{50\}/A/; s/b\{50\}/B/'
--- out
pax: data/A/B: The name is too long for the format.
pax: data/A/B/f: The name is too long for the format.
data/A

### pax a member from QSYS.LIB
pax -w -f /tmp/a.tar /QSYS.LIB/QGPL.LIB/QCLSRC.FILE/HELLO.MBR && pax -f /tmp/a.tar
--- out
/QSYS.LIB/QGPL.LIB/QCLSRC.FILE/HELLO.MBR

### pax an object that cannot be opened
pax -w -f /tmp/a.tar /QSYS.LIB/QGPL.LIB/HELLO.PGM; echo "status $?"
--- out
status 1
--- err
pax: /QSYS.LIB/QGPL.LIB/HELLO.PGM: The operation is not supported.

### pax absolute names restore in place
pax -w -f /tmp/a.tar /home/QSHUSER/data/fruits.txt && rm data/fruits.txt && pax -r -f /tmp/a.tar && cat data/fruits.txt
--- out
apple
banana
cherry

### pax raw bytes survive
pax -w -x cpio -f /tmp/a.cpio raw && mkdir /tmp/out && cd /tmp/out && pax -r -f /tmp/a.cpio && od -c raw/ff.bin
--- out
0000000 377 377 200  \0 001
0000005

### pax empty file and empty directory
mkdir data/void && pax -w -f /tmp/a.tar data/empty.txt data/void && pax -v -f /tmp/a.tar && mkdir /tmp/out && cd /tmp/out && pax -r -f /tmp/a.tar && ls -l data
--- out
-rw-r--r--  1 QSHUSER  0               0 May 28 20:26 data/empty.txt
drwxr-xr-x  1 QSHUSER  0               0 Sep 21 14:13 data/void
total: 0 kilobytes
-rw-r--r--  1 QSHUSER  0                     0 May 28 20:26 empty.txt
drwxr-xr-x  2 QSHUSER  0                     0 Sep 21 14:13 void

### pax hidden files are archived
pax -w -f /tmp/a.tar data && pax -f /tmp/a.tar data/.hidden
--- out
data/.hidden

### pax directory modes set after contents
chmod 555 data/sub && pax -w -f /tmp/a.tar data/sub && mkdir /tmp/out && cd /tmp/out && pax -r -f /tmp/a.tar && ls -ld data/sub && cat data/sub/inner/leaf
--- out
dr-xr-xr-x  3 QSHUSER  0                     2 May 28 20:26 data/sub
leaf

### pax read creates missing parents
pax -w -f /tmp/a.tar data/sub/inner/leaf && mkdir /tmp/out && cd /tmp/out && pax -r -f /tmp/a.tar && ls -ld data data/sub
--- out
drwxr-xr-x  3 QSHUSER  0                     1 Sep 21 14:13 data
drwxr-xr-x  3 QSHUSER  0                     1 Sep 21 14:13 data/sub

### pax read replaces a directory with a file
pax -w -f /tmp/a.tar data/fruits.txt && mkdir /tmp/out && cd /tmp/out && mkdir -p data/fruits.txt && pax -r -f /tmp/a.tar && cat data/fruits.txt
--- out
apple
banana
cherry

### pax list -v of an old date
pax -w -f /tmp/a.tar data/old.txt && pax -v -f /tmp/a.tar
--- out
-rw-r--r--  1 QSYS     QSHGRP          4 Sep 13  2020 data/old.txt

### pax list -v in another zone
pax -w -f /tmp/a.tar data/fruits.txt && TZ=EST5 pax -v -f /tmp/a.tar
--- out
-rw-r--r--  1 QSHUSER  0              20 May 28 15:26 data/fruits.txt

### pax every format round trips
for x in ustar tar cpio sv4cpio sv4crc; do
  pax -w -x $x -f /tmp/a.$x data/sub data/fruits.txt || echo fail $x
  mkdir /tmp/$x && cd /tmp/$x && pax -r -f /tmp/a.$x && find . | sort && cat data/sub/deep.txt && cd /home/QSHUSER
done

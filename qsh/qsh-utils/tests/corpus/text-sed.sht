### sed s first match
sed 's/a/X/' data/fruits.txt
--- out
Xpple
bXnana
cherry

### sed s global
sed 's/a/X/g' data/fruits.txt
--- out
Xpple
bXnXnX
cherry

### sed s nth match
sed 's/a/X/2' data/fruits.txt
--- out
apple
banXna
cherry

### sed s nth and after
sed 's/a/X/2g' data/fruits.txt
--- out
apple
banXnX
cherry

### sed s with ampersand
sed 's/an/[&]/g' data/fruits.txt
--- out
apple
b[an][an]a
cherry

### sed s escaped ampersand
sed 's/an/\&/' data/fruits.txt
--- out
apple
b&ana
cherry

### sed s groups
echo 'john smith' | sed 's/\(.*\) \(.*\)/\2, \1/'
--- out
smith, john

### sed s with another delimiter
echo /usr/bin | sed 's|/|:|g'
--- out
:usr:bin

### sed s escaped delimiter
echo a/b | sed 's/\//-/'
--- out
a-b

### sed s newline in the replacement
echo 'a,b' | sed 's/,/\
/'
--- out
a
b

### sed s backslash n in the replacement
echo 'a,b' | sed 's/,/\n/'
--- out
a
b

### sed s with p and -n
sed -n 's/an/AN/p' data/fruits.txt
--- out
bANana

### sed s with w file
sed -n 's/e/E/w changed' data/fruits.txt; cat changed
--- out
applE
chErry

### sed s empty matches
echo abc | sed 's/x*/-/g'
--- out
-a-b-c-

### sed s empty match after a match
echo baaac | sed 's/a*/x/g'
--- out
xbxcx

### sed s anchored
sed 's/^/> /' data/fruits.txt
--- out
> apple
> banana
> cherry

### sed s at the end
sed 's/$/;/' data/fruits.txt
--- out
apple;
banana;
cherry;

### sed s with ERE -E
echo 'aaa bbb' | sed -E 's/(a+) (b+)/\2 \1/'
--- out
bbb aaa

### sed s with -r
echo 'abc' | sed -r 's/b?c/X/'
--- out
aX

### sed s case of an empty regex reuses the last
sed -n '/an/s//AN/p' data/fruits.txt
--- out
bANana

### sed s bad count
sed 's/a/b/0' data/fruits.txt

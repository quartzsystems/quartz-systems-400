--- status
1

### sed p prints twice
sed p data/fruits.txt
--- out
apple
apple
banana
banana
cherry
cherry

### sed -n p prints once
sed -n p data/fruits.txt
--- out
apple
banana
cherry

### sed d deletes
sed '2d' data/fruits.txt
--- out
apple
cherry

### sed line ranges
seq() { i=$1; while [ $i -le $2 ]; do echo $i; i=$((i+1)); done; }; seq 1 6 | sed -n '2,4p'
--- out
2
3
4

### sed a range to the last line
sed -n '2,$p' data/fruits.txt
--- out
banana
cherry

### sed a regex range
sed -n '/apple/,/banana/p' data/fruits.txt
--- out
apple
banana

### sed a range that does not close
sed -n '/banana/,/nomatch/p' data/fruits.txt
--- out
banana
cherry

### sed a range whose end is before its start
seq() { i=$1; while [ $i -le $2 ]; do echo $i; i=$((i+1)); done; }; seq 1 5 | sed -n '3,1p'
--- out
3

### sed negated address
sed '2!d' data/fruits.txt
--- out
banana

### sed negated range
sed '1,2!s/^/x/' data/fruits.txt
--- out
apple
banana
xcherry

### sed last line address
sed -n '$p' data/fruits.txt
--- out
cherry

### sed last line over several files
sed -n '$p' data/fruits.txt data/csv.txt
--- out
z,3,c

### sed line numbers run across files
sed -n '4p' data/fruits.txt data/csv.txt
--- out
x,1,b


example.com.	300	IN	MX	20 backup.example.com.
example.com.	300	IN	NS	ns1.example.com.
example.com.	300	IN	NS	ns2.example.com.
example.com.	300	IN	TXT	"v=spf1 -all"
example.com.	300	IN	SOA	ns1.example.com. hostmaster.example.com. 2026102901 7200 3600 1209600 300

### dig q option
dig -q mail.example.com +short
--- out
192.0.2.25

### dig accepted options
dig +time=2 +tries=1 +norecurse +short www.example.com
--- out
93.184.216.34

### dig help
dig -h; echo status $?
--- out
Usage: dig [@server] [-t type] [-x address] [-q name] [-p port] [name] [type] [+[no]option ...]
status 0

### dig v6
dig +short v6only.example.com aaaa
--- out
2001:db8::1

### dig multi
dig +short multi.example.com
--- out
192.0.2.1
192.0.2.2

### dig srv
dig +noall +answer _ldap._tcp.example.com srv
--- out
_ldap._tcp.example.com.	300	IN	SRV	0 5 389 ldap.example.com.

### dig four six
dig -4 +short www.example.com
--- out
93.184.216.34

### rexec run
rexec -u qshuser -p secret rhost ls -l
--- out
ran: ls -l

### rexec netrc
printf 'machine rhost login QSHUSER password secret\n' > $HOME/.netrc; rexec rhost date
--- out
ran: date

### rexec netrc default
printf 'default login QSHUSER password secret\n' > $HOME/.netrc; rexec rhost.example.com pwd
--- out
ran: pwd

### rexec netrc other machine
printf 'machine other login x password y\n' > $HOME/.netrc; rexec rhost date; echo status $?
--- out
status 1
--- err
rexec: A password is needed: give -p or a machine entry in $HOME/.netrc.

### rexec default user
rexec -p secret rhost id
--- out
ran: id

### rexec bad password
rexec -u QSHUSER -p wrong rhost ls; echo status $?
--- out
status 1
--- err
rexec: rhost: Login incorrect.

### rexec bad user
rexec -u nobody -p secret rhost ls; echo status $?
--- out
status 1
--- err
rexec: rhost: Login incorrect.

### rexec no password
rexec rhost ls; echo status $?
--- out
status 1
--- err
rexec: A password is needed: give -p or a machine entry in $HOME/.netrc.

### rexec unknown host
rexec -p secret nohost ls; echo status $?
--- out
status 1
--- err
rexec: nohost: There is no route to the host.

### rexec wrong port
rexec -P 2000 -p secret rhost ls; echo status $?
--- out
status 1
--- err
rexec: rhost: The connection was refused.

### rexec bad port
rexec -P x -p secret rhost ls; echo status $?
--- out
status 2
--- err
rexec: The port x is not valid.

### rexec no command
rexec -p secret rhost; echo status $?
--- out
status 2
--- err
rexec: A host and a command are needed.

### rexec no host
rexec; echo status $?
--- out
status 2
--- err
rexec: A host and a command are needed.

### rexec stdin
printf 'line one\nline two\n' | rexec -p secret rhost cat
--- out
ran: cat
line one
line two

### rexec no stdin
printf 'ignored\n' | rexec -n -p secret rhost cat
--- out
ran: cat

### rexec l option
rexec -l QSHUSER -p secret rhost who
--- out
ran: who

### rexec bad option
rexec -z rhost ls; echo status $?
--- out
status 2
--- err
rexec: Option -z is not valid.

### rexec pipe
rexec -p secret rhost uname | tr a-z A-Z
--- out
RAN: UNAME

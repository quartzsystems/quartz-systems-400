### nohup runs
nohup echo hi; echo $?
--- out
hi
0

### nohup status
nohup sh -c 'exit 3'; echo $?
--- out
3

### nohup not found
nohup nosuchprog; echo $?
--- out
127
--- err
nohup: nosuchprog: not found.

### nohup not runnable
nohup data/fruits.txt; echo $?
--- out
126
--- err
nohup: data/fruits.txt: cannot be run.

### nohup usage
nohup; echo $?
--- out
127
--- err
nohup: A utility to run is needed.

### nohup dashdash
nohup -- echo ok
--- out
ok

### nohup args
nohup echo a 'b  c'
--- out
a b  c

### nohup no nohup.out when piped
nohup echo x | cat; ls nohup.out 2>&1; echo $?
--- out
x
ls: nohup.out: No such path or directory.
1

### printenv name
X=1 printenv X
--- out
1

### printenv unset
printenv NOSUCH; echo $?
--- out
1

### printenv several
A=1 B=2 printenv A B NOSUCH; echo $?
--- out
1
2
1

### printenv all
env -i A=1 B=two /usr/bin/printenv
--- out
A=1
B=two

### printenv home
printenv HOME LOGNAME
--- out
/home/QSHUSER
QSHUSER

### printenv bad option
printenv -x; echo $?
--- out
2
--- err
printenv: Option -x is not valid.

### test program true
/usr/bin/test -f data/fruits.txt; echo $?
--- out
0

### test program false
/usr/bin/test -d data/fruits.txt; echo $?
--- out
1

### test program strings
/usr/bin/test abc = abc; echo $?; /usr/bin/test abc != abc; echo $?
--- out
0
1

### test program numbers
/usr/bin/test 10 -gt 9; echo $?; /usr/bin/test 1 -eq 2; echo $?
--- out
0
1

### test program bad number
/usr/bin/test x -eq 1; echo $?
--- out
2
--- err
test: x is not a number.

### test program no args
/usr/bin/test; echo $?
--- out
1

### test program one arg
/usr/bin/test x; echo $?; /usr/bin/test ''; echo $?
--- out
0
1

### test program not
/usr/bin/test ! -e nosuch; echo $?
--- out
0

### test program and or
/usr/bin/test -f data/fruits.txt -a -d data; echo $?; /usr/bin/test -f nosuch -o -d data; echo $?
--- out
0
0

### test program parens
/usr/bin/test \( -f nosuch -o -d data \) -a -n x; echo $?
--- out
0

### test program link
/usr/bin/test -h data/link; echo $?; /usr/bin/test -L data/fruits.txt; echo $?
--- out
0
1

### test program size
/usr/bin/test -s data/empty.txt; echo $?; /usr/bin/test -s data/fruits.txt; echo $?
--- out
1
0

### test program exec
/usr/bin/test -x bin/tool; echo $?; /usr/bin/test -x data/fruits.txt; echo $?
--- out
0
1

### test program newer
/usr/bin/test data/fruits.txt -nt data/old.txt; echo $?; /usr/bin/test data/old.txt -nt data/fruits.txt; echo $?
--- out
0
1

### test program same file
/usr/bin/test data/link -ef data/fruits.txt; echo $?
--- out
0

### test program zn
/usr/bin/test -z ''; echo $?; /usr/bin/test -n ''; echo $?
--- out
0
1

### test program bad unary
/usr/bin/test -q x; echo $?
--- out
2
--- err
test: -q is not a unary operator.

### test program bad binary
/usr/bin/test a -foo b; echo $?
--- out
2
--- err
test: -foo is not a binary operator.

### test program extra
/usr/bin/test a = b c d e; echo $?
--- out
2
--- err
test: c was not expected.

### test program find exec
find data -name '*.txt' -exec test -s {} \; -print | sort
--- out
data/csv.txt
data/dup.txt
data/fruits.txt
data/mixed.txt
data/nonl.txt
data/nums.txt
data/old.txt
data/people.txt
data/sub/deep.txt
data/tabs.txt
data/words.txt

### test program xargs
echo data/fruits.txt | xargs test -r; echo $?
--- out
0

### test program qsys
/usr/bin/test -d /QSYS.LIB/QGPL.LIB; echo $?; /usr/bin/test -f /QSYS.LIB/QGPL.LIB/QCLSRC.FILE/HELLO.MBR; echo $?
--- out
0
0

### test program tty
/usr/bin/test -t 1; echo $?
--- out
1


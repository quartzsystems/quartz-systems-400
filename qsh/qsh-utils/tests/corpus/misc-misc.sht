/home/QSHUSER/data/sub

### pwd program last option wins
cd data && ln -s sub s && cd s && /usr/bin/pwd -P -L; /usr/bin/pwd -L -P
--- out
/home/QSHUSER/data/s
/home/QSHUSER/data/sub


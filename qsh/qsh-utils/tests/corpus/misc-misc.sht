mkfifo p; /usr/bin/test -p p; echo $?
--- out
0

### file text
file data/fruits.txt
--- out
data/fruits.txt: ASCII text

### file several
file data/empty.txt data/nonl.txt data data/link
--- out
data/empty.txt: empty
data/nonl.txt: ASCII text
data: directory
data/link: ASCII text

### file h
file -h data/link
--- out
data/link: symbolic link to fruits.txt

### file broken link
ln -s nowhere bl; file bl; file -h bl
--- out
bl: broken symbolic link to nowhere
bl: symbolic link to nowhere

### file raw
file raw/ff.bin raw/latin1.txt raw/ebcdic.txt raw/one.f8
--- out
raw/ff.bin: data
raw/latin1.txt: ISO-8859 text
raw/ebcdic.txt: EBCDIC text
raw/one.f8: data

### file utf8
printf 'caf\303\251\n' > u; file u
--- out
u: UTF-8 text

### file script
printf '#!/bin/sh\necho hi\n' > s; file s
--- out
s: shell script

### file dev null
file /dev/null
--- out
/dev/null: character special

### file fifo
mkfifo p; file p
--- out
p: fifo

### file qsys
file /QSYS.LIB/QGPL.LIB /QSYS.LIB/QGPL.LIB/HELLO.PGM /QSYS.LIB/QGPL.LIB/CFG.DTAARA /QSYS.LIB/QGPL.LIB/QCLSRC.FILE /QSYS.LIB/QGPL.LIB/QCLSRC.FILE/HELLO.MBR

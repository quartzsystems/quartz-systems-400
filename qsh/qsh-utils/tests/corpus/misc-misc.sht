setccsid 37 raw/ebcdic.txt 2>/dev/null; file raw/ebcdic.txt
--- out
raw/ebcdic.txt: EBCDIC text

### mkfifo makes
mkfifo p; ls -l p | cut -c1-10; echo $?
--- out
prw-r--r--
0

### mkfifo umask
umask 027; mkfifo p; ls -l p | cut -c1-10
--- out
prw-r-----

### mkfifo mode octal
mkfifo -m 600 p; ls -l p | cut -c1-10
--- out
prw-------

### mkfifo mode symbolic
mkfifo -m u=rw,go= p; ls -l p | cut -c1-10
--- out
prw-------

### mkfifo mode plus
umask 077; mkfifo -m +x p; ls -l p | cut -c1-10
--- out
prwxrw-rw-

### mkfifo several
mkfifo p1 p2; ls
--- out
bin
data
p1
p2
raw


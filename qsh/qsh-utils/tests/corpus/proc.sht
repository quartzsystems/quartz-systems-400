### xargs default runs echo
printf 'a b\nc\n' | xargs
--- out
a b c

### xargs a utility
printf 'a\nb\n' | xargs echo got
--- out
got a b

### xargs -n
printf '1 2 3 4 5\n' | xargs -n 2 echo
--- out
1 2
3 4
5

### xargs -L
printf 'a b\nc\nd e f\n' | xargs -L 2 echo
--- out
a b c
d e f

### xargs -I
printf 'one\n  two words\n' | xargs -I {} echo '[{}]'
--- out
[one]
[two words]

### xargs -I with several places
printf 'x\n' | xargs -I % echo % and %
--- out
x and x

### xargs quotes
printf '"a b" c\n' | xargs -n 1 echo
--- out
a b
c

### xargs single quotes and backslashes
printf "'q r' s\\\\ t\n" | xargs -n 1 echo
--- out
q r
s t

### xargs an unterminated quote
printf '"abc\n' | xargs echo
--- err
xargs: A quote is not closed.
--- status
1

### xargs -t traces
printf 'a\n' | xargs -t echo
--- out
a
--- err
echo a

### xargs -E end of input
printf 'a b STOP c\n' | xargs -E STOP echo
--- out
a b

### xargs -s size limits
printf 'aaaa bbbb cccc\n' | xargs -s 15 echo
--- out
aaaa bbbb
cccc

### xargs an argument too long for -s
printf 'aaaaaaaaaaaaaaaaaaaa\n' | xargs -s 10 echo
--- err
xargs: An argument is longer than the command line size.
--- status
1

### xargs no input runs once
printf '' | xargs echo none; echo $?
--- out
none
0

### xargs a missing utility
printf 'a\n' | xargs nosuchcmd
--- err
xargs: nosuchcmd: not found.
--- status
127

### xargs a failing utility is 123
printf 'a\n' | xargs sh -c 'exit 1'; echo $?
--- out
123

### xargs a utility ending 255 is 124
printf 'a\n' | xargs sh -c 'exit 255'; echo $?
--- out
124
--- err
xargs: sh: ended with status 255.

### xargs a bad -n
printf 'a\n' | xargs -n 0 echo
--- err
xargs: 0 is not a valid number.
--- status
2

### xargs with find
find data/sub -type f | xargs wc -l
--- out
       1 data/sub/deep.txt
       1 data/sub/inner/leaf
       2 total

### xargs -p declines
printf 'a\n' | xargs -p echo
--- err -n
echo a?...

### echo as a program
/usr/bin/echo a 'b\tc'
--- out
a b	c

### echo -n as a program
/usr/bin/echo -n x; /usr/bin/echo y
--- out
xy

### true and false as programs
/usr/bin/true; echo $?; /usr/bin/false; echo $?
--- out
0
1

### xargs runs a script with the shell
printf 'echo script got $1\n' > s.sh; chmod +x s.sh; echo arg | xargs ./s.sh
--- out
script got arg

### find -exec runs a script
printf 'echo seen $1\n' > s.sh; chmod +x s.sh; find data/sub -name deep.txt -exec ./s.sh {} \;
--- out
seen data/sub/deep.txt

### env runs a script
printf 'echo X=$X\n' > s.sh; chmod +x s.sh; env X=1 ./s.sh
--- out
X=1

### xargs a file that cannot be run
echo > s.sh; echo a | xargs ./s.sh
--- err
xargs: ./s.sh: cannot be run.
--- status
126

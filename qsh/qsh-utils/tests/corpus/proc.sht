### basename a path
basename /usr/bin/ls
--- out
ls

### basename a trailing slash
basename /usr/lib/
--- out
lib

### basename a suffix
basename /a/b/file.txt .txt
--- out
file

### basename the suffix is the whole name
basename .txt .txt
--- out
.txt

### basename of slashes
basename ///
--- out
/

### basename of an empty string
basename ''
--- out


### basename without operands
basename
--- err
basename: A string and an optional suffix are needed.
--- status
2

### basename too many operands
basename a b c
--- err
basename: A string and an optional suffix are needed.
--- status
2

### basename a QSYS.LIB path
basename /QSYS.LIB/QGPL.LIB/QCLSRC.FILE/HELLO.MBR .MBR
--- out
HELLO

### basename with --
basename -- -x
--- out
-x

### dirname a path
dirname /usr/bin/ls
--- out
/usr/bin

### dirname a name without slashes
dirname file
--- out
.

### dirname a trailing slash
dirname /usr/lib/
--- out
/usr

### dirname of the root
dirname /
--- out
/

### dirname of a top name
dirname /usr
--- out
/

### dirname of doubled slashes
dirname //a//b//
--- out
//a

### dirname without an operand
dirname
--- err
dirname: One string is needed.
--- status
2

### dirname a relative path
dirname a/b/c
--- out
a/b

### date default format in UTC
date
--- out
Mon Sep 21 14:13:20 UTC 2026

### date -u
date -u
--- out
Mon Sep 21 14:13:20 UTC 2026

### date with a format
date '+%Y-%m-%d %H:%M:%S'
--- out
2026-09-21 14:13:20

### date with a TZ
TZ=EST5EDT date
--- out
Mon Sep 21 10:13:20 EDT 2026

### date with a far zone
TZ='<+09>-9' date '+%H %Z %z'
--- out
23 +09 +0900

### date format letters
date '+%a %A %b %B %d %e %j %m %y %C %u %w %U %W %V %G'
--- out
Mon Monday Sep September 21 21 264 09 26 20 1 1 38 38 39 2026

### date format time letters
date '+%I %p %M %S %r %R %T %D %F %n%t%%'
--- out
02 PM 13 20 02:13:20 PM 14:13 14:13:20 09/21/26 2026-09-21 
	%

### date %s seconds
date '+%s'
--- out
1790000000

### date %c %x %X
date '+%c|%x|%X'
--- out
Mon Sep 21 14:13:20 2026|09/21/26|14:13:20

### date setting is refused
date 010112002020
--- err
date: Setting the date is not permitted.
--- status
1

### date too many operands
date +%Y +%m
--- err
date: Too many operands.
--- status
2

### date an unknown option
date -k
--- err
date: Option -k is not valid.
--- status
2

### date an unknown format letter is kept
date '+%Q'
--- out
%Q

### env prints the environment
env | sort
--- out
HOME=/home/QSHUSER
LOGNAME=QSHUSER
PWD=/home/QSHUSER

### env -i empty
env -i; echo "[$?]"
--- out
[0]

### env with an assignment runs a utility
env FOO=bar env | grep FOO
--- out
FOO=bar

### env -i with assignments
env -i A=1 B=2 env
--- out
A=1
B=2

### env replaces a variable
env HOME=/tmp env | grep '^HOME='
--- out
HOME=/tmp

### env a missing utility
env nosuchcmd
--- err
env: nosuchcmd: not found.
--- status
127

### env runs a utility with arguments
env basename /a/b
--- out
b

### env -i loses PATH but finds by path
env -i /usr/bin/basename /x/y
--- out
y

### env exit status passes through
env sh -c 'exit 3'; echo $?
--- out
3

### ps default columns
ps
--- out
PID DEVICE  TIME FUNCTION   STATUS JOBID
100 -      00:01 PGM-QZSHSH RUN    000123/QSHUSER/QZSHSH
101 -      01:05 PGM-ls     RUN    000124/QSHUSER/QP0ZSPWP

### ps -f
ps -f
--- out
USER    PID PPID DEVICE  TIME COMMAND
QSHUSER 100    1 -      00:01 qsh
QSHUSER 101  100 -      01:05 /usr/bin/ls -l

### ps -l
ps -l
--- out
UID PID PPID DEVICE  TIME FUNCTION   STATUS JOBID
100 100    1 -      00:01 PGM-QZSHSH RUN    000123/QSHUSER/QZSHSH
100 101  100 -      01:05 PGM-ls     RUN    000124/QSHUSER/QP0ZSPWP

### ps -o
ps -o pid,ppid,user,args
--- out
PID PPID USER    COMMAND
100    1 QSHUSER qsh
101  100 QSHUSER /usr/bin/ls -l

### ps -o with headers renamed
ps -o pid=ID -o comm=CMD
--- out
 ID CMD
100 qsh
101 ls

### ps -o with empty headers
ps -o pid= -o jobname=
--- out
100 QZSHSH
101 QP0ZSPWP

### ps -p selects
ps -p 101
--- out
PID DEVICE  TIME FUNCTION STATUS JOBID
101 -      01:05 PGM-ls   RUN    000124/QSHUSER/QP0ZSPWP

### ps -u selects by user
ps -u QSHUSER -o pid,user
--- out
PID USER
100 QSHUSER
101 QSHUSER

### ps -u a user with none
ps -u QSYS
--- out
PID DEVICE TIME FUNCTION STATUS JOBID

### ps -o job columns
ps -o jobnumber,jobuser,jobname,status,function
--- out
JOBNUMBER JOBUSER JOBNAME  STATUS FUNCTION
000123    QSHUSER QZSHSH   RUN    PGM-QZSHSH
000124    QSHUSER QP0ZSPWP RUN    PGM-ls

### ps -o time
ps -o pid,time
--- out
PID  TIME
100 00:01
101 01:05


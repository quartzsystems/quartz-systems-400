/* Compiled USRPRF(*OWNER) and owned by OWNA, whose group GRPA has       */
/* *CHANGE to SECORA/F while OWNA itself has none: does adoption bring   */
/* the group's authority? Called by USRA, who has no authority to F.     */
PGM
  DCL &LINE *CHAR 80
  CHKOBJ OBJ(SECORA/F) OBJTYPE(*FILE) AUT(*CHANGE)
  MONMSG CPF0000 EXEC(DO)
    CHGVAR &LINE 'adopt through owner''s group: refused'
    CALL SORACLE PARM('Q2' &LINE)
    RETURN
  ENDDO
  CHGVAR &LINE 'adopt through owner''s group: allowed'
  CALL SORACLE PARM('Q2' &LINE)
ENDPGM

/* Run signed on as USRA (a plain user, PTYLMT(5)): the observations    */
/* that need a user without special authority.                           */
PGM
  DCL &ID *CHAR 7
  DCL &PTY *DEC (2 0)
  DCL &LINE *CHAR 80
  DCL &ERR *CHAR 8 VALUE(X'0000000000000000')
  /* Q2: through the adopting program. */
  CALL SECORA/ADOPTQ2
  MONMSG CPF0000
  /* Q4: a password breaking QPWDMINLEN (6 or more), through QSYCHGPW. */
  CALL QSYCHGPW ('USRA' 'ORACLE1' 'AB' &ERR)
  MONMSG CPF0000 EXEC(DO)
    RCVMSG MSGTYPE(*EXCP) MSGID(&ID)
    CHGVAR &LINE ('CHGPWD rule failure: ' *CAT &ID)
    CALL SECORA/SORACLE PARM('Q4' &LINE)
  ENDDO
  /* Q5: a command needing *SECADM. */
  CRTUSRPRF USRPRF(NOPE) PASSWORD(*NONE)
  MONMSG CPF0000 EXEC(DO)
    RCVMSG MSGTYPE(*EXCP) MSGID(&ID)
    CHGVAR &LINE ('CRTUSRPRF without *SECADM: ' *CAT &ID)
    CALL SECORA/SORACLE PARM('Q5' &LINE)
  ENDDO
  /* Q7: RUNPTY under PTYLMT. */
  CHGJOB RUNPTY(10)
  MONMSG CPF0000 EXEC(DO)
    RCVMSG MSGTYPE(*EXCP) MSGID(&ID)
    CHGVAR &LINE ('CHGJOB RUNPTY(10) with PTYLMT(5): ' *CAT &ID)
    CALL SECORA/SORACLE PARM('Q7' &LINE)
    GOTO Q9
  ENDDO
  RTVJOBA RUNPTY(&PTY)
  CHGVAR &LINE ('CHGJOB RUNPTY(10) with PTYLMT(5): ' *CAT %CHAR(&PTY))
  CALL SECORA/SORACLE PARM('Q7' &LINE)
Q9:
  /* Q9: ADDPFM with *OBJOPR *OBJALTER *READ and no *OBJMGT. */
  ADDPFM FILE(SECORA/F) MBR(M9)
  MONMSG CPF0000 EXEC(DO)
    CHGVAR &LINE 'ADDPFM with *OBJALTER only: refused'
    CALL SECORA/SORACLE PARM('Q9' &LINE)
    GOTO Q12
  ENDDO
  CHGVAR &LINE 'ADDPFM with *OBJALTER only: allowed'
  CALL SECORA/SORACLE PARM('Q9' &LINE)
Q12:
  /* Q12: granting more than one has. */
  GRTOBJAUT OBJ(SECORA/F) OBJTYPE(*FILE) USER(GRPA) AUT(*ALL)
  MONMSG CPF0000 EXEC(DO)
    RCVMSG MSGTYPE(*EXCP) MSGID(&ID)
    CHGVAR &LINE ('GRTOBJAUT beyond own: ' *CAT &ID)
    CALL SECORA/SORACLE PARM('Q12' &LINE)
  ENDDO
ENDPGM

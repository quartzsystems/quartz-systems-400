/* The driver, run as QSECOFR: the library, profiles and objects, then   */
/* the observations a security officer can make. ASUSRA makes the rest. */
PGM
  DCL &S *CHAR 150
  DCL &OWN *CHAR 10
  DCL &PUB *CHAR 10
  DCL &PTY *DEC (2 0)
  DCL &ID *CHAR 7
  DCL &LINE *CHAR 80
  CRTLIB SECORA
  MONMSG CPF0000
  CRTPF FILE(SECORA/ORACLE) RCDLEN(80)
  MONMSG CPF0000
  CLRPFM SECORA/ORACLE
  /* Q1: the shipped profiles' special authorities. */
  RTVUSRPRF USRPRF(QSYSOPR) SPCAUT(&S)
  CHGVAR &LINE ('QSYSOPR ' *CAT &S)
  CALL SORACLE PARM('Q1' &LINE)
  RTVUSRPRF USRPRF(QPGMR) SPCAUT(&S)
  CHGVAR &LINE ('QPGMR ' *CAT &S)
  CALL SORACLE PARM('Q1' &LINE)
  RTVUSRPRF USRPRF(QSRV) SPCAUT(&S)
  CHGVAR &LINE ('QSRV ' *CAT &S)
  CALL SORACLE PARM('Q1' &LINE)
  RTVUSRPRF USRPRF(QTCP) SPCAUT(&S)
  CHGVAR &LINE ('QTCP ' *CAT &S)
  CALL SORACLE PARM('Q1' &LINE)
  /* The profiles and objects the other questions use. */
  CRTUSRPRF USRPRF(GRPA) PASSWORD(*NONE)
  MONMSG CPF0000
  CRTUSRPRF USRPRF(OWNA) PASSWORD(ORACLE1) GRPPRF(GRPA)
  MONMSG CPF0000
  CRTUSRPRF USRPRF(USRA) PASSWORD(ORACLE1) PTYLMT(5)
  MONMSG CPF0000
  CRTPF FILE(SECORA/F) RCDLEN(10) MAXMBRS(*NOMAX)
  MONMSG CPF0000
  GRTOBJAUT OBJ(SECORA/F) OBJTYPE(*FILE) USER(*PUBLIC) AUT(*EXCLUDE)
  GRTOBJAUT OBJ(SECORA/F) OBJTYPE(*FILE) USER(GRPA) AUT(*CHANGE)
  CRTAUTL AUTL(SECORAL)
  MONMSG CPF0000
  ADDAUTLE AUTL(SECORAL) USER(USRA) AUT(*USE)
  MONMSG CPF0000
  CHGOBJOWN OBJ(SECORA/ADOPTQ2) OBJTYPE(*PGM) NEWOWN(OWNA)
  MONMSG CPF0000
  GRTOBJAUT OBJ(SECORA/ADOPTQ2) OBJTYPE(*PGM) USER(*PUBLIC) AUT(*USE)
  GRTOBJAUT OBJ(SECORA/SORACLE) OBJTYPE(*PGM) USER(*PUBLIC) AUT(*USE)
  GRTOBJAUT OBJ(SECORA/ASUSRA) OBJTYPE(*PGM) USER(*PUBLIC) AUT(*USE)
  GRTOBJAUT OBJ(SECORA/ORACLE) OBJTYPE(*FILE) USER(*PUBLIC) AUT(*CHANGE)
  GRTOBJAUT OBJ(SECORA) OBJTYPE(*LIB) USER(*PUBLIC) AUT(*USE)
  /* Q6: a new profile's owner and *PUBLIC. */
  CRTUSRPRF USRPRF(NEWA) PASSWORD(*NONE)
  MONMSG CPF0000
  RTVOBJD OBJ(QSYS/NEWA) OBJTYPE(*USRPRF) OWNER(&OWN)
  CHGVAR &LINE ('new profile owner ' *CAT &OWN)
  CALL SORACLE PARM('Q6' &LINE)
  DLTUSRPRF NEWA
  MONMSG CPF0000
  /* Q3: the owner with reduced authority and a group holding *ALL. */
  CRTPF FILE(SECORA/F3) RCDLEN(10)
  MONMSG CPF0000
  CHGOBJOWN OBJ(SECORA/F3) OBJTYPE(*FILE) NEWOWN(OWNA)
  GRTOBJAUT OBJ(SECORA/F3) OBJTYPE(*FILE) USER(OWNA) AUT(*USE) REPLACE(*YES)
  GRTOBJAUT OBJ(SECORA/F3) OBJTYPE(*FILE) USER(GRPA) AUT(*ALL)
  GRTOBJAUT OBJ(SECORA/ASOWNA) OBJTYPE(*PGM) USER(*PUBLIC) AUT(*USE)
  /* The check itself runs as OWNA: ASOWNA. */
  /* Q7: RUNPTY under PTYLMT: recorded by ASUSRA in USRA's job. */
  /* Q9: ADDPFM with *OBJALTER and no *OBJMGT: as USRA. */
  GRTOBJAUT OBJ(SECORA/F) OBJTYPE(*FILE) USER(USRA) AUT(*OBJOPR *OBJALTER *READ)
  /* Q11: QSYCHGPR. */
  CHKOBJ OBJ(QSYS/QSYCHGPR) OBJTYPE(*PGM)
  MONMSG CPF9801 EXEC(DO)
    CHGVAR &LINE 'QSYCHGPR: absent'
    CALL SORACLE PARM('Q11' &LINE)
    GOTO Q12
  ENDDO
  CHGVAR &LINE 'QSYCHGPR: present'
  CALL SORACLE PARM('Q11' &LINE)
Q12:
  /* Q12: DLTUSRPRF of an owner; ADDAUTLE twice; RMVAUTLE of nobody. */
  DLTUSRPRF USRPRF(OWNA)
  MONMSG CPF0000 EXEC(DO)
    RCVMSG MSGTYPE(*EXCP) MSGID(&ID)
    CHGVAR &LINE ('DLTUSRPRF owner: ' *CAT &ID)
    CALL SORACLE PARM('Q12' &LINE)
  ENDDO
  ADDAUTLE AUTL(SECORAL) USER(USRA) AUT(*USE)
  MONMSG CPF0000 EXEC(DO)
    RCVMSG MSGTYPE(*EXCP) MSGID(&ID)
    CHGVAR &LINE ('ADDAUTLE duplicate: ' *CAT &ID)
    CALL SORACLE PARM('Q12' &LINE)
  ENDDO
  RMVAUTLE AUTL(SECORAL) USER(GRPA)
  MONMSG CPF0000 EXEC(DO)
    RCVMSG MSGTYPE(*EXCP) MSGID(&ID)
    CHGVAR &LINE ('RMVAUTLE absent: ' *CAT &ID)
    CALL SORACLE PARM('Q12' &LINE)
  ENDDO
ENDPGM

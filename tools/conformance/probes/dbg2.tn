# STRDBG screens, second pass: Display Module Source of the account's own
# program (no source view: DBGVIEW(*STMT)) under STRDBG UPDPROD(*NO),
# each function key and each debug command's answer. After every
# snapshot the script returns to the display (F12, then DSPMODSRC).
# Nothing is called and no object changes.
sleep 4000
key enter
wait "Main Menu"
continue
timeout 90000
key eraseinput
type strdbg pgm({user}1/qstestpub) updprod(*no)
key enter
wait "Display Module Source"
settle 1500
key f1
settle 1500
snap dbg-key-help
key f12
settle 1500
key eraseinput
type dspmodsrc
key enter
wait "Display Module Source"
settle 1000
key f5
settle 1500
snap dbg-key-f5
key f12
settle 1500
key eraseinput

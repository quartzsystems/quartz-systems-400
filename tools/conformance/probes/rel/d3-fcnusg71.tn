# Every function the primary (V7R1M0) lists in WRKFCNUSG, shown with
# DSPFCNUSG: product, group, default authority, *ALLOBJ use and users.
# Read-only.
wait "Sign On"
signon
settle 3000
timeout 30000
key enter
settle 2000
type call qcmd
key enter
wait "Command Entry"
continue
key eraseinput
type DSPFCNUSG FCNID(QIBM_DIRSRV_ADMIN)
key enter
settle 2500
snap fcn-qibm_dirsrv_admin
key f3
settle 1200
key eraseinput
type DSPFCNUSG FCNID(QIBM_ACCESS_ALLOBJ_JOBLOG)

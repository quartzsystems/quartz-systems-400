# The message ID behind the TELNET refusal on the primary
# (V7R1M0): F1 on each message at Command Entry. Read-only.
wait "Sign On"
signon
settle 3000
timeout 30000
key enter
settle 2000
type call qcmd
key enter
wait "Command Entry"
continue
type TELNET RMTSYS(QSNOSUCH.INVALID)
key enter
settle 8000
show
cursor 5 7
key help
settle 2000
snap msgid-telnet-nohost
key f12
settle 1500
key f3
settle 1500

# D3 on the primary (V7R1M0, QSECOFR): the prompts of the commands D3 adds,
# their F10 and F11 views. Read-only: each prompt is left with F12.
wait "Sign On"
signon
settle 3000
timeout 30000
key enter
settle 2000
type call qcmd
key enter
wait "Command Entry"
continue
key eraseinput
type SAVSAVFDTA
key f4
settle 3000
snap prompt-savsavfdta
key f10
settle 2000
snap prompt-savsavfdta-f10
key f11
settle 1500
snap prompt-savsavfdta-f11
key pgdn
settle 1500
snap prompt-savsavfdta-p2
key f12
settle 1500
key eraseinput

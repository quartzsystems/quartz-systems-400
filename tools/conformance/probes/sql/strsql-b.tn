# STRSQL: SELECT output 2 (printer) on Change Session Attributes and
# the display it leads to, each left with F12; nothing is changed.
timeout 30000
settle 2500
key enter
wait "Main Menu"
type strsql
key enter
wait "Enter SQL Statements"
settle 1500
snap strsql-b-restored
key eraseinput
key f13
wait "Interactive SQL Session Services"
type 1
key enter
wait "Change Session Attributes"
cursor 6 37
key eraseeof
type 2
key enter
settle 2000
snap strsql-out-printer
key f12
settle 1500
snap strsql-out-printer-f12

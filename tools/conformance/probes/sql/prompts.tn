# SQL tools' command prompts on pub400 (V7R5M0): every page, with F10's
# parameters, left with F12. No command is run. Goldens land in
# tools/conformance/golden/sql/prompts/ (command/sys-cpps/tests/sql_prompts.rs).
wait "Main Menu"
continue
timeout 30000
type runsql
key f4
settle 2500
snap prompt-runsql
key f10
settle 2000
snap prompt-runsql-f10
key pgdn
settle 1500
snap prompt-runsql-f10-2
key pgdn
settle 1500
snap prompt-runsql-f10-3
key pgdn
settle 1500
snap prompt-runsql-f10-4
key f12
settle 1500
wait "Main Menu"
type runsqlstm
key f4
settle 2500
snap prompt-runsqlstm
key f10
settle 2000
snap prompt-runsqlstm-f10
key pgdn
settle 1500
snap prompt-runsqlstm-f10-2
key pgdn
settle 1500
snap prompt-runsqlstm-f10-3
key pgdn
settle 1500
snap prompt-runsqlstm-f10-4
key pgdn
settle 1500
snap prompt-runsqlstm-f10-5
key f12
settle 1500
wait "Main Menu"
type crtsqlrpgi
key f4
settle 2500
snap prompt-crtsqlrpgi
key f10
settle 2000
snap prompt-crtsqlrpgi-f10
key pgdn
settle 1500
snap prompt-crtsqlrpgi-f10-2
key pgdn
settle 1500
snap prompt-crtsqlrpgi-f10-3
key pgdn
settle 1500
snap prompt-crtsqlrpgi-f10-4
key pgdn
settle 1500
snap prompt-crtsqlrpgi-f10-5
key pgdn
settle 1500
snap prompt-crtsqlrpgi-f10-6
key f12
settle 1500
wait "Main Menu"
type strsql
key f4
settle 2500
snap prompt-strsql
key f10
settle 2000
snap prompt-strsql-f10
key pgdn
settle 1500
snap prompt-strsql-f10-2
key pgdn
settle 1500
snap prompt-strsql-f10-3
key f12
settle 1500
wait "Main Menu"
type strdbmon
key f4
settle 2500
snap prompt-strdbmon
key f10
settle 2000
snap prompt-strdbmon-f10
key pgdn
settle 1500
snap prompt-strdbmon-f10-2
key pgdn
settle 1500
snap prompt-strdbmon-f10-3
key pgdn
settle 1500
snap prompt-strdbmon-f10-4
key f12
settle 1500
wait "Main Menu"
type enddbmon
key f4
settle 2500
snap prompt-enddbmon
key f10
settle 2000
snap prompt-enddbmon-f10
key pgdn
settle 1500
snap prompt-enddbmon-f10-2
key f12
settle 1500
wait "Main Menu"
type prtsqlinf
key f4
settle 2500
snap prompt-prtsqlinf
key f10
settle 2000
snap prompt-prtsqlinf-f10
key pgdn
settle 1500
snap prompt-prtsqlinf-f10-2
key f12
settle 1500
wait "Main Menu"
type dspsqlpkg
key f4
settle 2500
snap prompt-dspsqlpkg
key f10
settle 2000
snap prompt-dspsqlpkg-f10
key pgdn
settle 1500
snap prompt-dspsqlpkg-f10-2
key f12
settle 1500
wait "Main Menu"
type dltsqlpkg
key f4
settle 2500
snap prompt-dltsqlpkg
key f10
settle 2000
snap prompt-dltsqlpkg-f10
key pgdn
settle 1500
snap prompt-dltsqlpkg-f10-2
key f12
settle 1500

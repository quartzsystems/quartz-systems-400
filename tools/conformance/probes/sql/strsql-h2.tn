# STRSQL: the identifier of "Prompting was cancelled by the user." (the
# last step of strsql-h.tn, whose row was wrong). Left with option 2.
timeout 30000
settle 2500
key enter
wait "Main Menu"
type strsql
key enter
wait "Enter SQL Statements"
settle 1500
key eraseinput
key f3
wait "Exit Interactive SQL"
cursor 5 31
key eraseeof
type 2
key enter
wait "Main Menu"
type strsql
key enter
wait "Enter SQL Statements"
settle 1500
key eraseinput
pick "===>" drop table
key f4
wait "Specify DROP TABLE Statement"
key f12
wait "Enter SQL Statements"
settle 1000
snap strsql-cancelled
cursor 5 7
key help
settle 2000
snap strsql-msg-cancelled
key f12
wait "Enter SQL Statements"
key eraseinput
key f3
wait "Exit Interactive SQL"
cursor 5 31
key eraseeof
type 2
expect "Exit Interactive SQL"
key enter
wait "Main Menu"

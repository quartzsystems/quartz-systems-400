# CPP audit on the 7.1 oracle: DSPFFD of the model outfiles of DSPPTF
# (QADSPPTF), DSPSFWRSC (QARZLCOF) and DSPOBJAUT (QAOBJAUT), paged
# to the end. Read-only; each display is left with F3.
wait "Sign On"
signon
settle 3000
wait "Main Menu"
timeout 30000
type call qcmd
key enter
wait "Command Entry"
type DSPFFD FILE(QSYS/QADSPPTF)
key enter
settle 4000
snap dspffd-qadspptf-1
key pgdn
settle 1200
snap dspffd-qadspptf-2
key pgdn
settle 1200
snap dspffd-qadspptf-3
key pgdn
settle 1200
snap dspffd-qadspptf-4
key pgdn
settle 1200
snap dspffd-qadspptf-5
key pgdn
settle 1200
snap dspffd-qadspptf-6
key pgdn
settle 1200
snap dspffd-qadspptf-7
key pgdn
settle 1200
snap dspffd-qadspptf-8
key pgdn
settle 1200
snap dspffd-qadspptf-9
key pgdn
settle 1200
snap dspffd-qadspptf-10
key pgdn
settle 1200
snap dspffd-qadspptf-11
key pgdn
settle 1200
snap dspffd-qadspptf-12
key pgdn
settle 1200
snap dspffd-qadspptf-13
key pgdn
settle 1200
snap dspffd-qadspptf-14
key f3
settle 2000
type DSPFFD FILE(QSYS/QARZLCOF)
key enter
settle 4000
snap dspffd-qarzlcof-1
key pgdn
settle 1200
snap dspffd-qarzlcof-2
key pgdn
settle 1200
snap dspffd-qarzlcof-3
key pgdn
settle 1200
snap dspffd-qarzlcof-4
key pgdn
settle 1200
snap dspffd-qarzlcof-5
key pgdn
settle 1200
snap dspffd-qarzlcof-6
key pgdn
settle 1200
snap dspffd-qarzlcof-7
key pgdn
settle 1200
snap dspffd-qarzlcof-8
key pgdn
settle 1200
snap dspffd-qarzlcof-9
key pgdn
settle 1200
snap dspffd-qarzlcof-10
key pgdn
settle 1200
snap dspffd-qarzlcof-11
key pgdn
settle 1200
snap dspffd-qarzlcof-12
key pgdn
settle 1200
snap dspffd-qarzlcof-13
key pgdn
settle 1200
snap dspffd-qarzlcof-14
key f3
settle 2000
type DSPFFD FILE(QSYS/QAOBJAUT)
key enter
settle 4000
snap dspffd-qaobjaut-1
key pgdn
settle 1200
snap dspffd-qaobjaut-2
key pgdn
settle 1200
snap dspffd-qaobjaut-3
key pgdn
settle 1200
snap dspffd-qaobjaut-4
key pgdn
settle 1200
snap dspffd-qaobjaut-5
key pgdn
settle 1200
snap dspffd-qaobjaut-6
key pgdn
settle 1200
snap dspffd-qaobjaut-7
key pgdn
settle 1200
snap dspffd-qaobjaut-8
key pgdn
settle 1200
snap dspffd-qaobjaut-9
key pgdn
settle 1200
snap dspffd-qaobjaut-10
key pgdn
settle 1200
snap dspffd-qaobjaut-11
key pgdn
settle 1200
snap dspffd-qaobjaut-12
key pgdn
settle 1200
snap dspffd-qaobjaut-13
key pgdn

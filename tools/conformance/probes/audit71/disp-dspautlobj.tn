# CPP audit on the 7.1 oracle: DSPAUTLOBJ of a shipped authorization
# list from Command Entry, its first display and F3. Read-only.
wait "Sign On"
signon
settle 3000
wait "Main Menu"
timeout 30000
type call qcmd
key enter
wait "Command Entry"
type DSPAUTLOBJ AUTL(QPWFSERVER)
key enter
settle 3000
snap dspautlobj
key f3
settle 2000

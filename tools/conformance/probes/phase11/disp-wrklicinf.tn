# Phase 11: WRKLICINF. A display command: shown, paged with Page Down and
# left with F3; the only option typed is 5 (display). No `continue`:
# a refused command ends the run and the refusal is the snapshot.
wait "Main Menu"
timeout 30000
type call qcmd
key enter
wait "Command Entry"
type wrklicinf
key enter
settle 3000
snap wrklicinf
key pgdn
settle 1000
snap wrklicinf-2
key pgdn
settle 1000
snap wrklicinf-3
key pgdn
settle 1000
snap wrklicinf-4
key pgdn
settle 1000
snap wrklicinf-5
key pgdn
settle 1000
snap wrklicinf-6
key f3
wait "Command Entry"

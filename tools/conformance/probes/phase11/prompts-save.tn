# Phase 11: command prompts: save, restore and save files.
# Each command is typed on Command Entry and prompted with F4; the
# prompt, F10 (additional parameters) and up to six Page Downs are
# captured and the prompt is left with F12 (Reset clears the operator
# error F10 or Page Down leaves). Enter is never pressed after CALL QCMD,
# so nothing runs; `continue` only steps over a refused prompt. Pages
# that repeat the one before were dropped after the run.
wait "Main Menu"
timeout 20000
type call qcmd
key enter
wait "Command Entry"
continue
key eraseinput
type savlib
key f4
settle 1500
snap prompt-savlib
key pgdn
settle 1000
snap prompt-savlib-2
key reset
key pgup
settle 800
key f10
settle 1200
snap prompt-savlib-f10
key reset
key pgdn
settle 900
snap prompt-savlib-f10-2
key reset
key pgdn
settle 900
snap prompt-savlib-f10-3
key reset
key pgdn
settle 900
snap prompt-savlib-f10-4
key reset
key pgdn
settle 900
snap prompt-savlib-f10-5
key reset
key pgdn
settle 900
snap prompt-savlib-f10-6
key reset
key pgdn
settle 900
snap prompt-savlib-f10-7
key reset
key f12
wait "Command Entry"
key eraseinput
type savobj
key f4
settle 1500
snap prompt-savobj
key pgdn
settle 1000
snap prompt-savobj-2
key reset
key pgup

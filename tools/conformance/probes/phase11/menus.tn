# Phase 11: the save, restore, backup, cleanup, problem, PTF and service
# menus and the command menus of those areas, from Command Entry. Each
# menu is shown with GO, its second page with Page Down, and left with
# F12; nothing is typed on a menu's option line. A menu the profile may
# not use (or that does not exist) leaves Command Entry with its message;
# the snapshot is kept as `menu-NAME` showing the message, then F12 leaves
# Command Entry for the Main Menu, whose command line takes the next GO.
wait "Main Menu"
timeout 20000
type call qcmd
key enter
wait "Command Entry"
continue
key eraseinput
type go save
key enter
settle 2000
snap menu-save
key pgdn
settle 1000
snap menu-save-2
key reset
key pgdn
settle 1000
snap menu-save-3
key reset
key f12
settle 1500
key eraseinput
type go restore
key enter
settle 2000
snap menu-restore
key pgdn
settle 1000
snap menu-restore-2
key reset
key pgdn
settle 1000
snap menu-restore-3
key reset
key f12
settle 1500
key eraseinput
type go backup
key enter
settle 2000
snap menu-backup
key pgdn
settle 1000
snap menu-backup-2
key reset
key pgdn
settle 1000
snap menu-backup-3
key reset
key f12
settle 1500
key eraseinput

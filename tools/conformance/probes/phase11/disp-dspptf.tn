# Phase 11: DSPPTF, its pages and option 5 on an applied PTF. A display command: shown, paged with Page Down and
# left with F3; the only option typed is 5 (display). No `continue`:
# a refused command ends the run and the refusal is the snapshot.
wait "Main Menu"
timeout 30000
type call qcmd
key enter
wait "Command Entry"
type dspptf
key enter
settle 3000
snap dspptf
key pgdn
settle 1000
snap dspptf-2
key pgdn
settle 1000
snap dspptf-3
key pgdn
settle 1000
snap dspptf-4
key reset
key pgup
key pgup
key pgup
key pgup
settle 1000
pick "applied" 5
key enter
settle 2000
snap dspptf-5
key pgdn
settle 1000
snap dspptf-5-2
key pgdn
settle 1000
snap dspptf-5-3
key f12
settle 1500
key f3
wait "Command Entry"

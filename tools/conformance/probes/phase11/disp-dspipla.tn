# Phase 11: DSPIPLA. A display command: shown, paged with Page Down and
# left with F3; the only option typed is 5 (display). No `continue`:
# a refused command ends the run and the refusal is the snapshot.
wait "Main Menu"
timeout 30000
type call qcmd
key enter
wait "Command Entry"
type dspipla
key enter
settle 3000
snap dspipla
key f3
wait "Command Entry"

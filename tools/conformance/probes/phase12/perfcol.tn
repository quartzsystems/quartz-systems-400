key f10
settle 1500
snap prompt-crtpfrdta-f10
key reset
key pgdn
settle 1200
snap prompt-crtpfrdta-f10-2
key reset
key pgdn
settle 1200
snap prompt-crtpfrdta-f10-3
key reset
key f12
settle 1200
key reset
key eraseinput
type CHKPFRCOL
key enter
settle 2000
snap chkpfrcol-msg
key reset
key eraseinput
type CHKPRDOPT PRDID(5770PT1)
key enter
settle 3000
snap chkprdopt-pt1
key reset
key eraseinput
type DSPOBJD OBJ(QPFRDATA/*ALL) OBJTYPE(*MGTCOL)
key enter
settle 3000
snap dspobjd-mgtcol
key f3
settle 1500
key reset
key eraseinput
type DSPOBJD OBJ(QPFRDATA/QAPM*) OBJTYPE(*FILE)
key enter
settle 3000
snap dspobjd-qapm
key f3
settle 1500
key reset
key eraseinput
type WRKSYSSTS
key enter
settle 3000
snap wrksyssts
key f11
settle 1500
snap wrksyssts-f11
key f11
settle 1500
snap wrksyssts-f11-2
key f24
settle 1000
snap wrksyssts-f24
key f3
settle 1500
key reset
key eraseinput
type WRKSHRPOOL
key enter
settle 3000
snap wrkshrpool
key f11
settle 1500
snap wrkshrpool-f11

# Phase 12 Collection Services on the primary (V7R1M0): the collector
# commands' prompts (left with F12, never entered), the statistics
# displays, CHKPFRCOL and the *MGTCOL objects in QPFRDATA. Read-only:
# Collection Services is neither started nor changed.
wait "Sign On"
signon
wait "Main Menu"
timeout 30000
continue
type call qcmd
key enter
wait "Command Entry"
key reset
key eraseinput
type strpfrcol
key f4
settle 2000
snap prompt-strpfrcol
key f10
settle 1500
snap prompt-strpfrcol-f10
key reset
key pgdn
settle 1200
snap prompt-strpfrcol-f10-2
key reset
key pgdn
settle 1200
snap prompt-strpfrcol-f10-3
key reset
key f12
settle 1200
key reset
key eraseinput
type endpfrcol
key f4
settle 2000
snap prompt-endpfrcol
key f10
settle 1500
snap prompt-endpfrcol-f10
key reset
key pgdn
settle 1200
snap prompt-endpfrcol-f10-2
key reset
key pgdn
settle 1200
snap prompt-endpfrcol-f10-3
key reset
key f12
settle 1200
key reset
key eraseinput
type cfgpfrcol
key f4
settle 2000
snap prompt-cfgpfrcol
key f10
settle 1500
snap prompt-cfgpfrcol-f10
key reset
key pgdn
settle 1200
snap prompt-cfgpfrcol-f10-2
key reset
key pgdn
settle 1200
snap prompt-cfgpfrcol-f10-3
key reset
key f12
settle 1200
key reset
key eraseinput

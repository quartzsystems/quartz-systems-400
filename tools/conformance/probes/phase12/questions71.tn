# Open questions on the 7.1 oracle, inside QSTEST only (everything made
# is deleted at the end): ENDCMTCTL with a file open under commitment
# control, a QSH write to a data member, CHKOBJITG's outfile layout.
wait "Sign On"
signon
settle 3000
wait "Main Menu"
timeout 30000
type call qcmd
key enter
wait "Command Entry"
continue
type CRTPF FILE(QSTEST/QSCMT) RCDLEN(10)
key enter
settle 3000
type CRTJRNRCV JRNRCV(QSTEST/QSCMTR)
key enter
settle 3000
type CRTJRN JRN(QSTEST/QSCMTJ) JRNRCV(QSTEST/QSCMTR)
key enter
settle 3000
type STRJRNPF FILE(QSTEST/QSCMT) JRN(QSTEST/QSCMTJ)
key enter
settle 3000
type STRCMTCTL LCKLVL(*CHG)
key enter
settle 3000
type OPNDBF FILE(QSTEST/QSCMT) OPTION(*ALL) COMMIT(*YES)
key enter
settle 3000
type ENDCMTCTL
key enter
settle 3000
snap cmtctl-open
type DSPMSGD RANGE(CPF8355) MSGF(QCPFMSG)
key enter
settle 3000
snap cmtctl-cpf8355
key f3
settle 1500
type DSPMSGD RANGE(CPF8367) MSGF(QCPFMSG)
key enter
settle 3000
snap cmtctl-cpf8367
key f3
settle 1500
type CLOF OPNID(QSCMT)
key enter
settle 2000
type ENDCMTCTL
key enter
settle 3000
snap cmtctl-closed
type ENDJRNPF FILE(QSTEST/QSCMT)
key enter
settle 3000
type DLTF FILE(QSTEST/QSCMT)
key enter
settle 3000
type DLTJRN JRN(QSTEST/QSCMTJ)
key enter
settle 3000
type DLTJRNRCV JRNRCV(QSTEST/QSCMTR) DLTOPT(*IGNINQMSG)
key enter
settle 3000
snap cmtctl-cleanup
type CRTPF FILE(QSTEST/QSDTAF) RCDLEN(20)
key enter
settle 3000
type QSH CMD('echo hello > /qsys.lib/qstest.lib/qsdtaf.file/qsdtaf.mbr; echo rc=$?; wc -c /qsys.lib/qstest.lib/qsdtaf.file/qsdtaf.mbr')
key enter
settle 6000
snap qsh-pfdta
key f3
settle 2000
type DSPFD FILE(QSTEST/QSDTAF) TYPE(*MBR)
key enter
settle 3000
seek "Current number of records" 6
snap qsh-pfdta-dspfd
key f3
settle 1500
type DLTF FILE(QSTEST/QSDTAF)
key enter
settle 3000
type CHKOBJITG OBJ(QSTEST/*ALL) OBJTYPE(*ALL) OUTFILE(QSTEST/QSITG)
key enter
settle 15000
snap chkobjitg-msg
type DSPFFD FILE(QSTEST/QSITG)
key enter
settle 4000
snap chkobjitg-ffd-1
key pgdn
settle 1200
snap chkobjitg-ffd-2
key pgdn
settle 1200
snap chkobjitg-ffd-3
key pgdn
settle 1200
snap chkobjitg-ffd-4
key pgdn
settle 1200
snap chkobjitg-ffd-5
key pgdn
settle 1200
snap chkobjitg-ffd-6
key pgdn
settle 1200
snap chkobjitg-ffd-7
key pgdn
settle 1200
snap chkobjitg-ffd-8
key f3
settle 2000
type DLTF FILE(QSTEST/QSITG)
key enter
settle 3000
type DSPLIB QSTEST
key enter
settle 3000
snap qstest-after
key f3
settle 1500

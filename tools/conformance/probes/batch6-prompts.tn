# Batch 6: command prompts (F4) from Command Entry, plus F24, F9, F10 and F11 states for a few.
wait "Main Menu"
continue
timeout 60000
type call qcmd
key enter
wait "Command Entry"
type crtpf
key f4
settle 1500
snap prompt-crtpf
key f10
settle 1200
snap prompt-crtpf-f10
key f24
settle 800
snap prompt-crtpf-f24
key f11
settle 1000
snap prompt-crtpf-f11
key pgdn
settle 800
snap prompt-crtpf-f11-2
key f12
wait "Command Entry"
type crtlf
key f4
settle 1500
snap prompt-crtlf
key f12
wait "Command Entry"
type crtlib
key f4
settle 1500

# Phase 10: command prompts: TCP/IP configuration, lines, trace and diagnostics.
# Each command is typed on Command Entry and prompted with F4; the
# prompt, F10 (additional parameters) and two Page Downs are captured
# and the prompt is left with F12 (Reset clears the operator error F10
# leaves on a prompt without additional parameters). Enter is never pressed after CALL
# QCMD, so nothing runs; `continue` only skips a refused prompt.
wait "Main Menu"
timeout 20000
type call qcmd
key enter
wait "Command Entry"
continue
key eraseinput
type crtlineth
key f4
settle 1500
snap prompt-crtlineth
key f10
settle 1200
snap prompt-crtlineth-f10
key reset
key pgdn
settle 1000
snap prompt-crtlineth-f10-2
key reset
key pgdn
settle 1000
snap prompt-crtlineth-f10-3
key reset
key f12
wait "Command Entry"
key eraseinput
type chglineth lind(lineth)
key f4
settle 1500
snap prompt-chglineth
key f10
settle 1200
snap prompt-chglineth-f10
key reset
key pgdn
settle 1000
snap prompt-chglineth-f10-2
key reset
key pgdn
settle 1000
snap prompt-chglineth-f10-3
key reset
key f12
wait "Command Entry"

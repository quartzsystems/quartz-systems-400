# Phase 10: command prompts: TCP servers, host servers, mail, DDM/DRDA, printers.
# Each command is typed on Command Entry and prompted with F4; the
# prompt, F10 (additional parameters) and two Page Downs are captured
# and the prompt is left with F12 (Reset clears the operator error F10
# leaves on a prompt without additional parameters). Enter is never pressed after CALL
# QCMD, so nothing runs; `continue` only skips a refused prompt.
wait "Main Menu"
timeout 20000
type call qcmd
key enter
wait "Command Entry"
continue
key eraseinput
type strtcpsvr
key f4
settle 1500
snap prompt-strtcpsvr
key f10
settle 1200
snap prompt-strtcpsvr-f10
key reset
key pgdn
settle 1000
snap prompt-strtcpsvr-f10-2
key reset
key pgdn
settle 1000
snap prompt-strtcpsvr-f10-3
key reset
key f12
wait "Command Entry"
key eraseinput
type endtcpsvr
key f4
settle 1500
snap prompt-endtcpsvr
key f10
settle 1200
snap prompt-endtcpsvr-f10
key reset
key pgdn
settle 1000
snap prompt-endtcpsvr-f10-2
key reset
key pgdn
settle 1000
snap prompt-endtcpsvr-f10-3
key reset
key f12
wait "Command Entry"
key eraseinput

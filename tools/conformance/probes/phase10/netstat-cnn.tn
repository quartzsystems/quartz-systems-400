# Phase 10: NETSTAT, continued: options 5 and 8 on the telnet listener
# (a system job), option 5 only on one proxied telnet connection (pub400
# fronts telnet with a local proxy, so every session shows as 127.0.0.1
# and this session's own connection cannot be told apart; option 8 on
# someone else's connection would show their job), the IPv6 options, the
# stack status, *NBRCACHE and the NETSTAT prompt. Every IPv4 address
# other than 127.x and 0.x is masked.
wait "Main Menu"
timeout 60000
type call qcmd
key enter
wait "Command Entry"
type netstat
key enter
wait "10. Display TCP/IP stack status"
mask ip \b(?:[1-9]|[1-9]\d|1[01]\d|12[0-6]|12[89]|1[3-9]\d|2[0-4]\d|25[0-5])\.\d{1,3}\.\d{1,3}\.\d{1,3}\b => IPADDR
mask ipfrag \b(?:[1-9]|[1-9]\d|1[01]\d|12[0-6]|12[89]|1[3-9]\d|2[0-4]\d|25[0-5])\.\d{1,3}\.\d{1,3}\.\d* *> => IPADDR>
type 3
key enter
settle 2000
pick "re:^\s+\*\s+\*\s+telnet\s+\S+\s+Listen" 5
key enter
settle 1500
snap netstat-3-listen-5 +number
key pgdn
settle 1000
snap netstat-3-listen-5-2 +number
key pgdn
settle 1000
snap netstat-3-listen-5-3 +number
key f12
settle 1500
pick "re:^\s+\*\s+\*\s+telnet\s+\S+\s+Listen" 8
key enter
settle 1500
snap netstat-3-listen-8 +jobnum
key f12
settle 1500
seek "re:^\s+127\.0\.0\.1\s+\d+\s+telnet\s" 60
pick "re:^\s+127\.0\.0\.1\s+\d+\s+telnet\s" 5
key enter
settle 1500
snap netstat-3-cnn-5 +number
key pgdn
settle 1000
snap netstat-3-cnn-5-2 +number
key pgdn
settle 1000
snap netstat-3-cnn-5-3 +number
key f12
settle 1000
key f12
wait "10. Display TCP/IP stack status"
# 4 to 6: IPv6
type 4
key enter
settle 1500
snap netstat-4-ifc6
key f12
wait "10. Display TCP/IP stack status"
type 5
key enter
settle 1500
snap netstat-5-rte6
key f12
wait "10. Display TCP/IP stack status"
type 6
key enter
settle 1500
snap netstat-6-cnn6 +hhmm
key f12
wait "10. Display TCP/IP stack status"
# 10 stack status
type 10
key enter
settle 1500
snap netstat-10-status
key pgdn
settle 1000
snap netstat-10-status-2
key f12
wait "10. Display TCP/IP stack status"
key f12
wait "Command Entry"
# 2026-10-24: V7R5M0 refuses *NBRCACHE as an OPTION value; the
# refusal on Command Entry is the golden.
type netstat option(*nbrcache)
key enter
settle 1500
snap netstat-nbrcache-refused
key eraseinput
type netstat
key f4
settle 1500
snap prompt-netstat
key f12
wait "Command Entry"

# Phase 10: command prompts: IFS, QSH and environment variables.
# Each command is typed on Command Entry and prompted with F4; the
# prompt, F10 (additional parameters) and two Page Downs are captured
# and the prompt is left with F12 (Reset clears the operator error F10
# leaves on a prompt without additional parameters). Enter is never pressed after CALL
# QCMD, so nothing runs; `continue` only skips a refused prompt.
wait "Main Menu"
timeout 20000
type call qcmd
key enter
wait "Command Entry"
continue
key eraseinput
type wrklnk
key f4
settle 1500
snap prompt-wrklnk
key f10
settle 1200
snap prompt-wrklnk-f10
key reset
key pgdn
settle 1000
snap prompt-wrklnk-f10-2
key reset
key pgdn
settle 1000
snap prompt-wrklnk-f10-3
key reset
key f12
wait "Command Entry"
key eraseinput
type dsplnk
key f4
settle 1500
snap prompt-dsplnk
key f10
settle 1200
snap prompt-dsplnk-f10
key reset
key pgdn
settle 1000
snap prompt-dsplnk-f10-2
key reset
key pgdn
settle 1000
snap prompt-dsplnk-f10-3
key reset
key f12
wait "Command Entry"
key eraseinput
type chgaut
key f4
settle 1500
snap prompt-chgaut
key f10
settle 1200
snap prompt-chgaut-f10
key reset
key pgdn
settle 1000
snap prompt-chgaut-f10-2
key reset
key pgdn
settle 1000
snap prompt-chgaut-f10-3
key reset
key f12
wait "Command Entry"
key eraseinput
type dspaut

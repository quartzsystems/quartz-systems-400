# Phase 10: NETSTAT, its menu options, the connection details of this
# session's own telnet connection, and the *NBRCACHE and *STATUS forms.
# Read-only: only options 5 (display) and 8 (jobs) are typed; option 4
# (end) never. QS_CLIENT_IP holds this client's address as the oracle
# sees it. Every IPv4 address other than 127.x and 0.x is masked on the
# connection displays (other users' addresses).
wait "Main Menu"
timeout 60000
type call qcmd
key enter
wait "Command Entry"
type netstat
key enter
wait "10. Display TCP/IP stack status"
snap netstat
# 1 IPv4 interfaces
type 1
key enter
settle 1500
snap netstat-1-ifc
key f11
settle 1000
snap netstat-1-ifc-f11
key f11
settle 1000
pick "127.0.0.1" 5
key enter
settle 1500
snap netstat-1-ifc-5
key pgdn
settle 1000
snap netstat-1-ifc-5-2
key f12
settle 1000
key f12
wait "10. Display TCP/IP stack status"
# 2 IPv4 routes
type 2
key enter
settle 1500
snap netstat-2-rte
key f11
settle 1000
snap netstat-2-rte-f11
key f11
settle 1000
pick "*DFTROUTE" 5
key enter
settle 1500
snap netstat-2-rte-5
key f12
settle 1000
key f12
wait "10. Display TCP/IP stack status"
# 3 IPv4 connections
mask ip \b(?:[1-9]|[1-9]\d|1[01]\d|12[0-6]|12[89]|1[3-9]\d|2[0-4]\d|25[0-5])\.\d{1,3}\.\d{1,3}\.\d{1,3}\b => IPADDR
mask ipfrag \b(?:[1-9]|[1-9]\d|1[01]\d|12[0-6]|12[89]|1[3-9]\d|2[0-4]\d|25[0-5])\.\d{1,3}\.\d{1,3}\.\d* *> => IPADDR>
type 3
key enter
settle 2000
snap netstat-3-cnn +hhmm
key f11
settle 1000
snap netstat-3-cnn-f11 +hhmm
key f11
settle 1000
key f14
settle 1000
snap netstat-3-cnn-f14 +hhmm
key f14
settle 1000
key f12
wait "10. Display TCP/IP stack status"
key f12
wait "Command Entry"

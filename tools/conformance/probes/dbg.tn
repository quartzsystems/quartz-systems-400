snap dbg-cmd-display-watch
key f12
settle 1500
snap dbg-cmd-display-watch-back
cursor 20 16
key eraseeof
type thread
key enter
settle 1500
snap dbg-cmd-thread
key f12
settle 1500
snap dbg-cmd-thread-back
cursor 20 16
key eraseeof
type frob
key enter
settle 1500
snap dbg-cmd-unknown
cursor 20 16
key eraseeof
type help
key enter
settle 1500
snap dbg-cmd-help
key f12
settle 1500
snap dbg-cmd-help-back
key f10
settle 1500
snap dbg-f10
key f12
settle 1500
type dspmodsrc
key enter
wait "Display Module Source"
settle 1000
snap dbg-dspmodsrc-cmd
key f12
settle 1500
type dspbkp
key enter
settle 1500
snap dbg-dspbkp
key f12

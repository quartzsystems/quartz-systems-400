# The commands options run that QS/400 adds: prompts left with F12,
# lists left with F3 (nothing typed on an option line).
key eraseinput
type ?wrkf
key enter
settle 1500
snap prompt-wrkf
key f12
settle 1000
key eraseinput
type wrkf file(qgpl/*all)
key enter
settle 2000
snap wrkf
key f3
settle 1000
key eraseinput
type ?wrkmsgq
key enter
settle 1500
snap prompt-wrkmsgq
key f12
settle 1000
key eraseinput
type wrkmsgq msgq(*libl/*all)
key enter
settle 2000
snap wrkmsgq
key f3
settle 1000

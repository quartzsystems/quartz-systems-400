/* QSTEST: build the conformance library on IBM i and write every     */
/* output the kit compares with. Runs on 7.1: RUNSQLSTM MARGINS(240)   */
/* (the default reads 80 columns), no ADDCOLNAM, the outfiles in       */
/* QSTEST so QHEADERS.SQL can read their column names from the catalog. */
/* Without an RPG compiler, drop the two RLATEST lines.                 */
/* Sources under /home/QSTEST/dds and                                  */
/* /home/QSTEST/data; outputs to /home/QSTEST/out. RLATEST and         */
/* QRESULTS.SQL come from the kit (see README.md).                     */
PGM
  DCL VAR(&SRC) TYPE(*CHAR) LEN(64) VALUE('/home/QSTEST')
  DCL VAR(&OUT) TYPE(*CHAR) LEN(64) VALUE('/home/QSTEST/out')

  DLTLIB LIB(QSTEST)
  MONMSG MSGID(CPF0000)
  CRTLIB LIB(QSTEST) TEXT('Database conformance kit')
  CRTSRCPF FILE(QSTEST/QDDSSRC) RCDLEN(112)
  CRTSRCPF FILE(QSTEST/QSQLSRC) RCDLEN(240)
  MKDIR DIR(&OUT)
  MONMSG MSGID(CPF0000)
  MKDIR DIR('/home/QSTEST/out/data')
  MONMSG MSGID(CPF0000)
  MKDIR DIR('/home/QSTEST/out/sql')
  MONMSG MSGID(CPF0000)

  /* The DDS members, physical files first. */
  CPYFRMSTMF FROMSTMF('/home/QSTEST/dds/CUSTOMER.PF') TOMBR('/QSYS.LIB/QSTEST.LIB/QDDSSRC.FILE/CUSTOMER.MBR') MBROPT(*REPLACE)
  CPYFRMSTMF FROMSTMF('/home/QSTEST/dds/ORDERS.PF') TOMBR('/QSYS.LIB/QSTEST.LIB/QDDSSRC.FILE/ORDERS.MBR') MBROPT(*REPLACE)
  CPYFRMSTMF FROMSTMF('/home/QSTEST/dds/ORDLINE.PF') TOMBR('/QSYS.LIB/QSTEST.LIB/QDDSSRC.FILE/ORDLINE.MBR') MBROPT(*REPLACE)
  CPYFRMSTMF FROMSTMF('/home/QSTEST/dds/PRODUCT.PF') TOMBR('/QSYS.LIB/QSTEST.LIB/QDDSSRC.FILE/PRODUCT.MBR') MBROPT(*REPLACE)
  CPYFRMSTMF FROMSTMF('/home/QSTEST/dds/INVENTORY.PF') TOMBR('/QSYS.LIB/QSTEST.LIB/QDDSSRC.FILE/INVENTORY.MBR') MBROPT(*REPLACE)
  CPYFRMSTMF FROMSTMF('/home/QSTEST/dds/EVENTS.PF') TOMBR('/QSYS.LIB/QSTEST.LIB/QDDSSRC.FILE/EVENTS.MBR') MBROPT(*REPLACE)
  CPYFRMSTMF FROMSTMF('/home/QSTEST/dds/TYPES.PF') TOMBR('/QSYS.LIB/QSTEST.LIB/QDDSSRC.FILE/TYPES.MBR') MBROPT(*REPLACE)
  CPYFRMSTMF FROMSTMF('/home/QSTEST/dds/NOTES.PF') TOMBR('/QSYS.LIB/QSTEST.LIB/QDDSSRC.FILE/NOTES.MBR') MBROPT(*REPLACE)
  CPYFRMSTMF FROMSTMF('/home/QSTEST/dds/LOGHIST.PF') TOMBR('/QSYS.LIB/QSTEST.LIB/QDDSSRC.FILE/LOGHIST.MBR') MBROPT(*REPLACE)
  CPYFRMSTMF FROMSTMF('/home/QSTEST/dds/RLALOG.PF') TOMBR('/QSYS.LIB/QSTEST.LIB/QDDSSRC.FILE/RLALOG.MBR') MBROPT(*REPLACE)
  CPYFRMSTMF FROMSTMF('/home/QSTEST/dds/CUSBYNAME.LF') TOMBR('/QSYS.LIB/QSTEST.LIB/QDDSSRC.FILE/CUSBYNAME.MBR') MBROPT(*REPLACE)
  CPYFRMSTMF FROMSTMF('/home/QSTEST/dds/ORDBYCUS.LF') TOMBR('/QSYS.LIB/QSTEST.LIB/QDDSSRC.FILE/ORDBYCUS.MBR') MBROPT(*REPLACE)
  CPYFRMSTMF FROMSTMF('/home/QSTEST/dds/PRDBYDESC.LF') TOMBR('/QSYS.LIB/QSTEST.LIB/QDDSSRC.FILE/PRDBYDESC.MBR') MBROPT(*REPLACE)
  CPYFRMSTMF FROMSTMF('/home/QSTEST/dds/CUSORD.LF') TOMBR('/QSYS.LIB/QSTEST.LIB/QDDSSRC.FILE/CUSORD.MBR') MBROPT(*REPLACE)
  CPYFRMSTMF FROMSTMF('/home/QSTEST/dds/ORDALL.LF') TOMBR('/QSYS.LIB/QSTEST.LIB/QDDSSRC.FILE/ORDALL.MBR') MBROPT(*REPLACE)
  CPYFRMSTMF FROMSTMF('/home/QSTEST/dds/ORDJOIN.LF') TOMBR('/QSYS.LIB/QSTEST.LIB/QDDSSRC.FILE/ORDJOIN.MBR') MBROPT(*REPLACE)
  CPYFRMSTMF FROMSTMF('/home/QSTEST/dds/ACTIVE.LF') TOMBR('/QSYS.LIB/QSTEST.LIB/QDDSSRC.FILE/ACTIVE.MBR') MBROPT(*REPLACE)
  CPYFRMSTMF FROMSTMF('/home/QSTEST/dds/BIGORD.LF') TOMBR('/QSYS.LIB/QSTEST.LIB/QDDSSRC.FILE/BIGORD.MBR') MBROPT(*REPLACE)

  CRTPF FILE(QSTEST/CUSTOMER) SRCFILE(QSTEST/QDDSSRC)
  CRTPF FILE(QSTEST/ORDERS) SRCFILE(QSTEST/QDDSSRC)
  CRTPF FILE(QSTEST/ORDLINE) SRCFILE(QSTEST/QDDSSRC)
  CRTPF FILE(QSTEST/PRODUCT) SRCFILE(QSTEST/QDDSSRC)
  CRTPF FILE(QSTEST/INVENTORY) SRCFILE(QSTEST/QDDSSRC)
  CRTPF FILE(QSTEST/EVENTS) SRCFILE(QSTEST/QDDSSRC)
  CRTPF FILE(QSTEST/TYPES) SRCFILE(QSTEST/QDDSSRC)
  CRTPF FILE(QSTEST/NOTES) SRCFILE(QSTEST/QDDSSRC)
  CRTPF FILE(QSTEST/LOGHIST) SRCFILE(QSTEST/QDDSSRC) REUSEDLT(*YES)
  CRTPF FILE(QSTEST/RLALOG) SRCFILE(QSTEST/QDDSSRC)
  CRTLF FILE(QSTEST/CUSBYNAME) SRCFILE(QSTEST/QDDSSRC)
  CRTLF FILE(QSTEST/ORDBYCUS) SRCFILE(QSTEST/QDDSSRC)
  CRTLF FILE(QSTEST/PRDBYDESC) SRCFILE(QSTEST/QDDSSRC)
  CRTLF FILE(QSTEST/CUSORD) SRCFILE(QSTEST/QDDSSRC)
  CRTLF FILE(QSTEST/ORDALL) SRCFILE(QSTEST/QDDSSRC)
  CRTLF FILE(QSTEST/ORDJOIN) SRCFILE(QSTEST/QDDSSRC)
  CRTLF FILE(QSTEST/ACTIVE) SRCFILE(QSTEST/QDDSSRC)
  CRTLF FILE(QSTEST/BIGORD) SRCFILE(QSTEST/QDDSSRC)

  /* The data: ISO dates and times whatever the field's format, nulls empty. */
  CPYFRMIMPF FROMSTMF('/home/QSTEST/data/CUSTOMER.csv') TOFILE(QSTEST/CUSTOMER) MBROPT(*REPLACE) RCDDLM(*LF) DATFMT(*ISO) TIMFMT(*ISO) RPLNULLVAL(*FLDDFT)
  CPYFRMIMPF FROMSTMF('/home/QSTEST/data/ORDERS.csv') TOFILE(QSTEST/ORDERS) MBROPT(*REPLACE) RCDDLM(*LF) DATFMT(*ISO) TIMFMT(*ISO) RPLNULLVAL(*FLDDFT)
  CPYFRMIMPF FROMSTMF('/home/QSTEST/data/ORDLINE.csv') TOFILE(QSTEST/ORDLINE) MBROPT(*REPLACE) RCDDLM(*LF)
  CPYFRMIMPF FROMSTMF('/home/QSTEST/data/PRODUCT.csv') TOFILE(QSTEST/PRODUCT) MBROPT(*REPLACE) RCDDLM(*LF)
  CPYFRMIMPF FROMSTMF('/home/QSTEST/data/INVENTORY.csv') TOFILE(QSTEST/INVENTORY) MBROPT(*REPLACE) RCDDLM(*LF) DATFMT(*ISO) RPLNULLVAL(*FLDDFT)
  CPYFRMIMPF FROMSTMF('/home/QSTEST/data/EVENTS.csv') TOFILE(QSTEST/EVENTS) MBROPT(*REPLACE) RCDDLM(*LF) DATFMT(*ISO) TIMFMT(*ISO)
  CPYFRMIMPF FROMSTMF('/home/QSTEST/data/TYPES.csv') TOFILE(QSTEST/TYPES) MBROPT(*REPLACE) RCDDLM(*LF) DATFMT(*ISO) TIMFMT(*ISO) RPLNULLVAL(*FLDDFT)
  CPYFRMIMPF FROMSTMF('/home/QSTEST/data/NOTES.csv') TOFILE(QSTEST/NOTES) MBROPT(*REPLACE) RCDDLM(*LF) RPLNULLVAL(*FLDDFT)
  CPYFRMIMPF FROMSTMF('/home/QSTEST/data/LOGHIST.csv') TOFILE(QSTEST/LOGHIST) MBROPT(*REPLACE) RCDDLM(*LF)

  /* The journal, then the script. */
  CRTJRNRCV JRNRCV(QSTEST/QSTRCV0001)
  CRTJRN JRN(QSTEST/QSTJRN) JRNRCV(QSTEST/QSTRCV0001)
  STRJRNPF FILE(QSTEST/CUSTOMER) JRN(QSTEST/QSTJRN) IMAGES(*BOTH)
  CRTBNDRPG PGM(QSTEST/RLATEST) SRCSTMF('/home/QSTEST/oracle/RLATEST.RPGLE')
  CALL PGM(QSTEST/RLATEST)

  /* The queries as tables. */
  CPYFRMSTMF FROMSTMF('/home/QSTEST/oracle/QRESULTS.SQL') TOMBR('/QSYS.LIB/QSTEST.LIB/QSQLSRC.FILE/QRESULTS.MBR') MBROPT(*REPLACE)
  RUNSQLSTM SRCFILE(QSTEST/QSQLSRC) SRCMBR(QRESULTS) NAMING(*SYS) COMMIT(*NONE) ERRLVL(30) MARGINS(240)

  /* Exports: every physical file and the single-format logical files. */
  CPYTOIMPF FROMFILE(QSTEST/CUSTOMER) TOSTMF('/home/QSTEST/out/data/CUSTOMER.csv') MBROPT(*REPLACE) STMFCODPAG(*PCASCII) RCDDLM(*LF) DATFMT(*ISO) TIMFMT(*ISO)
  CPYTOIMPF FROMFILE(QSTEST/ORDERS) TOSTMF('/home/QSTEST/out/data/ORDERS.csv') MBROPT(*REPLACE) STMFCODPAG(*PCASCII) RCDDLM(*LF) DATFMT(*ISO) TIMFMT(*ISO)
  CPYTOIMPF FROMFILE(QSTEST/ORDLINE) TOSTMF('/home/QSTEST/out/data/ORDLINE.csv') MBROPT(*REPLACE) STMFCODPAG(*PCASCII) RCDDLM(*LF)
  CPYTOIMPF FROMFILE(QSTEST/PRODUCT) TOSTMF('/home/QSTEST/out/data/PRODUCT.csv') MBROPT(*REPLACE) STMFCODPAG(*PCASCII) RCDDLM(*LF)
  CPYTOIMPF FROMFILE(QSTEST/INVENTORY) TOSTMF('/home/QSTEST/out/data/INVENTORY.csv') MBROPT(*REPLACE) STMFCODPAG(*PCASCII) RCDDLM(*LF) DATFMT(*ISO)
  CPYTOIMPF FROMFILE(QSTEST/EVENTS) TOSTMF('/home/QSTEST/out/data/EVENTS.csv') MBROPT(*REPLACE) STMFCODPAG(*PCASCII) RCDDLM(*LF) DATFMT(*ISO) TIMFMT(*ISO)
  CPYTOIMPF FROMFILE(QSTEST/TYPES) TOSTMF('/home/QSTEST/out/data/TYPES.csv') MBROPT(*REPLACE) STMFCODPAG(*PCASCII) RCDDLM(*LF) DATFMT(*ISO) TIMFMT(*ISO)
  CPYTOIMPF FROMFILE(QSTEST/NOTES) TOSTMF('/home/QSTEST/out/data/NOTES.csv') MBROPT(*REPLACE) STMFCODPAG(*PCASCII) RCDDLM(*LF)
  CPYTOIMPF FROMFILE(QSTEST/LOGHIST) TOSTMF('/home/QSTEST/out/data/LOGHIST.csv') MBROPT(*REPLACE) STMFCODPAG(*PCASCII) RCDDLM(*LF)
  CPYTOIMPF FROMFILE(QSTEST/RLALOG) TOSTMF('/home/QSTEST/out/data/RLALOG.csv') MBROPT(*REPLACE) STMFCODPAG(*PCASCII) RCDDLM(*LF)
  CPYTOIMPF FROMFILE(QSTEST/CUSBYNAME) TOSTMF('/home/QSTEST/out/data/CUSBYNAME.csv') MBROPT(*REPLACE) STMFCODPAG(*PCASCII) RCDDLM(*LF) DATFMT(*ISO)
  CPYTOIMPF FROMFILE(QSTEST/ORDBYCUS) TOSTMF('/home/QSTEST/out/data/ORDBYCUS.csv') MBROPT(*REPLACE) STMFCODPAG(*PCASCII) RCDDLM(*LF) DATFMT(*ISO) TIMFMT(*ISO)
  CPYTOIMPF FROMFILE(QSTEST/PRDBYDESC) TOSTMF('/home/QSTEST/out/data/PRDBYDESC.csv') MBROPT(*REPLACE) STMFCODPAG(*PCASCII) RCDDLM(*LF)
  CPYTOIMPF FROMFILE(QSTEST/ORDJOIN) TOSTMF('/home/QSTEST/out/data/ORDJOIN.csv') MBROPT(*REPLACE) STMFCODPAG(*PCASCII) RCDDLM(*LF)
  CPYTOIMPF FROMFILE(QSTEST/ACTIVE) TOSTMF('/home/QSTEST/out/data/ACTIVE.csv') MBROPT(*REPLACE) STMFCODPAG(*PCASCII) RCDDLM(*LF) DATFMT(*ISO)
  CPYTOIMPF FROMFILE(QSTEST/BIGORD) TOSTMF('/home/QSTEST/out/data/BIGORD.csv') MBROPT(*REPLACE) STMFCODPAG(*PCASCII) RCDDLM(*LF) DATFMT(*ISO) TIMFMT(*ISO)

  /* The script log as rla.csv, with a header line the comparer maps. */
  CPYTOIMPF FROMFILE(QSTEST/RLALOG) TOSTMF('/home/QSTEST/out/rla.csv') MBROPT(*REPLACE) STMFCODPAG(*PCASCII) RCDDLM(*LF)

  /* Field descriptions, level identifiers and the journal through outfiles. */
  DSPFFD FILE(QSTEST/*ALL) OUTPUT(*OUTFILE) OUTFILE(QSTEST/FFD)
  CPYTOIMPF FROMFILE(QSTEST/FFD) TOSTMF('/home/QSTEST/out/ffd.csv') MBROPT(*REPLACE) STMFCODPAG(*PCASCII) RCDDLM(*LF)
  DSPFD FILE(QSTEST/*ALL) TYPE(*RCDFMT) OUTPUT(*OUTFILE) OUTFILE(QSTEST/LVLID)
  CPYTOIMPF FROMFILE(QSTEST/LVLID) TOSTMF('/home/QSTEST/out/lvlid.csv') MBROPT(*REPLACE) STMFCODPAG(*PCASCII) RCDDLM(*LF)
  DSPJRN JRN(QSTEST/QSTJRN) OUTPUT(*OUTFILE) OUTFILFMT(*TYPE1) OUTFILE(QSTEST/JRN)
  CPYTOIMPF FROMFILE(QSTEST/JRN) TOSTMF('/home/QSTEST/out/dspjrn.csv') MBROPT(*REPLACE) STMFCODPAG(*PCASCII) RCDDLM(*LF)

  /* The query results. */
  CPYTOIMPF FROMFILE(QSTEST/QRES01) TOSTMF('/home/QSTEST/out/sql/Q01.csv') MBROPT(*REPLACE) STMFCODPAG(*PCASCII) RCDDLM(*LF) DATFMT(*ISO) TIMFMT(*ISO)
  CPYTOIMPF FROMFILE(QSTEST/QRES02) TOSTMF('/home/QSTEST/out/sql/Q02.csv') MBROPT(*REPLACE) STMFCODPAG(*PCASCII) RCDDLM(*LF)
  CPYTOIMPF FROMFILE(QSTEST/QRES03) TOSTMF('/home/QSTEST/out/sql/Q03.csv') MBROPT(*REPLACE) STMFCODPAG(*PCASCII) RCDDLM(*LF)
  CPYTOIMPF FROMFILE(QSTEST/QRES04) TOSTMF('/home/QSTEST/out/sql/Q04.csv') MBROPT(*REPLACE) STMFCODPAG(*PCASCII) RCDDLM(*LF)
  CPYTOIMPF FROMFILE(QSTEST/QRES05) TOSTMF('/home/QSTEST/out/sql/Q05.csv') MBROPT(*REPLACE) STMFCODPAG(*PCASCII) RCDDLM(*LF)
  CPYTOIMPF FROMFILE(QSTEST/QRES06) TOSTMF('/home/QSTEST/out/sql/Q06.csv') MBROPT(*REPLACE) STMFCODPAG(*PCASCII) RCDDLM(*LF)
  CPYTOIMPF FROMFILE(QSTEST/QRES07) TOSTMF('/home/QSTEST/out/sql/Q07.csv') MBROPT(*REPLACE) STMFCODPAG(*PCASCII) RCDDLM(*LF)
  CPYTOIMPF FROMFILE(QSTEST/QRES08) TOSTMF('/home/QSTEST/out/sql/Q08.csv') MBROPT(*REPLACE) STMFCODPAG(*PCASCII) RCDDLM(*LF) DATFMT(*ISO) TIMFMT(*ISO)
  CPYTOIMPF FROMFILE(QSTEST/QRES09) TOSTMF('/home/QSTEST/out/sql/Q09.csv') MBROPT(*REPLACE) STMFCODPAG(*PCASCII) RCDDLM(*LF) DATFMT(*ISO) TIMFMT(*ISO)
  CPYTOIMPF FROMFILE(QSTEST/QRES10) TOSTMF('/home/QSTEST/out/sql/Q10.csv') MBROPT(*REPLACE) STMFCODPAG(*PCASCII) RCDDLM(*LF)
  CPYTOIMPF FROMFILE(QSTEST/QRES11) TOSTMF('/home/QSTEST/out/sql/Q11.csv') MBROPT(*REPLACE) STMFCODPAG(*PCASCII) RCDDLM(*LF)
  CPYTOIMPF FROMFILE(QSTEST/QRES12) TOSTMF('/home/QSTEST/out/sql/Q12.csv') MBROPT(*REPLACE) STMFCODPAG(*PCASCII) RCDDLM(*LF)
  /* Column names of the outfiles, from the catalog (7.1 has no header option). */
  CPYFRMSTMF FROMSTMF('/home/QSTEST/oracle/QHEADERS.SQL') TOMBR('/QSYS.LIB/QSTEST.LIB/QSQLSRC.FILE/QHEADERS.MBR') MBROPT(*REPLACE)
  RUNSQLSTM SRCFILE(QSTEST/QSQLSRC) SRCMBR(QHEADERS) NAMING(*SYS) COMMIT(*NONE) ERRLVL(30) MARGINS(240)
  CPYTOIMPF FROMFILE(QSTEST/FFDH) TOSTMF('/home/QSTEST/out/ffd.hdr') MBROPT(*REPLACE) STMFCODPAG(*PCASCII) RCDDLM(*LF)
  CPYTOIMPF FROMFILE(QSTEST/LVLIDH) TOSTMF('/home/QSTEST/out/lvlid.hdr') MBROPT(*REPLACE) STMFCODPAG(*PCASCII) RCDDLM(*LF)
  CPYTOIMPF FROMFILE(QSTEST/JRNH) TOSTMF('/home/QSTEST/out/dspjrn.hdr') MBROPT(*REPLACE) STMFCODPAG(*PCASCII) RCDDLM(*LF)
  CPYTOIMPF FROMFILE(QSTEST/RLALOGH) TOSTMF('/home/QSTEST/out/rla.hdr') MBROPT(*REPLACE) STMFCODPAG(*PCASCII) RCDDLM(*LF)
ENDPGM

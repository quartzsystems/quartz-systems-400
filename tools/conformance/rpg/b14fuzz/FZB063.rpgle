      line = 'P009 V2 ' + '[' + V2 + ']';
      write QSYSPRT line;
    endfor;
  endfor;
endif;
line = 'P010 V0 ' + %char(V0);
write QSYSPRT line;
line = 'P011 V1 ' + V1;
write QSYSPRT line;
line = 'P012 V2 ' + '[' + V2 + ']';
write QSYSPRT line;
line = 'P013 V3 ' + %char(V3);
write QSYSPRT line;
line = 'P014 V4 ' + '[' + V4 + ']';
write QSYSPRT line;
end-proc;

**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s I0 int(10);
dcl-s I1 int(10);
dcl-s I2 int(10);
dcl-s V0 packed(1:1);
dcl-s V1 ind inz(*on);
dcl-s V2 char(6) inz('RPG');
dcl-s V3 packed(3:0);
dcl-s V4 int(10);
dcl-s V5 ind;
dcl-s V6 char(13) inz('abc');
dcl-s V7 zoned(1:0);
dcl-s V8 packed(3:0);
if 'Quartz' + 'zz' >= 'x' + '  pad  ';
  for I0 = 1 to 1;
    monitor;
      V1 = 236 >= 512;
    on-error;
      line = 'P001 E ' + %char(%status());
      write QSYSPRT line;
    endmon;
    line = 'P002 V1 ' + V1;
    write QSYSPRT line;
    if ((%rem(%int(V7) : 4) + %rem(%int(V7) : 8)) < %int((V8 * V8)) and 'abc' < V6 + V6);
      monitor;
        V1 = '0123' <= %char(V8);
      on-error;
        line = 'P003 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      line = 'P004 V1 ' + V1;
      write QSYSPRT line;
      monitor;
        V2 = V2;
      on-error;
        line = 'P005 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      line = 'P006 V2 ' + '[' + V2 + ']';
      write QSYSPRT line;
    elseif %char(14) <> %subst(V6 : 2 : 3);
      monitor;
        V2 = V2;
      on-error;
        line = 'P007 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      line = 'P008 V2 ' + '[' + V2 + ']';
      write QSYSPRT line;
    endif;
    monitor;
      V4 = 7;
    on-error;
      line = 'P009 E ' + %char(%status());
      write QSYSPRT line;
    endmon;
  endfor;
endif;
monitor;
  eval(h) V8 = %len(V6);
on-error;
  line = 'P010 E ' + %char(%status());
  write QSYSPRT line;
endmon;
line = 'P011 V8 ' + %char(V8);
write QSYSPRT line;
line = 'P012 V0 ' + %char(V0);
write QSYSPRT line;
line = 'P013 V1 ' + V1;
write QSYSPRT line;
line = 'P014 V2 ' + '[' + V2 + ']';
write QSYSPRT line;
line = 'P015 V3 ' + %char(V3);
write QSYSPRT line;
line = 'P016 V4 ' + %char(V4);
write QSYSPRT line;
line = 'P017 V5 ' + V5;
write QSYSPRT line;
line = 'P018 V6 ' + '[' + V6 + ']';
write QSYSPRT line;
line = 'P019 V7 ' + %char(V7);
write QSYSPRT line;
line = 'P020 V8 ' + %char(V8);
write QSYSPRT line;
*inlr = *on;

**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s I0 int(10);
dcl-s I1 int(10);
dcl-s I2 int(10);
dcl-s V0 char(8);
dcl-s V1 varchar(22) inz('  pad  ');
dcl-s V2 varchar(7);
dcl-s V3 zoned(8:3);
dcl-s V4 int(10);
dcl-s V5 ind;
monitor;
  V2 = %char(%dec(V3 : 15 : 2));
on-error;
  line = 'P001 E ' + %char(%status());
  write QSYSPRT line;
endmon;
if %scan('x' : V2) <> (V3 * -463);
  if %rem(%int(902) : 9) = V3;
    select;
    when %abs(%abs(446)) >= -173.48;
      monitor;
        V0 = %subst(V0 : 3 : 5);
      on-error;
        line = 'P002 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      monitor;
        V2 = %trim(V2 + 'RPG');
      on-error;
        line = 'P003 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      line = 'P004 V2 ' + '[' + V2 + ']';
      write QSYSPRT line;
      monitor;
        V3 = %dec((%rem(%int(V3) : 3) * -877) : 15 : 2);
      on-error;
        line = 'P005 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
    when (V0 > V2 or V3 <> %int(V3));
      monitor;
        V5 = 737.20 = (-258.28 - 925.30);
      on-error;
        line = 'P006 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      line = 'P007 V5 ' + V5;
      write QSYSPRT line;
      monitor;
        V4 = (%abs(%abs(V3)) + V4);
      on-error;
        line = 'P008 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      monitor;
        V3 = 896;
      on-error;
        line = 'P009 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
    other;
      monitor;
        V5 = (((-374 - V3) - (474 + 400.62)) > (870 / 8) or (V3 + V4) >= (458 / 9));
      on-error;
        line = 'P010 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      line = 'P011 V5 ' + V5;
      write QSYSPRT line;
    endsl;
    monitor;
      V4 = 321.50;
    on-error;
      line = 'P012 E ' + %char(%status());
      write QSYSPRT line;
    endmon;
    select;
    when V5;
      monitor;
        V1 = V0 + %char(528);
      on-error;
        line = 'P013 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
    when V1 > %char(852);
      monitor;
        V0 = %char((98.31 - V3));
      on-error;
        line = 'P014 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      monitor;
        V4 = 257.45;
      on-error;
        line = 'P015 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
    endsl;
  endif;
  monitor;
    V0 = %char(V4);
  on-error;
    line = 'P016 E ' + %char(%status());
    write QSYSPRT line;
  endmon;
  line = 'P017 V0 ' + '[' + V0 + ']';
  write QSYSPRT line;
else;
  monitor;
    V4 = (%dec(184 : 15 : 2) + %dec((805.45 - 128) : 15 : 2));
  on-error;
    line = 'P018 E ' + %char(%status());
    write QSYSPRT line;
  endmon;
  line = 'P019 V4 ' + %char(V4);
  write QSYSPRT line;
endif;
if V5;
  monitor;
    V1 = V2;
  on-error;
    line = 'P020 E ' + %char(%status());
    write QSYSPRT line;
  endmon;
else;
endif;
line = 'P021 V0 ' + '[' + V0 + ']';
write QSYSPRT line;
line = 'P022 V1 ' + '[' + V1 + ']';
write QSYSPRT line;
line = 'P023 V2 ' + '[' + V2 + ']';
write QSYSPRT line;
line = 'P024 V3 ' + %char(V3);
write QSYSPRT line;
line = 'P025 V4 ' + %char(V4);
write QSYSPRT line;
line = 'P026 V5 ' + V5;
write QSYSPRT line;
*inlr = *on;

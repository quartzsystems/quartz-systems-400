write QSYSPRT line;
line = 'P034 V4 ' + V4;
write QSYSPRT line;
line = 'P035 V5 ' + %char(V5);
write QSYSPRT line;
line = 'P036 V6 ' + '[' + V6 + ']';
write QSYSPRT line;
end-proc;
dcl-proc F0959;
  dcl-pi *n packed(15:2);
    a packed(15:2) value;
  end-pi;
  return a * 2 + 75;
end-proc;

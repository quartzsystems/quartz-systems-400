**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s I0 int(10);
dcl-s I1 int(10);
dcl-s I2 int(10);
dcl-s V0 char(12) inz('hello world');
dcl-s V1 char(17);
dcl-s V2 int(10);
dcl-s V3 packed(4:3);
dcl-s V4 packed(13:4);
dcl-s V5 varchar(19);
dcl-s V6 char(13);
dcl-s V7 zoned(9:2);
dcl-s V8 char(11) inz('  pad  ');
monitor;
  V1 = '  pad  ';
on-error;
  line = 'P001 E ' + %char(%status());
  write QSYSPRT line;
endmon;
for I0 = 1 to 2;
  monitor;
    V6 = V1 + %char(959);
  on-error;
    line = 'P002 E ' + %char(%status());
    write QSYSPRT line;
  endmon;
endfor;
if V7 > %scan('z' : V5);
  for I0 = 1 to 2;
    monitor;
      V7 = V7;
    on-error;
      line = 'P003 E ' + %char(%status());
      write QSYSPRT line;
    endmon;
    line = 'P004 V7 ' + %char(V7);
    write QSYSPRT line;
    select;
    when not (%subst(V8 : 10 : 2) > V5 + 'abc');
      monitor;
        V2 = 613;
      on-error;
        line = 'P005 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      line = 'P006 V2 ' + %char(V2);
      write QSYSPRT line;
      monitor;
        eval(h) V4 = 874.39;
      on-error;
        line = 'P007 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
    when %triml(V0) > %trim(V0);
      monitor;
        V0 = %subst(V0 : 12 : 1);
      on-error;
        line = 'P008 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      monitor;
        V0 = V8;
      on-error;
        line = 'P009 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
    endsl;
    select;
    when 'Quartz' + 'RPG' <= 'Quartz' + V0;
      monitor;
        V0 = 'x';
      on-error;
        line = 'P010 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      monitor;
        V2 = %abs(V7);
      on-error;
        line = 'P011 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      line = 'P012 V2 ' + %char(V2);
      write QSYSPRT line;
    when ((124 - V3) - -655) < ((V2 - 683) - %dec(-860 : 15 : 2));
      monitor;
        eval(h) V3 = 628.44;
      on-error;
        line = 'P013 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
    when V4 <= (543 + 557);
      monitor;
        V8 = %char(V2) + 'Quartz' + V8;
      on-error;
        line = 'P014 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      line = 'P015 V8 ' + '[' + V8 + ']';
      write QSYSPRT line;
    other;
    endsl;
  endfor;
endif;
line = 'P016 V0 ' + '[' + V0 + ']';
write QSYSPRT line;
line = 'P017 V1 ' + '[' + V1 + ']';
write QSYSPRT line;
line = 'P018 V2 ' + %char(V2);
write QSYSPRT line;
line = 'P019 V3 ' + %char(V3);
write QSYSPRT line;
line = 'P020 V4 ' + %char(V4);
write QSYSPRT line;
line = 'P021 V5 ' + '[' + V5 + ']';
write QSYSPRT line;
line = 'P022 V6 ' + '[' + V6 + ']';
write QSYSPRT line;
line = 'P023 V7 ' + %char(V7);
write QSYSPRT line;
line = 'P024 V8 ' + '[' + V8 + ']';
write QSYSPRT line;
*inlr = *on;

        line = 'P010 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      monitor;
        V7 = %trimr(%char(974));
      on-error;
        line = 'P011 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      line = 'P012 V7 ' + '[' + V7 + ']';
      write QSYSPRT line;
      monitor;
        V8 = %dec(V1 : 15 : 2);
      on-error;
        line = 'P013 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
    when 'Quartz' + V4 <> %subst(V7 : 8 : 1);
      monitor;
        V6 = V4;
      on-error;
        line = 'P014 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
    endsl;
    if %subst(V7 : 7 : 1) > %char(V2);
      monitor;
        V1 = %dec(%dec(V8 : 15 : 2) : 15 : 2);
      on-error;
        line = 'P015 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
    else;
      monitor;
        V7 = V0;
      on-error;
        line = 'P016 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      monitor;
        V5 = V7;
      on-error;
        line = 'P017 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      line = 'P018 V5 ' + '[' + V5 + ']';
      write QSYSPRT line;
    endif;
  when 803.42 = 536;
    for I0 = 1 to 1;
      monitor;
        V7 = %trim(V4 + '  pad  ');
      on-error;
        line = 'P019 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      line = 'P020 V7 ' + '[' + V7 + ']';
      write QSYSPRT line;
      monitor;
        V2 = %dec((373 / 8) : 15 : 2);
      on-error;
        line = 'P021 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      monitor;
        V4 = 'zz';
      on-error;
        line = 'P022 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      line = 'P023 V4 ' + '[' + V4 + ']';

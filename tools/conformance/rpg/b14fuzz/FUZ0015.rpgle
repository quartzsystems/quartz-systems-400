        line = 'P007 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      line = 'P008 V4 ' + '[' + V4 + ']';
      write QSYSPRT line;
      monitor;
        V7 = V6;
      on-error;
        line = 'P009 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
    when 886 <> %dec(73 : 15 : 2);
      monitor;
        V7 = V4 + %char(V1);

**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s I0 int(10);
dcl-s I1 int(10);
dcl-s I2 int(10);
dcl-s V0 int(10);
dcl-s V1 packed(8:0);
dcl-s V2 packed(15:1);
dcl-s V3 zoned(7:0);
dcl-s V4 varchar(3) inz('RPG');
dcl-s V5 zoned(8:0);
dcl-s V6 int(10);
monitor;
  V4 = %char(V3);
on-error;
  line = 'P001 E ' + %char(%status());
  write QSYSPRT line;
endmon;
for I0 = 1 by 2 to 2;
  for I1 = 1 by 2 to 3;
    monitor;
      V0 = (992 + V1);
    on-error;
      line = 'P002 E ' + %char(%status());
      write QSYSPRT line;
    endmon;
    for I2 = 1 to 3;
      monitor;
        V6 = V6;
      on-error;
        line = 'P003 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      line = 'P004 V6 ' + %char(V6);
      write QSYSPRT line;
      monitor;
        V2 = 12;
      on-error;
        line = 'P005 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      line = 'P006 V2 ' + %char(V2);
      write QSYSPRT line;
    endfor;
  endfor;
endfor;
for I0 = 1 to 3;
  monitor;
    eval(h) V0 = %int(V1);
  on-error;
    line = 'P007 E ' + %char(%status());
    write QSYSPRT line;
  endmon;
  line = 'P008 V0 ' + %char(V0);
  write QSYSPRT line;
  monitor;
    eval(h) V6 = 956.90;
  on-error;
    line = 'P009 E ' + %char(%status());
    write QSYSPRT line;
  endmon;
endfor;
for I0 = 1 to 1;
  if '0123' + V4 = V4 + '  pad  ';
    if %char(794) = V4 + 'RPG';
      monitor;
        eval(h) V2 = %abs((%len(V4) - (V1 + V3)));
      on-error;
        line = 'P010 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      monitor;
        V1 = 492.38;
      on-error;
        line = 'P011 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      line = 'P012 V1 ' + %char(V1);
      write QSYSPRT line;
    else;
      monitor;
        V3 = 671.27;
      on-error;
        line = 'P013 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      line = 'P014 V3 ' + %char(V3);
      write QSYSPRT line;
    endif;
  else;
  endif;
endfor;
line = 'P015 V0 ' + %char(V0);
write QSYSPRT line;
line = 'P016 V1 ' + %char(V1);
write QSYSPRT line;
line = 'P017 V2 ' + %char(V2);
write QSYSPRT line;
line = 'P018 V3 ' + %char(V3);
write QSYSPRT line;
line = 'P019 V4 ' + '[' + V4 + ']';
write QSYSPRT line;
line = 'P020 V5 ' + %char(V5);
write QSYSPRT line;
line = 'P021 V6 ' + %char(V6);
write QSYSPRT line;
*inlr = *on;

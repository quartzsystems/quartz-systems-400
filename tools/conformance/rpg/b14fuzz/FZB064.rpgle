      monitor;
        V6 = 624.69 < (%abs(-569) - (V2 - V5));
      on-error;
        line = 'P006 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      line = 'P007 V6 ' + V6;
      write QSYSPRT line;
    endfor;
    if V3;
      monitor;
        V1 = %triml(%char(V5));
      on-error;
        line = 'P008 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      monitor;
        eval(h) V2 = %abs(%int((V5 + V2)));
      on-error;
        line = 'P009 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      line = 'P010 V2 ' + %char(V2);
      write QSYSPRT line;
      monitor;
        V4 = 'RPG';
      on-error;
        line = 'P011 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      line = 'P012 V4 ' + '[' + V4 + ']';
      write QSYSPRT line;
    elseif %triml('  pad  ') <= %triml(V0);
      monitor;
        V1 = %char((993 + V2));
      on-error;
        line = 'P013 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
    endif;
    monitor;
      V3 = V3;
    on-error;
      line = 'P014 E ' + %char(%status());
      write QSYSPRT line;
    endmon;
  endsl;
endif;
line = 'P015 V0 ' + '[' + V0 + ']';
write QSYSPRT line;
line = 'P016 V1 ' + '[' + V1 + ']';
write QSYSPRT line;
line = 'P017 V2 ' + %char(V2);
write QSYSPRT line;
line = 'P018 V3 ' + V3;
write QSYSPRT line;
line = 'P019 V4 ' + '[' + V4 + ']';
write QSYSPRT line;
line = 'P020 V5 ' + %char(V5);
write QSYSPRT line;
line = 'P021 V6 ' + V6;
write QSYSPRT line;
end-proc;

**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s I0 int(10);
dcl-s I1 int(10);
dcl-s I2 int(10);
dcl-s V0 varchar(6);
dcl-s V1 varchar(8) inz('RPG');
dcl-s V2 ind;
dcl-s V3 zoned(1:0);
dcl-s V4 int(10);
dcl-s V5 int(10);
dcl-s V6 int(10);
dcl-s V7 varchar(20);
monitor;
  V5 = (%abs(V4) * (274.73 - V5));
on-error;
  line = 'P001 E ' + %char(%status());
  write QSYSPRT line;
endmon;
monitor;
  V1 = %trimr(V0);
on-error;
  line = 'P002 E ' + %char(%status());
  write QSYSPRT line;
endmon;
monitor;
  V2 = not ('RPG' > V1 + V1);
on-error;
  line = 'P003 E ' + %char(%status());
  write QSYSPRT line;
endmon;
monitor;
  V1 = 'zz';
on-error;
  line = 'P004 E ' + %char(%status());
  write QSYSPRT line;
endmon;
monitor;
  V2 = 'zz' = 'abc';
on-error;
  line = 'P005 E ' + %char(%status());
  write QSYSPRT line;
endmon;
monitor;
  V1 = %char(%rem(%int(V6) : 7));
on-error;
  line = 'P006 E ' + %char(%status());
  write QSYSPRT line;
endmon;
for I0 = 1 to 3;
  if (FN(491) + FN(V6)) > %dec(V4 : 15 : 2);
    monitor;
      V6 = V3;
    on-error;
      line = 'P007 E ' + %char(%status());
      write QSYSPRT line;
    endmon;
    line = 'P008 V6 ' + %char(V6);
    write QSYSPRT line;
    for I1 = 1 to 4;
      monitor;
        V2 = %char(V3) <= %char(-753.41);
      on-error;
        line = 'P009 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      monitor;
        eval(h) V3 = V4;
      on-error;
        line = 'P010 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
    endfor;
  elseif %abs((792.09 - 841)) <> 575;
    monitor;
      eval(h) V3 = FN(%int((V4 + V6)));
    on-error;
      line = 'P011 E ' + %char(%status());
      write QSYSPRT line;
    endmon;
    line = 'P012 V3 ' + %char(V3);
    write QSYSPRT line;
    if V2;
      monitor;
        V1 = V0;
      on-error;
        line = 'P013 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      line = 'P014 V1 ' + '[' + V1 + ']';
      write QSYSPRT line;
    else;
      monitor;
        eval(h) V5 = 811;
      on-error;
        line = 'P015 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      monitor;
        V2 = 556 > FN((239 * -80.23));
      on-error;
        line = 'P016 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      monitor;
        V3 = V4;
      on-error;
        line = 'P017 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
    endif;
  else;
    monitor;
      V0 = V1 + V7;
    on-error;
      line = 'P018 E ' + %char(%status());
      write QSYSPRT line;
    endmon;
    line = 'P019 V0 ' + '[' + V0 + ']';
    write QSYSPRT line;
  endif;
endfor;
line = 'P020 V0 ' + '[' + V0 + ']';
write QSYSPRT line;
line = 'P021 V1 ' + '[' + V1 + ']';
write QSYSPRT line;
line = 'P022 V2 ' + V2;
write QSYSPRT line;
line = 'P023 V3 ' + %char(V3);
write QSYSPRT line;
line = 'P024 V4 ' + %char(V4);
write QSYSPRT line;
line = 'P025 V5 ' + %char(V5);
write QSYSPRT line;
line = 'P026 V6 ' + %char(V6);
write QSYSPRT line;
line = 'P027 V7 ' + '[' + V7 + ']';
write QSYSPRT line;
*inlr = *on;
dcl-proc FN;
  dcl-pi *n packed(15:2);
    a packed(15:2) value;
  end-pi;
  return a * 8 + 10;
end-proc;

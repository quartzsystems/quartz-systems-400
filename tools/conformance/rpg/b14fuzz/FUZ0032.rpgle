**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s I0 int(10);
dcl-s I1 int(10);
dcl-s I2 int(10);
dcl-s V0 ind inz(*on);
dcl-s V1 zoned(1:1);
dcl-s V2 int(10);
dcl-s V3 varchar(7);
dcl-s V4 zoned(7:0);
dcl-s V5 packed(10:1);
monitor;
  V0 = 'x' >= %char(V1);
on-error;
  line = 'P001 E ' + %char(%status());
  write QSYSPRT line;
endmon;
line = 'P002 V0 ' + V0;
write QSYSPRT line;
for I0 = 1 by 2 to 4;
  monitor;
    V0 = (V1 + (V1 + 304)) >= FN(%dec(V4 : 15 : 2));
  on-error;
    line = 'P003 E ' + %char(%status());
    write QSYSPRT line;
  endmon;
  line = 'P004 V0 ' + V0;
  write QSYSPRT line;
  monitor;
    eval(h) V2 = FN(%abs(-921));
  on-error;
    line = 'P005 E ' + %char(%status());
    write QSYSPRT line;
  endmon;
  line = 'P006 V2 ' + %char(V2);
  write QSYSPRT line;
  monitor;
    V0 = (V1 + (V4 + 526)) >= ((V4 * 489) - 898);
  on-error;
    line = 'P007 E ' + %char(%status());
    write QSYSPRT line;
  endmon;
  line = 'P008 V0 ' + V0;
  write QSYSPRT line;
endfor;
monitor;
  V2 = (((V5 - V4) - %dec(V1 : 15 : 2)) - (V1 + (V2 * V2)));
on-error;
  line = 'P009 E ' + %char(%status());
  write QSYSPRT line;
endmon;
monitor;
  V2 = V2;
on-error;
  line = 'P010 E ' + %char(%status());
  write QSYSPRT line;
endmon;
line = 'P011 V2 ' + %char(V2);
write QSYSPRT line;
for I0 = 1 to 3;
  monitor;
    eval(h) V5 = V4;
  on-error;
    line = 'P012 E ' + %char(%status());
    write QSYSPRT line;
  endmon;
  monitor;
    V5 = (((V2 - V1) / 8) - V4);
  on-error;
    line = 'P013 E ' + %char(%status());
    write QSYSPRT line;
  endmon;
  line = 'P014 V5 ' + %char(V5);
  write QSYSPRT line;
endfor;
line = 'P015 V0 ' + V0;
write QSYSPRT line;
line = 'P016 V1 ' + %char(V1);
write QSYSPRT line;
line = 'P017 V2 ' + %char(V2);
write QSYSPRT line;
line = 'P018 V3 ' + '[' + V3 + ']';
write QSYSPRT line;
line = 'P019 V4 ' + %char(V4);
write QSYSPRT line;
line = 'P020 V5 ' + %char(V5);
write QSYSPRT line;
*inlr = *on;
dcl-proc FN;
  dcl-pi *n packed(15:2);
    a packed(15:2) value;
  end-pi;
  return a * 7 + 8;
end-proc;

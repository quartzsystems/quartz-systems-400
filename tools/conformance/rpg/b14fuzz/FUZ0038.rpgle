**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s I0 int(10);
dcl-s I1 int(10);
dcl-s I2 int(10);
dcl-s V0 char(1);
dcl-s V1 varchar(27);
dcl-s V2 ind inz(*on);
dcl-s V3 ind;
dcl-s V4 varchar(15) inz('x');
dcl-s V5 varchar(1) inz('R');
dcl-s V6 varchar(10);
dcl-s V7 varchar(22);
monitor;
  V3 = (-248 + (491.30 - 137.70)) >= 755;
on-error;
  line = 'P001 E ' + %char(%status());
  write QSYSPRT line;
endmon;
select;
when ((594.43 + 394.63) - 516) > %rem(%int(-917) : 8);
  if (354 < 135 or (V2 or V2));
    monitor;
      V1 = %trim(V1) + V0;
    on-error;
      line = 'P002 E ' + %char(%status());
      write QSYSPRT line;
    endmon;
    line = 'P003 V1 ' + '[' + V1 + ']';
    write QSYSPRT line;
  endif;
  for I0 = 1 by 2 to 2;
    monitor;
      V3 = %char(87.56) = V6;
    on-error;
      line = 'P004 E ' + %char(%status());
      write QSYSPRT line;
    endmon;
    line = 'P005 V3 ' + V3;
    write QSYSPRT line;
  endfor;
  for I0 = 1 by 2 to 3;
    for I1 = 1 to 3;
    endfor;
  endfor;
when V1 <> 'Quartz';
when V4 <> V0 + 'x';
other;
endsl;
line = 'P006 V0 ' + '[' + V0 + ']';
write QSYSPRT line;
line = 'P007 V1 ' + '[' + V1 + ']';
write QSYSPRT line;
line = 'P008 V2 ' + V2;
write QSYSPRT line;
line = 'P009 V3 ' + V3;
write QSYSPRT line;
line = 'P010 V4 ' + '[' + V4 + ']';
write QSYSPRT line;
line = 'P011 V5 ' + '[' + V5 + ']';
write QSYSPRT line;
line = 'P012 V6 ' + '[' + V6 + ']';
write QSYSPRT line;
line = 'P013 V7 ' + '[' + V7 + ']';
write QSYSPRT line;
*inlr = *on;

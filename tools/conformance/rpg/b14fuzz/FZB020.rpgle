        line = 'P014 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      line = 'P015 V5 ' + %char(V5);
      write QSYSPRT line;
    endfor;
  endfor;
endfor;
line = 'P016 V0 ' + V0;
write QSYSPRT line;
line = 'P017 V1 ' + '[' + V1 + ']';
write QSYSPRT line;
line = 'P018 V2 ' + '[' + V2 + ']';
write QSYSPRT line;
line = 'P019 V3 ' + V3;
write QSYSPRT line;
line = 'P020 V4 ' + %char(V4);
write QSYSPRT line;
line = 'P021 V5 ' + %char(V5);
write QSYSPRT line;
line = 'P022 V6 ' + %char(V6);
write QSYSPRT line;
line = 'P023 V7 ' + %char(V7);
write QSYSPRT line;
end-proc;

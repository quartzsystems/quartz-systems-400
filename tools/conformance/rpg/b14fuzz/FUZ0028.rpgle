**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s I0 int(10);
dcl-s I1 int(10);
dcl-s I2 int(10);
dcl-s V0 varchar(27);
dcl-s V1 varchar(2) inz('zz');
dcl-s V2 char(2) inz('  ');
dcl-s V3 varchar(8);
dcl-s V4 varchar(28) inz('x');
dcl-s V5 packed(5:0);
monitor;
  eval(h) V5 = V5;
on-error;
  line = 'P001 E ' + %char(%status());
  write QSYSPRT line;
endmon;
select;
when V5 >= ((V5 - V5) + %abs(V5));
  monitor;
    V2 = '0123';
  on-error;
    line = 'P002 E ' + %char(%status());
    write QSYSPRT line;
  endmon;
  line = 'P003 V2 ' + '[' + V2 + ']';
  write QSYSPRT line;
  if (V5 / 8) > 178.25;
    for I0 = 1 by 2 to 2;
      monitor;
        V0 = V4;
      on-error;
        line = 'P004 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      monitor;
        V4 = %char(648) + %trimr(V0);
      on-error;
        line = 'P005 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
    endfor;
    select;
    when %int(V5) < V5;
      monitor;
        V0 = %char(381.31) + V0 + V0;
      on-error;
        line = 'P006 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      line = 'P007 V0 ' + '[' + V0 + ']';
      write QSYSPRT line;
      monitor;
        V3 = V0;
      on-error;
        line = 'P008 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      monitor;
        V2 = V1;
      on-error;
        line = 'P009 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      line = 'P010 V2 ' + '[' + V2 + ']';
      write QSYSPRT line;
    when (886 - (V5 - 383.71)) >= ((274 - 941.18) - (V5 + V5));
      monitor;
        V5 = (%dec((V5 + V5) : 15 : 2) - %rem(%int(%rem(%int(V5) : 6)) : 4));
      on-error;
        line = 'P011 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      line = 'P012 V5 ' + %char(V5);
      write QSYSPRT line;
      monitor;
        V3 = %trimr(%triml(V3));
      on-error;
        line = 'P013 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
    other;
      monitor;
        V2 = '  pad  ';
      on-error;
        line = 'P014 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      line = 'P015 V2 ' + '[' + V2 + ']';
      write QSYSPRT line;
      monitor;
        V4 = V4 + 'abc';
      on-error;
        line = 'P016 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      line = 'P017 V4 ' + '[' + V4 + ']';
      write QSYSPRT line;
    endsl;
    for I0 = 1 to 4;
      monitor;
        V4 = %char(%rem(%int(434.05) : 8));
      on-error;
        line = 'P018 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      monitor;
        V3 = V3 + %trim('Quartz');
      on-error;
        line = 'P019 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
    endfor;
  elseif (V5 - %int(V5)) > %int((V5 - V5));
  endif;
when %int(570) < ((V5 / 2) - V5);
when ('  pad  ' + 'hello world' = V3 + V1 or 'x' + '0123' <= %trim('0123'));
other;
endsl;
line = 'P020 V0 ' + '[' + V0 + ']';
write QSYSPRT line;
line = 'P021 V1 ' + '[' + V1 + ']';
write QSYSPRT line;
line = 'P022 V2 ' + '[' + V2 + ']';
write QSYSPRT line;
line = 'P023 V3 ' + '[' + V3 + ']';
write QSYSPRT line;
line = 'P024 V4 ' + '[' + V4 + ']';
write QSYSPRT line;
line = 'P025 V5 ' + %char(V5);
write QSYSPRT line;
*inlr = *on;

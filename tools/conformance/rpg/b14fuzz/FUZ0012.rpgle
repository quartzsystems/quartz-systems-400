**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s I0 int(10);
dcl-s I1 int(10);
dcl-s I2 int(10);
dcl-s V0 packed(9:4);
dcl-s V1 packed(1:0);
dcl-s V2 packed(9:2);
dcl-s V3 int(10) inz(34);
dcl-s V4 varchar(17);
monitor;
  V4 = %triml(%char(29));
on-error;
  line = 'P001 E ' + %char(%status());
  write QSYSPRT line;
endmon;
line = 'P002 V4 ' + '[' + V4 + ']';
write QSYSPRT line;
select;
when (V0 - V3) < ((V2 - -712.78) - %abs(V2));
  for I0 = 1 to 2;
    if (V0 - 71) < %dec((V1 - 727.38) : 15 : 2);
      monitor;
        eval(h) V0 = (%rem(%int(%abs(102)) : 2) * ((215.02 + V1) + 126));
      on-error;
        line = 'P003 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      line = 'P004 V0 ' + %char(V0);
      write QSYSPRT line;
      monitor;
        V2 = V1;
      on-error;
        line = 'P005 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      line = 'P006 V2 ' + %char(V2);
      write QSYSPRT line;
      monitor;
        V4 = %char(FN(V3));
      on-error;
        line = 'P007 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
    endif;
    monitor;
      V1 = ((672 * (272 + -948.91)) + V3);
    on-error;
      line = 'P008 E ' + %char(%status());
      write QSYSPRT line;
    endmon;
    line = 'P009 V1 ' + %char(V1);
    write QSYSPRT line;
    monitor;
      eval(h) V3 = %scan('R' : V4);
    on-error;
      line = 'P010 E ' + %char(%status());
      write QSYSPRT line;
    endmon;
  endfor;
when 'hello world' + V4 <= %char(V1);
  if %triml(V4) <= V4;
    monitor;
      eval(h) V0 = FN(%len(V4));
    on-error;
      line = 'P011 E ' + %char(%status());
      write QSYSPRT line;
    endmon;
    line = 'P012 V0 ' + %char(V0);
    write QSYSPRT line;
    monitor;
      eval(h) V2 = (%len(V4) * %scan('z' : V4));
    on-error;
      line = 'P013 E ' + %char(%status());
      write QSYSPRT line;
    endmon;
  endif;
  monitor;
    V0 = -796;
  on-error;
    line = 'P014 E ' + %char(%status());
    write QSYSPRT line;
  endmon;
when 'Quartz' + V4 <> %trimr(V4);
endsl;
line = 'P015 V0 ' + %char(V0);
write QSYSPRT line;
line = 'P016 V1 ' + %char(V1);
write QSYSPRT line;
line = 'P017 V2 ' + %char(V2);
write QSYSPRT line;
line = 'P018 V3 ' + %char(V3);
write QSYSPRT line;
line = 'P019 V4 ' + '[' + V4 + ']';
write QSYSPRT line;
*inlr = *on;
dcl-proc FN;
  dcl-pi *n packed(15:2);
    a packed(15:2) value;
  end-pi;
  return a * 3 + 5;
end-proc;

**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s I0 int(10);
dcl-s I1 int(10);
dcl-s I2 int(10);
dcl-s V0 char(14);
dcl-s V1 int(10);
dcl-s V2 packed(2:2);
dcl-s V3 ind inz(*on);
dcl-s V4 int(10);
dcl-s V5 varchar(16);
for I0 = 1 to 4;
  for I1 = 1 to 1;
    for I2 = 1 to 1;
      monitor;
        V0 = %char(529);
      on-error;
        line = 'P001 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      monitor;
        V2 = (%rem(%int(658.34) : 4) - %int(890));
      on-error;
        line = 'P002 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      line = 'P003 V2 ' + %char(V2);
      write QSYSPRT line;
      monitor;
        V3 = ((V1 * V1) * (V1 * V1)) <= ((V1 / 9) / 3);
      on-error;
        line = 'P004 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
    endfor;
  endfor;
  monitor;
    eval(h) V1 = ((%abs(V4) + 508) + V2);
  on-error;
    line = 'P005 E ' + %char(%status());
    write QSYSPRT line;
  endmon;
  line = 'P006 V1 ' + %char(V1);
  write QSYSPRT line;
endfor;
monitor;
  V0 = %char(FN(90));
on-error;
  line = 'P007 E ' + %char(%status());
  write QSYSPRT line;
endmon;
line = 'P008 V0 ' + '[' + V0 + ']';
write QSYSPRT line;
for I0 = 1 to 3;
endfor;
line = 'P009 V0 ' + '[' + V0 + ']';
write QSYSPRT line;
line = 'P010 V1 ' + %char(V1);
write QSYSPRT line;
line = 'P011 V2 ' + %char(V2);
write QSYSPRT line;
line = 'P012 V3 ' + V3;
write QSYSPRT line;
line = 'P013 V4 ' + %char(V4);
write QSYSPRT line;
line = 'P014 V5 ' + '[' + V5 + ']';
write QSYSPRT line;
*inlr = *on;
dcl-proc FN;
  dcl-pi *n packed(15:2);
    a packed(15:2) value;
  end-pi;
  return a * 5 + 99;
end-proc;

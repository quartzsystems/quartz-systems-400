  endsl;
endsl;
line = 'P031 V0 ' + %char(V0);
write QSYSPRT line;
line = 'P032 V1 ' + '[' + V1 + ']';
write QSYSPRT line;
line = 'P033 V2 ' + '[' + V2 + ']';
write QSYSPRT line;
line = 'P034 V3 ' + '[' + V3 + ']';
write QSYSPRT line;
line = 'P035 V4 ' + %char(V4);
write QSYSPRT line;
line = 'P036 V5 ' + '[' + V5 + ']';
write QSYSPRT line;
line = 'P037 V6 ' + '[' + V6 + ']';
write QSYSPRT line;
line = 'P038 V7 ' + %char(V7);
write QSYSPRT line;
*inlr = *on;
dcl-proc FN;
  dcl-pi *n packed(15:2);
    a packed(15:2) value;
  end-pi;
  return a * 8 + 55;
end-proc;

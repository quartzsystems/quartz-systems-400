monitor;
  V6 = %trimr(V5 + 'hello world');
on-error;
  line = 'P001 E ' + %char(%status());
  write QSYSPRT line;
endmon;
select;
when ((314 + V7) * %int(471)) <> %int(FN(96.02));
  monitor;
    eval(h) V0 = %int(V0);
  on-error;
    line = 'P002 E ' + %char(%status());
    write QSYSPRT line;
  endmon;
  line = 'P003 V0 ' + %char(V0);
  write QSYSPRT line;
when %triml(V2) >= 'hello world' + V5;
  for I0 = 1 to 1;
    if %char(V7) > %subst(V3 : 2 : 2);
      monitor;
        V4 = V4;
      on-error;
        line = 'P004 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      line = 'P005 V4 ' + %char(V4);
      write QSYSPRT line;

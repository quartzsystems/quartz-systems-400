    endif;
  endfor;
  select;
  when %int(V0) >= (%int(V4) * FN(-668));
    select;
    when %trimr(V2) >= %trim(V6);
      monitor;
        V0 = (762.72 - V4);
      on-error;
        line = 'P010 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
    when ((V0 + V4) * (V7 * V4)) = ((V7 - 28) - (V7 + 892.56));
      monitor;
        V2 = %subst(V3 : 2 : 2);
      on-error;
        line = 'P011 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
    other;
      monitor;
        V4 = 502;
      on-error;
        line = 'P012 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
    endsl;
    select;
    when not (%char(V0) >= %trim(V3));
      monitor;
        V2 = V3 + V6 + %char(969.15);
      on-error;
        line = 'P013 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      monitor;
        V3 = %trim(%subst(V3 : 3 : 2));
      on-error;
        line = 'P014 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      monitor;
        V6 = %char(846);
      on-error;
        line = 'P015 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
    when 400 > %len(V1);
      monitor;
        V1 = %trimr('zz');
      on-error;
        line = 'P016 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      line = 'P017 V1 ' + '[' + V1 + ']';
      write QSYSPRT line;
      monitor;
        V3 = %trim(%trimr(V1));
      on-error;
        line = 'P018 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      monitor;
        V1 = %subst(V3 : 1 : 2);
      on-error;
        line = 'P019 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
    endsl;
    if V6 = V5 + V3;
      monitor;
        V4 = FN(%abs(V0));
      on-error;
        line = 'P020 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      monitor;
        eval(h) V7 = (V7 - ((V4 - V7) * %int(V4)));
      on-error;
        line = 'P021 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      line = 'P022 V7 ' + %char(V7);
      write QSYSPRT line;
      monitor;
        V5 = %char(93.71) + V2;
      on-error;
        line = 'P023 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
    elseif %subst(V5 : 6 : 5) > V3 + V2;
      monitor;
        V4 = %abs((203 - (V0 + -327)));
      on-error;
        line = 'P024 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      monitor;
        V5 = V6;
      on-error;
        line = 'P025 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      line = 'P026 V5 ' + '[' + V5 + ']';
      write QSYSPRT line;
      monitor;
        eval(h) V4 = 279;

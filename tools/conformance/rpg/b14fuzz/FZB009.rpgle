line = 'P027 V1 ' + '[' + V1 + ']';
write QSYSPRT line;
line = 'P028 V2 ' + '[' + V2 + ']';
write QSYSPRT line;
line = 'P029 V3 ' + %char(V3);
write QSYSPRT line;
line = 'P030 V4 ' + '[' + V4 + ']';
write QSYSPRT line;
line = 'P031 V5 ' + %char(V5);
write QSYSPRT line;
line = 'P032 V6 ' + %char(V6);
write QSYSPRT line;
end-proc;

**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s I0 int(10);
dcl-s I1 int(10);
dcl-s I2 int(10);
dcl-s V0 varchar(14) inz('abc');
dcl-s V1 int(10);
dcl-s V2 int(10) inz(35);
dcl-s V3 varchar(23) inz('zz');
dcl-s V4 packed(4:1);
if V2 < %abs(V1);
  monitor;
    V4 = (%abs((V4 + V1)) - ((10 * 310) + V2));
  on-error;
    line = 'P001 E ' + %char(%status());
    write QSYSPRT line;
  endmon;
  line = 'P002 V4 ' + %char(V4);
  write QSYSPRT line;
  if V1 < V1;
    monitor;
      V1 = 860.64;
    on-error;
      line = 'P003 E ' + %char(%status());
      write QSYSPRT line;
    endmon;
    line = 'P004 V1 ' + %char(V1);
    write QSYSPRT line;
    for I0 = 1 to 1;
      monitor;
        V4 = %abs(V4);
      on-error;
        line = 'P005 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      monitor;
        eval(h) V2 = V4;
      on-error;
        line = 'P006 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      monitor;
        V4 = %scan('a' : V0);
      on-error;
        line = 'P007 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      line = 'P008 V4 ' + %char(V4);
      write QSYSPRT line;
    endfor;
    if 'Quartz' + '  pad  ' > %char(V4);
      monitor;
        V3 = 'hello world';
      on-error;
        line = 'P009 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      monitor;
        V2 = (805.95 * V4);
      on-error;
        line = 'P010 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
    elseif (V4 + %rem(%int(V2) : 3)) < V2;
      monitor;
        V2 = %abs(914.71);
      on-error;
        line = 'P011 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      line = 'P012 V2 ' + %char(V2);
      write QSYSPRT line;
    else;
    endif;
  elseif (FN(822) + (V4 - 756.15)) > (V2 * (V1 / 3));
  else;
  endif;
else;
endif;
line = 'P013 V0 ' + '[' + V0 + ']';
write QSYSPRT line;
line = 'P014 V1 ' + %char(V1);
write QSYSPRT line;
line = 'P015 V2 ' + %char(V2);
write QSYSPRT line;
line = 'P016 V3 ' + '[' + V3 + ']';
write QSYSPRT line;
line = 'P017 V4 ' + %char(V4);
write QSYSPRT line;
*inlr = *on;
dcl-proc FN;
  dcl-pi *n packed(15:2);
    a packed(15:2) value;
  end-pi;
  return a * 3 + 47;
end-proc;

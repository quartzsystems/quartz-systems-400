**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s I0 int(10);
dcl-s I1 int(10);
dcl-s I2 int(10);
dcl-s V0 varchar(7) inz('0123');
dcl-s V1 zoned(8:2);
dcl-s V2 varchar(2) inz('Qu');
dcl-s V3 int(10);
dcl-s V4 zoned(6:2);
dcl-s V5 char(9) inz('  pad  ');
dcl-s V6 ind inz(*on);
monitor;
  V4 = V3;
on-error;
  line = 'P001 E ' + %char(%status());
  write QSYSPRT line;
endmon;
monitor;
  V0 = V5;
on-error;
  line = 'P002 E ' + %char(%status());
  write QSYSPRT line;
endmon;
line = 'P003 V0 ' + '[' + V0 + ']';
write QSYSPRT line;
monitor;
  V2 = %char(V3);
on-error;
  line = 'P004 E ' + %char(%status());
  write QSYSPRT line;
endmon;
if V6;
  monitor;
    V4 = %int(((V4 + V1) - (737.38 / 4)));
  on-error;
    line = 'P005 E ' + %char(%status());
    write QSYSPRT line;
  endmon;
  line = 'P006 V4 ' + %char(V4);
  write QSYSPRT line;
  for I0 = 1 to 3;
    monitor;
      V2 = 'zz';
    on-error;
      line = 'P007 E ' + %char(%status());
      write QSYSPRT line;
    endmon;
    line = 'P008 V2 ' + '[' + V2 + ']';
    write QSYSPRT line;
    if 'zz' <> 'Quartz';
      monitor;
        V2 = '0123';
      on-error;
        line = 'P009 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      line = 'P010 V2 ' + '[' + V2 + ']';
      write QSYSPRT line;
      monitor;
        V6 = (%abs(%len(V2)) > V3 and V6);
      on-error;
        line = 'P011 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      line = 'P012 V6 ' + V6;
      write QSYSPRT line;
      monitor;
        V6 = 'Quartz' + '  pad  ' <> %subst(V5 : 1 : 1);
      on-error;
        line = 'P013 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      line = 'P014 V6 ' + V6;
      write QSYSPRT line;
    else;
      monitor;
        V4 = %abs((V4 + (V1 / 1)));
      on-error;
        line = 'P015 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      monitor;
        V0 = %char(V3);
      on-error;
        line = 'P016 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      line = 'P017 V0 ' + '[' + V0 + ']';
      write QSYSPRT line;
      monitor;
        V4 = (((V3 - V4) * (-556.09 + V1)) + (668.62 - %rem(%int(948) : 9)));
      on-error;
        line = 'P018 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      line = 'P019 V4 ' + %char(V4);
      write QSYSPRT line;
    endif;
    monitor;
      V1 = V3;
    on-error;
      line = 'P020 E ' + %char(%status());
      write QSYSPRT line;
    endmon;
    line = 'P021 V1 ' + %char(V1);
    write QSYSPRT line;
  endfor;
endif;
for I0 = 1 to 4;
  for I1 = 1 to 1;
    monitor;
      V0 = V5 + %char(V3);
    on-error;
      line = 'P022 E ' + %char(%status());
      write QSYSPRT line;
    endmon;
    for I2 = 1 by 2 to 3;
      monitor;
        V3 = %dec(V4 : 15 : 2);
      on-error;
        line = 'P023 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
    endfor;
    select;
    when V3 < (17 - %abs(V1));
      monitor;
        V0 = V5 + 'zz' + 'RPG';
      on-error;
        line = 'P024 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
    when (%int(V4) <> (%scan('x' : V0) - (997 + V3)) or V3 >= %len(V0));
      monitor;
        V0 = 'abc';
      on-error;
        line = 'P025 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      line = 'P026 V0 ' + '[' + V0 + ']';
      write QSYSPRT line;
    other;
    endsl;
  endfor;
endfor;
line = 'P027 V0 ' + '[' + V0 + ']';
write QSYSPRT line;
line = 'P028 V1 ' + %char(V1);
write QSYSPRT line;
line = 'P029 V2 ' + '[' + V2 + ']';
write QSYSPRT line;
line = 'P030 V3 ' + %char(V3);
write QSYSPRT line;
line = 'P031 V4 ' + %char(V4);
write QSYSPRT line;
line = 'P032 V5 ' + '[' + V5 + ']';
write QSYSPRT line;
line = 'P033 V6 ' + V6;
write QSYSPRT line;
*inlr = *on;

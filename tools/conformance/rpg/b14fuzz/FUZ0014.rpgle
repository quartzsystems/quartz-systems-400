**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s I0 int(10);
dcl-s I1 int(10);
dcl-s I2 int(10);
dcl-s V0 char(19) inz('RPG');
dcl-s V1 packed(11:1);
dcl-s V2 char(8);
dcl-s V3 varchar(30) inz('  pad  ');
dcl-s V4 varchar(10);
dcl-s V5 char(19) inz('hello world');
dcl-s V6 int(10);
dcl-s V7 int(10);
dcl-s V8 int(10);
for I0 = 1 by 2 to 2;
  monitor;
    eval(h) V6 = 189;
  on-error;
    line = 'P001 E ' + %char(%status());
    write QSYSPRT line;
  endmon;
  line = 'P002 V6 ' + %char(V6);
  write QSYSPRT line;
  monitor;
    V6 = V8;
  on-error;
    line = 'P003 E ' + %char(%status());
    write QSYSPRT line;
  endmon;
  line = 'P004 V6 ' + %char(V6);
  write QSYSPRT line;
endfor;
select;
when %char(V8) >= V0 + V5;
  monitor;
    V0 = V2 + V0;
  on-error;
    line = 'P005 E ' + %char(%status());
    write QSYSPRT line;
  endmon;
  select;
  when %trim(V4) = 'zz';
    monitor;
      V4 = V0;
    on-error;
      line = 'P006 E ' + %char(%status());
      write QSYSPRT line;
    endmon;
    for I0 = 1 by 2 to 4;
      monitor;
        V2 = %subst(V5 : 4 : 2);
      on-error;
        line = 'P007 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      monitor;
        V8 = %scan('a' : V5);
      on-error;
        line = 'P008 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
    endfor;
  when %scan('h' : V5) > (V1 - 984);
    monitor;
      V4 = 'x';
    on-error;
      line = 'P009 E ' + %char(%status());
      write QSYSPRT line;
    endmon;
    line = 'P010 V4 ' + '[' + V4 + ']';
    write QSYSPRT line;
  when not (-961.12 > %len(V3));
  other;
  endsl;
when (%rem(%int(V8) : 5) + %abs(V1)) > 673;
endsl;
line = 'P011 V0 ' + '[' + V0 + ']';
write QSYSPRT line;
line = 'P012 V1 ' + %char(V1);
write QSYSPRT line;
line = 'P013 V2 ' + '[' + V2 + ']';
write QSYSPRT line;
line = 'P014 V3 ' + '[' + V3 + ']';
write QSYSPRT line;
line = 'P015 V4 ' + '[' + V4 + ']';
write QSYSPRT line;
line = 'P016 V5 ' + '[' + V5 + ']';
write QSYSPRT line;
line = 'P017 V6 ' + %char(V6);
write QSYSPRT line;
line = 'P018 V7 ' + %char(V7);
write QSYSPRT line;
line = 'P019 V8 ' + %char(V8);
write QSYSPRT line;
*inlr = *on;

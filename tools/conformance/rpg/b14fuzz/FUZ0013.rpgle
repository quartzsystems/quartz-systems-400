  endsl;
endsl;
line = 'P025 V0 ' + %char(V0);
write QSYSPRT line;
line = 'P026 V1 ' + '[' + V1 + ']';
write QSYSPRT line;
line = 'P027 V2 ' + '[' + V2 + ']';
write QSYSPRT line;
line = 'P028 V3 ' + '[' + V3 + ']';
write QSYSPRT line;

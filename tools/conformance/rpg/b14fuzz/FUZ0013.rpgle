  monitor;
    V5 = %trim(%subst(V2 : 2 : 1));
  on-error;
    line = 'P006 E ' + %char(%status());
    write QSYSPRT line;
  endmon;
  line = 'P007 V5 ' + '[' + V5 + ']';
  write QSYSPRT line;
endsl;
monitor;
  V0 = (((948.53 - 830) + (V4 - V4)) - (V0 * -699));
on-error;
  line = 'P008 E ' + %char(%status());
  write QSYSPRT line;
endmon;
if (V4 - 60) = 704;
  for I0 = 1 to 4;
    monitor;
      eval(h) V0 = %abs(V0);
    on-error;
      line = 'P009 E ' + %char(%status());
      write QSYSPRT line;
    endmon;
    line = 'P010 V0 ' + %char(V0);
    write QSYSPRT line;
  endfor;
endif;
monitor;
  V3 = '  pad  ' + %subst(V2 : 2 : 1);
on-error;
  line = 'P011 E ' + %char(%status());
  write QSYSPRT line;
endmon;
monitor;
  V5 = V3;
on-error;
  line = 'P012 E ' + %char(%status());
  write QSYSPRT line;
endmon;
for I0 = 1 to 4;
  for I1 = 1 by 2 to 2;
    for I2 = 1 by 2 to 2;
      monitor;
        V1 = %trim('  pad  ' + V5);
      on-error;
        line = 'P013 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      monitor;
        V5 = %char(987.98);
      on-error;
        line = 'P014 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      line = 'P015 V5 ' + '[' + V5 + ']';
      write QSYSPRT line;
      monitor;
        V4 = (V0 + %int(%abs(V0)));
      on-error;
        line = 'P016 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      line = 'P017 V4 ' + %char(V4);
      write QSYSPRT line;
    endfor;
    monitor;
      V1 = %trim(%subst(V1 : 7 : 1));
    on-error;
      line = 'P018 E ' + %char(%status());
      write QSYSPRT line;
    endmon;
    line = 'P019 V1 ' + '[' + V1 + ']';
    write QSYSPRT line;
  endfor;
endfor;
monitor;
  V1 = %trim('x' + V6);
on-error;
  line = 'P020 E ' + %char(%status());
  write QSYSPRT line;
endmon;
monitor;
  eval(h) V0 = (%abs(813) + V4);
on-error;
  line = 'P021 E ' + %char(%status());
  write QSYSPRT line;
endmon;
select;
when %scan('z' : V6) < %scan('0' : V1);
  select;
  when %char(285) <> 'Quartz';
    if 903.79 <= V0;
      monitor;
        V5 = V6;
      on-error;
        line = 'P022 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      line = 'P023 V5 ' + '[' + V5 + ']';
      write QSYSPRT line;
      monitor;
        V0 = 771.26;
      on-error;
        line = 'P024 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
    else;
    endif;
  when %trim(V2) <= %triml(V7);

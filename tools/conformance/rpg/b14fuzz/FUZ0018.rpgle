**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s I0 int(10);
dcl-s I1 int(10);
dcl-s I2 int(10);
dcl-s V0 char(9) inz('zz');
dcl-s V1 ind inz(*on);
dcl-s V2 char(16);
dcl-s V3 zoned(7:1);
monitor;
  V3 = 747.34;
on-error;
  line = 'P001 E ' + %char(%status());
  write QSYSPRT line;
endmon;
line = 'P002 V3 ' + %char(V3);
write QSYSPRT line;
for I0 = 1 by 2 to 1;
  for I1 = 1 to 2;
    monitor;
      V1 = V1;
    on-error;
      line = 'P003 E ' + %char(%status());
      write QSYSPRT line;
    endmon;
    monitor;
      V2 = 'RPG';
    on-error;
      line = 'P004 E ' + %char(%status());
      write QSYSPRT line;
    endmon;
    line = 'P005 V2 ' + '[' + V2 + ']';
    write QSYSPRT line;
  endfor;
  monitor;
    V1 = %abs(FN(V3)) <= %abs((V3 / 3));
  on-error;
    line = 'P006 E ' + %char(%status());
    write QSYSPRT line;
  endmon;
endfor;
monitor;
  V0 = %triml(V0 + 'x');
on-error;
  line = 'P007 E ' + %char(%status());
  write QSYSPRT line;
endmon;
if V0 < %trimr(V2);
  for I0 = 1 by 2 to 3;
    monitor;
      V1 = V3 < 353.19;
    on-error;
      line = 'P008 E ' + %char(%status());
      write QSYSPRT line;
    endmon;
  endfor;
  for I0 = 1 to 4;
    for I1 = 1 by 2 to 2;
      monitor;
        V0 = %trim(%trim(V0));
      on-error;
        line = 'P009 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
    endfor;
  endfor;
endif;
line = 'P010 V0 ' + '[' + V0 + ']';
write QSYSPRT line;
line = 'P011 V1 ' + V1;
write QSYSPRT line;
line = 'P012 V2 ' + '[' + V2 + ']';
write QSYSPRT line;
line = 'P013 V3 ' + %char(V3);
write QSYSPRT line;
*inlr = *on;
dcl-proc FN;
  dcl-pi *n packed(15:2);
    a packed(15:2) value;
  end-pi;
  return a * 9 + 5;
end-proc;

**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s I0 int(10);
dcl-s I1 int(10);
dcl-s I2 int(10);
dcl-s V0 packed(12:3);
dcl-s V1 packed(10:4);
dcl-s V2 varchar(14);
dcl-s V3 char(9);
dcl-s V4 int(10);
dcl-s V5 ind inz(*on);
dcl-s V6 zoned(2:0);
dcl-s V7 packed(12:2);
select;
when V1 <= (166 - %len(V2));
  monitor;
    V0 = V0;
  on-error;
    line = 'P001 E ' + %char(%status());
    write QSYSPRT line;
  endmon;
  if V5;
    monitor;
      eval(h) V6 = %dec(%int(310.48) : 15 : 2);
    on-error;
      line = 'P002 E ' + %char(%status());
      write QSYSPRT line;
    endmon;
    for I0 = 1 to 3;
      monitor;
        eval(h) V6 = %rem(%int(V1) : 5);
      on-error;
        line = 'P003 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      line = 'P004 V6 ' + %char(V6);
      write QSYSPRT line;
    endfor;
    monitor;
      V5 = '0123' < V3 + 'zz';
    on-error;
      line = 'P005 E ' + %char(%status());
      write QSYSPRT line;
    endmon;
  elseif V5;
    for I0 = 1 to 3;
    endfor;
  endif;
when not (771 < %int(V1));
endsl;
line = 'P006 V0 ' + %char(V0);
write QSYSPRT line;
line = 'P007 V1 ' + %char(V1);
write QSYSPRT line;
line = 'P008 V2 ' + '[' + V2 + ']';
write QSYSPRT line;
line = 'P009 V3 ' + '[' + V3 + ']';
write QSYSPRT line;
line = 'P010 V4 ' + %char(V4);
write QSYSPRT line;
line = 'P011 V5 ' + V5;
write QSYSPRT line;
line = 'P012 V6 ' + %char(V6);
write QSYSPRT line;
line = 'P013 V7 ' + %char(V7);
write QSYSPRT line;
*inlr = *on;

**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s I0 int(10);
dcl-s I1 int(10);
dcl-s I2 int(10);
dcl-s V0 varchar(23) inz('RPG');
dcl-s V1 char(6) inz('  pad ');
dcl-s V2 packed(5:1);
dcl-s V3 int(10) inz(18);
monitor;
  eval(h) V2 = 233;
on-error;
  line = 'P001 E ' + %char(%status());
  write QSYSPRT line;
endmon;
for I0 = 1 to 1;
  monitor;
    V1 = %subst(V1 : 4 : 3);
  on-error;
    line = 'P002 E ' + %char(%status());
    write QSYSPRT line;
  endmon;
  line = 'P003 V1 ' + '[' + V1 + ']';
  write QSYSPRT line;
  if %triml('hello world') <= 'x' + V1;
    monitor;
      V2 = V3;
    on-error;
      line = 'P004 E ' + %char(%status());
      write QSYSPRT line;
    endmon;
    line = 'P005 V2 ' + %char(V2);
    write QSYSPRT line;
    monitor;
      V2 = (861.12 / 5);
    on-error;
      line = 'P006 E ' + %char(%status());
      write QSYSPRT line;
    endmon;
    line = 'P007 V2 ' + %char(V2);
    write QSYSPRT line;
  elseif %subst(V1 : 1 : 3) >= %trimr(V0);
    monitor;
      eval(h) V2 = 290.95;
    on-error;
      line = 'P008 E ' + %char(%status());
      write QSYSPRT line;
    endmon;
    line = 'P009 V2 ' + %char(V2);
    write QSYSPRT line;
    monitor;
      V1 = 'x' + 'zz' + '0123';
    on-error;
      line = 'P010 E ' + %char(%status());
      write QSYSPRT line;
    endmon;
    monitor;
      V1 = V1 + 'RPG' + %trimr(V0);
    on-error;
      line = 'P011 E ' + %char(%status());
      write QSYSPRT line;
    endmon;
    line = 'P012 V1 ' + '[' + V1 + ']';
    write QSYSPRT line;
  endif;
  for I1 = 1 by 2 to 1;
    for I2 = 1 to 3;
      monitor;
        V0 = '0123';
      on-error;
        line = 'P013 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
    endfor;
    select;
    when ((V3 + -299) + %rem(%int(V2) : 5)) <> 612.76;
      monitor;
        V0 = %subst(V1 : 5 : 2);
      on-error;
        line = 'P014 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      monitor;
        V0 = V0;
      on-error;
        line = 'P015 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      line = 'P016 V0 ' + '[' + V0 + ']';
      write QSYSPRT line;
    when (V3 * -973.90) >= FN(V2);
      monitor;
        eval(h) V3 = V3;
      on-error;
        line = 'P017 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      line = 'P018 V3 ' + %char(V3);
      write QSYSPRT line;
    when 485.96 >= ((V2 - V3) - %scan('Q' : V1));
      monitor;
        V1 = 'hello world';
      on-error;
        line = 'P019 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      line = 'P020 V1 ' + '[' + V1 + ']';
      write QSYSPRT line;
      monitor;
        V1 = %subst(V1 : 2 : 2);
      on-error;
        line = 'P021 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      line = 'P022 V1 ' + '[' + V1 + ']';
      write QSYSPRT line;
      monitor;
        V1 = %triml(V0 + V1);
      on-error;
        line = 'P023 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
    endsl;
    monitor;
      V0 = '0123' + V0 + '0123';
    on-error;
      line = 'P024 E ' + %char(%status());
      write QSYSPRT line;
    endmon;
  endfor;
endfor;
monitor;
  V1 = %subst(V1 : 3 : 2);
on-error;
  line = 'P025 E ' + %char(%status());
  write QSYSPRT line;
endmon;
for I0 = 1 to 2;
  if %dec((-774.41 + V2) : 15 : 2) > V3;
    select;
    when %int(V2) < FN(%int(V2));
      monitor;
        V0 = V1;
      on-error;
        line = 'P026 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      line = 'P027 V0 ' + '[' + V0 + ']';
      write QSYSPRT line;
      monitor;
        V0 = V0;
      on-error;
        line = 'P028 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      monitor;
        V0 = %trim(V0 + V1);
      on-error;
        line = 'P029 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      line = 'P030 V0 ' + '[' + V0 + ']';
      write QSYSPRT line;
    when (V3 + V3) = %rem(%int((V3 + V2)) : 8);
    other;
    endsl;
  elseif %rem(%int(FN(V2)) : 5) = (-303.97 + V2);
  endif;
endfor;
line = 'P031 V0 ' + '[' + V0 + ']';
write QSYSPRT line;
line = 'P032 V1 ' + '[' + V1 + ']';
write QSYSPRT line;
line = 'P033 V2 ' + %char(V2);
write QSYSPRT line;
line = 'P034 V3 ' + %char(V3);
write QSYSPRT line;
*inlr = *on;
dcl-proc FN;
  dcl-pi *n packed(15:2);
    a packed(15:2) value;
  end-pi;
  return a * 4 + 46;
end-proc;

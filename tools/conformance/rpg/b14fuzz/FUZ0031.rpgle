**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s I0 int(10);
dcl-s I1 int(10);
dcl-s I2 int(10);
dcl-s V0 varchar(26);
dcl-s V1 varchar(18) inz('hello world');
dcl-s V2 zoned(8:0);
dcl-s V3 char(18);
if (V2 + 445.00) <> (%abs(V2) - %dec(638 : 15 : 2));
  monitor;
    V1 = V0;
  on-error;
    line = 'P001 E ' + %char(%status());
    write QSYSPRT line;
  endmon;
  line = 'P002 V1 ' + '[' + V1 + ']';
  write QSYSPRT line;
elseif ((824.02 - -206) / 6) <= V2;
  monitor;
    V0 = %trim('Quartz' + V1);
  on-error;
    line = 'P003 E ' + %char(%status());
    write QSYSPRT line;
  endmon;
  monitor;
    V3 = V0 + %char(V2);
  on-error;
    line = 'P004 E ' + %char(%status());
    write QSYSPRT line;
  endmon;
  line = 'P005 V3 ' + '[' + V3 + ']';
  write QSYSPRT line;
else;
  select;
  when 'abc' + V0 = 'x' + V1;
    select;
    when (%int(374) + 731) < V2;
      monitor;
        V1 = 'zz';
      on-error;
        line = 'P006 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
    when 914 > ((V2 - V2) - 720.52);
      monitor;
        V0 = 'RPG';
      on-error;
        line = 'P007 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      monitor;
        V2 = -87;
      on-error;
        line = 'P008 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
    endsl;
  when V2 = ((V2 + V2) + V2);
    if V2 > (596 - V2);
      monitor;
        V3 = %subst(V3 : 10 : 6);
      on-error;
        line = 'P009 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      monitor;
        V0 = %char((V2 * V2));
      on-error;
        line = 'P010 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      monitor;
        V3 = %subst(V3 : 15 : 4);
      on-error;
        line = 'P011 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
    elseif ((V2 - V2) / 4) < (V2 * 830.30);
      monitor;
        V2 = (((V2 + V2) + V2) - %int(V2));
      on-error;
        line = 'P012 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      monitor;
        V1 = %char((V2 - V2));
      on-error;
        line = 'P013 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
    else;
      monitor;
        eval(h) V2 = V2;
      on-error;
        line = 'P014 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      line = 'P015 V2 ' + %char(V2);
      write QSYSPRT line;
      monitor;
        V3 = 'abc';
      on-error;
        line = 'P016 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      monitor;
        V2 = %int(-839);
      on-error;
        line = 'P017 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
    endif;
    monitor;
      V0 = V0;
    on-error;
      line = 'P018 E ' + %char(%status());
      write QSYSPRT line;
    endmon;
    line = 'P019 V0 ' + '[' + V0 + ']';
    write QSYSPRT line;
  other;
    for I0 = 1 to 1;
      monitor;
        V2 = V2;
      on-error;
        line = 'P020 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      line = 'P021 V2 ' + %char(V2);
      write QSYSPRT line;
      monitor;
        V1 = %trim(%trim(V1));
      on-error;
        line = 'P022 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
    endfor;
  endsl;
endif;
line = 'P023 V0 ' + '[' + V0 + ']';
write QSYSPRT line;
line = 'P024 V1 ' + '[' + V1 + ']';
write QSYSPRT line;
line = 'P025 V2 ' + %char(V2);
write QSYSPRT line;
line = 'P026 V3 ' + '[' + V3 + ']';
write QSYSPRT line;
*inlr = *on;

**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s I0 int(10);
dcl-s I1 int(10);
dcl-s I2 int(10);
dcl-s V0 packed(6:0);
dcl-s V1 int(10) inz(12);
dcl-s V2 int(10) inz(31);
dcl-s V3 varchar(15) inz('0123');
dcl-s V4 varchar(30);
dcl-s V5 char(9) inz('  pad  ');
monitor;
  V0 = FN(%abs((V2 - 425)));
on-error;
  line = 'P001 E ' + %char(%status());
  write QSYSPRT line;
endmon;
select;
when (%dec(304 : 15 : 2) * %int(380)) <= V2;
  monitor;
    V2 = (FN(531) - %abs(FN(V1)));
  on-error;
    line = 'P002 E ' + %char(%status());
    write QSYSPRT line;
  endmon;
  line = 'P003 V2 ' + %char(V2);
  write QSYSPRT line;
  select;
  when V5 + 'RPG' = %triml('RPG');
    select;
    when not (V0 <> V1);
      monitor;
        V5 = %triml(%char(-989.89));
      on-error;
        line = 'P004 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      monitor;
        V4 = V5;
      on-error;
        line = 'P005 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      line = 'P006 V4 ' + '[' + V4 + ']';
      write QSYSPRT line;
    endsl;
  other;
    monitor;
      V0 = %abs(V2);
    on-error;
      line = 'P007 E ' + %char(%status());
      write QSYSPRT line;
    endmon;
    monitor;
      V3 = %char((617 + V2));
    on-error;
      line = 'P008 E ' + %char(%status());
      write QSYSPRT line;
    endmon;
    monitor;
      V5 = V5 + 'zz';
    on-error;
      line = 'P009 E ' + %char(%status());
      write QSYSPRT line;
    endmon;
  endsl;
endsl;
monitor;
  V0 = (V1 + ((V2 - V0) - (773.15 + -515.98)));
on-error;
  line = 'P010 E ' + %char(%status());
  write QSYSPRT line;
endmon;
monitor;
  V0 = %dec(V1 : 15 : 2);
on-error;
  line = 'P011 E ' + %char(%status());
  write QSYSPRT line;
endmon;
line = 'P012 V0 ' + %char(V0);
write QSYSPRT line;
select;
when not (FN(V0) > %len(V3));
  if %triml(V3) > %char(217.65);
    for I0 = 1 to 3;
      monitor;
        V3 = V5;
      on-error;
        line = 'P013 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      line = 'P014 V3 ' + '[' + V3 + ']';
      write QSYSPRT line;
    endfor;
  endif;
when (%subst(V5 : 2 : 7) > V5 and V4 + V5 <> V4 + V3);
endsl;
line = 'P015 V0 ' + %char(V0);
write QSYSPRT line;
line = 'P016 V1 ' + %char(V1);
write QSYSPRT line;
line = 'P017 V2 ' + %char(V2);
write QSYSPRT line;
line = 'P018 V3 ' + '[' + V3 + ']';
write QSYSPRT line;
line = 'P019 V4 ' + '[' + V4 + ']';
write QSYSPRT line;
line = 'P020 V5 ' + '[' + V5 + ']';
write QSYSPRT line;
*inlr = *on;
dcl-proc FN;
  dcl-pi *n packed(15:2);
    a packed(15:2) value;
  end-pi;
  return a * 2 + 82;
end-proc;

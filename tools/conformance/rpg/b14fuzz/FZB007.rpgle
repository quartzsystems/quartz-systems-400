      endmon;
    endfor;
    for I0 = 1 by 2 to 1;
    endfor;
  when 'hello world' + 'zz' > %trimr(V1);
  other;
  endsl;
endif;
line = 'P017 V0 ' + '[' + V0 + ']';
write QSYSPRT line;
line = 'P018 V1 ' + '[' + V1 + ']';
write QSYSPRT line;
line = 'P019 V2 ' + '[' + V2 + ']';
write QSYSPRT line;
line = 'P020 V3 ' + V3;
write QSYSPRT line;
line = 'P021 V4 ' + %char(V4);
write QSYSPRT line;
end-proc;

**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s I0 int(10);
dcl-s I1 int(10);
dcl-s I2 int(10);
dcl-s V0 varchar(26) inz('0123');
dcl-s V1 packed(4:1);
dcl-s V2 ind;
dcl-s V3 char(20) inz('Quartz');
dcl-s V4 ind inz(*on);
dcl-s V5 packed(2:2);
for I0 = 1 to 2;
  monitor;
    V1 = (((V5 / 3) + %abs(V1)) / 2);
  on-error;
    line = 'P001 E ' + %char(%status());
    write QSYSPRT line;
  endmon;
  line = 'P002 V1 ' + %char(V1);
  write QSYSPRT line;
  select;
  when V5 > ((V1 - 304) - V1);
    monitor;
      V0 = 'x';
    on-error;
      line = 'P003 E ' + %char(%status());
      write QSYSPRT line;
    endmon;
  endsl;
endfor;
monitor;
  V2 = 360 > %scan(' ' : V0);
on-error;
  line = 'P004 E ' + %char(%status());
  write QSYSPRT line;
endmon;
line = 'P005 V2 ' + V2;
write QSYSPRT line;
monitor;
  V2 = '  pad  ' + V0 < V3 + 'x';
on-error;
  line = 'P006 E ' + %char(%status());
  write QSYSPRT line;
endmon;
line = 'P007 V2 ' + V2;
write QSYSPRT line;
monitor;
  V2 = ((V1 / 3) + 886.99) < 471;
on-error;
  line = 'P008 E ' + %char(%status());
  write QSYSPRT line;
endmon;
for I0 = 1 to 2;
  for I1 = 1 by 2 to 1;
    monitor;
      V5 = V5;
    on-error;
      line = 'P009 E ' + %char(%status());
      write QSYSPRT line;
    endmon;
  endfor;
  monitor;
    V1 = V1;
  on-error;
    line = 'P010 E ' + %char(%status());
    write QSYSPRT line;
  endmon;
  line = 'P011 V1 ' + %char(V1);
  write QSYSPRT line;
  for I1 = 1 to 4;
    monitor;
      V3 = %trim('0123' + V3);
    on-error;
      line = 'P012 E ' + %char(%status());
      write QSYSPRT line;
    endmon;
    for I2 = 1 to 1;
      monitor;
        V0 = V0;
      on-error;
        line = 'P013 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      line = 'P014 V0 ' + '[' + V0 + ']';
      write QSYSPRT line;
      monitor;
        V0 = V3 + 'Quartz' + V0;
      on-error;
        line = 'P015 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      line = 'P016 V0 ' + '[' + V0 + ']';
      write QSYSPRT line;
      monitor;
        V1 = (%rem(%int(%scan('h' : V0)) : 2) / 9);
      on-error;
        line = 'P017 E ' + %char(%status());
        write QSYSPRT line;
      endmon;
      line = 'P018 V1 ' + %char(V1);
      write QSYSPRT line;
    endfor;
  endfor;
endfor;
line = 'P019 V0 ' + '[' + V0 + ']';
write QSYSPRT line;
line = 'P020 V1 ' + %char(V1);
write QSYSPRT line;
line = 'P021 V2 ' + V2;
write QSYSPRT line;
line = 'P022 V3 ' + '[' + V3 + ']';
write QSYSPRT line;
line = 'P023 V4 ' + V4;
write QSYSPRT line;
line = 'P024 V5 ' + %char(V5);
write QSYSPRT line;
*inlr = *on;

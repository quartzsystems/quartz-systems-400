**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-pr f int(10);
  a int(10) const options(*omit);
end-pr;
dcl-s p pointer inz(*null);
dcl-s c char(4) inz(*all'ab');
dcl-s n packed(5:2) inz(*hival);
dcl-s m packed(5:2) inz(*loval);
dcl-s i ind inz(*on);
line = %char(n) + ' ' + %char(m) + ' ' + c + ' ' + i;
write QSYSPRT line;
if p = *null;
  line = 'null';
  write QSYSPRT line;
endif;
*in05 = *on;
*in(6) = *in05;
line = *in05 + *in(6) + *inlr;
write QSYSPRT line;
line = %char(f(*omit)) + ' ' + %char(f(3));
write QSYSPRT line;
*inlr = *on;
dcl-proc f;
  dcl-pi *n int(10);
    a int(10) const options(*omit);
  end-pi;
  if %addr(a) = *null;
    return -1;
  endif;
  return a;
end-proc;

0   57     dcl-s q pointer;                                                                                     005700
    58     dcl-ds bb;                                                                                           005800
    59       bc char(1);                                                                                        005900
    60       bu uns(3) overlay(bc);                                                                             006000
    61     end-ds;                                                                                              006100
    62     dcl-s o varchar(200);                                                                                006200
    63     dcl-s i int(10);                                                                                     006300
    64     for i = 0 to n - 1;                                                                                  006400
    65       q = p + i;                                                                                         006500
    66       bc = c;                                                                                            006600
    67       o += %subst(DIG: %div(bu: 16) + 1: 1) + %subst(DIG: %rem(bu: 16) + 1: 1);                          006700
    68     endfor;                                                                                              006800
    69     return o;                                                                                            006900
    70   end-proc;                                                                                              007000

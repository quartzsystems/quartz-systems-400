     2   //; cmd: CRTSQLRPGI OBJ({lib}/{name}) SRCFILE({lib}/QRPGLESRC) COMMIT(*NONE) OUTPUT(*PRINT)            000200
     3   //; sqlfile: DATYP                                                                                     000300
     4   ctl-opt dftactgrp(*no);                                                                                000400
     5   dcl-f QSYSPRT printer(132);                                                                            000500
     6   dcl-ds line len(132) end-ds;                                                                           000600
     7   dcl-c SQL_NUM 25;                                                                                      000700
     8   exec sql include SQLDA;                                                                                000800
     9   dcl-s txt varchar(300);                                                                                000900
    10   // DESCRIBE OUTPUT of every column type: the SQLDA byte for byte, in hex.                              001000
    11   txt = 'select * from DATYP';                                                                           001100
    12   exec sql prepare s1 from :txt;                                                                         001200
    13   SQLN = SQL_NUM;                                                                                        001300
    14   exec sql describe s1 into :sqlda;                                                                      001400
    15   showda();                                                                                              001500
    16   // The names of expressions and the null-capable entries.                                              001600
    17   txt = 'select ID + 1, NM concat ''x'' as NX, AMT * 2, count(*), max(D) '                               001700
    18     + 'from DATYP group by ID, NM, AMT';                                                                 001800
    19   exec sql prepare s2 from :txt;                                                                         001900
    20   SQLN = SQL_NUM;                                                                                        002000
    21   exec sql describe s2 into :sqlda;                                                                      002100
    22   showda();                                                                                              002200
    23   *inlr = *on;                                                                                           002300
    24                                                                                                          002400
    25   // The SQLCA's code and the SQLDA: the header, then each entry in two lines.                           002500
    26   dcl-proc showda;                                                                                       002600
    27     dcl-s i int(10);                                                                                     002700
    28     dcl-s n int(10);                                                                                     002800
    29     line = %char(sqlcode) + ' ' + sqlstate + ' ' + sqlwarn(1) + sqlwarn(2) + ' '                         002900
    30       + hex(%addr(SQLDA): 16);                                                                           003000
    31     write QSYSPRT line;                                                                                  003100
    32     n = SQLD;                                                                                            003200
    33     if %subst(SQLDAID: 7: 1) = '2';                                                                      003300
    34       n = SQLD * 2;                                                                                      003400
    35     elseif %subst(SQLDAID: 7: 1) = '3';                                                                  003500
    36       n = SQLD * 3;                                                                                      003600
    37     endif;                                                                                               003700
    38     for i = 1 to n;                                                                                      003800
    39       if i > SQLN;                                                                                       003900
    40         leave;                                                                                           004000
    41       endif;                                                                                             004100
    42       line = hex(%addr(SQL_VAR(i)): 48);                                                                 004200
    43       write QSYSPRT line;                                                                                004300
    44       line = '  ' + hex(%addr(SQL_VAR(i)) + 48: 32);                                                     004400
    45       write QSYSPRT line;                                                                                004500
    46     endfor;                                                                                              004600
    47   end-proc;                                                                                              004700
    48                                                                                                          004800
    49   // Bytes as hexadecimal.                                                                               004900
    50   dcl-proc hex;                                                                                          005000
    51     dcl-pi *n varchar(200);                                                                              005100
    52       p pointer value;                                                                                   005200
    53       n int(10) value;                                                                                   005300
    54     end-pi;                                                                                              005400
    55     dcl-c DIG '0123456789ABCDEF';                                                                        005500
    56     dcl-s c char(1) based(q);                                                                            005600

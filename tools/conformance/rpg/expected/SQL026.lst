    14   // A join, LIKE, IN and BETWEEN with host variables.                                                   001400
    15   exec sql declare c1 cursor for select E.NAME, D.DNAME from EMPT E join DEPTT D                         001500
    16     on E.DEPT = D.DEPT where E.NAME like :pat order by E.ID;                                             001600
    17   exec sql open c1;                                                                                      001700
    18   dow 1 = 1;                                                                                             001800
    19     exec sql fetch c1 into :nm, :dn;                                                                     001900
    20     if sqlcode <> 0;                                                                                     002000
    21       leave;                                                                                             002100
    22     endif;                                                                                               002200
    23     line = nm + ' ' + dn;                                                                                002300
    24     write QSYSPRT line;                                                                                  002400
    25   enddo;                                                                                                 002500
    26   exec sql close c1;                                                                                     002600
    27   exec sql select count(*) into :n from EMPT where DEPT in ('ACC', 'OPS');                               002700
    28   line = %char(sqlcode) + ' ' + sqlstate + ' ' + %char(n);                                               002800
    29   write QSYSPRT line;                                                                                    002900
    30   exec sql select count(*) into :n from EMPT where SAL between :lo and :hi;                              003000
    31   line = %char(sqlcode) + ' ' + sqlstate + ' ' + %char(n);                                               003100
    32   write QSYSPRT line;                                                                                    003200
    33   exec sql select DNAME into :dn from DEPTT where DEPT = (select DEPT from EMPT where ID = 4);           003300
    34   line = %char(sqlcode) + ' ' + sqlstate + ' ' + dn;                                                     003400
    35   write QSYSPRT line;                                                                                    003500
    36   *inlr = *on;                                                                                           003600

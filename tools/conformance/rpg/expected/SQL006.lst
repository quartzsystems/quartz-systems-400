     2   //; cmd: CRTSQLRPGI OBJ({lib}/{name}) SRCFILE({lib}/QRPGLESRC) COMMIT(*NONE) OUTPUT(*PRINT)            000200
     3   //; sqlfile: EMPT                                                                                      000300
     4   ctl-opt dftactgrp(*no);                                                                                000400
     5   dcl-f QSYSPRT printer(132);                                                                            000500
     6   dcl-ds line len(132) end-ds;                                                                           000600
     7   dcl-s id int(10);                                                                                      000700
     8   dcl-s sal packed(9:2);                                                                                 000800
     9   // Positioned UPDATE and DELETE through a FOR UPDATE cursor.                                           000900
    10   exec sql declare c1 cursor for select ID, SAL from EMPT for update of SAL;                             001000
    11   exec sql declare c2 cursor for select ID, SAL from EMPT order by ID;                                   001100
    12   exec sql open c1;                                                                                      001200
    13   dow 1 = 1;                                                                                             001300
    14     exec sql fetch c1 into :id, :sal;                                                                    001400
    15     if sqlcode <> 0;                                                                                     001500
    16       leave;                                                                                             001600
    17     endif;                                                                                               001700
    18     if id = 2;                                                                                           001800
    19       exec sql update EMPT set SAL = SAL + 1000 where current of c1;                                     001900
    20       line = 'upd ' + %char(sqlcode) + ' ' + sqlstate + ' ' + %char(sqlerrd(3));                         002000
    21       write QSYSPRT line;                                                                                002100
    22     endif;                                                                                               002200
    23     if id = 4;                                                                                           002300
    24       exec sql delete from EMPT where current of c1;                                                     002400
    25       line = 'dlt ' + %char(sqlcode) + ' ' + sqlstate + ' ' + %char(sqlerrd(3));                         002500
    26       write QSYSPRT line;                                                                                002600
    27     endif;                                                                                               002700
    28   enddo;                                                                                                 002800
    29   exec sql close c1;                                                                                     002900
    30   exec sql update EMPT set SAL = 1 where current of c1;                                                  003000
    31   line = 'closed ' + %char(sqlcode) + ' ' + sqlstate;                                                    003100
    32   write QSYSPRT line;                                                                                    003200
    33   exec sql open c2;                                                                                      003300
    34   dow 1 = 1;                                                                                             003400
    35     exec sql fetch c2 into :id, :sal;                                                                    003500
    36     if sqlcode <> 0;                                                                                     003600
    37       leave;                                                                                             003700
    38     endif;                                                                                               003800
    39     line = %char(id) + ' ' + %char(sal);                                                                 003900
    40     write QSYSPRT line;                                                                                  004000
    41   enddo;                                                                                                 004100
    42   exec sql close c2;                                                                                     004200
    43   *inlr = *on;                                                                                           004300

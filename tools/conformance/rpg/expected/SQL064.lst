0    1   **FREE                                                                                                 000100
     2   //; cmd: CRTSQLRPGI OBJ({lib}/{name}) SRCFILE({lib}/QRPGLESRC) COMMIT(*NONE) OUTPUT(*PRINT)            000200
     3   //; sqlfile: EMPT                                                                                      000300
     4   //; run: no                                                                                            000400
     5   ctl-opt dftactgrp(*no);                                                                                000500
     6   dcl-s id int(10);                                                                                      000600
     7   dcl-s n int(10);                                                                                       000700
     8   dcl-s ind int(5) dim(3);                                                                               000800
     9   // What the precompiler refuses: FETCH ABSOLUTE, options of routines only,                             000900
    10   // an indicator array element, a list of values not in parentheses.                                    001000
    11   exec sql set option commit = *none, dbgview = *none, output = *print, tgtrls = *current;               001100
    12   exec sql declare c1 scroll cursor for select ID from EMPT order by ID;                                 001200
    13   exec sql open c1;                                                                                      001300
    14   exec sql fetch absolute 2 from c1 into :id;                                                            001400
    15   exec sql select BONUS into :n :ind(2) from EMPT where ID = 2;                                          001500
    16   exec sql values 1, 2 into :id, :n;                                                                     001600
    17   *inlr = *on;                                                                                           001700

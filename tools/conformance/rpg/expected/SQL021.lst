    11   // GROUP BY through a cursor.                                                                          001100
    12   exec sql declare c1 cursor for select DEPT, count(*), sum(SAL), avg(SAL) from EMPT                     001200
    13     group by DEPT order by DEPT;                                                                         001300
    14   exec sql open c1;                                                                                      001400
    15   dow 1 = 1;                                                                                             001500
    16     exec sql fetch c1 into :dp, :n, :tot, :av;                                                           001600
    17     if sqlcode <> 0;                                                                                     001700
    18       leave;                                                                                             001800
    19     endif;                                                                                               001900
    20     line = dp + ' ' + %char(n) + ' ' + %char(tot) + ' ' + %char(av);                                     002000
    21     write QSYSPRT line;                                                                                  002100
    22   enddo;                                                                                                 002200
    23   exec sql close c1;                                                                                     002300
    24   *inlr = *on;                                                                                           002400

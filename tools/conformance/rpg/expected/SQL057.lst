    296 // The SQLCA's code and the SQLDA: the header, then each entry in two lines.                                         005800
-   297 dcl-proc showda;                                                                                                     005900
-   298   dcl-s i int(10);                                                                                                   006000
    299   dcl-s n int(10);                                                                                                   006100
-   300   line = %char(sqlcode) + ' ' + sqlstate + ' ' + sqlwarn(1) + sqlwarn(2) + ' '                                       006200
    301     + hex(%addr(SQLDA): 16);                                                                                         006300
    302   write QSYSPRT line;                                                                                                006400
    303   n = SQLD;                                                                                                          006500
    304   if %subst(SQLDAID: 7: 1) = '2';                                                                    B01             006600
    305     n = SQLD * 2;                                                                                     01             006700
    306   elseif %subst(SQLDAID: 7: 1) = '3';                                                                X01             006800
    307     n = SQLD * 3;                                                                                     01             006900
    308   endif;                                                                                             E01             007000
    309   for i = 1 to n;                                                                                    B01             007100
    310     if i > SQLN;                                                                                     B02             007200
    311       leave;                                                                                          02             007300
    312     endif;                                                                                           E02             007400
    313     line = hex(%addr(SQL_VAR(i)): 48);                                                                01             007500
    314     write QSYSPRT line;                                                                               01             007600
    315     line = '  ' + hex(%addr(SQL_VAR(i)) + 48: 32);                                                    01             007700
    316     write QSYSPRT line;                                                                               01             007800
    317   endfor;                                                                                            E01             007900
    318 end-proc;                                                                                                            008000
    319                                                                                                                      008100
    320 // Bytes as hexadecimal.                                                                                             008200
    321 dcl-proc hex;                                                                                                        008300

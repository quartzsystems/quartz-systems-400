0   57                                                                                                          005700
    58   // The SQLCA's code and the SQLDA: the header, then each entry in two lines.                           005800
    59   dcl-proc showda;                                                                                       005900
    60     dcl-s i int(10);                                                                                     006000
    61     dcl-s n int(10);                                                                                     006100
    62     line = %char(sqlcode) + ' ' + sqlstate + ' ' + sqlwarn(1) + sqlwarn(2) + ' '                         006200
    63       + hex(%addr(SQLDA): 16);                                                                           006300
    64     write QSYSPRT line;                                                                                  006400
    65     n = SQLD;                                                                                            006500
    66     if %subst(SQLDAID: 7: 1) = '2';                                                                      006600
    67       n = SQLD * 2;                                                                                      006700
    68     elseif %subst(SQLDAID: 7: 1) = '3';                                                                  006800
    69       n = SQLD * 3;                                                                                      006900
    70     endif;                                                                                               007000
    71     for i = 1 to n;                                                                                      007100
    72       if i > SQLN;                                                                                       007200
    73         leave;                                                                                           007300
    74       endif;                                                                                             007400
    75       line = hex(%addr(SQL_VAR(i)): 48);                                                                 007500
    76       write QSYSPRT line;                                                                                007600
    77       line = '  ' + hex(%addr(SQL_VAR(i)) + 48: 32);                                                     007700
    78       write QSYSPRT line;                                                                                007800
    79     endfor;                                                                                              007900
    80   end-proc;                                                                                              008000
    81                                                                                                          008100
    82   // Bytes as hexadecimal.                                                                               008200
    83   dcl-proc hex;                                                                                          008300
    84     dcl-pi *n varchar(200);                                                                              008400
    85       p pointer value;                                                                                   008500
    86       n int(10) value;                                                                                   008600
    87     end-pi;                                                                                              008700
    88     dcl-c DIG '0123456789ABCDEF';                                                                        008800
    89     dcl-s c char(1) based(q);                                                                            008900
    90     dcl-s q pointer;                                                                                     009000
    91     dcl-ds bb;                                                                                           009100
    92       bc char(1);                                                                                        009200
    93       bu uns(3) overlay(bc);                                                                             009300
    94     end-ds;                                                                                              009400
    95     dcl-s o varchar(200);                                                                                009500
    96     dcl-s i int(10);                                                                                     009600
    97     for i = 0 to n - 1;                                                                                  009700
    98       q = p + i;                                                                                         009800
    99       bc = c;                                                                                            009900
   100       o += %subst(DIG: %div(bu: 16) + 1: 1) + %subst(DIG: %rem(bu: 16) + 1: 1);                          010000
   101     endfor;                                                                                              010100
   102     return o;                                                                                            010200
   103   end-proc;                                                                                              010300

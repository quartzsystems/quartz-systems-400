**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s d0 date(*MDY&) inz(d'2026-05-13');
dcl-s d1 date(*DMY/) inz(d'2026-06-14');
dcl-s d2 date(*DMY-) inz(d'2026-07-15');
dcl-s t0 time(*HMS:) inz(t'04.28.00');
dcl-s t1 time(*HMS.) inz(t'09.29.01');
line = '*MDY& ' + %char(d0) + ' ' + %char(%size(d0));
write QSYSPRT line;
line = '*DMY/ ' + %char(d1) + ' ' + %char(%size(d1));
write QSYSPRT line;
line = '*DMY- ' + %char(d2) + ' ' + %char(%size(d2));
write QSYSPRT line;
line = '*HMS: ' + %char(t0) + ' ' + %char(%size(t0));
write QSYSPRT line;
line = '*HMS. ' + %char(t1) + ' ' + %char(%size(t1));
write QSYSPRT line;
line = '*CYMD/ ' + %char(d0 : *CYMD/);
write QSYSPRT line;
line = '  ' + %char(%date(%char(d0 : *CYMD/) : *CYMD/));
write QSYSPRT line;
line = '*CMDY- ' + %char(d0 : *CMDY-);
write QSYSPRT line;
line = '  ' + %char(%date(%char(d0 : *CMDY-) : *CMDY-));
write QSYSPRT line;
line = '*CDMY. ' + %char(d0 : *CDMY.);
write QSYSPRT line;
line = '  ' + %char(%date(%char(d0 : *CDMY.) : *CDMY.));
write QSYSPRT line;
line = '*ISO0 ' + %char(t0 : *ISO0);
write QSYSPRT line;
line = '  ' + %char(%time(%char(t0 : *ISO0) : *ISO0));
write QSYSPRT line;
*inlr = *on;

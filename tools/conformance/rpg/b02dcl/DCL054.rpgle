**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-ds DS1;
  S01 time(*HMS:) inz(t'14.30.05');
  S02 float(8) inz(1.5);
  S03 zoned(2:0) inz(1);
  S04 varchar(9) inz('vw');
  S05 timestamp inz(z'2026-03-05-14.30.05.000123');
  S06 char(10) inz('kq');
  S07 date(*USA) inz(d'2026-03-05');
end-ds;
line = 'size ' + %char(%size(DS1));
write QSYSPRT line;
line = 'S01 ' + %char(%size(S01)) + ' ' + %char(%addr(S01) - %addr(DS1));
write QSYSPRT line;
line = '  ' + %char(S01);
write QSYSPRT line;
line = 'S02 ' + %char(%size(S02)) + ' ' + %char(%addr(S02) - %addr(DS1));
write QSYSPRT line;
line = '  ' + %char(S02);
write QSYSPRT line;
line = 'S03 ' + %char(%size(S03)) + ' ' + %char(%addr(S03) - %addr(DS1));
write QSYSPRT line;
line = '  ' + %char(S03);
write QSYSPRT line;
line = 'S04 ' + %char(%size(S04)) + ' ' + %char(%addr(S04) - %addr(DS1));
write QSYSPRT line;
line = '  ' + '[' + S04 + ']';
write QSYSPRT line;
line = 'S05 ' + %char(%size(S05)) + ' ' + %char(%addr(S05) - %addr(DS1));
write QSYSPRT line;
line = '  ' + %char(S05);
write QSYSPRT line;
line = 'S06 ' + %char(%size(S06)) + ' ' + %char(%addr(S06) - %addr(DS1));
write QSYSPRT line;
line = '  ' + '[' + S06 + ']';
write QSYSPRT line;
line = 'S07 ' + %char(%size(S07)) + ' ' + %char(%addr(S07) - %addr(DS1));
write QSYSPRT line;
line = '  ' + %char(S07);
write QSYSPRT line;
*inlr = *on;

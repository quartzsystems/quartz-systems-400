**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-ds DS1 qualified;
  S01 timestamp;
  S02 char(8) pos(14);
  S03 packed(8:1) overlay(S02 : *next);
  S04 uns(20) overlay(S02);
  S05 uns(3);
  S06 char(3) pos(22);
end-ds;
line = 'size ' + %char(%size(DS1));
write QSYSPRT line;
line = 'S01 ' + %char(%size(DS1.S01)) + ' ' + %char(%addr(DS1.S01) - %addr(DS1));
write QSYSPRT line;
line = 'S02 ' + %char(%size(DS1.S02)) + ' ' + %char(%addr(DS1.S02) - %addr(DS1));
write QSYSPRT line;
line = 'S03 ' + %char(%size(DS1.S03)) + ' ' + %char(%addr(DS1.S03) - %addr(DS1));
write QSYSPRT line;
line = 'S04 ' + %char(%size(DS1.S04)) + ' ' + %char(%addr(DS1.S04) - %addr(DS1));
write QSYSPRT line;
line = 'S05 ' + %char(%size(DS1.S05)) + ' ' + %char(%addr(DS1.S05) - %addr(DS1));
write QSYSPRT line;
line = 'S06 ' + %char(%size(DS1.S06)) + ' ' + %char(%addr(DS1.S06) - %addr(DS1));
write QSYSPRT line;
DS1 = 'AHOV29GNU18FMT07ELSZ6DKRY5CJQX4BIPW3AHOV29GNU18FMT07ELSZ6DKR';
line = 'S02 [' + DS1.S02 + ']';
write QSYSPRT line;
line = 'S06 [' + DS1.S06 + ']';
write QSYSPRT line;
*inlr = *on;

**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s d0 date(*JUL-) inz(d'2026-02-04');
dcl-s d1 date(*JUL.) inz(d'2026-03-05');
dcl-s d2 date(*JUL,) inz(d'2026-04-06');
dcl-s t0 time(*EUR) inz(t'10.10.00');
dcl-s t1 time(*JIS) inz(t'15.11.01');
line = '*JUL- ' + %char(d0) + ' ' + %char(%size(d0));
write QSYSPRT line;
line = '*JUL. ' + %char(d1) + ' ' + %char(%size(d1));
write QSYSPRT line;
line = '*JUL, ' + %char(d2) + ' ' + %char(%size(d2));
write QSYSPRT line;
line = '*EUR ' + %char(t0) + ' ' + %char(%size(t0));
write QSYSPRT line;
line = '*JIS ' + %char(t1) + ' ' + %char(%size(t1));
write QSYSPRT line;
line = '*CYMD/ ' + %char(d0 : *CYMD/);
write QSYSPRT line;
line = '  ' + %char(%date(%char(d0 : *CYMD/) : *CYMD/));
write QSYSPRT line;
line = '*CMDY- ' + %char(d0 : *CMDY-);
write QSYSPRT line;
line = '  ' + %char(%date(%char(d0 : *CMDY-) : *CMDY-));
write QSYSPRT line;
line = '*CDMY. ' + %char(d0 : *CDMY.);
write QSYSPRT line;
line = '  ' + %char(%date(%char(d0 : *CDMY.) : *CDMY.));
write QSYSPRT line;
line = '*JIS0 ' + %char(t0 : *JIS0);
write QSYSPRT line;
line = '  ' + %char(%time(%char(t0 : *JIS0) : *JIS0));
write QSYSPRT line;
*inlr = *on;

dcl-s V2 float(8) dim(3);
dcl-s V3 zoned(4:1) inz(*loval);
dcl-s V4 uns(10) inz(*zeros);
dcl-s V5 date(*JUL.) inz(d'2026-03-05');
dcl-s V6 date(*YMD-) inz(d'2026-03-05');
dcl-s V7 timestamp inz(z'2026-03-05-14.30.05.000123');
line = 'V0 ' + %char(%size(V0(3))) + ' ' + %char(%len(V0(3))) + ' ' + %char(V0(3));
write QSYSPRT line;
line = 'V1 ' + %char(%size(V1)) + ' ' + %char(V1);
write QSYSPRT line;
line = 'V2 ' + %char(%size(V2(3))) + ' ' + %char(V2(3));
write QSYSPRT line;
line = 'V3 ' + %char(%size(V3)) + ' ' + %char(%len(V3)) + ' ' + %char(V3);
write QSYSPRT line;
line = 'V4 ' + %char(%size(V4)) + ' ' + %char(%len(V4)) + ' ' + %char(V4);
write QSYSPRT line;
line = 'V5 ' + %char(%size(V5)) + ' ' + %char(V5);
write QSYSPRT line;
line = 'V6 ' + %char(%size(V6)) + ' ' + %char(V6);
write QSYSPRT line;
line = 'V7 ' + %char(%size(V7)) + ' ' + %char(V7);
write QSYSPRT line;
*inlr = *on;

**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s V0 char(6) dim(3) inz('k');
dcl-s V1 float(4) inz(*hival);
dcl-s V2 uns(3) inz(61);
dcl-s V3 varchar(5) inz('vw');
dcl-s V4 timestamp inz(*loval);
dcl-s V5 ucs2(2) dim(3);
dcl-s V6 ind inz(*off);
dcl-s V7 varchar(2) inz(*blanks);
line = 'V0 ' + %char(%size(V0(3))) + ' ' + %char(%len(V0(3))) + ' ' + '[' + V0(3) + ']';
write QSYSPRT line;
line = 'V1 ' + %char(%size(V1)) + ' ' + %char(V1);
write QSYSPRT line;
line = 'V2 ' + %char(%size(V2)) + ' ' + %char(%len(V2)) + ' ' + %char(V2);
write QSYSPRT line;
line = 'V3 ' + %char(%size(V3)) + ' ' + %char(%len(V3)) + ' ' + '[' + V3 + ']';
write QSYSPRT line;
line = 'V4 ' + %char(%size(V4)) + ' ' + %char(V4);
write QSYSPRT line;
line = 'V5 ' + %char(%size(V5(3))) + ' ' + %char(%len(V5(3))) + ' ' + %char(V5(3));
write QSYSPRT line;
line = 'V6 ' + %char(%size(V6)) + ' ' + V6;
write QSYSPRT line;
line = 'V7 ' + %char(%size(V7)) + ' ' + %char(%len(V7)) + ' ' + '[' + V7 + ']';
write QSYSPRT line;
*inlr = *on;

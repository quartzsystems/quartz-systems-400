**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s d0 date(*DMY-) inz(d'2026-06-16');
dcl-s d1 date(*DMY.) inz(d'2026-07-17');
dcl-s d2 date(*DMY,) inz(d'2026-08-18');
dcl-s t0 time(*HMS.) inz(t'05.35.00');
dcl-s t1 time(*HMS,) inz(t'10.36.01');
line = '*DMY- ' + %char(d0) + ' ' + %char(%size(d0));
write QSYSPRT line;
line = '*DMY. ' + %char(d1) + ' ' + %char(%size(d1));
write QSYSPRT line;
line = '*DMY, ' + %char(d2) + ' ' + %char(%size(d2));
write QSYSPRT line;
line = '*HMS. ' + %char(t0) + ' ' + %char(%size(t0));
write QSYSPRT line;
line = '*HMS, ' + %char(t1) + ' ' + %char(%size(t1));
write QSYSPRT line;
line = '*LONGJUL, ' + %char(d0 : *LONGJUL,);
write QSYSPRT line;
line = '  ' + %char(%date(%char(d0 : *LONGJUL,) : *LONGJUL,));
write QSYSPRT line;
line = '*CYMD0 ' + %char(d0 : *CYMD0);
write QSYSPRT line;
line = '  ' + %char(%date(%char(d0 : *CYMD0) : *CYMD0));
write QSYSPRT line;
line = '*LONGJUL0 ' + %char(d0 : *LONGJUL0);
write QSYSPRT line;
line = '  ' + %char(%date(%char(d0 : *LONGJUL0) : *LONGJUL0));
write QSYSPRT line;
line = '*EUR0 ' + %char(t0 : *EUR0);
write QSYSPRT line;
line = '  ' + %char(%time(%char(t0 : *EUR0) : *EUR0));
write QSYSPRT line;
*inlr = *on;

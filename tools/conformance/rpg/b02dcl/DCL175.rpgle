**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s V0 zoned(15:4) inz(9636.6192);
dcl-s V1 date(*JUL,) inz(d'2026-03-05');
dcl-s V2 bindec(8:1) inz(98.3);
dcl-s V3 date(*YMD/) inz(*hival);
dcl-s V4 varchar(2) inz('vw');
dcl-s V5 ucs2(6) inz(u'0075');
dcl-s V6 char(3) inz('kq');
dcl-s V7 date(*USA) dim(3) inz(*hival);
line = 'V0 ' + %char(%size(V0)) + ' ' + %char(%len(V0)) + ' ' + %char(V0);
write QSYSPRT line;
line = 'V1 ' + %char(%size(V1)) + ' ' + %char(V1);
write QSYSPRT line;
line = 'V2 ' + %char(%size(V2)) + ' ' + %char(%len(V2)) + ' ' + %char(V2);
write QSYSPRT line;
line = 'V3 ' + %char(%size(V3)) + ' ' + %char(V3);
write QSYSPRT line;
line = 'V4 ' + %char(%size(V4)) + ' ' + %char(%len(V4)) + ' ' + '[' + V4 + ']';
write QSYSPRT line;
line = 'V5 ' + %char(%size(V5)) + ' ' + %char(%len(V5)) + ' ' + %char(V5);
write QSYSPRT line;
line = 'V6 ' + %char(%size(V6)) + ' ' + %char(%len(V6)) + ' ' + '[' + V6 + ']';
write QSYSPRT line;
line = 'V7 ' + %char(%size(V7(3))) + ' ' + %char(V7(3));
write QSYSPRT line;
*inlr = *on;

**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s F00 date(*jis);
dcl-s F01 uns(10) inz(63);
dcl-s F02 ind;
dcl-s F03 int(3);
dcl-s F04 timestamp inz(z'2026-03-05-14.30.05.123456');

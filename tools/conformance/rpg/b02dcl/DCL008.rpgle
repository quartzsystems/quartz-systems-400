dcl-s F07 int(20) inz(83);
dcl-s F08 int(3) inz(64);
dcl-s F09 ind inz(*off);
dcl-s F10 int(3);
dcl-s F11 packed(24:0);
line = 'F00 ' + %char(%size(F00)) + ' ' + %char(%len(F00));
write QSYSPRT line;
line = '  ' + '[' + %char(F00) + ']';
write QSYSPRT line;
line = 'F01 ' + %char(%size(F01)) + ' ' + %char(%len(F01)) + ' ' + %char(%decpos(F01));
write QSYSPRT line;
line = '  ' + %char(F01);

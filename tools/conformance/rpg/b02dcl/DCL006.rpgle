dcl-s F08 time(*iso);
dcl-s F09 packed(26:2);
dcl-s F10 varchar(15);
dcl-s F11 int(5) inz(75);
line = 'F00 ' + %char(%size(F00)) + ' ' + %char(%len(F00)) + ' ' + %char(%decpos(F00));
write QSYSPRT line;
line = '  ' + %char(F00);
write QSYSPRT line;

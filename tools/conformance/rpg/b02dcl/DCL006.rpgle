**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s F00 int(10) inz(16);
dcl-s F01 timestamp inz(z'2026-03-05-14.30.05.123456');

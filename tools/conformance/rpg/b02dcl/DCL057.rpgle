**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-ds DS1;
  S01 date(*EUR) inz(d'2026-03-05');
  S02 char(7) inz('k');
  S03 pointer inz(*null);
  S04 float(8) inz(3E2);
end-ds;
line = 'size ' + %char(%size(DS1));
write QSYSPRT line;
line = 'S01 ' + %char(%size(S01)) + ' ' + %char(%addr(S01) - %addr(DS1));
write QSYSPRT line;
line = '  ' + %char(S01);
write QSYSPRT line;
line = 'S02 ' + %char(%size(S02)) + ' ' + %char(%addr(S02) - %addr(DS1));
write QSYSPRT line;
line = '  ' + '[' + S02 + ']';
write QSYSPRT line;
line = 'S03 ' + %char(%size(S03)) + ' ' + %char(%addr(S03) - %addr(DS1));
write QSYSPRT line;
line = '  ' + 'ptr';
write QSYSPRT line;
line = 'S04 ' + %char(%size(S04)) + ' ' + %char(%addr(S04) - %addr(DS1));
write QSYSPRT line;
line = '  ' + %char(S04);
write QSYSPRT line;
*inlr = *on;

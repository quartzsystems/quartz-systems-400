**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-ds DS1 qualified inz;
  S01 packed(14:4);
  S02 zoned(6:0);
  S03 pointer;
  S04 int(10);
  S05 zoned(3:1);
  S06 date(*DMY/);
  S07 char(1);
  S08 packed(13:0);
end-ds;
line = 'size ' + %char(%size(DS1));
write QSYSPRT line;
line = 'S01 ' + %char(%size(DS1.S01)) + ' ' + %char(%addr(DS1.S01) - %addr(DS1));
write QSYSPRT line;
line = '  ' + %char(DS1.S01);
write QSYSPRT line;
line = 'S02 ' + %char(%size(DS1.S02)) + ' ' + %char(%addr(DS1.S02) - %addr(DS1));
write QSYSPRT line;
line = '  ' + %char(DS1.S02);
write QSYSPRT line;
line = 'S03 ' + %char(%size(DS1.S03)) + ' ' + %char(%addr(DS1.S03) - %addr(DS1));
write QSYSPRT line;
line = '  ' + 'ptr';
write QSYSPRT line;
line = 'S04 ' + %char(%size(DS1.S04)) + ' ' + %char(%addr(DS1.S04) - %addr(DS1));
write QSYSPRT line;
line = '  ' + %char(DS1.S04);
write QSYSPRT line;
line = 'S05 ' + %char(%size(DS1.S05)) + ' ' + %char(%addr(DS1.S05) - %addr(DS1));
write QSYSPRT line;
line = '  ' + %char(DS1.S05);
write QSYSPRT line;
line = 'S06 ' + %char(%size(DS1.S06)) + ' ' + %char(%addr(DS1.S06) - %addr(DS1));
write QSYSPRT line;
line = '  ' + %char(DS1.S06);
write QSYSPRT line;
line = 'S07 ' + %char(%size(DS1.S07)) + ' ' + %char(%addr(DS1.S07) - %addr(DS1));
write QSYSPRT line;
line = '  ' + '[' + DS1.S07 + ']';
write QSYSPRT line;
line = 'S08 ' + %char(%size(DS1.S08)) + ' ' + %char(%addr(DS1.S08) - %addr(DS1));
write QSYSPRT line;
line = '  ' + %char(DS1.S08);
write QSYSPRT line;
*inlr = *on;

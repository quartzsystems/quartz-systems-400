**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s V0 float(8) inz(*zeros);
dcl-s V1 char(3) dim(3) inz('k');
dcl-s V2 ucs2(2) inz(u'0075');
dcl-s V3 timestamp inz(z'2026-03-05-14.30.05.000123');
dcl-s V4 char(8) dim(3) inz(*zeros);
dcl-s V5 timestamp dim(3) inz(z'2026-03-05-14.30.05.000123');
dcl-s V6 char(11) dim(3) inz(*zeros);
dcl-s V7 time(*HMS.) inz(*hival);
line = 'V0 ' + %char(%size(V0)) + ' ' + %char(V0);
write QSYSPRT line;
line = 'V1 ' + %char(%size(V1(3))) + ' ' + %char(%len(V1(3))) + ' ' + '[' + V1(3) + ']';
write QSYSPRT line;
line = 'V2 ' + %char(%size(V2)) + ' ' + %char(%len(V2)) + ' ' + %char(V2);
write QSYSPRT line;
line = 'V3 ' + %char(%size(V3)) + ' ' + %char(V3);
write QSYSPRT line;
line = 'V4 ' + %char(%size(V4(3))) + ' ' + %char(%len(V4(3))) + ' ' + '[' + V4(3) + ']';
write QSYSPRT line;
line = 'V5 ' + %char(%size(V5(3))) + ' ' + %char(V5(3));
write QSYSPRT line;
line = 'V6 ' + %char(%size(V6(3))) + ' ' + %char(%len(V6(3))) + ' ' + '[' + V6(3) + ']';
write QSYSPRT line;
line = 'V7 ' + %char(%size(V7)) + ' ' + %char(V7);
write QSYSPRT line;
*inlr = *on;

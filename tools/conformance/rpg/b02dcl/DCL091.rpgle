**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s d0 date(*DMY,) inz(d'2026-07-19');
dcl-s d1 date(*DMY&) inz(d'2026-08-20');
dcl-s d2 date(*YMD/) inz(d'2026-09-21');
dcl-s t0 time(*HMS,) inz(t'06.42.00');
dcl-s t1 time(*HMS&) inz(t'11.43.01');
line = '*DMY, ' + %char(d0) + ' ' + %char(%size(d0));
write QSYSPRT line;
line = '*DMY& ' + %char(d1) + ' ' + %char(%size(d1));
write QSYSPRT line;
line = '*YMD/ ' + %char(d2) + ' ' + %char(%size(d2));
write QSYSPRT line;
line = '*HMS, ' + %char(t0) + ' ' + %char(%size(t0));
write QSYSPRT line;
line = '*HMS& ' + %char(t1) + ' ' + %char(%size(t1));
write QSYSPRT line;
line = '*ISO0 ' + %char(d0 : *ISO0);
write QSYSPRT line;
line = '  ' + %char(%date(%char(d0 : *ISO0) : *ISO0));
write QSYSPRT line;
line = '*USA0 ' + %char(d0 : *USA0);
write QSYSPRT line;
line = '  ' + %char(%date(%char(d0 : *USA0) : *USA0));
write QSYSPRT line;
line = '*EUR0 ' + %char(d0 : *EUR0);
write QSYSPRT line;
line = '  ' + %char(%date(%char(d0 : *EUR0) : *EUR0));
write QSYSPRT line;
line = '*JIS0 ' + %char(t0 : *JIS0);
write QSYSPRT line;
line = '  ' + %char(%time(%char(t0 : *JIS0) : *JIS0));
write QSYSPRT line;
*inlr = *on;

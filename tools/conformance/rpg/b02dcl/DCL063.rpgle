**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-ds DS1;
  S01 ind;
  S02 timestamp pos(7);
  S03 char(8);
  S04 char(8) overlay(S03 : 1);
  S05 char(5) overlay(S03 : 1);
  S06 char(1) overlay(S05 : 1);
  S07 varchar(8);
  S08 uns(3) overlay(S03 : 4);
  S09 char(12);
end-ds;
line = 'size ' + %char(%size(DS1));
write QSYSPRT line;
line = 'S01 ' + %char(%size(S01)) + ' ' + %char(%addr(S01) - %addr(DS1));
write QSYSPRT line;
line = 'S02 ' + %char(%size(S02)) + ' ' + %char(%addr(S02) - %addr(DS1));
write QSYSPRT line;
line = 'S03 ' + %char(%size(S03)) + ' ' + %char(%addr(S03) - %addr(DS1));
write QSYSPRT line;
line = 'S04 ' + %char(%size(S04)) + ' ' + %char(%addr(S04) - %addr(DS1));
write QSYSPRT line;
line = 'S05 ' + %char(%size(S05)) + ' ' + %char(%addr(S05) - %addr(DS1));
write QSYSPRT line;
line = 'S06 ' + %char(%size(S06)) + ' ' + %char(%addr(S06) - %addr(DS1));
write QSYSPRT line;
line = 'S07 ' + %char(%size(S07)) + ' ' + %char(%addr(S07) - %addr(DS1));
write QSYSPRT line;
line = 'S08 ' + %char(%size(S08)) + ' ' + %char(%addr(S08) - %addr(DS1));
write QSYSPRT line;
line = 'S09 ' + %char(%size(S09)) + ' ' + %char(%addr(S09) - %addr(DS1));
write QSYSPRT line;
DS1 = 'AHOV29GNU18FMT07ELSZ6DKRY5CJQX4BIPW3AHOV29GNU18FMT07ELSZ6DKR';
line = 'S03 [' + S03 + ']';
write QSYSPRT line;
line = 'S04 [' + S04 + ']';
write QSYSPRT line;
line = 'S05 [' + S05 + ']';
write QSYSPRT line;
line = 'S06 [' + S06 + ']';
write QSYSPRT line;
line = 'S09 [' + S09 + ']';
write QSYSPRT line;
*inlr = *on;

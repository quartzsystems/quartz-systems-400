**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s V0 ind inz(*off);
dcl-s V1 bindec(4:1) inz(*hival);
dcl-s V2 ind inz(*off);
dcl-s V3 uns(5) inz(*hival);
dcl-s V4 float(8) inz(1.5);
dcl-s V5 time(*HMS.) dim(3) inz(t'14.30.05');
dcl-s V6 char(11) dim(3) inz(*zeros);
dcl-s V7 ucs2(3) inz(u'0075');
line = 'V0 ' + %char(%size(V0)) + ' ' + V0;
write QSYSPRT line;
line = 'V1 ' + %char(%size(V1)) + ' ' + %char(%len(V1)) + ' ' + %char(V1);
write QSYSPRT line;
line = 'V2 ' + %char(%size(V2)) + ' ' + V2;
write QSYSPRT line;
line = 'V3 ' + %char(%size(V3)) + ' ' + %char(%len(V3)) + ' ' + %char(V3);
write QSYSPRT line;
line = 'V4 ' + %char(%size(V4)) + ' ' + %char(V4);
write QSYSPRT line;
line = 'V5 ' + %char(%size(V5(3))) + ' ' + %char(V5(3));
write QSYSPRT line;
line = 'V6 ' + %char(%size(V6(3))) + ' ' + %char(%len(V6(3))) + ' ' + '[' + V6(3) + ']';
write QSYSPRT line;
line = 'V7 ' + %char(%size(V7)) + ' ' + %char(%len(V7)) + ' ' + %char(V7);
write QSYSPRT line;
*inlr = *on;

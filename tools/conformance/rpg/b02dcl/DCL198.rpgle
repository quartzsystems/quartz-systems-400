**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s V0 char(6) inz(*blanks);
dcl-s V1 date(*JUL,) inz(*loval);
dcl-s V2 uns(5) inz(5);
dcl-s V3 time(*ISO) inz(t'14.30.05');
dcl-s V4 bindec(3:1) inz(48.8);
dcl-s V5 zoned(1:1) inz(0.5);
dcl-s V6 ucs2(5);
dcl-s V7 uns(10) inz(*loval);
line = 'V0 ' + %char(%size(V0)) + ' ' + %char(%len(V0)) + ' ' + '[' + V0 + ']';
write QSYSPRT line;
line = 'V1 ' + %char(%size(V1)) + ' ' + %char(V1);
write QSYSPRT line;
line = 'V2 ' + %char(%size(V2)) + ' ' + %char(%len(V2)) + ' ' + %char(V2);
write QSYSPRT line;
line = 'V3 ' + %char(%size(V3)) + ' ' + %char(V3);
write QSYSPRT line;
line = 'V4 ' + %char(%size(V4)) + ' ' + %char(%len(V4)) + ' ' + %char(V4);
write QSYSPRT line;
line = 'V5 ' + %char(%size(V5)) + ' ' + %char(%len(V5)) + ' ' + %char(V5);
write QSYSPRT line;
line = 'V6 ' + %char(%size(V6)) + ' ' + %char(%len(V6)) + ' ' + %char(V6);
write QSYSPRT line;
line = 'V7 ' + %char(%size(V7)) + ' ' + %char(%len(V7)) + ' ' + %char(V7);
write QSYSPRT line;
*inlr = *on;

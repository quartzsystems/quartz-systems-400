**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s F00 float(4) inz(1.5);
dcl-s F01 uns(5);
dcl-s F02 packed(12:5) inz(7272655.31526);
dcl-s F03 packed(23:1) inz(414535181.0);
dcl-s F04 packed(13:6);
dcl-s F05 zoned(7:5);
dcl-s F06 date(*eur) inz(d'2026-03-05');
dcl-s F07 ind;
dcl-s F08 varchar(23) inz('xyz');
dcl-s F09 timestamp;
dcl-s F10 bindec(6:0) inz(8607);
dcl-s F11 ind inz(*on);
line = 'F00 ' + %char(%size(F00)) + ' ' + %char(%len(F00)) + ' ' + %char(%decpos(F00));
write QSYSPRT line;
line = '  ' + %char(F00);
write QSYSPRT line;
line = 'F01 ' + %char(%size(F01)) + ' ' + %char(%len(F01)) + ' ' + %char(%decpos(F01));
write QSYSPRT line;
line = '  ' + %char(F01);

**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s V0 ind;
dcl-s V1 date(*YMD-) inz(d'2026-03-05');
dcl-s V2 int(3) inz(*loval);
dcl-s V3 char(4);
dcl-s V4 ind inz(*on);
dcl-s V5 timestamp;
dcl-s V6 int(3) inz(62);
dcl-s V7 varchar(3) dim(3) inz('vw');
line = 'V0 ' + %char(%size(V0)) + ' ' + V0;
write QSYSPRT line;
line = 'V1 ' + %char(%size(V1)) + ' ' + %char(V1);
write QSYSPRT line;
line = 'V2 ' + %char(%size(V2)) + ' ' + %char(%len(V2)) + ' ' + %char(V2);
write QSYSPRT line;
line = 'V3 ' + %char(%size(V3)) + ' ' + %char(%len(V3)) + ' ' + '[' + V3 + ']';
write QSYSPRT line;
line = 'V4 ' + %char(%size(V4)) + ' ' + V4;
write QSYSPRT line;
line = 'V5 ' + %char(%size(V5)) + ' ' + %char(V5);
write QSYSPRT line;
line = 'V6 ' + %char(%size(V6)) + ' ' + %char(%len(V6)) + ' ' + %char(V6);
write QSYSPRT line;
line = 'V7 ' + %char(%size(V7(3))) + ' ' + %char(%len(V7(3))) + ' ' + '[' + V7(3) + ']';
write QSYSPRT line;
*inlr = *on;

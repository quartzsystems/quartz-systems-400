**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s V0 ind;
dcl-s V1 varchar(8);
dcl-s V2 varchar(9);
dcl-s V3 int(10) inz(28);
dcl-s V4 int(3) dim(3) inz(63);
dcl-s V5 date(*MDY,) inz(d'2026-03-05');
dcl-s V6 float(4) inz(1.5);
dcl-s V7 packed(12:3) inz(*loval);
line = 'V0 ' + %char(%size(V0)) + ' ' + V0;
write QSYSPRT line;
line = 'V1 ' + %char(%size(V1)) + ' ' + %char(%len(V1)) + ' ' + '[' + V1 + ']';
write QSYSPRT line;
line = 'V2 ' + %char(%size(V2)) + ' ' + %char(%len(V2)) + ' ' + '[' + V2 + ']';
write QSYSPRT line;
line = 'V3 ' + %char(%size(V3)) + ' ' + %char(%len(V3)) + ' ' + %char(V3);
write QSYSPRT line;
line = 'V4 ' + %char(%size(V4(3))) + ' ' + %char(%len(V4(3))) + ' ' + %char(V4(3));
write QSYSPRT line;
line = 'V5 ' + %char(%size(V5)) + ' ' + %char(V5);
write QSYSPRT line;
line = 'V6 ' + %char(%size(V6)) + ' ' + %char(V6);
write QSYSPRT line;
line = 'V7 ' + %char(%size(V7)) + ' ' + %char(%len(V7)) + ' ' + %char(V7);
write QSYSPRT line;
*inlr = *on;

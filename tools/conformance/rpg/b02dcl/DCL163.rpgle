**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s V0 char(11);
dcl-s V1 bindec(9:0);
dcl-s V2 uns(5) inz(28);
dcl-s V3 bindec(9:0) dim(3) inz(-16);
dcl-s V4 char(4) inz(*zeros);
dcl-s V5 int(3) inz(*zeros);
dcl-s V6 ind;
dcl-s V7 varchar(6) dim(3);
line = 'V0 ' + %char(%size(V0)) + ' ' + %char(%len(V0)) + ' ' + '[' + V0 + ']';
write QSYSPRT line;
line = 'V1 ' + %char(%size(V1)) + ' ' + %char(%len(V1)) + ' ' + %char(V1);
write QSYSPRT line;
line = 'V2 ' + %char(%size(V2)) + ' ' + %char(%len(V2)) + ' ' + %char(V2);
write QSYSPRT line;
line = 'V3 ' + %char(%size(V3(3))) + ' ' + %char(%len(V3(3))) + ' ' + %char(V3(3));
write QSYSPRT line;
line = 'V4 ' + %char(%size(V4)) + ' ' + %char(%len(V4)) + ' ' + '[' + V4 + ']';
write QSYSPRT line;
line = 'V5 ' + %char(%size(V5)) + ' ' + %char(%len(V5)) + ' ' + %char(V5);
write QSYSPRT line;
line = 'V6 ' + %char(%size(V6)) + ' ' + V6;
write QSYSPRT line;
line = 'V7 ' + %char(%size(V7(3))) + ' ' + %char(%len(V7(3))) + ' ' + '[' + V7(3) + ']';
write QSYSPRT line;
*inlr = *on;

**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s V0 zoned(2:0) dim(3) inz(*hival);
dcl-s V1 float(8) dim(3) inz(*hival);
dcl-s V2 char(6) dim(3) inz('kqzwmx');
dcl-s V3 ucs2(1);
dcl-s V4 timestamp;
dcl-s V5 float(8) inz(1.5);
dcl-s V6 ucs2(3);
dcl-s V7 bindec(1:1) inz(*hival);
line = 'V0 ' + %char(%size(V0(3))) + ' ' + %char(%len(V0(3))) + ' ' + %char(V0(3));
write QSYSPRT line;
line = 'V1 ' + %char(%size(V1(3))) + ' ' + %char(V1(3));
write QSYSPRT line;
line = 'V2 ' + %char(%size(V2(3))) + ' ' + %char(%len(V2(3))) + ' ' + '[' + V2(3) + ']';
write QSYSPRT line;
line = 'V3 ' + %char(%size(V3)) + ' ' + %char(%len(V3)) + ' ' + %char(V3);
write QSYSPRT line;
line = 'V4 ' + %char(%size(V4)) + ' ' + %char(V4);
write QSYSPRT line;
line = 'V5 ' + %char(%size(V5)) + ' ' + %char(V5);
write QSYSPRT line;
line = 'V6 ' + %char(%size(V6)) + ' ' + %char(%len(V6)) + ' ' + %char(V6);
write QSYSPRT line;
line = 'V7 ' + %char(%size(V7)) + ' ' + %char(%len(V7)) + ' ' + %char(V7);
write QSYSPRT line;
*inlr = *on;

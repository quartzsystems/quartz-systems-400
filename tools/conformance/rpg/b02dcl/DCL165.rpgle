**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s V0 zoned(2:1) inz(*loval);
dcl-s V1 int(20) inz(*loval);
dcl-s V2 zoned(10:1) inz(*zeros);
dcl-s V3 zoned(15:2) inz(6338.73);
dcl-s V4 float(4) dim(3) inz(3E2);
dcl-s V5 ind;
dcl-s V6 date(*YMD&);
dcl-s V7 char(5) inz(*blanks);
line = 'V0 ' + %char(%size(V0)) + ' ' + %char(%len(V0)) + ' ' + %char(V0);
write QSYSPRT line;
line = 'V1 ' + %char(%size(V1)) + ' ' + %char(%len(V1)) + ' ' + %char(V1);
write QSYSPRT line;
line = 'V2 ' + %char(%size(V2)) + ' ' + %char(%len(V2)) + ' ' + %char(V2);
write QSYSPRT line;
line = 'V3 ' + %char(%size(V3)) + ' ' + %char(%len(V3)) + ' ' + %char(V3);
write QSYSPRT line;
line = 'V4 ' + %char(%size(V4(3))) + ' ' + %char(V4(3));
write QSYSPRT line;
line = 'V5 ' + %char(%size(V5)) + ' ' + V5;
write QSYSPRT line;
line = 'V6 ' + %char(%size(V6)) + ' ' + %char(V6);
write QSYSPRT line;
line = 'V7 ' + %char(%size(V7)) + ' ' + %char(%len(V7)) + ' ' + '[' + V7 + ']';
write QSYSPRT line;
*inlr = *on;

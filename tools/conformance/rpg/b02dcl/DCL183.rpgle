**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s V0 ind dim(3) inz(*on);
dcl-s V1 time(*HMS.);
dcl-s V2 date(*YMD-) inz(d'2026-03-05');
dcl-s V3 float(4) dim(3) inz(*hival);
dcl-s V4 ucs2(3);
dcl-s V5 packed(3:1) dim(3) inz(*zeros);
dcl-s V6 date(*JUL-) inz(*loval);
dcl-s V7 char(1) inz(*zeros);
line = 'V0 ' + %char(%size(V0(3))) + ' ' + V0(3);
write QSYSPRT line;
line = 'V1 ' + %char(%size(V1)) + ' ' + %char(V1);
write QSYSPRT line;
line = 'V2 ' + %char(%size(V2)) + ' ' + %char(V2);
write QSYSPRT line;
line = 'V3 ' + %char(%size(V3(3))) + ' ' + %char(V3(3));
write QSYSPRT line;
line = 'V4 ' + %char(%size(V4)) + ' ' + %char(%len(V4)) + ' ' + %char(V4);
write QSYSPRT line;
line = 'V5 ' + %char(%size(V5(3))) + ' ' + %char(%len(V5(3))) + ' ' + %char(V5(3));
write QSYSPRT line;
line = 'V6 ' + %char(%size(V6)) + ' ' + %char(V6);
write QSYSPRT line;
line = 'V7 ' + %char(%size(V7)) + ' ' + %char(%len(V7)) + ' ' + '[' + V7 + ']';
write QSYSPRT line;
*inlr = *on;

write QSYSPRT line;
line = '  ' + '[' + %char(F05) + ']';
write QSYSPRT line;
line = 'F06 ' + %char(%size(F06)) + ' ' + %char(%len(F06));
write QSYSPRT line;
line = '  ' + '[' + %char(F06) + ']';

**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s F00 char(1) inz('a');
dcl-s F01 timestamp;
dcl-s F02 varchar(27) inz('xyz');
dcl-s F03 ind inz(*off);
dcl-s F04 packed(19:7) inz(-589712111.4818420);
dcl-s F05 char(6) inz('ab');
dcl-s F06 ind inz(*on);
dcl-s F07 bindec(8:4) inz(1911);
dcl-s F08 uns(5);
dcl-s F09 timestamp inz(z'2026-03-05-14.30.05.123456');
dcl-s F10 date(*jis);
dcl-s F11 uns(10) inz(63);
line = 'F00 ' + %char(%size(F00)) + ' ' + %char(%len(F00));
write QSYSPRT line;
line = '  ' + '[' + %char(F00) + ']';
write QSYSPRT line;
line = 'F01 ' + %char(%size(F01)) + ' ' + %char(%len(F01));
write QSYSPRT line;
line = '  ' + '[' + %char(F01) + ']';

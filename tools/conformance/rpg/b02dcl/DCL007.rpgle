line = '  ' + '[' + %char(F03) + ']';
write QSYSPRT line;
line = 'F04 ' + %char(%size(F04)) + ' ' + %char(%len(F04)) + ' ' + %char(%decpos(F04));
write QSYSPRT line;
line = '  ' + %char(F04);
write QSYSPRT line;

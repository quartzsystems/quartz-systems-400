line = 'F09 ' + %char(%size(F09)) + ' ' + %char(%len(F09));
write QSYSPRT line;
line = '  ' + '[' + %char(F09) + ']';
write QSYSPRT line;
line = 'F10 ' + %char(%size(F10)) + ' ' + %char(%len(F10));

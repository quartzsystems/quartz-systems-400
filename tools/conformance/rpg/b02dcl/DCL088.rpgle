**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s d0 date(*MDY.) inz(d'2026-04-10');
dcl-s d1 date(*MDY,) inz(d'2026-05-11');
dcl-s d2 date(*MDY&) inz(d'2026-06-12');
dcl-s t0 time(*JIS) inz(t'03.21.00');
dcl-s t1 time(*HMS:) inz(t'08.22.01');
line = '*MDY. ' + %char(d0) + ' ' + %char(%size(d0));
write QSYSPRT line;
line = '*MDY, ' + %char(d1) + ' ' + %char(%size(d1));
write QSYSPRT line;
line = '*MDY& ' + %char(d2) + ' ' + %char(%size(d2));
write QSYSPRT line;
line = '*JIS ' + %char(t0) + ' ' + %char(%size(t0));
write QSYSPRT line;
line = '*HMS: ' + %char(t1) + ' ' + %char(%size(t1));
write QSYSPRT line;
line = '*CMDY ' + %char(d0 : *CMDY);
write QSYSPRT line;
line = '  ' + %char(%date(%char(d0 : *CMDY) : *CMDY));
write QSYSPRT line;
line = '*CDMY ' + %char(d0 : *CDMY);
write QSYSPRT line;
line = '  ' + %char(%date(%char(d0 : *CDMY) : *CDMY));
write QSYSPRT line;
line = '*LONGJUL ' + %char(d0 : *LONGJUL);
write QSYSPRT line;
line = '  ' + %char(%date(%char(d0 : *LONGJUL) : *LONGJUL));
write QSYSPRT line;
line = '*HMS0 ' + %char(t0 : *HMS0);
write QSYSPRT line;
line = '  ' + %char(%time(%char(t0 : *HMS0) : *HMS0));
write QSYSPRT line;
*inlr = *on;

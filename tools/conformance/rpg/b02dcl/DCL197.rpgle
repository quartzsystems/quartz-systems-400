**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s V0 ucs2(4);
dcl-s V1 float(4) dim(3) inz(-0.25);
dcl-s V2 timestamp inz(z'2026-03-05-14.30.05.000123');
dcl-s V3 char(10);
dcl-s V4 date(*DMY.) inz(*hival);
dcl-s V5 packed(9:1) dim(3) inz(*loval);
dcl-s V6 ucs2(2);
dcl-s V7 ucs2(6);
line = 'V0 ' + %char(%size(V0)) + ' ' + %char(%len(V0)) + ' ' + %char(V0);
write QSYSPRT line;
line = 'V1 ' + %char(%size(V1(3))) + ' ' + %char(V1(3));
write QSYSPRT line;
line = 'V2 ' + %char(%size(V2)) + ' ' + %char(V2);
write QSYSPRT line;
line = 'V3 ' + %char(%size(V3)) + ' ' + %char(%len(V3)) + ' ' + '[' + V3 + ']';
write QSYSPRT line;
line = 'V4 ' + %char(%size(V4)) + ' ' + %char(V4);
write QSYSPRT line;
line = 'V5 ' + %char(%size(V5(3))) + ' ' + %char(%len(V5(3))) + ' ' + %char(V5(3));
write QSYSPRT line;
line = 'V6 ' + %char(%size(V6)) + ' ' + %char(%len(V6)) + ' ' + %char(V6);
write QSYSPRT line;
line = 'V7 ' + %char(%size(V7)) + ' ' + %char(%len(V7)) + ' ' + %char(V7);
write QSYSPRT line;
*inlr = *on;

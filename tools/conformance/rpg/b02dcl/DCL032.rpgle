**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s F00 float(8) inz(1.5);
dcl-s F01 ind inz(*off);
dcl-s F02 bindec(9:0) inz(9527);
dcl-s F03 uns(20);
dcl-s F04 ind inz(*off);
dcl-s F05 float(4) inz(100);
dcl-s F06 ind;
dcl-s F07 zoned(10:5) inz(-41519.91058);
dcl-s F08 varchar(31) inz('xyz');
dcl-s F09 varchar(16) inz('xyz');
dcl-s F10 bindec(5:4);
dcl-s F11 float(8) inz(100);
line = 'F00 ' + %char(%size(F00)) + ' ' + %char(%len(F00));
write QSYSPRT line;
line = '  ' + %char(F00);
write QSYSPRT line;
line = 'F01 ' + %char(%size(F01)) + ' ' + %char(%len(F01));
write QSYSPRT line;
line = '  ' + '[' + %char(F01) + ']';
write QSYSPRT line;
line = 'F02 ' + %char(%size(F02)) + ' ' + %char(%len(F02)) + ' ' + %char(%decpos(F02));
write QSYSPRT line;
line = '  ' + %char(F02);
write QSYSPRT line;
line = 'F03 ' + %char(%size(F03)) + ' ' + %char(%len(F03)) + ' ' + %char(%decpos(F03));
write QSYSPRT line;
line = '  ' + %char(F03);
write QSYSPRT line;
line = 'F04 ' + %char(%size(F04)) + ' ' + %char(%len(F04));
write QSYSPRT line;
line = '  ' + '[' + %char(F04) + ']';
write QSYSPRT line;
line = 'F05 ' + %char(%size(F05)) + ' ' + %char(%len(F05));
write QSYSPRT line;
line = '  ' + %char(F05);
write QSYSPRT line;
line = 'F06 ' + %char(%size(F06)) + ' ' + %char(%len(F06));
write QSYSPRT line;
line = '  ' + '[' + %char(F06) + ']';
write QSYSPRT line;
line = 'F07 ' + %char(%size(F07)) + ' ' + %char(%len(F07)) + ' ' + %char(%decpos(F07));
write QSYSPRT line;
line = '  ' + %char(F07);
write QSYSPRT line;
line = 'F08 ' + %char(%size(F08)) + ' ' + %char(%len(F08));
write QSYSPRT line;
line = '  ' + '[' + %char(F08) + ']';
write QSYSPRT line;
line = 'F09 ' + %char(%size(F09)) + ' ' + %char(%len(F09));
write QSYSPRT line;
line = '  ' + '[' + %char(F09) + ']';
write QSYSPRT line;
line = 'F10 ' + %char(%size(F10)) + ' ' + %char(%len(F10)) + ' ' + %char(%decpos(F10));
write QSYSPRT line;
line = '  ' + %char(F10);
write QSYSPRT line;
line = 'F11 ' + %char(%size(F11)) + ' ' + %char(%len(F11));
write QSYSPRT line;
line = '  ' + %char(F11);
write QSYSPRT line;
*inlr = *on;

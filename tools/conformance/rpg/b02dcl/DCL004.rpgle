**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s F00 varchar(16) inz('xyz');
dcl-s F01 int(20) inz(52);
dcl-s F02 bindec(14:2) inz(572);
dcl-s F03 packed(25:0) inz(718546533);
dcl-s F04 timestamp;
dcl-s F05 uns(10) inz(18);
dcl-s F06 date(*iso) inz(d'2026-03-05');
dcl-s F07 timestamp;
dcl-s F08 ind inz(*on);
dcl-s F09 packed(1:0) inz(9);
dcl-s F10 int(10);
dcl-s F11 zoned(3:0) inz(-481);
line = 'F00 ' + %char(%size(F00)) + ' ' + %char(%len(F00));
write QSYSPRT line;
line = '  ' + '[' + %char(F00) + ']';
write QSYSPRT line;
line = 'F01 ' + %char(%size(F01)) + ' ' + %char(%len(F01)) + ' ' + %char(%decpos(F01));
write QSYSPRT line;
line = '  ' + %char(F01);
write QSYSPRT line;
line = 'F02 ' + %char(%size(F02)) + ' ' + %char(%len(F02)) + ' ' + %char(%decpos(F02));
write QSYSPRT line;
line = '  ' + %char(F02);
write QSYSPRT line;
line = 'F03 ' + %char(%size(F03)) + ' ' + %char(%len(F03)) + ' ' + %char(%decpos(F03));
write QSYSPRT line;
line = '  ' + %char(F03);
write QSYSPRT line;
line = 'F04 ' + %char(%size(F04)) + ' ' + %char(%len(F04));
write QSYSPRT line;
line = '  ' + '[' + %char(F04) + ']';
write QSYSPRT line;
line = 'F05 ' + %char(%size(F05)) + ' ' + %char(%len(F05)) + ' ' + %char(%decpos(F05));
write QSYSPRT line;
line = '  ' + %char(F05);
write QSYSPRT line;
line = 'F06 ' + %char(%size(F06)) + ' ' + %char(%len(F06));
write QSYSPRT line;
line = '  ' + '[' + %char(F06) + ']';
write QSYSPRT line;
line = 'F07 ' + %char(%size(F07)) + ' ' + %char(%len(F07));
write QSYSPRT line;
line = '  ' + '[' + %char(F07) + ']';
write QSYSPRT line;
line = 'F08 ' + %char(%size(F08)) + ' ' + %char(%len(F08));
write QSYSPRT line;
line = '  ' + '[' + %char(F08) + ']';
write QSYSPRT line;
line = 'F09 ' + %char(%size(F09)) + ' ' + %char(%len(F09)) + ' ' + %char(%decpos(F09));
write QSYSPRT line;
line = '  ' + %char(F09);
write QSYSPRT line;
line = 'F10 ' + %char(%size(F10)) + ' ' + %char(%len(F10)) + ' ' + %char(%decpos(F10));
write QSYSPRT line;
line = '  ' + %char(F10);
write QSYSPRT line;
line = 'F11 ' + %char(%size(F11)) + ' ' + %char(%len(F11)) + ' ' + %char(%decpos(F11));
write QSYSPRT line;
line = '  ' + %char(F11);
write QSYSPRT line;
*inlr = *on;

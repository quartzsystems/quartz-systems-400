**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s d0 date(*JUL,) inz(d'2026-03-07');
dcl-s d1 date(*JUL&) inz(d'2026-04-08');
dcl-s d2 date(*ISO) inz(d'2026-05-09');
dcl-s t0 time(*JIS) inz(t'11.17.00');
dcl-s t1 time(*HMS:) inz(t'16.18.01');
line = '*JUL, ' + %char(d0) + ' ' + %char(%size(d0));
write QSYSPRT line;
line = '*JUL& ' + %char(d1) + ' ' + %char(%size(d1));
write QSYSPRT line;
line = '*ISO ' + %char(d2) + ' ' + %char(%size(d2));
write QSYSPRT line;
line = '*JIS ' + %char(t0) + ' ' + %char(%size(t0));
write QSYSPRT line;
line = '*HMS: ' + %char(t1) + ' ' + %char(%size(t1));
write QSYSPRT line;
line = '*LONGJUL, ' + %char(d0 : *LONGJUL,);
write QSYSPRT line;
line = '  ' + %char(%date(%char(d0 : *LONGJUL,) : *LONGJUL,));
write QSYSPRT line;
line = '*CYMD0 ' + %char(d0 : *CYMD0);
write QSYSPRT line;
line = '  ' + %char(%date(%char(d0 : *CYMD0) : *CYMD0));
write QSYSPRT line;
line = '*LONGJUL0 ' + %char(d0 : *LONGJUL0);
write QSYSPRT line;
line = '  ' + %char(%date(%char(d0 : *LONGJUL0) : *LONGJUL0));
write QSYSPRT line;
line = '*HMS0 ' + %char(t0 : *HMS0);
write QSYSPRT line;
line = '  ' + %char(%time(%char(t0 : *HMS0) : *HMS0));
write QSYSPRT line;
*inlr = *on;

**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s d0 date(*MDY/) inz(d'2026-03-07');
dcl-s d1 date(*MDY-) inz(d'2026-04-08');
dcl-s d2 date(*MDY.) inz(d'2026-05-09');
dcl-s t0 time(*EUR) inz(t'02.14.00');
dcl-s t1 time(*JIS) inz(t'07.15.01');
line = '*MDY/ ' + %char(d0) + ' ' + %char(%size(d0));
write QSYSPRT line;
line = '*MDY- ' + %char(d1) + ' ' + %char(%size(d1));
write QSYSPRT line;
line = '*MDY. ' + %char(d2) + ' ' + %char(%size(d2));
write QSYSPRT line;
line = '*EUR ' + %char(t0) + ' ' + %char(%size(t0));
write QSYSPRT line;
line = '*JIS ' + %char(t1) + ' ' + %char(%size(t1));
write QSYSPRT line;
line = '*YMD0 ' + %char(d0 : *YMD0);
write QSYSPRT line;
line = '  ' + %char(%date(%char(d0 : *YMD0) : *YMD0));
write QSYSPRT line;
line = '*JUL0 ' + %char(d0 : *JUL0);
write QSYSPRT line;
line = '  ' + %char(%date(%char(d0 : *JUL0) : *JUL0));
write QSYSPRT line;
line = '*CYMD ' + %char(d0 : *CYMD);
write QSYSPRT line;
line = '  ' + %char(%date(%char(d0 : *CYMD) : *CYMD));
write QSYSPRT line;
line = '*JIS0 ' + %char(t0 : *JIS0);
write QSYSPRT line;
line = '  ' + %char(%time(%char(t0 : *JIS0) : *JIS0));
write QSYSPRT line;
*inlr = *on;

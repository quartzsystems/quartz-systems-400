**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-ds DS1 align;
  S01 int(10);
  S02 pointer;
  S03 date(*EUR);
  S04 ucs2(2);
  S05 varchar(6);
  S06 date(*DMY-);
  S07 ucs2(1);
  S08 int(20);
end-ds;
line = 'size ' + %char(%size(DS1));
write QSYSPRT line;
line = 'S01 ' + %char(%size(S01)) + ' ' + %char(%addr(S01) - %addr(DS1));
write QSYSPRT line;
line = 'S02 ' + %char(%size(S02)) + ' ' + %char(%addr(S02) - %addr(DS1));
write QSYSPRT line;
line = 'S03 ' + %char(%size(S03)) + ' ' + %char(%addr(S03) - %addr(DS1));
write QSYSPRT line;
line = 'S04 ' + %char(%size(S04)) + ' ' + %char(%addr(S04) - %addr(DS1));
write QSYSPRT line;
line = 'S05 ' + %char(%size(S05)) + ' ' + %char(%addr(S05) - %addr(DS1));
write QSYSPRT line;
line = 'S06 ' + %char(%size(S06)) + ' ' + %char(%addr(S06) - %addr(DS1));
write QSYSPRT line;
line = 'S07 ' + %char(%size(S07)) + ' ' + %char(%addr(S07) - %addr(DS1));
write QSYSPRT line;
line = 'S08 ' + %char(%size(S08)) + ' ' + %char(%addr(S08) - %addr(DS1));
write QSYSPRT line;
*inlr = *on;

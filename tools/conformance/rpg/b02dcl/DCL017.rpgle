**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-ds d1;
  s1 char(5) inz('abc');
  s2 packed(5:2) inz(1.25);
  s3 zoned(4:0);
  s4 int(5);
end-ds;
dcl-ds d2 qualified inz;
  a char(3);
  b packed(3:0);
  c ind;
end-ds;
dcl-ds d3 len(40);
  p1 char(4) pos(10);
  p2 char(2) pos(30);
end-ds;
line = %char(%size(d1)) + ' ' + %char(%size(d2)) + ' ' + %char(%size(d3));
write QSYSPRT line;
line = '[' + s1 + '] ' + %char(s2) + ' ' + %char(s3) + ' ' + %char(s4);
write QSYSPRT line;
line = '[' + d2.a + '] ' + %char(d2.b) + ' ' + d2.c;
write QSYSPRT line;
p1 = 'WXYZ';
p2 = 'QQ';
line = '[' + d3 + ']';
write QSYSPRT line;
*inlr = *on;

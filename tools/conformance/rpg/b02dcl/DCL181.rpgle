**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s V0 packed(8:0) inz(*zeros);
dcl-s V1 varchar(6);
dcl-s V2 time(*HMS.) inz(t'14.30.05');
dcl-s V3 float(4) inz(*hival);
dcl-s V4 char(6) inz(*blanks);
dcl-s V5 float(8) inz(*zeros);
dcl-s V6 uns(5) inz(*zeros);
dcl-s V7 float(8) inz(*hival);
line = 'V0 ' + %char(%size(V0)) + ' ' + %char(%len(V0)) + ' ' + %char(V0);
write QSYSPRT line;
line = 'V1 ' + %char(%size(V1)) + ' ' + %char(%len(V1)) + ' ' + '[' + V1 + ']';
write QSYSPRT line;
line = 'V2 ' + %char(%size(V2)) + ' ' + %char(V2);
write QSYSPRT line;
line = 'V3 ' + %char(%size(V3)) + ' ' + %char(V3);
write QSYSPRT line;
line = 'V4 ' + %char(%size(V4)) + ' ' + %char(%len(V4)) + ' ' + '[' + V4 + ']';
write QSYSPRT line;
line = 'V5 ' + %char(%size(V5)) + ' ' + %char(V5);
write QSYSPRT line;
line = 'V6 ' + %char(%size(V6)) + ' ' + %char(%len(V6)) + ' ' + %char(V6);
write QSYSPRT line;
line = 'V7 ' + %char(%size(V7)) + ' ' + %char(V7);
write QSYSPRT line;
*inlr = *on;

**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s V0 date(*DMY&) dim(3) inz(d'2026-03-05');
dcl-s V1 int(5) inz(26);
dcl-s V2 timestamp inz(z'2026-03-05-14.30.05.000123');
dcl-s V3 time(*ISO) inz(*loval);
dcl-s V4 varchar(7);
dcl-s V5 ucs2(4);
dcl-s V6 timestamp inz(*hival);
dcl-s V7 ucs2(3) dim(3);
line = 'V0 ' + %char(%size(V0(3))) + ' ' + %char(V0(3));
write QSYSPRT line;
line = 'V1 ' + %char(%size(V1)) + ' ' + %char(%len(V1)) + ' ' + %char(V1);
write QSYSPRT line;
line = 'V2 ' + %char(%size(V2)) + ' ' + %char(V2);
write QSYSPRT line;
line = 'V3 ' + %char(%size(V3)) + ' ' + %char(V3);
write QSYSPRT line;
line = 'V4 ' + %char(%size(V4)) + ' ' + %char(%len(V4)) + ' ' + '[' + V4 + ']';
write QSYSPRT line;
line = 'V5 ' + %char(%size(V5)) + ' ' + %char(%len(V5)) + ' ' + %char(V5);
write QSYSPRT line;
line = 'V6 ' + %char(%size(V6)) + ' ' + %char(V6);
write QSYSPRT line;
line = 'V7 ' + %char(%size(V7(3))) + ' ' + %char(%len(V7(3))) + ' ' + %char(V7(3));
write QSYSPRT line;
*inlr = *on;

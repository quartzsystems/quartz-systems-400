**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s d0 date(*YMD&) inz(d'2026-01-01');
dcl-s d1 date(*JUL/) inz(d'2026-02-02');
dcl-s d2 date(*JUL-) inz(d'2026-03-03');
dcl-s t0 time(*USA) inz(t'09.03.00');
dcl-s t1 time(*EUR) inz(t'14.04.01');
line = '*YMD& ' + %char(d0) + ' ' + %char(%size(d0));
write QSYSPRT line;
line = '*JUL/ ' + %char(d1) + ' ' + %char(%size(d1));
write QSYSPRT line;
line = '*JUL- ' + %char(d2) + ' ' + %char(%size(d2));
write QSYSPRT line;
line = '*USA ' + %char(t0) + ' ' + %char(%size(t0));
write QSYSPRT line;
line = '*EUR ' + %char(t1) + ' ' + %char(%size(t1));
write QSYSPRT line;
line = '*CMDY ' + %char(d0 : *CMDY);
write QSYSPRT line;
line = '  ' + %char(%date(%char(d0 : *CMDY) : *CMDY));
write QSYSPRT line;
line = '*CDMY ' + %char(d0 : *CDMY);
write QSYSPRT line;
line = '  ' + %char(%date(%char(d0 : *CDMY) : *CDMY));
write QSYSPRT line;
line = '*LONGJUL ' + %char(d0 : *LONGJUL);
write QSYSPRT line;
line = '  ' + %char(%date(%char(d0 : *LONGJUL) : *LONGJUL));
write QSYSPRT line;
line = '*EUR0 ' + %char(t0 : *EUR0);
write QSYSPRT line;
line = '  ' + %char(%time(%char(t0 : *EUR0) : *EUR0));
write QSYSPRT line;
*inlr = *on;

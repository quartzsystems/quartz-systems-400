**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s base packed(7:2) inz(12.34);
dcl-s more like(base : +3);
dcl-s less like(base : -2);
dcl-s name char(10) inz('abc');
dcl-s longer like(name : 5);
dcl-s vname varchar(8) inz('vv');
dcl-s likev like(vname);
dcl-c K1 'quoted';
dcl-c K2 const(123.45);
dcl-c K3 *blanks;
dcl-c K4 x'C1C2';
more = base * 10;
less = 99.9;
longer = name + 'xyz';
line = 'more ' + %char(%size(more)) + ' ' + %char(%len(more)) + ' ' + %char(%decpos(more));
write QSYSPRT line;
line = '  ' + %char(more);
write QSYSPRT line;
line = 'less ' + %char(%size(less)) + ' ' + %char(%len(less)) + ' ' + %char(%decpos(less));
write QSYSPRT line;
line = '  ' + %char(less);
write QSYSPRT line;
line = 'longer ' + %char(%size(longer)) + ' ' + %char(%len(longer));
write QSYSPRT line;
line = '  ' + '[' + %char(longer) + ']';
write QSYSPRT line;
line = 'likev ' + %char(%size(likev)) + ' ' + %char(%len(likev));
write QSYSPRT line;
line = '  ' + '[' + %char(likev) + ']';
write QSYSPRT line;
line = K1 + ' ' + %char(K2) + '[' + K3 + ']' + K4;
write QSYSPRT line;
line = %char(%len(K1)) + ' ' + %char(%size(K2));
write QSYSPRT line;
*inlr = *on;

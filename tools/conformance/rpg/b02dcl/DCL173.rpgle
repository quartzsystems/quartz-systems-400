**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s V0 char(5);
dcl-s V1 bindec(2:1) inz(4.6);
dcl-s V2 uns(5) inz(*loval);
dcl-s V3 ind;
dcl-s V4 char(6) dim(3);
dcl-s V5 packed(8:2) inz(*loval);
dcl-s V6 float(8) inz(*zeros);
dcl-s V7 packed(2:0) inz(80);
line = 'V0 ' + %char(%size(V0)) + ' ' + %char(%len(V0)) + ' ' + '[' + V0 + ']';
write QSYSPRT line;
line = 'V1 ' + %char(%size(V1)) + ' ' + %char(%len(V1)) + ' ' + %char(V1);
write QSYSPRT line;
line = 'V2 ' + %char(%size(V2)) + ' ' + %char(%len(V2)) + ' ' + %char(V2);
write QSYSPRT line;
line = 'V3 ' + %char(%size(V3)) + ' ' + V3;
write QSYSPRT line;
line = 'V4 ' + %char(%size(V4(3))) + ' ' + %char(%len(V4(3))) + ' ' + '[' + V4(3) + ']';
write QSYSPRT line;
line = 'V5 ' + %char(%size(V5)) + ' ' + %char(%len(V5)) + ' ' + %char(V5);
write QSYSPRT line;
line = 'V6 ' + %char(%size(V6)) + ' ' + %char(V6);
write QSYSPRT line;
line = 'V7 ' + %char(%size(V7)) + ' ' + %char(%len(V7)) + ' ' + %char(V7);
write QSYSPRT line;
*inlr = *on;

**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s d0 date(*YMD.) inz(d'2026-09-25');
dcl-s d1 date(*YMD,) inz(d'2026-01-26');
dcl-s d2 date(*YMD&) inz(d'2026-02-27');
dcl-s t0 time(*ISO) inz(t'08.56.00');
dcl-s t1 time(*USA) inz(t'13.57.01');
line = '*YMD. ' + %char(d0) + ' ' + %char(%size(d0));
write QSYSPRT line;
line = '*YMD, ' + %char(d1) + ' ' + %char(%size(d1));
write QSYSPRT line;
line = '*YMD& ' + %char(d2) + ' ' + %char(%size(d2));
write QSYSPRT line;
line = '*ISO ' + %char(t0) + ' ' + %char(%size(t0));
write QSYSPRT line;
line = '*USA ' + %char(t1) + ' ' + %char(%size(t1));
write QSYSPRT line;
line = '*YMD0 ' + %char(d0 : *YMD0);
write QSYSPRT line;
line = '  ' + %char(%date(%char(d0 : *YMD0) : *YMD0));
write QSYSPRT line;
line = '*JUL0 ' + %char(d0 : *JUL0);
write QSYSPRT line;
line = '  ' + %char(%date(%char(d0 : *JUL0) : *JUL0));
write QSYSPRT line;
line = '*CYMD ' + %char(d0 : *CYMD);
write QSYSPRT line;
line = '  ' + %char(%date(%char(d0 : *CYMD) : *CYMD));
write QSYSPRT line;
line = '*ISO0 ' + %char(t0 : *ISO0);
write QSYSPRT line;
line = '  ' + %char(%time(%char(t0 : *ISO0) : *ISO0));
write QSYSPRT line;
*inlr = *on;

**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s F00 ind inz(*on);
dcl-s F01 float(4) inz(-2.25);
dcl-s F02 timestamp inz(z'2026-03-05-14.30.05.123456');
dcl-s F03 bindec(3:2);
dcl-s F04 char(13);
dcl-s F05 date(*eur) inz(d'2026-03-05');
dcl-s F06 varchar(37);
dcl-s F07 int(10);
dcl-s F08 date(*usa);
dcl-s F09 uns(10) inz(43);
dcl-s F10 uns(10) inz(74);
dcl-s F11 varchar(1);
line = 'F00 ' + %char(%size(F00)) + ' ' + %char(%len(F00));
write QSYSPRT line;
line = '  ' + '[' + %char(F00) + ']';
write QSYSPRT line;
line = 'F01 ' + %char(%size(F01)) + ' ' + %char(%len(F01));
write QSYSPRT line;
line = '  ' + %char(F01);
write QSYSPRT line;
line = 'F02 ' + %char(%size(F02)) + ' ' + %char(%len(F02));
write QSYSPRT line;
line = '  ' + '[' + %char(F02) + ']';
write QSYSPRT line;
line = 'F03 ' + %char(%size(F03)) + ' ' + %char(%len(F03)) + ' ' + %char(%decpos(F03));
write QSYSPRT line;
line = '  ' + %char(F03);
write QSYSPRT line;
line = 'F04 ' + %char(%size(F04)) + ' ' + %char(%len(F04));
write QSYSPRT line;
line = '  ' + '[' + %char(F04) + ']';
write QSYSPRT line;
line = 'F05 ' + %char(%size(F05)) + ' ' + %char(%len(F05));
write QSYSPRT line;
line = '  ' + '[' + %char(F05) + ']';
write QSYSPRT line;
line = 'F06 ' + %char(%size(F06)) + ' ' + %char(%len(F06));
write QSYSPRT line;
line = '  ' + '[' + %char(F06) + ']';
write QSYSPRT line;
line = 'F07 ' + %char(%size(F07)) + ' ' + %char(%len(F07)) + ' ' + %char(%decpos(F07));
write QSYSPRT line;
line = '  ' + %char(F07);
write QSYSPRT line;
line = 'F08 ' + %char(%size(F08)) + ' ' + %char(%len(F08));
write QSYSPRT line;
line = '  ' + '[' + %char(F08) + ']';
write QSYSPRT line;
line = 'F09 ' + %char(%size(F09)) + ' ' + %char(%len(F09)) + ' ' + %char(%decpos(F09));
write QSYSPRT line;
line = '  ' + %char(F09);
write QSYSPRT line;
line = 'F10 ' + %char(%size(F10)) + ' ' + %char(%len(F10)) + ' ' + %char(%decpos(F10));
write QSYSPRT line;
line = '  ' + %char(F10);
write QSYSPRT line;
line = 'F11 ' + %char(%size(F11)) + ' ' + %char(%len(F11));
write QSYSPRT line;
line = '  ' + '[' + %char(F11) + ']';
write QSYSPRT line;
*inlr = *on;

**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s d0 date(*EUR) inz(d'2026-02-04');
dcl-s d1 date(*JIS) inz(d'2026-03-05');
dcl-s d2 date(*MDY/) inz(d'2026-04-06');
dcl-s t0 time(*USA) inz(t'01.07.00');
dcl-s t1 time(*EUR) inz(t'06.08.01');
line = '*EUR ' + %char(d0) + ' ' + %char(%size(d0));
write QSYSPRT line;
line = '*JIS ' + %char(d1) + ' ' + %char(%size(d1));
write QSYSPRT line;
line = '*MDY/ ' + %char(d2) + ' ' + %char(%size(d2));
write QSYSPRT line;
line = '*USA ' + %char(t0) + ' ' + %char(%size(t0));
write QSYSPRT line;
line = '*EUR ' + %char(t1) + ' ' + %char(%size(t1));
write QSYSPRT line;
line = '*JIS0 ' + %char(d0 : *JIS0);
write QSYSPRT line;
line = '  ' + %char(%date(%char(d0 : *JIS0) : *JIS0));
write QSYSPRT line;
line = '*MDY0 ' + %char(d0 : *MDY0);
write QSYSPRT line;
line = '  ' + %char(%date(%char(d0 : *MDY0) : *MDY0));
write QSYSPRT line;
line = '*DMY0 ' + %char(d0 : *DMY0);
write QSYSPRT line;
line = '  ' + %char(%date(%char(d0 : *DMY0) : *DMY0));
write QSYSPRT line;
line = '*EUR0 ' + %char(t0 : *EUR0);
write QSYSPRT line;
line = '  ' + %char(%time(%char(t0 : *EUR0) : *EUR0));
write QSYSPRT line;
*inlr = *on;

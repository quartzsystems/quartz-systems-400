**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s V0 float(4);
dcl-s V1 date(*YMD&);
dcl-s V2 time(*HMS&) dim(3);
dcl-s V3 time(*ISO);
dcl-s V4 char(10) inz(*zeros);
dcl-s V5 char(5) inz(*blanks);
dcl-s V6 date(*JUL.);
dcl-s V7 bindec(8:2) dim(3) inz(*hival);
line = 'V0 ' + %char(%size(V0)) + ' ' + %char(V0);
write QSYSPRT line;
line = 'V1 ' + %char(%size(V1)) + ' ' + %char(V1);
write QSYSPRT line;
line = 'V2 ' + %char(%size(V2(3))) + ' ' + %char(V2(3));
write QSYSPRT line;
line = 'V3 ' + %char(%size(V3)) + ' ' + %char(V3);
write QSYSPRT line;
line = 'V4 ' + %char(%size(V4)) + ' ' + %char(%len(V4)) + ' ' + '[' + V4 + ']';
write QSYSPRT line;
line = 'V5 ' + %char(%size(V5)) + ' ' + %char(%len(V5)) + ' ' + '[' + V5 + ']';
write QSYSPRT line;
line = 'V6 ' + %char(%size(V6)) + ' ' + %char(V6);
write QSYSPRT line;
line = 'V7 ' + %char(%size(V7(3))) + ' ' + %char(%len(V7(3))) + ' ' + %char(V7(3));
write QSYSPRT line;
*inlr = *on;

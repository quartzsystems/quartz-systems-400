**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s V0 packed(2:1) inz(9.7);
dcl-s V1 char(5) inz('k');
dcl-s V2 date(*MDY.);
dcl-s V3 date(*JUL,) inz(*hival);
dcl-s V4 timestamp inz(z'2026-03-05-14.30.05.000123');
dcl-s V5 date(*DMY&) inz(d'2026-03-05');
dcl-s V6 float(4) inz(*loval);
dcl-s V7 float(4) inz(3E2);
line = 'V0 ' + %char(%size(V0)) + ' ' + %char(%len(V0)) + ' ' + %char(V0);
write QSYSPRT line;
line = 'V1 ' + %char(%size(V1)) + ' ' + %char(%len(V1)) + ' ' + '[' + V1 + ']';
write QSYSPRT line;
line = 'V2 ' + %char(%size(V2)) + ' ' + %char(V2);
write QSYSPRT line;
line = 'V3 ' + %char(%size(V3)) + ' ' + %char(V3);
write QSYSPRT line;
line = 'V4 ' + %char(%size(V4)) + ' ' + %char(V4);
write QSYSPRT line;
line = 'V5 ' + %char(%size(V5)) + ' ' + %char(V5);
write QSYSPRT line;
line = 'V6 ' + %char(%size(V6)) + ' ' + %char(V6);
write QSYSPRT line;
line = 'V7 ' + %char(%size(V7)) + ' ' + %char(V7);
write QSYSPRT line;
*inlr = *on;

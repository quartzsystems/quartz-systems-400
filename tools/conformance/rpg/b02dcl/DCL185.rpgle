**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s V0 packed(11:4) inz(3742.1432);
dcl-s V1 date(*JIS) inz(d'2026-03-05');
dcl-s V2 int(10) inz(12);
dcl-s V3 time(*JIS);
dcl-s V4 timestamp dim(3);
dcl-s V5 bindec(8:1);
dcl-s V6 date(*DMY-);
dcl-s V7 timestamp;
line = 'V0 ' + %char(%size(V0)) + ' ' + %char(%len(V0)) + ' ' + %char(V0);
write QSYSPRT line;
line = 'V1 ' + %char(%size(V1)) + ' ' + %char(V1);
write QSYSPRT line;
line = 'V2 ' + %char(%size(V2)) + ' ' + %char(%len(V2)) + ' ' + %char(V2);
write QSYSPRT line;
line = 'V3 ' + %char(%size(V3)) + ' ' + %char(V3);
write QSYSPRT line;
line = 'V4 ' + %char(%size(V4(3))) + ' ' + %char(V4(3));
write QSYSPRT line;
line = 'V5 ' + %char(%size(V5)) + ' ' + %char(%len(V5)) + ' ' + %char(V5);
write QSYSPRT line;
line = 'V6 ' + %char(%size(V6)) + ' ' + %char(V6);
write QSYSPRT line;
line = 'V7 ' + %char(%size(V7)) + ' ' + %char(V7);
write QSYSPRT line;
*inlr = *on;

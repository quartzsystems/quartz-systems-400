**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s d0 date(*YMD/) inz(d'2026-08-22');
dcl-s d1 date(*YMD-) inz(d'2026-09-23');
dcl-s d2 date(*YMD.) inz(d'2026-01-24');
dcl-s t0 time(*HMS&) inz(t'07.49.00');
dcl-s t1 time(*ISO) inz(t'12.50.01');
line = '*YMD/ ' + %char(d0) + ' ' + %char(%size(d0));
write QSYSPRT line;
line = '*YMD- ' + %char(d1) + ' ' + %char(%size(d1));
write QSYSPRT line;
line = '*YMD. ' + %char(d2) + ' ' + %char(%size(d2));
write QSYSPRT line;
line = '*HMS& ' + %char(t0) + ' ' + %char(%size(t0));
write QSYSPRT line;
line = '*ISO ' + %char(t1) + ' ' + %char(%size(t1));
write QSYSPRT line;
line = '*JIS0 ' + %char(d0 : *JIS0);
write QSYSPRT line;
line = '  ' + %char(%date(%char(d0 : *JIS0) : *JIS0));
write QSYSPRT line;
line = '*MDY0 ' + %char(d0 : *MDY0);
write QSYSPRT line;
line = '  ' + %char(%date(%char(d0 : *MDY0) : *MDY0));
write QSYSPRT line;
line = '*DMY0 ' + %char(d0 : *DMY0);
write QSYSPRT line;
line = '  ' + %char(%date(%char(d0 : *DMY0) : *DMY0));
write QSYSPRT line;
line = '*HMS0 ' + %char(t0 : *HMS0);
write QSYSPRT line;
line = '  ' + %char(%time(%char(t0 : *HMS0) : *HMS0));
write QSYSPRT line;
*inlr = *on;

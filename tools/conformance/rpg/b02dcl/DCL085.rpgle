**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s d0 date(*ISO) inz(d'2026-01-01');
dcl-s d1 date(*USA) inz(d'2026-02-02');
dcl-s d2 date(*EUR) inz(d'2026-03-03');
dcl-s t0 time(*ISO) inz(t'00.00.00');
dcl-s t1 time(*USA) inz(t'05.01.01');
line = '*ISO ' + %char(d0) + ' ' + %char(%size(d0));
write QSYSPRT line;
line = '*USA ' + %char(d1) + ' ' + %char(%size(d1));
write QSYSPRT line;
line = '*EUR ' + %char(d2) + ' ' + %char(%size(d2));
write QSYSPRT line;
line = '*ISO ' + %char(t0) + ' ' + %char(%size(t0));
write QSYSPRT line;
line = '*USA ' + %char(t1) + ' ' + %char(%size(t1));
write QSYSPRT line;
line = '*ISO0 ' + %char(d0 : *ISO0);
write QSYSPRT line;
line = '  ' + %char(%date(%char(d0 : *ISO0) : *ISO0));
write QSYSPRT line;
line = '*USA0 ' + %char(d0 : *USA0);
write QSYSPRT line;
line = '  ' + %char(%date(%char(d0 : *USA0) : *USA0));
write QSYSPRT line;
line = '*EUR0 ' + %char(d0 : *EUR0);
write QSYSPRT line;
line = '  ' + %char(%date(%char(d0 : *EUR0) : *EUR0));
write QSYSPRT line;
line = '*ISO0 ' + %char(t0 : *ISO0);
write QSYSPRT line;
line = '  ' + %char(%time(%char(t0 : *ISO0) : *ISO0));
write QSYSPRT line;
*inlr = *on;

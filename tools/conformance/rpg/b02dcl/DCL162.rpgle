**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s V0 char(8);
dcl-s V1 timestamp;
dcl-s V2 char(5) inz(*blanks);
dcl-s V3 date(*MDY,);
dcl-s V4 char(5) dim(3) inz('kqzwm');
dcl-s V5 bindec(4:2) inz(*hival);
dcl-s V6 varchar(7) inz(*blanks);
dcl-s V7 ind inz(*off);
line = 'V0 ' + %char(%size(V0)) + ' ' + %char(%len(V0)) + ' ' + '[' + V0 + ']';
write QSYSPRT line;
line = 'V1 ' + %char(%size(V1)) + ' ' + %char(V1);
write QSYSPRT line;
line = 'V2 ' + %char(%size(V2)) + ' ' + %char(%len(V2)) + ' ' + '[' + V2 + ']';
write QSYSPRT line;
line = 'V3 ' + %char(%size(V3)) + ' ' + %char(V3);
write QSYSPRT line;
line = 'V4 ' + %char(%size(V4(3))) + ' ' + %char(%len(V4(3))) + ' ' + '[' + V4(3) + ']';
write QSYSPRT line;
line = 'V5 ' + %char(%size(V5)) + ' ' + %char(%len(V5)) + ' ' + %char(V5);
write QSYSPRT line;
line = 'V6 ' + %char(%size(V6)) + ' ' + %char(%len(V6)) + ' ' + '[' + V6 + ']';
write QSYSPRT line;
line = 'V7 ' + %char(%size(V7)) + ' ' + V7;
write QSYSPRT line;
*inlr = *on;

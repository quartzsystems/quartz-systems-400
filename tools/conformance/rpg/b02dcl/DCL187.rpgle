**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s V0 date(*JUL,) inz(*loval);
dcl-s V1 int(3) inz(*hival);
dcl-s V2 bindec(6:0) dim(3) inz(*hival);
dcl-s V3 uns(3) dim(3) inz(*zeros);
dcl-s V4 char(8) inz('kq');
dcl-s V5 bindec(4:2) inz(32.16);
dcl-s V6 char(6) inz('kqzw');
dcl-s V7 ucs2(4);
line = 'V0 ' + %char(%size(V0)) + ' ' + %char(V0);
write QSYSPRT line;
line = 'V1 ' + %char(%size(V1)) + ' ' + %char(%len(V1)) + ' ' + %char(V1);
write QSYSPRT line;
line = 'V2 ' + %char(%size(V2(3))) + ' ' + %char(%len(V2(3))) + ' ' + %char(V2(3));
write QSYSPRT line;
line = 'V3 ' + %char(%size(V3(3))) + ' ' + %char(%len(V3(3))) + ' ' + %char(V3(3));
write QSYSPRT line;
line = 'V4 ' + %char(%size(V4)) + ' ' + %char(%len(V4)) + ' ' + '[' + V4 + ']';
write QSYSPRT line;
line = 'V5 ' + %char(%size(V5)) + ' ' + %char(%len(V5)) + ' ' + %char(V5);
write QSYSPRT line;
line = 'V6 ' + %char(%size(V6)) + ' ' + %char(%len(V6)) + ' ' + '[' + V6 + ']';
write QSYSPRT line;
line = 'V7 ' + %char(%size(V7)) + ' ' + %char(%len(V7)) + ' ' + %char(V7);
write QSYSPRT line;
*inlr = *on;

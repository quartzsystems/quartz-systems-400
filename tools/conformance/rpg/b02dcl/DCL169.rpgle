**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s V0 char(9) inz('k');
dcl-s V1 date(*YMD&) inz(d'2026-03-05');
dcl-s V2 zoned(13:3) dim(3) inz(*zeros);
dcl-s V3 ucs2(4) dim(3);
dcl-s V4 packed(8:2) inz(*loval);
dcl-s V5 time(*HMS.) inz(*loval);
dcl-s V6 ucs2(6) inz(u'0075');
dcl-s V7 float(8) inz(3E2);
line = 'V0 ' + %char(%size(V0)) + ' ' + %char(%len(V0)) + ' ' + '[' + V0 + ']';
write QSYSPRT line;
line = 'V1 ' + %char(%size(V1)) + ' ' + %char(V1);
write QSYSPRT line;
line = 'V2 ' + %char(%size(V2(3))) + ' ' + %char(%len(V2(3))) + ' ' + %char(V2(3));
write QSYSPRT line;
line = 'V3 ' + %char(%size(V3(3))) + ' ' + %char(%len(V3(3))) + ' ' + %char(V3(3));
write QSYSPRT line;
line = 'V4 ' + %char(%size(V4)) + ' ' + %char(%len(V4)) + ' ' + %char(V4);
write QSYSPRT line;
line = 'V5 ' + %char(%size(V5)) + ' ' + %char(V5);
write QSYSPRT line;
line = 'V6 ' + %char(%size(V6)) + ' ' + %char(%len(V6)) + ' ' + %char(V6);
write QSYSPRT line;
line = 'V7 ' + %char(%size(V7)) + ' ' + %char(V7);
write QSYSPRT line;
*inlr = *on;

**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-ds DS1 inz;
  S01 time(*HMS&);
  S02 pointer;
  S03 time(*EUR);
  S04 bindec(3:0);
  S05 date(*JUL.);
  S06 zoned(5:4);
  S07 char(4);
end-ds;
line = 'size ' + %char(%size(DS1));
write QSYSPRT line;
line = 'S01 ' + %char(%size(S01)) + ' ' + %char(%addr(S01) - %addr(DS1));
write QSYSPRT line;
line = '  ' + %char(S01);
write QSYSPRT line;
line = 'S02 ' + %char(%size(S02)) + ' ' + %char(%addr(S02) - %addr(DS1));
write QSYSPRT line;
line = '  ' + 'ptr';
write QSYSPRT line;
line = 'S03 ' + %char(%size(S03)) + ' ' + %char(%addr(S03) - %addr(DS1));
write QSYSPRT line;
line = '  ' + %char(S03);
write QSYSPRT line;
line = 'S04 ' + %char(%size(S04)) + ' ' + %char(%addr(S04) - %addr(DS1));
write QSYSPRT line;
line = '  ' + %char(S04);
write QSYSPRT line;
line = 'S05 ' + %char(%size(S05)) + ' ' + %char(%addr(S05) - %addr(DS1));
write QSYSPRT line;
line = '  ' + %char(S05);
write QSYSPRT line;
line = 'S06 ' + %char(%size(S06)) + ' ' + %char(%addr(S06) - %addr(DS1));
write QSYSPRT line;
line = '  ' + %char(S06);
write QSYSPRT line;
line = 'S07 ' + %char(%size(S07)) + ' ' + %char(%addr(S07) - %addr(DS1));
write QSYSPRT line;
line = '  ' + '[' + S07 + ']';
write QSYSPRT line;
*inlr = *on;

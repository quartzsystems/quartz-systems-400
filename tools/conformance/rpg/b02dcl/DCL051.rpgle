**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-ds DS1 inz;
  S01 packed(15:4);
  S02 varchar(3);
  S03 time(*JIS);
  S04 uns(10);
end-ds;
line = 'size ' + %char(%size(DS1));
write QSYSPRT line;
line = 'S01 ' + %char(%size(S01)) + ' ' + %char(%addr(S01) - %addr(DS1));
write QSYSPRT line;
line = '  ' + %char(S01);
write QSYSPRT line;
line = 'S02 ' + %char(%size(S02)) + ' ' + %char(%addr(S02) - %addr(DS1));
write QSYSPRT line;
line = '  ' + '[' + S02 + ']';
write QSYSPRT line;
line = 'S03 ' + %char(%size(S03)) + ' ' + %char(%addr(S03) - %addr(DS1));
write QSYSPRT line;
line = '  ' + %char(S03);
write QSYSPRT line;
line = 'S04 ' + %char(%size(S04)) + ' ' + %char(%addr(S04) - %addr(DS1));
write QSYSPRT line;
line = '  ' + %char(S04);
write QSYSPRT line;
*inlr = *on;

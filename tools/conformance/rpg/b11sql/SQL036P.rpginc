**FREE
ctl-opt dftactgrp(*no) actgrp(*new);
dcl-pi *n;
  res char(30);
end-pi;
dcl-s id int(10);
// In an activation group of its own, ended at each return.
exec sql declare c1 cursor for select ID from EMPT order by ID;
exec sql open c1;
res = %char(sqlcode);
exec sql fetch c1 into :id;
res = %trim(res) + ' ' + %char(sqlcode) + ' ' + %char(id);
*inlr = *on;

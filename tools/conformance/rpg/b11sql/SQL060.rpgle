**FREE
//; cmd: CRTSQLRPGI OBJ({lib}/{name}) SRCFILE({lib}/QRPGLESRC) COMMIT(*NONE) OUTPUT(*PRINT)
//; sqlfile: DATYP
//; cleanup: RMVLNK OBJLNK('/tmp/QSSQL060.txt')
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s cl sqltype(clob: 100);
dcl-s bl sqltype(blob: 50);
dcl-s dbc sqltype(dbclob: 20);
dcl-s cloc sqltype(clob_locator);
dcl-s bloc sqltype(blob_locator);
dcl-s cf sqltype(clob_file);
dcl-s bin sqltype(binary: 4);
dcl-s vbin sqltype(varbinary: 8);
dcl-s rid sqltype(rowid);
dcl-s rs sqltype(result_set_locator);
dcl-s n int(10);
dcl-s c varchar(40);
// LOB host variables, locators and file references.
exec sql select CL, BL into :cl, :bl from DALOB where ID = 1;
line = 'lob ' + %char(sqlcode) + ' ' + %char(cl_len) + ' ' + %subst(cl_data: 1: cl_len)
  + ' ' + %char(bl_len);
write QSYSPRT line;
exec sql select hex(:bl) into :c from SYSIBM.SYSDUMMY1;
line = 'hex ' + %char(sqlcode) + ' ' + c;
write QSYSPRT line;
exec sql select DB into :dbc from DALOB where ID = 1;
line = 'dbclob ' + %char(sqlcode) + ' ' + %char(dbc_len);
write QSYSPRT line;
exec sql select CL into :cloc from DALOB where ID = 1;
line = 'locator ' + %char(sqlcode) + ' ' + %char(%int(cloc <> 0));
write QSYSPRT line;
exec sql values length(:cloc) into :n;
line = 'length ' + %char(sqlcode) + ' ' + %char(n);
write QSYSPRT line;
exec sql values substr(:cloc, 6, 4) into :c;
line = 'substr ' + %char(sqlcode) + ' ' + c;
write QSYSPRT line;
exec sql free locator :cloc;
line = 'free ' + %char(sqlcode);
write QSYSPRT line;
exec sql values length(:cloc) into :n;
line = 'freed ' + %char(sqlcode) + ' ' + sqlstate;
write QSYSPRT line;
exec sql select BL into :bloc from DALOB where ID = 1;
exec sql hold locator :bloc;
line = 'hold ' + %char(sqlcode);
write QSYSPRT line;
exec sql values hex(:bloc) into :c;
line = 'held ' + %char(sqlcode) + ' ' + c;
write QSYSPRT line;
cl_data = 'from a host variable';
cl_len = 20;
exec sql insert into DALOB (ID, CL) values (2, :cl);
line = 'insert ' + %char(sqlcode);
write QSYSPRT line;
cf_name = '/tmp/QSSQL060.txt';
cf_nl = %len(%trim(cf_name));
cf_fo = SQFCRT;
exec sql select CL into :cf from DALOB where ID = 2;
line = 'file out ' + %char(sqlcode) + ' ' + %char(cf_dl);
write QSYSPRT line;
cf_fo = SQFRD;
exec sql insert into DALOB (ID, CL) values (3, :cf);
line = 'file in ' + %char(sqlcode);
write QSYSPRT line;
exec sql select length(CL), CL into :n, :c from DALOB where ID = 3;
line = 'read ' + %char(sqlcode) + ' ' + %char(n) + ' ' + c;
write QSYSPRT line;
cf_fo = SQFCRT;
exec sql select CL into :cf from DALOB where ID = 2;
line = 'exists ' + %char(sqlcode) + ' ' + sqlstate;
write QSYSPRT line;
exec sql values (cast(x'0102' as binary(4)), cast(x'0A0B0C' as varbinary(8))) into :bin, :vbin;
line = 'binary ' + %char(sqlcode) + ' ' + %char(%len(vbin));
write QSYSPRT line;
exec sql values hex(:bin) concat ' ' concat hex(:vbin) into :c;
line = 'hexes ' + %char(sqlcode) + ' ' + c;
write QSYSPRT line;
rs = 0;
rid = '';
*inlr = *on;

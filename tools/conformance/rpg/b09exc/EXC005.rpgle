**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-ds pgmsts psds qualified;
  proc *proc;
  status *status;
  prvsts zoned(5:0) pos(16);
  stmt char(8) pos(21);
  routine *routine;
  parms *parms;
  msgtype char(3) pos(40);
  msgnum char(4) pos(43);
  pgmlib char(10) pos(81);
  excid char(7) pos(40);
end-ds;
dcl-s z packed(3:0) inz(0);
dcl-s r packed(5:0);
monitor;
  r = 1 / z;
on-error;
  line = 'st=' + %char(pgmsts.status) + ' ex=' + pgmsts.excid + ' rt=' + pgmsts.routine;
  write QSYSPRT line;
  line = 'pr=' + pgmsts.proc + ' pa=' + %char(pgmsts.parms) + ' sm=' + pgmsts.stmt;
  write QSYSPRT line;
endmon;
line = 'status now ' + %char(%status) + ' ' + %char(pgmsts.status);
write QSYSPRT line;
*inlr = *on;

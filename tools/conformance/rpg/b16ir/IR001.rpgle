**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s v varchar(70000);
dcl-s w varchar(100000);
dcl-s c char(20);
dcl-s i int(10);
v = 'abc';
line = 'a ' + %char(%len(v)) + ' ' + %char(%size(v)) + ' ' + %char(%size(w));
write QSYSPRT line;
v = '';
for i = 1 to 7000;
  v += 'abcdefghij';
endfor;
line = 'b ' + %char(%len(v)) + ' [' + %subst(v:69991:10) + ']';
write QSYSPRT line;
w = v + v;
line = 'c ' + %char(%len(w)) + ' [' + %subst(w:99995:6) + ']';
write QSYSPRT line;
%len(v) = 65540;
line = 'd ' + %char(%len(v)) + ' [' + %subst(v:65531:10) + ']';
write QSYSPRT line;
i = %scan('j':v:65532);
line = 'e ' + %char(i) + ' ' + %char(%scan('xyz':v));
write QSYSPRT line;
v = %replace('XY':v:65001:3);
line = 'f ' + %char(%len(v)) + ' [' + %subst(v:64998:8) + ']';
write QSYSPRT line;
c = %subst(v:65520:20);
line = 'g [' + c + '] ' + %char(%checkr('abcdefghij':v));
write QSYSPRT line;
v = %trimr(%subst(v:1:5) + '   ');
line = 'h ' + %char(%len(v)) + ' [' + v + ']';
write QSYSPRT line;
if v < 'abcdf';
  line = 'i lt';
else;
  line = 'i ge';
endif;
write QSYSPRT line;
*inlr = *on;

**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s bare vargraph(5);
dcl-s wide vargraph(10:4);
dcl-ds src;
  g graph(4) pos(1);
  gc char(8) pos(1);
end-ds;
dcl-ds dst;
  vg vargraph(5) pos(1);
  vgl int(5) pos(1);
  vgc char(10) pos(3);
end-ds;
dcl-ds dst4;
  wg vargraph(6:4) pos(1);
  wgl int(10) pos(1);
  wgc char(12) pos(5);
end-ds;
line = 'a ' + %char(%len(bare)) + ' ' + %char(%size(bare)) + ' ' + %char(%size(wide));
write QSYSPRT line;
gc = 'ABCDEFGH';
vg = g;
line = 'b ' + %char(vgl) + ' ' + %char(%len(vg)) + ' [' + %subst(vgc:1:8) + ']';
write QSYSPRT line;
vg = %subst(g:2:2);
line = 'c ' + %char(vgl) + ' [' + %subst(vgc:1:4) + ']';
write QSYSPRT line;
wg = g;
wg = wg + %subst(g:1:1);
line = 'd ' + %char(wgl) + ' ' + %char(%size(wg)) + ' [' + %subst(wgc:1:10) + ']';
write QSYSPRT line;
bare = vg;
wide = bare + bare;
line = 'e ' + %char(%len(bare)) + ' ' + %char(%len(wide));
write QSYSPRT line;
%len(wg) = 1;
if wg = %subst(g:1:1);
  line = 'f eq ' + %char(wgl);
else;
  line = 'f ne ' + %char(wgl);
endif;
write QSYSPRT line;
*inlr = *on;

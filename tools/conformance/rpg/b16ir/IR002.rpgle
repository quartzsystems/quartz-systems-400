**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-ds d;
  pv varchar(10:4) pos(1);
  plen int(10) pos(1);
  pdata char(10) pos(5);
  uv varucs2(5:4) pos(15);
  ulen int(10) pos(15);
  tail char(3) pos(29);
end-ds;
dcl-s s varchar(10:4);
dcl-s s2 varchar(10:2);
dcl-s u varucs2(6:4);
pv = 'hello';
tail = 'end';
line = 'a ' + %char(%size(d)) + ' ' + %char(plen) + ' [' + pdata + '] ' + %char(%size(pv));
write QSYSPRT line;
uv = %ucs2('ab');
line = 'b ' + %char(ulen) + ' ' + %char(%size(uv)) + ' ' + %char(%len(uv)) + ' ' + tail;
write QSYSPRT line;
s = pv + '!';
s2 = s;
line = 'c ' + %char(%len(s)) + ' ' + %char(%size(s)) + ' [' + s2 + '] ' + %char(%size(s2));
write QSYSPRT line;
%len(pv) = 2;
line = 'd ' + %char(plen) + ' [' + pv + ']';
write QSYSPRT line;
u = uv + %ucs2('xyz');
line = 'e ' + %char(%len(u)) + ' [' + %char(u) + '] ' + %char(%size(u));
write QSYSPRT line;
plen = 3;
line = 'f [' + pv + '] ' + %char(%len(pv));
write QSYSPRT line;
d = *blanks;
pv = 'q';
line = 'g ' + %char(plen) + ' [' + pv + ']';
write QSYSPRT line;
*inlr = *on;

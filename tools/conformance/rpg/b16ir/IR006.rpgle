**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-ds d qualified;
  arr char(10) dim(3);
  code char(3) overlay(arr);
  num zoned(5) overlay(arr:4);
  flag char(1) overlay(arr:*next);
  rest char(1) overlay(arr:*next);
end-ds;
dcl-ds e;
  item char(6) dim(4);
  part char(2) overlay(item:3);
  qty int(5) overlay(item:5);
end-ds;
dcl-s i int(10);
d.arr(1) = 'ABC00012XY';
d.arr(2) = 'DEF00034ZW';
d.arr(3) = 'GHI00056UV';
line = 'a ' + d.code(2) + ' ' + %char(d.num(3)) + ' ' + d.flag(1) + d.rest(1) +
       ' ' + %char(%elem(d.code)) + ' ' + %char(%size(d.code)) + ' ' + %char(%size(d.code:*all));
write QSYSPRT line;
d.code(3) = 'xyz';
d.num(1) = 98765;
d.flag(2) = '#';
line = 'b ' + d.arr(1) + ' ' + d.arr(2) + ' ' + d.arr(3);
write QSYSPRT line;
for i = 1 to %elem(item);
  item(i) = 'it' + %char(i) + '   ';
  qty(i) = i * 100;
endfor;
line = 'c ' + part(1) + part(2) + part(3) + part(4) + ' ' + %char(qty(2) + qty(4));
write QSYSPRT line;
sorta d.code;
line = 'd ' + d.arr(1) + ' ' + d.arr(2) + ' ' + d.arr(3);
write QSYSPRT line;
sorta(d) d.num;
line = 'e ' + d.arr(1) + ' ' + d.arr(2) + ' ' + d.arr(3);
write QSYSPRT line;
i = %lookup('DEF':d.code);
line = 'f ' + %char(i) + ' ' + %char(%lookup(5600:d.num)) + ' ' + %char(%xfoot(d.num));
write QSYSPRT line;
d.code = 'QQQ';
line = 'g ' + d.arr(1) + ' ' + d.arr(2) + ' ' + d.arr(3);
write QSYSPRT line;
*inlr = *on;

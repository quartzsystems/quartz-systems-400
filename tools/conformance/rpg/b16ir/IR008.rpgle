**FREE
//; sqlfile: IRNUL
ctl-opt dftactgrp(*no) alwnull(*usrctl);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-f IRNUL keyed usage(*update:*output) rename(IRNUL:IRNULR);
dcl-s tag char(2);
tag = 'a';
exsr show;
chain (2) IRNUL;
line = 'b ' + %char(%found) + ' ' + %nullind(V) + %nullind(P);
write QSYSPRT line;
%nullind(V) = *off;
V = 'two';
update IRNULR;
chain (1) IRNUL;
%nullind(P) = *on;
update IRNULR;
chain (3) IRNUL;
%nullind(V) = *on;
%nullind(P) = *off;
P = 33;
update IRNULR %fields(V : P);
K = 5;
V = 'five';
P = 50;
%nullind(V) = *on;
%nullind(P) = *off;
write IRNULR;
K = 6;
%nullind(V) = *off;
%nullind(P) = *on;
write IRNULR;
tag = 'c';
exsr show;
*inlr = *on;

begsr show;
  setll *loval IRNUL;
  read IRNUL;
  dow not %eof(IRNUL);
    line = tag + ' ' + %char(K) + ' ' + %nullind(V) + %nullind(P);
    if not %nullind(V);
      line = %trimr(line) + ' [' + V + ']';
    endif;
    if not %nullind(P);
      line = %trimr(line) + ' ' + %char(P);
    endif;
    write QSYSPRT line;
    read IRNUL;
  enddo;
endsr;

**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s a packed(5:0) inz(1);
line = opt(a);
write QSYSPRT line;
line = opt(a : 'two');
write QSYSPRT line;
line = opt(a : 'two' : 3);
write QSYSPRT line;
line = om(*omit);
write QSYSPRT line;
line = om(a);
write QSYSPRT line;
*inlr = *on;
dcl-proc opt;
  dcl-pi *n varchar(40);
    x packed(5:0);
    y char(5) const options(*nopass);
    z int(10) value options(*nopass);
  end-pi;
  dcl-s r varchar(40);
  r = 'parms=' + %char(%parms());
  if %parms() >= 2;
    r += ' y=' + %trim(y);
  endif;
  if %parms() >= 3;
    r += ' z=' + %char(z);
  endif;
  return r;
end-proc;
dcl-proc om;
  dcl-pi *n varchar(20);
    x packed(5:0) options(*omit);
  end-pi;
  if %addr(x) = *null;
    return 'omitted';
  endif;
  return 'given ' + %char(x);
end-proc;

**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-pr op int(10) extproc(fp);
  a int(10) value;
  b int(10) value;
end-pr;
dcl-s fp pointer(*proc);
fp = %paddr(plus);
line = %char(op(3 : 4));
write QSYSPRT line;
fp = %paddr(times);
line = %char(op(3 : 4));
write QSYSPRT line;
*inlr = *on;
dcl-proc plus;
  dcl-pi *n int(10);
    a int(10) value;
    b int(10) value;
  end-pi;
  return a + b;
end-proc;
dcl-proc times;
  dcl-pi *n int(10);
    a int(10) value;
    b int(10) value;
  end-pi;
  return a * b;
end-proc;

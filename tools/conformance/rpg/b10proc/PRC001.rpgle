**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s n packed(7:2) inz(10);
dcl-s c char(10) inz('abc');
dcl-s v varchar(20);
dcl-s f ind;
dcl-s i int(10);
bump(n);
line = 'bump ' + %char(n);
write QSYSPRT line;
v = twice('xy');
line = 'twice ' + v + ' ' + %char(%len(v));
write QSYSPRT line;
i = sum3(1 : 2 : n * 2);
line = 'sum3 ' + %char(i);
write QSYSPRT line;
f = isbig(n + 1000);
line = 'isbig ' + f;
write QSYSPRT line;
c = %trim(c) + 'd';
line = 'val ' + byval(c) + ' ' + c;
write QSYSPRT line;
line = 'fact ' + %char(fact(10));
write QSYSPRT line;
*inlr = *on;
dcl-proc bump;
  dcl-pi *n;
    x packed(7:2);
  end-pi;
  x += 1.5;
end-proc;
dcl-proc twice;
  dcl-pi *n varchar(20);
    s varchar(10) const;
  end-pi;
  return s + s;
end-proc;
dcl-proc sum3;
  dcl-pi *n int(10);
    a int(10) value;
    b int(10) value;
    c packed(9:2) const;
  end-pi;
  return a + b + %int(c);
end-proc;
dcl-proc isbig;
  dcl-pi *n ind;
    x packed(9:2) value;
  end-pi;
  return x > 500;
end-proc;
dcl-proc byval;
  dcl-pi *n char(10);
    s char(10) value;
  end-pi;
  s = 'changed';
  return s;
end-proc;
dcl-proc fact;
  dcl-pi *n packed(15:0);
    k int(10) value;
  end-pi;
  if k <= 1;
    return 1;
  endif;
  return k * fact(k - 1);
end-proc;

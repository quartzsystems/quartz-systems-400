**FREE
//; run: no
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s c1 char(10);
dcl-s c2 varchar(20);
dcl-s c3 varchar(10:4);
dcl-s u1 ucs2(5);
dcl-s u2 varucs2(6);
dcl-s g1 graph(4);
dcl-s p1 packed(7:2);
dcl-s z1 zoned(9:3);
dcl-s b1 bindec(4:1);
dcl-s i1 int(3);
dcl-s i2 int(5);
dcl-s i3 int(10);
dcl-s i4 int(20);
dcl-s n1 uns(10);
dcl-s f1 float(4);
dcl-s f2 float(8);
dcl-s d1 date;
dcl-s d2 date(*mdy);
dcl-s d3 date(*jul-);
dcl-s t1 time;
dcl-s t2 time(*hms.);
dcl-s s1 timestamp;
dcl-s s2 timestamp(3);
dcl-s ptr pointer;
dcl-s pp pointer(*proc);
dcl-s ok ind;
dcl-c k1 'text';
dcl-c k2 42;
line = c1 + c2 + c3 + %char(u1) + %char(u2) + %char(p1) + %char(z1) + %char(b1);
write QSYSPRT line;
line = %char(i1) + %char(i2) + %char(i3) + %char(i4) + %char(n1) + %char(f1) + %char(f2);
write QSYSPRT line;
line = %char(d1) + %char(d2) + %char(d3) + %char(t1) + %char(t2) + %char(s1) + %char(s2);
write QSYSPRT line;
ptr = %addr(c1);
ok = (ptr <> *null) and (pp = *null);
line = ok + k1 + %char(k2);
write QSYSPRT line;
*inlr = *on;

       // The SQL CLI as RPG prototypes, the kit's own declarations: every
       // pointer argument is passed as a pointer by value.
       dcl-c SQL_SUCCESS 0;
       dcl-c SQL_ERROR -1;
       dcl-c SQL_NO_DATA 100;
       dcl-c SQL_NTS -3;
       dcl-c SQL_NULL_DATA -1;
       dcl-c SQL_HANDLE_ENV 1;
       dcl-c SQL_HANDLE_DBC 2;
       dcl-c SQL_HANDLE_STMT 3;
       dcl-c SQL_CLOSE 0;
       dcl-c SQL_DROP 1;
       dcl-c SQL_UNBIND 2;
       dcl-c SQL_RESET_PARAMS 3;
       dcl-c SQL_COMMIT 0;
       dcl-c SQL_ROLLBACK 1;
       dcl-c SQL_CHAR 1;
       dcl-c SQL_NUMERIC 2;
       dcl-c SQL_DECIMAL 3;
       dcl-c SQL_INTEGER 4;
       dcl-c SQL_SMALLINT 5;
       dcl-c SQL_DOUBLE 8;
       dcl-c SQL_VARCHAR 12;
       dcl-c SQL_BIGINT 19;
       dcl-c SQL_DATE 91;
       dcl-c SQL_TIME 92;
       dcl-c SQL_TIMESTAMP 93;
       dcl-c SQL_ATTR_SERVER_MODE 10004;
       dcl-c SQL_ATTR_OUTPUT_NTS 10001;
       dcl-c SQL_ATTR_AUTOCOMMIT 10003;
       dcl-c SQL_ATTR_DBC_SYS_NAMING 10004;
       dcl-c SQL_ATTR_DBC_DEFAULT_LIB 10005;
       dcl-c SQL_ATTR_COMMIT 0;
       dcl-c SQL_ATTR_CURSOR_SCROLLABLE 10015;
       dcl-c SQL_ATTR_CURSOR_HOLD 10017;
       dcl-c SQL_ATTR_FOR_FETCH_ONLY 10014;
       dcl-c SQL_FETCH_NEXT 1;
       dcl-c SQL_FETCH_FIRST 2;
       dcl-c SQL_FETCH_LAST 3;
       dcl-c SQL_FETCH_PRIOR 4;
       dcl-c SQL_FETCH_ABSOLUTE 5;
       dcl-c SQL_FETCH_RELATIVE 6;
       dcl-c SQL_PARAM_INPUT 1;
       dcl-c SQL_DIAG_SQLSTATE 4;
       dcl-c SQL_DIAG_NATIVE 5;
       dcl-c SQL_DIAG_NUMBER 2;
       dcl-c SQL_DIAG_ROW_COUNT 3;

       dcl-pr SQLAllocEnv int(10) extproc('SQLAllocEnv');
         phenv pointer value;
       end-pr;
       dcl-pr SQLAllocConnect int(10) extproc('SQLAllocConnect');
         henv int(10) value;
         phdbc pointer value;
       end-pr;
       dcl-pr SQLAllocStmt int(10) extproc('SQLAllocStmt');
         hdbc int(10) value;
         phstmt pointer value;
       end-pr;
       dcl-pr SQLAllocHandle int(10) extproc('SQLAllocHandle');
         htype int(5) value;
         ihnd int(10) value;
         ohnd pointer value;
       end-pr;
       dcl-pr SQLSetEnvAttr int(10) extproc('SQLSetEnvAttr');
         henv int(10) value;
         attr int(10) value;
         val pointer value;
         len int(10) value;
       end-pr;
       dcl-pr SQLGetEnvAttr int(10) extproc('SQLGetEnvAttr');
         henv int(10) value;
         attr int(10) value;
         val pointer value;
         max int(10) value;
         olen pointer value;
       end-pr;
       dcl-pr SQLSetConnectAttr int(10) extproc('SQLSetConnectAttr');
         hdbc int(10) value;

**FREE
//; with: DTAP
//; setup: CRTBNDRPG PGM({lib}/DTAP) SRCFILE({lib}/QRPGLESRC) SRCMBR(DTAP) DBGVIEW(*NONE)
//; cleanup: DLTPGM PGM({lib}/DTAP)
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-ds cust qualified;
  id packed(5);
  name varchar(20);
  city char(10);
  vip ind;
  n int(10);
end-ds;
dcl-ds item qualified template;
  sku char(4);
  qty int(10);
end-ds;
dcl-ds ord qualified;
  num zoned(4);
  num_items int(10);
  items likeds(item) dim(5);
  tags char(3) dim(4);
end-ds;
dcl-ds sds psds;
  cnt int(20) pos(372);
end-ds;
dcl-s doc varchar(1000);
dcl-s i int(10);
doc = '( id: =12 name: =Ann_Lee city: =Oslo vip: =1 n: =-7 )';
data-into cust %data(doc) %parser('DTAP');
line = 'a ' + %char(cust.id) + ' [' + cust.name + '] [' + cust.city + '] ' + cust.vip
  + ' ' + %char(cust.n);
write QSYSPRT line;
line = 'a count ' + %char(cnt);
write QSYSPRT line;
doc = '( ID: =13 Name: =Bo CITY: =Rio VIP: =0 N: =5 )';
data-into cust %data(doc : 'case=any') %parser('DTAP');
line = 'b ' + %char(cust.id) + ' ' + cust.name + ' ' + cust.city + ' ' + cust.vip + ' '
  + %char(cust.n);
write QSYSPRT line;
doc = '( num: =42 items: < ( sku: =A1 qty: =3 ) ( sku: =B2 qty: =4 ) > tags: < =x =y =z > )';
data-into ord %data(doc : 'case=any countprefix=num_ allowmissing=yes') %parser('DTAP');
line = 'c ' + %char(ord.num) + ' ' + %char(ord.num_items);
for i = 1 to 3;
  line = %trimr(line) + ' ' + ord.items(i).sku + '/' + %char(ord.items(i).qty) + ' ' + ord.tags(i);
endfor;
write QSYSPRT line;
line = 'c count ' + %char(cnt);
write QSYSPRT line;
doc = '( id: =14 name: =Cy extra: =1 city: =Bern vip: =0 n: =1 )';
data-into cust %data(doc : 'allowextra=yes') %parser('DTAP');
line = 'd ' + %char(cust.id) + ' ' + cust.name + ' ' + cust.city;
write QSYSPRT line;
doc = '( id: =15 name: =Di )';
data-into cust %data(doc : 'allowmissing=yes') %parser('DTAP');
line = 'e ' + %char(cust.id) + ' ' + cust.name + ' ' + cust.city + ' ' + %char(cust.n);
write QSYSPRT line;
doc = '( top: ( inner: ( id: =16 name: =Ed city: =Graz vip: =1 n: =2 ) ) )';
monitor;
  data-into cust %data(doc : 'path=top/inner') %parser('DTAP');
  line = 'f ' + %char(cust.id) + ' ' + cust.name + ' ' + cust.city;
on-error;
  line = 'f ' + %char(%status);
endmon;
write QSYSPRT line;
monitor;
  data-into cust %data(doc : 'path=x/top/inner') %parser('DTAP');
  line = 'f2 ' + %char(cust.id) + ' ' + cust.name + ' ' + cust.city;
on-error;
  line = 'f2 ' + %char(%status);
endmon;
write QSYSPRT line;
doc = '( id: =__17__ name: =__Fay__Ng__ city: =Ulm vip: =0 n: =3 )';
monitor;
  data-into cust %data(doc : 'trim=none') %parser('DTAP');
  line = 'g ' + %char(cust.id) + ' [' + cust.name + '] ' + cust.city;
on-error;
  line = 'g ' + %char(%status);
endmon;
write QSYSPRT line;
doc = '( id: =__18__ name: =__Gil___Ng__ city: =Ulm vip: =0 n: =3 )';
monitor;
  data-into cust %data(doc) %parser('DTAP');
  line = 'h ' + %char(cust.id) + ' [' + cust.name + '] ' + cust.city;
on-error;
  line = 'h ' + %char(%status);
endmon;
write QSYSPRT line;
*inlr = *on;

**FREE
//; with: DTAP
//; setup: CRTBNDRPG PGM({lib}/DTAP) SRCFILE({lib}/QRPGLESRC) SRCMBR(DTAP) DBGVIEW(*NONE)
//; cleanup: DLTPGM PGM({lib}/DTAP)
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-ds cust qualified;
  id packed(5);
  name varchar(20);
end-ds;
dcl-s doc varchar(1000);
dcl-s flag char(1);
dcl-s num packed(5);
dcl-s arr int(10) dim(2);
doc = '( id: =1 )';
try('missing' : doc : '');
doc = '( id: =1 name: =A extra: =2 )';
try('extra' : doc : '');
doc = '( id: =x name: =A )';
try('badnum' : doc : '');
doc = '( id: =1 name: =A )';
try('badopt' : doc : 'bogus=yes');
try('badopt2' : doc : 'case=sideways');
doc = '( id: =1 /17 name: =A )';
try('error' : doc : '');
flag = ' ';
monitor;
  data-into cust %data(doc) %parser('DTAP' : flag);
on-error;
  line = 'flag [' + flag + '] ' + %char(%status);
endmon;
write QSYSPRT line;
monitor;
  data-into cust %data(doc) %parser('NOSUCHPGM');
on-error;
  line = 'nopgm ' + %char(%status);
endmon;
write QSYSPRT line;
doc = '=?u';
monitor;
  data-into num %data(doc) %parser('DTAP' : '123');
  line = 'uparm ' + %char(num);
on-error;
  line = 'uparm ' + %char(%status);
endmon;
write QSYSPRT line;
doc = '=?n';
monitor;
  data-into num %data(doc) %parser('DTAP' : '1');
  line = 'isstr ' + %char(num);
on-error;
  line = 'isstr ' + %char(%status);
endmon;
write QSYSPRT line;
doc = '< =1 =2 =3 >';
monitor;
  data-into arr %data(doc) %parser('DTAP');
  line = 'arr ' + %char(arr(1)) + ' ' + %char(arr(2));
on-error;
  line = 'arr ' + %char(%status);
endmon;
write QSYSPRT line;
doc = '< =4 =5 >';
monitor;
  data-into arr %data(doc) %parser('DTAP');
  line = 'arr2 ' + %char(arr(1)) + ' ' + %char(arr(2));
on-error;
  line = 'arr2 ' + %char(%status);
endmon;
write QSYSPRT line;
doc = '( id: =9 name: =Q )';
monitor;
  data-into num %data(doc) %parser('DTAP');
  line = 'shape ' + %char(num);
on-error;
  line = 'shape ' + %char(%status);
endmon;
write QSYSPRT line;
*inlr = *on;

dcl-proc try;
  dcl-pi *n;
    what varchar(10) const;
    d varchar(1000) const;
    opts varchar(100) const;
  end-pi;
  monitor;
    data-into cust %data(d : opts) %parser('DTAP');
    line = what + ' ok ' + %char(cust.id) + ' ' + cust.name;
  on-error;
    line = what + ' ' + %char(%status);
  endmon;
  write QSYSPRT line;
end-proc;

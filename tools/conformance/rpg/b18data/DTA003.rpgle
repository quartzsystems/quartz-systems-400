**FREE
//; with: DTAP
//; setup: CRTBNDRPG PGM({lib}/DTAP) SRCFILE({lib}/QRPGLESRC) SRCMBR(DTAP) DBGVIEW(*NONE)
//; cleanup: DLTPGM PGM({lib}/DTAP)
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-ds item qualified template;
  sku char(4);
  qty int(10);
end-ds;
dcl-ds cust qualified;
  id packed(5);
  name varchar(20);
end-ds;
dcl-pr hdl int(10);
  total int(10);
  items likeds(item) dim(2) const;
  n uns(10) value;
end-pr;
dcl-s doc varchar(1000);
dcl-s total int(10);
dcl-s nm varchar(20);
doc = '< ( sku: =A1 qty: =1 ) ( sku: =B2 qty: =2 ) ( sku: =C3 qty: =3 ) >';
data-into %handler(hdl : total) %data(doc) %parser('DTAP');
line = 'total ' + %char(total);
write QSYSPRT line;
doc = '( %id=5 name: =X )';
monitor;
  data-into cust %data(doc) %parser('DTAP');
  line = 'attr ' + %char(cust.id) + ' ' + cust.name;
on-error;
  line = 'attr ' + %char(%status);
endmon;
write QSYSPRT line;
doc = '*hello =Plain';
monitor;
  data-into nm %data(doc) %parser('DTAP');
  line = 'scalar ' + nm;
on-error;
  line = 'scalar ' + %char(%status);
endmon;
write QSYSPRT line;
doc = 'nm: =Named';
monitor;
  data-into nm %data(doc) %parser('DTAP');
  line = 'named ' + nm;
on-error;
  line = 'named ' + %char(%status);
endmon;
write QSYSPRT line;
doc = '( cust: ( id: =7 name: =In ) )';
monitor;
  data-into cust %data(doc) %parser('DTAP');
  line = 'nested ' + %char(cust.id) + ' ' + cust.name;
on-error;
  line = 'nested ' + %char(%status);
endmon;
write QSYSPRT line;
doc = 'cust: ( id: =8 name: =Nm )';
monitor;
  data-into cust %data(doc) %parser('DTAP');
  line = 'rootname ' + %char(cust.id) + ' ' + cust.name;
on-error;
  line = 'rootname ' + %char(%status);
endmon;
write QSYSPRT line;
doc = 'other: ( id: =9 name: =On )';
monitor;
  data-into cust %data(doc) %parser('DTAP');
  line = 'othername ' + %char(cust.id) + ' ' + cust.name;
on-error;
  line = 'othername ' + %char(%status);
endmon;
write QSYSPRT line;
*inlr = *on;

dcl-proc hdl;
  dcl-pi *n int(10);
    total int(10);
    items likeds(item) dim(2) const;
    n uns(10) value;
  end-pi;
  dcl-s i int(10);
  line = 'call ' + %char(n);
  for i = 1 to n;
    total += items(i).qty;
    line = %trimr(line) + ' ' + items(i).sku;
  endfor;
  write QSYSPRT line;
  return 0;
end-proc;

**FREE
//; with: DTGG
//; setup: CRTBNDRPG PGM({lib}/DTGG) SRCFILE({lib}/QRPGLESRC) SRCMBR(DTGG) DBGVIEW(*NONE)
//; cleanup: DLTPGM PGM({lib}/DTGG)
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-ds item qualified template;
  sku char(4);
  qty int(10);
end-ds;
dcl-ds ord qualified;
  num zoned(4:1) inz(4.5);
  name varchar(10) inz('Bob');
  ok ind inz(*on);
  dt date inz(d'2026-03-04');
  items likeds(item) dim(2);
  tags char(2) dim(3) inz('t');
  f float(8) inz(1.25);
  i int(5) inz(-3);
end-ds;
dcl-s out varchar(8000);
dcl-s s varchar(20) inz('just me');
dcl-s flag char(1);
dcl-s bad varchar(20) inz('bogus=1');
ord.items(1).sku = 'A1';
ord.items(1).qty = 3;
ord.items(2).sku = 'B2';
ord.items(2).qty = 4;
data-gen ord %data(out) %gen('DTGG');
show('ord');
data-gen s %data(out) %gen('DTGG' : 'parm text');
show('scalar');
flag = 'T';
data-gen ord.items %data(out : 'name=things') %gen('DTGG' : flag);
show('array');
flag = 'E';
monitor;
  data-gen s %data(out) %gen('DTGG' : flag);
  line = 'no error';
on-error;
  line = 'error ' + %char(%status);
endmon;
write QSYSPRT line;
monitor;
  data-gen s %data(out : bad) %gen('DTGG');
  line = 'no error';
on-error;
  line = 'badopt ' + %char(%status);
endmon;
write QSYSPRT line;
monitor;
  data-gen s %data(out) %gen('NOSUCHGEN');
  line = 'no error';
on-error;
  line = 'nogen ' + %char(%status);
endmon;
write QSYSPRT line;
*inlr = *on;

dcl-proc show;
  dcl-pi *n;
    what varchar(10) const;
  end-pi;
  dcl-s at int(10);
  dcl-s from int(10) inz(1);
  line = what + ' ' + %char(%len(out));
  write QSYSPRT line;
  at = %scan(x'25' : out);
  dow at > 0;
    line = ' ' + %subst(out : from : at - from);
    write QSYSPRT line;
    from = at + 1;
    if from > %len(out);
      leave;
    endif;
    at = %scan(x'25' : out : from);
  enddo;
  if from <= %len(out);
    line = ' rest ' + %subst(out : from);
    write QSYSPRT line;
  endif;
end-proc;

**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s d date inz(d'2026-03-05');
dcl-s e date(*mdy) inz(d'2026-03-05');
dcl-s t time inz(t'14.30.05');
dcl-s z timestamp;
dcl-s c char(10) inz('2026-02-30');
dcl-s n packed(8:0) inz(20261301);
dcl-s x char(10) inz('xx');
monitor;
  d = %date(c:*iso);
  line = 'bad day ok';
write QSYSPRT line;
on-error 112;
  line = 'bad day 112';
write QSYSPRT line;
on-error 113;
  line = 'bad day 113';
write QSYSPRT line;
on-error 114;
  line = 'bad day 114';
write QSYSPRT line;
on-error;
  line = 'bad day other';
write QSYSPRT line;
endmon;
line = %char(d);
write QSYSPRT line;
monitor;
  d = %date(x:*iso);
  line = 'bad text ok';
write QSYSPRT line;
on-error 112;
  line = 'bad text 112';
write QSYSPRT line;
on-error 113;
  line = 'bad text 113';
write QSYSPRT line;
on-error 114;
  line = 'bad text 114';
write QSYSPRT line;
on-error;
  line = 'bad text other';
write QSYSPRT line;
endmon;
monitor;
  d = %date(n:*iso);
  line = 'bad num ok';
write QSYSPRT line;
on-error 112;
  line = 'bad num 112';
write QSYSPRT line;
on-error 113;
  line = 'bad num 113';
write QSYSPRT line;
on-error 114;
  line = 'bad num 114';
write QSYSPRT line;
on-error;
  line = 'bad num other';
write QSYSPRT line;
endmon;
monitor;
  e = d'2050-01-01';
  line = 'mdy range ok';
write QSYSPRT line;
on-error 112;
  line = 'mdy range 112';
write QSYSPRT line;
on-error 113;
  line = 'mdy range 113';
write QSYSPRT line;
on-error 114;
  line = 'mdy range 114';
write QSYSPRT line;
on-error;
  line = 'mdy range other';
write QSYSPRT line;
endmon;
line = %char(e);
write QSYSPRT line;
monitor;
  e = e + %years(30);
  line = 'mdy add ok';
write QSYSPRT line;
on-error 112;
  line = 'mdy add 112';
write QSYSPRT line;
on-error 113;
  line = 'mdy add 113';
write QSYSPRT line;
on-error 114;
  line = 'mdy add 114';
write QSYSPRT line;
on-error;
  line = 'mdy add other';
write QSYSPRT line;
endmon;
line = %char(e);
write QSYSPRT line;
monitor;
  d = d'9999-12-31' + %days(1);
  line = 'top ok';
write QSYSPRT line;
on-error 112;
  line = 'top 112';
write QSYSPRT line;
on-error 113;
  line = 'top 113';
write QSYSPRT line;
on-error 114;
  line = 'top 114';
write QSYSPRT line;
on-error;
  line = 'top other';
write QSYSPRT line;
endmon;
line = %char(d);
write QSYSPRT line;
monitor;
  d = d'0001-01-01' - %days(1);
  line = 'bottom ok';
write QSYSPRT line;
on-error 112;
  line = 'bottom 112';
write QSYSPRT line;
on-error 113;
  line = 'bottom 113';
write QSYSPRT line;
on-error 114;
  line = 'bottom 114';
write QSYSPRT line;
on-error;
  line = 'bottom other';
write QSYSPRT line;
endmon;
monitor;
  t = %time('25.00.00':*iso);
  line = 'bad time ok';
write QSYSPRT line;
on-error 112;
  line = 'bad time 112';
write QSYSPRT line;
on-error 113;
  line = 'bad time 113';
write QSYSPRT line;
on-error 114;
  line = 'bad time 114';
write QSYSPRT line;
on-error;
  line = 'bad time other';
write QSYSPRT line;
endmon;
line = %char(t);
write QSYSPRT line;
monitor;
  z = %timestamp('2026-03-05-24.00.00.000000');
  line = 'bad stamp ok';
write QSYSPRT line;
on-error 112;
  line = 'bad stamp 112';
write QSYSPRT line;
on-error 113;
  line = 'bad stamp 113';
write QSYSPRT line;
on-error 114;
  line = 'bad stamp 114';
write QSYSPRT line;
on-error;
  line = 'bad stamp other';
write QSYSPRT line;
endmon;
monitor;
  d = %date('2026/03/05':*iso);
  line = 'bad sep ok';
write QSYSPRT line;
on-error 112;
  line = 'bad sep 112';
write QSYSPRT line;
on-error 113;
  line = 'bad sep 113';
write QSYSPRT line;
on-error 114;
  line = 'bad sep 114';
write QSYSPRT line;
on-error;

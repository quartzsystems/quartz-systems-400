**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s c char(5) dim(5);
dcl-s n packed(5:1) dim(5);
dcl-s d int(10) dim(4) descend;
dcl-ds e qualified dim(3);
  name char(5);
  amt packed(5:0);
end-ds;
c(1) = 'pear';
c(2) = 'fig';
c(3) = 'apple';
c(4) = 'kiwi';
c(5) = 'date';
sorta c;
line = 'a ' + c(1) + c(2) + c(3) + c(4) + c(5);
write QSYSPRT line;
sorta(d) c;
line = 'b ' + c(1) + c(2) + c(3) + c(4) + c(5);
write QSYSPRT line;
n(1) = 3.5;
n(2) = -1;
n(3) = 10;
n(4) = 0;
n(5) = 2.2;
sorta %subarr(n:2:3);
line = 'c ' + %char(n(1)) + ' ' + %char(n(2)) + ' ' + %char(n(3));
write QSYSPRT line;
line = 'c2 ' + %char(n(4)) + ' ' + %char(n(5));
write QSYSPRT line;
sorta n;
line = 'd ' + %char(n(1)) + ' ' + %char(n(2)) + ' ' + %char(n(3));
write QSYSPRT line;
line = 'd2 ' + %char(n(4)) + ' ' + %char(n(5));
write QSYSPRT line;
d(1) = 5;
d(2) = 50;
d(3) = -5;
d(4) = 7;
sorta d;
line = 'e ' + %char(d(1)) + ' ' + %char(d(2)) + ' ' + %char(d(3)) + ' ' + %char(d(4));
write QSYSPRT line;
e(1).name = 'bob';
e(1).amt = 30;
e(2).name = 'al';
e(2).amt = 10;
e(3).name = 'cy';
e(3).amt = 20;
sorta e(*).amt;
line = 'f ' + e(1).name + e(2).name + e(3).name;
write QSYSPRT line;
sorta(d) e(*).name;
line = 'g ' + e(1).name + e(2).name + e(3).name;
write QSYSPRT line;
sorta(a) %subarr(c:1:2);
line = 'h ' + c(1) + c(2) + c(3) + c(4) + c(5);
write QSYSPRT line;
*inlr = *on;

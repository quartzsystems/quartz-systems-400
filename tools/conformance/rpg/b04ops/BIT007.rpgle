**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s c char(3) inz('b');
dcl-s n packed(5:0) inz(5);
dcl-s v varchar(5) inz('xy');
if c in %list('a':'b':'c');
line = 'a yes';
write QSYSPRT line;
endif;
if not (c in %list('x':'y'));
line = 'b no';
write QSYSPRT line;
endif;
if n in %range(1:9);
line = 'c in range';
write QSYSPRT line;
endif;
if n in %range(6:9);
line = 'd wrong';
write QSYSPRT line;
else;
line = 'd out';
write QSYSPRT line;
endif;
if v in %range('aa':'zz');
line = 'e chars';
write QSYSPRT line;
endif;
if n + 1 in %list(4:6:8);
line = 'f expr';
write QSYSPRT line;
endif;
if 'b  ' in %list(c:'q');
line = 'g padded';
write QSYSPRT line;
endif;
*inlr = *on;

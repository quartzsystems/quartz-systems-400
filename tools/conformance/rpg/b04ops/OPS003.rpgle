**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s n int(10);
dcl-s t int(10);
n = 4;
exsr fact;
line = 'fact ' + %char(t);
write QSYSPRT line;
n = 1;
exsr fact;
line = 'fact ' + %char(t);
write QSYSPRT line;
exsr early;
*inlr = *on;
return;
begsr fact;
  t = 1;
  dow n > 1;
    t *= n;
    n -= 1;
  enddo;
endsr;
begsr early;
  line = 'early';
write QSYSPRT line;
  leavesr;
  line = 'never';
write QSYSPRT line;
endsr;
*inlr = *on;

**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s au char(3) dim(*auto:10);
dcl-s vr packed(3:0) dim(*var:5);
dcl-s i int(10);
line = 'a ' + %char(%elem(au)) + ' ' + %char(%elem(au:*max)) + ' ' + %char(%elem(vr));
write QSYSPRT line;
au(1) = 'one';
au(4) = 'fou';
line = 'b ' + %char(%elem(au)) + ' [' + au(2) + '] ' + au(4);
write QSYSPRT line;
%elem(au) = 2;
line = 'c ' + %char(%elem(au));
write QSYSPRT line;
au(*next) = 'nxt';
line = 'd ' + %char(%elem(au)) + ' ' + au(3);
write QSYSPRT line;
%elem(vr) = 3;
vr = 4;
line = 'e ' + %char(%elem(vr)) + ' ' + %char(vr(1)) + ' ' + %char(vr(3)) + ' ' +
      %char(%xfoot(vr));
write QSYSPRT line;
vr(2) = 1;
sorta vr;
line = 'f ' + %char(vr(1)) + ' ' + %char(vr(2)) + ' ' + %char(vr(3));
write QSYSPRT line;
%elem(vr) = 5;
line = 'g ' + %char(vr(4)) + ' ' + %char(vr(5)) + ' ' + %char(%lookup(1:vr));
write QSYSPRT line;
%elem(vr) = 1;
%elem(vr) = 2;
line = 'h ' + %char(vr(1)) + ' ' + %char(vr(2));
write QSYSPRT line;
for i = 1 to %elem(au);
line = 'i ' + %char(i) + ' [' + au(i) + ']';
write QSYSPRT line;
endfor;
*inlr = *on;

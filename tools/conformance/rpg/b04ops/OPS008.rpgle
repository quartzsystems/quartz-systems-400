**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s x packed(5:0);
monitor;
  x = 1 / 0;
  line = 'not reached';
write QSYSPRT line;
on-error 102;
  line = 'divide by zero';
write QSYSPRT line;
endmon;
monitor;
  x = 99999 + 1;
on-error *program;
  line = 'program error';
write QSYSPRT line;
endmon;
monitor;
  x = 2;
  line = 'no error';
write QSYSPRT line;
on-error;
  line = 'never';
write QSYSPRT line;
endmon;
line = 'x=' + %char(x);
write QSYSPRT line;
*inlr = *on;

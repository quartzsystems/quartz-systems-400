**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s d1 date;
dcl-s d2 date(*mdy);
dcl-s d3 date(*jul);
dcl-s t1 time;
dcl-s t2 time(*usa);
dcl-s z1 timestamp;
dcl-s z12 timestamp(12);
d1 = *hival;
d2 = *hival;
d3 = *hival;
t1 = *hival;
t2 = *hival;
z1 = *hival;
z12 = *hival;
line = %char(d1) + '|' + %char(d2) + '|' + %char(d3) + '|' + %char(t1) + '|' + %char(t2);
write QSYSPRT line;
line = %char(z1) + '|' + %char(z12);
write QSYSPRT line;
d1 = *loval;
d2 = *loval;
d3 = *loval;
t1 = *loval;
t2 = *loval;
z1 = *loval;
line = %char(d1) + '|' + %char(d2) + '|' + %char(d3) + '|' + %char(t1) + '|' + %char(t2);
write QSYSPRT line;
line = %char(z1);
write QSYSPRT line;
if d2 = *loval and d1 < d'1000-01-01';
  line = 'loval compares';
write QSYSPRT line;
endif;
if d1 <> *hival;
  line = 'not hival';
write QSYSPRT line;
endif;
*inlr = *on;

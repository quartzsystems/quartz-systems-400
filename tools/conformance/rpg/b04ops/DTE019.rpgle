**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s d date inz(d'2026-03-05');
dcl-s e date inz(*loval);
dcl-s t time;
e = shift(d:10);
line = %char(e) + ' ' + %char(shift(d'2026-12-25':7));
write QSYSPRT line;
t = later(t'10.00.00');
line = %char(t) + ' ' + %char(span(d:e));
write QSYSPRT line;
*inlr = *on;
dcl-proc shift;
  dcl-pi *n date;
    from date(*mdy) const;
    n int(10) value;
  end-pi;
  return from + %days(n);
end-proc;
dcl-proc later;
  dcl-pi *n time(*usa);
    t time value;
  end-pi;
  return t + %minutes(75);
end-proc;
dcl-proc span;
  dcl-pi *n int(10);
    a date const;
    b date(*jul) const;
  end-pi;
  return %diff(b:a:*days);
end-proc;

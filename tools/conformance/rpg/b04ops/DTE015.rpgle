**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s d date inz(d'2026-03-05');
dcl-s e date(*mdy);
dcl-s f date(*jul);
dcl-s g date(*eur);
dcl-s t time inz(t'14.30.05');
dcl-s u time(*usa);
dcl-s h time(*hms);
dcl-s z timestamp inz(z'2026-03-05-14.30.05.123456');
dcl-s z0 timestamp(0);
dcl-s z12 timestamp(12);
dcl-s z3 timestamp(3);
dcl-s c char(12);
e = d;
f = e;
g = f;
d = d'1999-01-01';
d = g;
line = %char(e) + ' ' + %char(f) + ' ' + %char(g) + ' ' + %char(d);
write QSYSPRT line;
u = t;
h = u;
line = %char(u) + ' ' + %char(h);
write QSYSPRT line;
z0 = z;
z12 = z;
z3 = z;
line = %char(z0) + ' ' + %char(z3);
write QSYSPRT line;
line = %char(z12);
write QSYSPRT line;
z = z0;
line = %char(z);
write QSYSPRT line;
c = %char(e);
line = '[' + c + ']';
write QSYSPRT line;
d = %date(z12);
t = %time(z12);
line = %char(d) + ' ' + %char(t);
write QSYSPRT line;
*inlr = *on;

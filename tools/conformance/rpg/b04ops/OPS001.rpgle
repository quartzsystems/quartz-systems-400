**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s i int(10);
dcl-s n int(10);
for i = 1 to 10 by 3;
  line = 'for ' + %char(i);
write QSYSPRT line;
endfor;
for i = 10 downto 1 by 4;
  line = 'down ' + %char(i);
write QSYSPRT line;
endfor;
n = 0;
dow n < 3;
  n += 1;
  if n = 2;
    iter;
  endif;
  line = 'dow ' + %char(n);
write QSYSPRT line;
enddo;
dou n >= 6;
  n += 1;
  if n = 5;
    leave;
  endif;
enddo;
line = 'after ' + %char(n);
write QSYSPRT line;
*inlr = *on;

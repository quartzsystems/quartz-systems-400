**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s d1 date;
dcl-s d2 date(*mdy);
dcl-s d3 date(*jul);
dcl-s d4 date(*usa);
dcl-s t1 time;
dcl-s t2 time(*usa);
dcl-s t3 time(*hms);
dcl-s z1 timestamp;
dcl-s z0 timestamp(0);
dcl-s z3 timestamp(3);
dcl-s z12 timestamp(12);
line = %char(d1) + '|' + %char(d2) + '|' + %char(d3) + '|' + %char(d4);
write QSYSPRT line;
line = %char(t1) + '|' + %char(t2) + '|' + %char(t3);
write QSYSPRT line;
line = %char(z1) + '|' + %char(z0) + '|' + %char(z3);
write QSYSPRT line;
line = %char(z12);
write QSYSPRT line;
clear d2;
clear t2;
clear z0;
line = %char(d2) + '|' + %char(t2) + '|' + %char(z0);
write QSYSPRT line;
*inlr = *on;

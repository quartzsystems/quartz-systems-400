**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s a packed(5:0) dim(6);
dcl-s b packed(5:0) dim(4);
dcl-s c char(4) dim(3);
dcl-s i int(10);
a = 7;
line = 'a ' + %char(a(1)) + ' ' + %char(a(6)) + ' ' + %char(%xfoot(a));
write QSYSPRT line;
for i = 1 to 6;
  a(i) = i * 10;
endfor;
b = %subarr(a:3);
line = 'b ' + %char(b(1)) + ' ' + %char(b(2)) + ' ' + %char(b(3)) + ' ' + %char(b(4));
write QSYSPRT line;
%subarr(a:2:2) = 0;
line = 'c ' + %char(a(1)) + ' ' + %char(a(2)) + ' ' + %char(a(3)) + ' ' + %char(a(4));
write QSYSPRT line;
%subarr(a:4) = b;
line = 'd ' + %char(a(4)) + ' ' + %char(a(5)) + ' ' + %char(a(6));
write QSYSPRT line;
line = 'e ' + %char(%xfoot(%subarr(a:4:2)));
write QSYSPRT line;
a(2) = 99;
a(5) = -3;
line = 'f ' + %char(%maxarr(a)) + ' ' + %char(%minarr(a));
write QSYSPRT line;
line = 'g ' + %char(%maxarr(a:3)) + ' ' + %char(%minarr(a:1:4));
write QSYSPRT line;
c = 'xy';
c(2) = 'zz';
line = 'h ' + c(1) + c(2) + c(3) + ' ' + %char(%maxarr(c)) + ' ' + %char(%minarr(c));
write QSYSPRT line;
b = a;
line = 'i ' + %char(b(1)) + ' ' + %char(b(2)) + ' ' + %char(b(4));
write QSYSPRT line;
*inlr = *on;

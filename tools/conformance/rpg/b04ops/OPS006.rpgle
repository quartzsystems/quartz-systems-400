**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s c char(10);
dcl-s v varchar(10);
dcl-s n packed(5:2);
c = 'abc';
v = c;
line = '[' + v + ']' + %char(%len(v));
write QSYSPRT line;
v = %trim(c);
line = '[' + v + ']' + %char(%len(v));
write QSYSPRT line;
c = 'toolongforfield';
line = '[' + c + ']';
write QSYSPRT line;
evalr c = 'right';
line = '[' + c + ']';
write QSYSPRT line;
n = 123.456;
line = %char(n);
write QSYSPRT line;
eval(h) n = 123.456;
line = %char(n);
write QSYSPRT line;
eval(h) n = -0.005;
line = %char(n);
write QSYSPRT line;
*inlr = *on;

**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s i int(10) inz(-32);
dcl-s j int(10) inz(478);
dcl-s k int(10) inz(-50);
dcl-s i20 int(20) inz(-32);
dcl-s u uns(10) inz(5);
dcl-s u10 uns(10) inz(10);
dcl-s p packed(5) inz(-32);
dcl-s r int(10);
dcl-s q packed(15:2);
monitor;
  r = %abs(i) - 478;
  line = '1 ' + %char(r);
on-error;
  line = '1 E ' + %char(%status());
endmon;
write QSYSPRT line;
monitor;
  r = %abs(i) - 10;
  line = '2 ' + %char(r);
on-error;
  line = '2 E ' + %char(%status());
endmon;
write QSYSPRT line;
monitor;
  r = 10 - %abs(i);
  line = '3 ' + %char(r);
on-error;
  line = '3 E ' + %char(%status());
endmon;
write QSYSPRT line;
monitor;
  r = %abs(i) - j;
  line = '4 ' + %char(r);
on-error;
  line = '4 E ' + %char(%status());
endmon;
write QSYSPRT line;
monitor;
  r = %abs(i) * -2;
  line = '5 ' + %char(r);
on-error;
  line = '5 E ' + %char(%status());
endmon;
write QSYSPRT line;
monitor;
  r = %abs(i) - 478.0;
  line = '6 ' + %char(r);
on-error;
  line = '6 E ' + %char(%status());
endmon;
write QSYSPRT line;
monitor;
  r = u - 10;
  line = '7 ' + %char(r);
on-error;
  line = '7 E ' + %char(%status());
endmon;
write QSYSPRT line;
monitor;
  r = u - u10;
  line = '8 ' + %char(r);
on-error;
  line = '8 E ' + %char(%status());
endmon;
write QSYSPRT line;
monitor;
  if 895 - %abs(i) < 0;
    line = '9 Y';
  else;
    line = '9 N';
  endif;
on-error;
  line = '9 E ' + %char(%status());
endmon;
write QSYSPRT line;
monitor;
  r = %abs(p) - 478;
  line = '10 ' + %char(r);
on-error;
  line = '10 E ' + %char(%status());
endmon;
write QSYSPRT line;
monitor;
  r = %abs(i) + 5;
  line = '11 ' + %char(r);
on-error;
  line = '11 E ' + %char(%status());
endmon;
write QSYSPRT line;
monitor;
  r = %abs(i20) - 478;
  line = '12 ' + %char(r);
on-error;
  line = '12 E ' + %char(%status());
endmon;
write QSYSPRT line;
monitor;
  r = u - j;
  line = '13 ' + %char(r);
on-error;
  line = '13 E ' + %char(%status());
endmon;
write QSYSPRT line;
monitor;
  line = '14 ' + %char(%abs(i) - 478);
on-error;
  line = '14 E ' + %char(%status());
endmon;
write QSYSPRT line;
monitor;
  r = -%abs(i);
  line = '15 ' + %char(r);
on-error;
  line = '15 E ' + %char(%status());
endmon;
write QSYSPRT line;
monitor;
  r = %abs(i) - %abs(k);
  line = '16 ' + %char(r);
on-error;
  line = '16 E ' + %char(%status());
endmon;
write QSYSPRT line;
monitor;
  r = %abs(i) - 478 + 1000;
  line = '17 ' + %char(r);
on-error;
  line = '17 E ' + %char(%status());
endmon;
write QSYSPRT line;
monitor;
  r = %int(%abs(i)) - 478;
  line = '18 ' + %char(r);
on-error;
  line = '18 E ' + %char(%status());
endmon;
write QSYSPRT line;
monitor;
  q = %abs(i) - 478;
  line = '19 ' + %char(q);
on-error;
  line = '19 E ' + %char(%status());
endmon;
write QSYSPRT line;
monitor;
  r = %abs(i) - 4294967295;
  line = '20 ' + %char(r);
on-error;
  line = '20 E ' + %char(%status());
endmon;
write QSYSPRT line;
monitor;
  r = %rem(%abs(i) - 478 : 1);
  line = '21 ' + %char(r);
on-error;
  line = '21 E ' + %char(%status());
endmon;
write QSYSPRT line;
*inlr = *on;

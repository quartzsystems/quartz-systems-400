**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s n int(10);
dcl-s c char(3) inz('b');
for n = 1 to 5;
  select n;
  when-is 1;
    line = %char(n) + ' is one';
    write QSYSPRT line;
  when-in %list(2:3);
    line = %char(n) + ' in list';
    write QSYSPRT line;
  when-in %range(4:4);
    line = %char(n) + ' in range';
    write QSYSPRT line;
  other;
    line = %char(n) + ' other';
    write QSYSPRT line;
  endsl;
endfor;
select c;
when-is 'a';
  line = 'a';
  write QSYSPRT line;
when-in %list('b':'c');
  line = 'b or c';
  write QSYSPRT line;
endsl;
*inlr = *on;

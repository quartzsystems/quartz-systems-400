**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-ds info qualified;
  name varchar(10);
  qty int(10);
end-ds;
monitor;
  xml-into info %xml('<info><name>x</name></info>':'doc=string');
  line = 'missing ok';
  write QSYSPRT line;
on-error;
  line = 'missing ' + %char(%status);
  write QSYSPRT line;
endmon;
monitor;
  xml-into info %xml('<info><name>x</name><qty>1</qty><z>1</z></info>':'doc=string');
  line = 'extra ok';
  write QSYSPRT line;
on-error;
  line = 'extra ' + %char(%status);
  write QSYSPRT line;
endmon;
monitor;
  xml-into info %xml('<info><name>x</name><qty>1</qty>':'doc=string');
  line = 'bad xml ok';
  write QSYSPRT line;
on-error;
  line = 'bad xml ' + %char(%status);
  write QSYSPRT line;
endmon;
monitor;
  xml-into info %xml('<info><name>x</name><qty>abc</qty></info>':'doc=string');
  line = 'bad data ok';
  write QSYSPRT line;
on-error;
  line = 'bad data ' + %char(%status);
  write QSYSPRT line;
endmon;
monitor;
  xml-into info %xml('<info><name>x</name><qty>1</qty></info>':'doc=string bogus=1');
  line = 'bad option ok';
  write QSYSPRT line;
on-error;
  line = 'bad option ' + %char(%status);
  write QSYSPRT line;
endmon;
*inlr = *on;

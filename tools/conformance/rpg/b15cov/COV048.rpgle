**FREE
ctl-opt dftactgrp(*no);
dcl-f QSYSPRT printer(132);
dcl-ds line len(132) end-ds;
dcl-s u uns(10);
dcl-s n packed(5:0) inz(-3);
dcl-s c char(5) inz('1a');
monitor;
  u = %uns(n);
  line = 'neg ok';
  write QSYSPRT line;
on-error;
  line = 'neg ' + %char(%status);
  write QSYSPRT line;
endmon;
monitor;
  u = %uns(c);
  line = 'char ok';
  write QSYSPRT line;
on-error;
  line = 'char ' + %char(%status);
  write QSYSPRT line;
endmon;
monitor;
  u = %unsh(-0.4);
  line = 'unsh ok';
  write QSYSPRT line;
on-error;
  line = 'unsh ' + %char(%status);
  write QSYSPRT line;
endmon;
*inlr = *on;

// A Qlg_Path_Name_T with the path in place, CCSID 0 (the job's).
dcl-ds qlgT qualified template;
  ccsid int(10);
  country char(2);
  lang char(3);
  res char(3);
  ptype uns(10);
  len int(10);
  delim char(2);
  res2 char(10);
  name char(200);
end-ds;

dcl-pr q_open int(10) extproc('QlgOpen');
  path likeds(qlgT) const;
  oflag int(10) value;
  mode uns(10) value options(*nopass);
end-pr;
dcl-pr q_creat int(10) extproc('QlgCreat');
  path likeds(qlgT) const;
  mode uns(10) value;
end-pr;
dcl-pr q_stat int(10) extproc('QlgStat');
  path likeds(qlgT) const;
  buf pointer value;
end-pr;
dcl-pr q_lstat int(10) extproc('QlgLstat');
  path likeds(qlgT) const;
  buf pointer value;
end-pr;
dcl-pr q_access int(10) extproc('QlgAccess');
  path likeds(qlgT) const;
  amode int(10) value;
end-pr;
dcl-pr q_chmod int(10) extproc('QlgChmod');
  path likeds(qlgT) const;
  mode uns(10) value;
end-pr;
dcl-pr q_mkdir int(10) extproc('QlgMkdir');
  path likeds(qlgT) const;
  mode uns(10) value;
end-pr;
dcl-pr q_rmdir int(10) extproc('QlgRmdir');
  path likeds(qlgT) const;
end-pr;
dcl-pr q_chdir int(10) extproc('QlgChdir');
  path likeds(qlgT) const;
end-pr;
dcl-pr q_unlink int(10) extproc('QlgUnlink');
  path likeds(qlgT) const;
end-pr;
dcl-pr q_link int(10) extproc('QlgLink');
  a likeds(qlgT) const;
  b likeds(qlgT) const;
end-pr;
dcl-pr q_symlink int(10) extproc('QlgSymlink');
  t likeds(qlgT) const;
  p likeds(qlgT) const;
end-pr;
dcl-pr q_readlink int(10) extproc('QlgReadlink');
  p likeds(qlgT) const;
  buf pointer value;
  n uns(10) value;
end-pr;
dcl-pr q_renkeep int(10) extproc('QlgRenameKeep');
  a likeds(qlgT) const;
  b likeds(qlgT) const;
end-pr;
dcl-pr q_renunlink int(10) extproc('QlgRenameUnlink');
  a likeds(qlgT) const;
  b likeds(qlgT) const;
end-pr;
dcl-pr q_opendir pointer extproc('QlgOpendir');
  path likeds(qlgT) const;
end-pr;
dcl-pr q_readdir pointer extproc('QlgReaddir');
  dir pointer value;
end-pr;
dcl-pr q_getcwd pointer extproc('QlgGetcwd');
  buf pointer value;
  n uns(10) value;
end-pr;
dcl-pr q_pathconf int(10) extproc('QlgPathconf');
  path likeds(qlgT) const;
  name int(10) value;
end-pr;
dcl-pr q_statvfs int(10) extproc('QlgStatvfs');
  path likeds(qlgT) const;
  buf pointer value;
end-pr;
dcl-pr q_utime int(10) extproc('QlgUtime');
  path likeds(qlgT) const;
  times pointer value;
end-pr;
dcl-pr q_getattr int(10) extproc('Qp0lGetAttr');
  path likeds(qlgT) const;
  ids pointer value;
  buf pointer value;
  size uns(10) value;
  need uns(10);
  got uns(10);
  follow uns(10) value;
end-pr;
dcl-pr q_setattr int(10) extproc('Qp0lSetAttr');
  path likeds(qlgT) const;
  buf pointer value;
  size uns(10) value;
  follow uns(10) value;
end-pr;
dcl-pr q_cvtpath extproc('Qp0lCvtPathToQSYSObjName');
  path likeds(qlgT) const;
  info pointer value;
  fmt char(8) const;
  size uns(10) value;
  ccsid uns(10) value;
  err pointer value;
end-pr;
dcl-pr q_pathfromid pointer extproc('Qp0lGetPathFromFileID');
  buf pointer value;
  size uns(10) value;
  fid pointer value;
end-pr;
dcl-pr q_qlgpathfromid pointer extproc('QlgGetPathFromFileID');
  buf pointer value;
  size uns(10) value;
  fid pointer value;
end-pr;
dcl-pr q_subtree int(10) extproc('Qp0lProcessSubtree');
  path likeds(qlgT) const;
  subtree uns(10) value;
  types pointer value;
  local uns(10) value;
  inex pointer value;
  erropt uns(10) value;
  uf pointer value;
  info pointer value;
end-pr;
dcl-s d varchar(64);
dcl-s fd int(10);
dcl-s dp pointer;
dcl-s e pointer;
dcl-s data char(3) inz('xyz');
dcl-s st char(128);
dcl-s cwd char(96);
dcl-s lnk char(96);
dcl-s vfs char(160);
d = HOME + '/IFSAPI09';
rc(q_mkdir(qlg(d): 493));
rc(q_chdir(qlg(d)));
say('QlgGetcwd: the path''s length');
ptrok(q_getcwd(%addr(cwd): 96));
say(%char(int4(%addr(cwd): 16)));
say('QlgOpen O_CREAT O_RDWR');
fd = q_open(qlg(d + '/q.txt'): 12: 420);
rc(fd);
rc(p_write(fd: %addr(data): 3));
p_close(fd);
say('QlgStat: size');
rc(q_stat(qlg(d + '/q.txt'): %addr(st)));
say(%char(int4(%addr(st): 20)));
say('QlgAccess, QlgChmod 0o600');
rc(q_access(qlg(d + '/q.txt'): 4));
rc(q_chmod(qlg(d + '/q.txt'): 384));
say('QlgLink, QlgUnlink');
rc(q_link(qlg(d + '/q.txt'): qlg(d + '/h.txt')));
rc(q_unlink(qlg(d + '/h.txt')));
say('QlgSymlink, QlgReadlink, QlgLstat');
rc(q_symlink(qlg(d + '/q.txt'): qlg(d + '/s.lnk')));
rc(q_readlink(qlg(d + '/s.lnk'): %addr(lnk): 96));
say(%char(int4(%addr(lnk): 16)));
rc(q_lstat(qlg(d + '/s.lnk'): %addr(st)));
say(%char(%div(int4(%addr(st): 0): 4096)));
say('QlgRenameKeep, QlgRenameUnlink');
rc(q_renkeep(qlg(d + '/q.txt'): qlg(d + '/r.txt')));
fd = q_creat(qlg(d + '/q.txt'): 420);
rc(fd);
p_close(fd);
rc(q_renkeep(qlg(d + '/q.txt'): qlg(d + '/r.txt')));
rc(q_renunlink(qlg(d + '/q.txt'): qlg(d + '/r.txt')));
say('QlgOpendir, QlgReaddir: name lengths');
dp = q_opendir(qlg(d));
ptrok(dp);
e = q_readdir(dp);
dow e <> *null;
  say(%char(int4(e: 56)));
  e = q_readdir(dp);
enddo;
rc(p_closedir(dp));
say('QlgPathconf, QlgStatvfs, QlgUtime');
rc(q_pathconf(qlg(d): 4));
rc(q_statvfs(qlg(d): %addr(vfs)));
rc(q_utime(qlg(d + '/r.txt'): *null));
rc(q_unlink(qlg(d + '/s.lnk')));
rc(q_chdir(qlg(HOME)));
rc(q_unlink(qlg(d + '/r.txt')));
rc(q_rmdir(qlg(d)));
*inlr = *on;
return;

dcl-proc say;
  dcl-pi *n;
    t varchar(132) const;
  end-pi;
  out = t;
  write QSYSPRT out;
end-proc;

dcl-proc errnum;
  dcl-pi *n int(10);
  end-pi;
  dcl-s p pointer;
  dcl-s e int(10) based(p);
  p = errnoptr();
  return e;
end-proc;

dcl-proc rc;
  dcl-pi *n;
    r int(10) value;
  end-pi;
  if r < 0;
    say('-1 errno');
    say(%char(errnum()));
  else;
    say(%char(r));
  endif;
end-proc;

dcl-proc ptrok;
  dcl-pi *n;
    p pointer value;
  end-pi;
  if p = *null;
    say('null errno');
    say(%char(errnum()));
  else;
    say('ok');
  endif;
end-proc;

dcl-proc int4;
  dcl-pi *n int(10);
    p pointer value;
    off int(10) value;
  end-pi;
  dcl-s q pointer;
  dcl-s v int(10) based(q);
  q = p + off;
  return v;
end-proc;

dcl-proc int8;
  dcl-pi *n int(20);
    p pointer value;
    off int(10) value;
  end-pi;
  dcl-s q pointer;
  dcl-s v int(20) based(q);
  q = p + off;
  return v;
end-proc;

dcl-proc short;
  dcl-pi *n int(10);
    p pointer value;
    off int(10) value;
  end-pi;
  dcl-s q pointer;
  dcl-s v uns(5) based(q);
  q = p + off;
  return v;
end-proc;

dcl-proc text;
  dcl-pi *n varchar(132);
    p pointer value;
    off int(10) value;
    n int(10) value;
  end-pi;
  dcl-s q pointer;
  dcl-s v char(132) based(q);
  q = p + off;
  return %subst(v: 1: n);
end-proc;

dcl-proc qlg;
  dcl-pi *n likeds(qlgT);
    path varchar(200) const;
  end-pi;
  dcl-ds q likeds(qlgT) inz;
  q.ccsid = 0;
  q.country = x'0000';
  q.lang = x'000000';
  q.res = x'000000';
  q.ptype = 0;
  q.len = %len(path);
  q.delim = '/' + x'00';
  q.res2 = *allx'00';
  q.name = path;
  return q;
end-proc;

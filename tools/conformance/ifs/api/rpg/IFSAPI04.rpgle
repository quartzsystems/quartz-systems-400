**FREE
// The IFS API probe IFSAPI04: prints on QSYSPRT what
// conformance/ifs/api/programs/IFSAPI04.qir shows, against /home/QSTEST.
ctl-opt dftactgrp(*no) actgrp(*new);
dcl-f QSYSPRT printer(132);
dcl-ds out len(132) end-ds;
dcl-c HOME '/home/QSTEST';
dcl-pr p_open int(10) extproc('open');
  path pointer value options(*string);
  oflag int(10) value;
  mode uns(10) value options(*nopass);
  cp uns(10) value options(*nopass);
  tcp uns(10) value options(*nopass);
end-pr;
dcl-pr p_open64 int(10) extproc('open64');
  path pointer value options(*string);
  oflag int(10) value;
  mode uns(10) value options(*nopass);
end-pr;
dcl-pr p_creat int(10) extproc('creat');
  path pointer value options(*string);
  mode uns(10) value;
end-pr;
dcl-pr p_creat64 int(10) extproc('creat64');
  path pointer value options(*string);
  mode uns(10) value;
end-pr;
dcl-pr p_read int(10) extproc('read');
  fd int(10) value;
  buf pointer value;
  n uns(10) value;
end-pr;
dcl-pr p_write int(10) extproc('write');
  fd int(10) value;
  buf pointer value;
  n uns(10) value;
end-pr;
dcl-pr p_pread int(10) extproc('pread');
  fd int(10) value;
  buf pointer value;
  n uns(10) value;
  off int(10) value;
end-pr;
dcl-pr p_pread64 int(10) extproc('pread64');
  fd int(10) value;
  buf pointer value;
  n uns(10) value;
  off int(20) value;
end-pr;
dcl-pr p_pwrite int(10) extproc('pwrite');
  fd int(10) value;
  buf pointer value;
  n uns(10) value;
  off int(10) value;
end-pr;
dcl-pr p_pwrite64 int(10) extproc('pwrite64');
  fd int(10) value;
  buf pointer value;
  n uns(10) value;
  off int(20) value;
end-pr;
dcl-pr p_lseek int(10) extproc('lseek');
  fd int(10) value;
  off int(10) value;
  whence int(10) value;
end-pr;
dcl-pr p_lseek64 int(20) extproc('lseek64');
  fd int(10) value;
  off int(20) value;
  whence int(10) value;
end-pr;
dcl-pr p_close int(10) extproc('close');
  fd int(10) value;
end-pr;
dcl-pr p_fsync int(10) extproc('fsync');
  fd int(10) value;
end-pr;
dcl-pr p_ftruncate int(10) extproc('ftruncate');
  fd int(10) value;
  len int(10) value;
end-pr;
dcl-pr p_ftruncate64 int(10) extproc('ftruncate64');
  fd int(10) value;
  len int(20) value;
end-pr;
dcl-pr p_stat int(10) extproc('stat');
  path pointer value options(*string);
  buf pointer value;
end-pr;
dcl-pr p_lstat int(10) extproc('lstat');
  path pointer value options(*string);
  buf pointer value;
end-pr;
dcl-pr p_stat64 int(10) extproc('stat64');
  path pointer value options(*string);
  buf pointer value;
end-pr;
dcl-pr p_lstat64 int(10) extproc('lstat64');
  path pointer value options(*string);
  buf pointer value;
end-pr;
dcl-pr p_fstat int(10) extproc('fstat');
  fd int(10) value;
  buf pointer value;
end-pr;
dcl-pr p_fstat64 int(10) extproc('fstat64');
  fd int(10) value;
  buf pointer value;
end-pr;
dcl-pr p_access int(10) extproc('access');
  path pointer value options(*string);
  amode int(10) value;
end-pr;
dcl-pr p_chmod int(10) extproc('chmod');
  path pointer value options(*string);
  mode uns(10) value;
end-pr;
dcl-pr p_fchmod int(10) extproc('fchmod');
  fd int(10) value;
  mode uns(10) value;
end-pr;
dcl-pr p_chown int(10) extproc('chown');
  path pointer value options(*string);
  uid uns(10) value;
  gid uns(10) value;
end-pr;
dcl-pr p_fchown int(10) extproc('fchown');
  fd int(10) value;
  uid uns(10) value;
  gid uns(10) value;
end-pr;
dcl-pr p_lchown int(10) extproc('lchown');
  path pointer value options(*string);
  uid uns(10) value;
  gid uns(10) value;
end-pr;
dcl-pr p_link int(10) extproc('link');
  a pointer value options(*string);
  b pointer value options(*string);
end-pr;
dcl-pr p_unlink int(10) extproc('unlink');
  path pointer value options(*string);
end-pr;
dcl-pr p_rename int(10) extproc('Qp0lRenameKeep');
  a pointer value options(*string);
  b pointer value options(*string);
end-pr;
dcl-pr p_renkeep int(10) extproc('Qp0lRenameKeep');
  a pointer value options(*string);
  b pointer value options(*string);
end-pr;
dcl-pr p_renunlink int(10) extproc('Qp0lRenameUnlink');
  a pointer value options(*string);
  b pointer value options(*string);
end-pr;
dcl-pr p_symlink int(10) extproc('symlink');
  target pointer value options(*string);
  path pointer value options(*string);
end-pr;
dcl-pr p_readlink int(10) extproc('readlink');
  path pointer value options(*string);
  buf pointer value;
  n uns(10) value;
end-pr;
dcl-pr p_mkdir int(10) extproc('mkdir');
  path pointer value options(*string);
  mode uns(10) value;
end-pr;
dcl-pr p_rmdir int(10) extproc('rmdir');
  path pointer value options(*string);
end-pr;
dcl-pr p_opendir pointer extproc('opendir');
  path pointer value options(*string);
end-pr;
dcl-pr p_readdir pointer extproc('readdir');
  dir pointer value;
end-pr;
dcl-pr p_readdir_r int(10) extproc('readdir_r');
  dir pointer value;
  entry pointer value;
  result pointer;
end-pr;
dcl-pr p_rewinddir extproc('rewinddir');
  dir pointer value;
end-pr;
dcl-pr p_closedir int(10) extproc('closedir');
  dir pointer value;
end-pr;
dcl-pr p_chdir int(10) extproc('chdir');
  path pointer value options(*string);
end-pr;
dcl-pr p_fchdir int(10) extproc('fchdir');
  fd int(10) value;
end-pr;
dcl-pr p_getcwd pointer extproc('getcwd');
  buf pointer value;
  n uns(10) value;
end-pr;
dcl-pr p_dup int(10) extproc('dup');
  fd int(10) value;
end-pr;
dcl-pr p_dup2 int(10) extproc('dup2');
  fd int(10) value;
  to int(10) value;
end-pr;
dcl-pr p_fcntl int(10) extproc('fcntl');
  fd int(10) value;
  cmd int(10) value;
  arg int(10) value;
end-pr;
dcl-pr p_fcntlp int(10) extproc('fcntl');
  fd int(10) value;
  cmd int(10) value;
  lock pointer value;
end-pr;
dcl-pr p_utime int(10) extproc('utime');
  path pointer value options(*string);
  times pointer value;
end-pr;
dcl-pr p_umask uns(10) extproc('umask');
  mask uns(10) value;
end-pr;
dcl-pr p_pathconf int(10) extproc('pathconf');
  path pointer value options(*string);
  name int(10) value;
end-pr;
dcl-pr p_fpathconf int(10) extproc('fpathconf');
  fd int(10) value;
  name int(10) value;
end-pr;
dcl-pr p_statvfs int(10) extproc('statvfs');
  path pointer value options(*string);
  buf pointer value;
end-pr;
dcl-pr p_fstatvfs int(10) extproc('fstatvfs');
  fd int(10) value;
  buf pointer value;
end-pr;
dcl-pr p_statvfs64 int(10) extproc('statvfs64');
  path pointer value options(*string);
  buf pointer value;
end-pr;
dcl-pr errnoptr pointer extproc('__errno');
end-pr;
dcl-pr p_strerror pointer extproc('strerror');
  e int(10) value;
end-pr;
dcl-pr p_perror extproc('perror');
  s pointer value options(*string);
end-pr;
dcl-s d varchar(64);
dcl-s a varchar(64);
dcl-s b varchar(64);
dcl-s c varchar(64);
dcl-s s varchar(64);
dcl-s fd int(10);
dcl-s lnk char(30) inz(*blanks);
dcl-s shrt char(10) inz(*blanks);
dcl-s st char(128);
d = HOME + '/IFSAPI04';
a = d + '/a';
b = d + '/b';
c = d + '/c';
s = d + '/s';
rc(p_mkdir(d: 493));
fd = p_creat(a: 420);
p_close(fd);
say('link a b');
rc(p_link(a: b));
nlink(a);
say('link onto an existing name');
rc(p_link(a: b));
say('unlink b');
rc(p_unlink(b));
nlink(a);
fd = p_creat(c: 420);
p_close(fd);
say('Qp0lRenameKeep a c: c exists');
rc(p_renkeep(a: c));
say('rename a c: as Qp0lRenameKeep');
rc(p_rename(a: c));
say('Qp0lRenameUnlink a c: c replaced');
rc(p_renunlink(a: c));
rc(p_access(a: 0));
say('Qp0lRenameKeep c b');
rc(p_renkeep(c: b));
say('rename of nothing');
rc(p_rename(d + '/none': a));
say('symlink s to c, readlink');
rc(p_symlink(c: s));
rc(p_readlink(s: %addr(lnk): 30));
say(lnk);
say('readlink into ten bytes');
rc(p_readlink(s: %addr(shrt): 10));
say(shrt);
say('readlink of a file');
rc(p_readlink(b: %addr(lnk): 30));
say('a dangling link: stat and lstat');
rc(p_stat(s: %addr(st)));
rc(p_lstat(s: %addr(st)));
p_unlink(s);
rc(p_unlink(b));
rc(p_rmdir(d));
*inlr = *on;
return;

dcl-proc nlink;
  dcl-pi *n;
    path varchar(64) const;
  end-pi;
  dcl-s x char(128);
  rc(p_stat(path: %addr(x)));
  say(%char(short(%addr(x): 8)));
end-proc;

dcl-proc say;
  dcl-pi *n;
    t varchar(132) const;
  end-pi;
  out = t;
  write QSYSPRT out;
end-proc;

dcl-proc errnum;
  dcl-pi *n int(10);
  end-pi;
  dcl-s p pointer;
  dcl-s e int(10) based(p);
  p = errnoptr();
  return e;
end-proc;

dcl-proc rc;
  dcl-pi *n;
    r int(10) value;
  end-pi;
  if r < 0;
    say('-1 errno');
    say(%char(errnum()));
  else;
    say(%char(r));
  endif;
end-proc;

dcl-proc ptrok;
  dcl-pi *n;
    p pointer value;
  end-pi;
  if p = *null;
    say('null errno');
    say(%char(errnum()));
  else;
    say('ok');
  endif;
end-proc;

dcl-proc int4;
  dcl-pi *n int(10);
    p pointer value;
    off int(10) value;
  end-pi;
  dcl-s q pointer;
  dcl-s v int(10) based(q);
  q = p + off;
  return v;
end-proc;

dcl-proc int8;
  dcl-pi *n int(20);
    p pointer value;
    off int(10) value;
  end-pi;
  dcl-s q pointer;
  dcl-s v int(20) based(q);
  q = p + off;
  return v;
end-proc;

dcl-proc short;
  dcl-pi *n int(10);
    p pointer value;
    off int(10) value;
  end-pi;
  dcl-s q pointer;
  dcl-s v uns(5) based(q);
  q = p + off;
  return v;
end-proc;

dcl-proc text;
  dcl-pi *n varchar(132);
    p pointer value;
    off int(10) value;
    n int(10) value;
  end-pi;
  dcl-s q pointer;
  dcl-s v char(132) based(q);
  q = p + off;
  return %subst(v: 1: n);
end-proc;

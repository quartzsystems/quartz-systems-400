dcl-pr q_cvtpath extproc('Qp0lCvtPathToQSYSObjName');
  path likeds(qlgT) const;
  info pointer value;
  fmt char(8) const;
  size uns(10) value;
  ccsid uns(10) value;
  err pointer value;

  a likeds(qlgT) const;
  b likeds(qlgT) const;
end-pr;
dcl-pr q_symlink int(10) extproc('QlgSymlink');
  t likeds(qlgT) const;
  p likeds(qlgT) const;
end-pr;
dcl-pr q_readlink int(10) extproc('QlgReadlink');
  p likeds(qlgT) const;
  buf pointer value;
  n uns(10) value;
end-pr;
dcl-pr q_renkeep int(10) extproc('QlgRenameKeep');
  a likeds(qlgT) const;
  b likeds(qlgT) const;
end-pr;

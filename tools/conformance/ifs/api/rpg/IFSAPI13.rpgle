end-pr;
dcl-pr qp0lror extpgm('QP0LROR');
  rcv char(128);
  len int(10) const;
  fmt char(8) const;
  path likeds(qlgT) const;
  err char(16);
end-pr;
dcl-pr qp0lrro extpgm('QP0LRRO');
  rcv char(256);
  len int(10) const;
  fmt char(8) const;
  job char(26) const;
  jfmt char(8) const;
  err char(16);
end-pr;
dcl-s d varchar(64);
dcl-s f varchar(64);
dcl-s fd int(10);
dcl-s f1 int(10);
dcl-s f2 int(10);
dcl-s rcv char(128);
dcl-s rcv2 char(256);
dcl-s err char(16);
dcl-s lo int(10);
d = HOME + '/IFSAPI13';
f = d + '/r.txt';
p_mkdir(d: 493);
fd = p_creat(f: 420);
p_close(fd);
err = x'00000010' + x'000000000000000000000000';
say('no references');
qp0lror(rcv: 128: 'RORO0100': qlg(f): err);
show();
say('one read, one write');
f1 = p_open(f: 1);
f2 = p_open(f: 2);
qp0lror(rcv: 128: 'RORO0100': qlg(f): err);
show();
say('the objects this job references');
qp0lrro(rcv2: 256: 'RROO0100': '*': 'JIDF0100': err);
say(%char(int4(%addr(rcv2): 8)));
lo = int4(%addr(rcv2): 16);
say(%char(int4(%addr(rcv2): lo + 12)));
say('another job');
qp0lrro(rcv2: 256: 'RROO0100': 'QZDASOINIT': 'JIDF0100': err);
say(%subst(err: 9: 7));
p_close(f1);
p_close(f2);
p_unlink(f);
rc(p_rmdir(d));
*inlr = *on;
return;

dcl-proc show;
  dcl-s so int(10);
  say(%char(int4(%addr(rcv): 0)));
  say(%char(int4(%addr(rcv): 16)));
  say(%char(int4(%addr(rcv): 20)));
  so = int4(%addr(rcv): 8);
  say(%char(int4(%addr(rcv): so)));
  say(%char(int4(%addr(rcv): so + 4)));
  say(%char(int4(%addr(rcv): so + 24)));
end-proc;

dcl-proc say;
  dcl-pi *n;
    t varchar(132) const;
  end-pi;
  out = t;
  write QSYSPRT out;
end-proc;

dcl-proc errnum;
  dcl-pi *n int(10);
  end-pi;
  dcl-s p pointer;
  dcl-s e int(10) based(p);
  p = errnoptr();
  return e;
end-proc;

dcl-proc rc;
  dcl-pi *n;
    r int(10) value;
  end-pi;
  if r < 0;
    say('-1 errno');
    say(%char(errnum()));
  else;
    say(%char(r));
  endif;
end-proc;

dcl-proc ptrok;
  dcl-pi *n;
    p pointer value;
  end-pi;
  if p = *null;
    say('null errno');
    say(%char(errnum()));
  else;
    say('ok');
  endif;
end-proc;

dcl-proc int4;
  dcl-pi *n int(10);
    p pointer value;
    off int(10) value;
  end-pi;
  dcl-s q pointer;
  dcl-s v int(10) based(q);
  q = p + off;
  return v;
end-proc;

dcl-proc int8;
  dcl-pi *n int(20);
    p pointer value;
    off int(10) value;
  end-pi;
  dcl-s q pointer;
  dcl-s v int(20) based(q);
  q = p + off;
  return v;
end-proc;

dcl-proc short;
  dcl-pi *n int(10);
    p pointer value;
    off int(10) value;
  end-pi;
  dcl-s q pointer;
  dcl-s v uns(5) based(q);
  q = p + off;
  return v;
end-proc;

dcl-proc text;
  dcl-pi *n varchar(132);
    p pointer value;
    off int(10) value;
    n int(10) value;
  end-pi;
  dcl-s q pointer;
  dcl-s v char(132) based(q);
  q = p + off;
  return %subst(v: 1: n);
end-proc;

dcl-proc qlg;
  dcl-pi *n likeds(qlgT);
    path varchar(200) const;
  end-pi;
  dcl-ds q likeds(qlgT) inz;
  q.ccsid = 0;
  q.country = x'0000';
  q.lang = x'000000';
  q.res = x'000000';
  q.ptype = 0;
  q.len = %len(path);
  q.delim = '/' + x'00';
  q.res2 = *allx'00';
  q.name = path;
  return q;
end-proc;

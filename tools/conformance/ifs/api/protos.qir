extern proc QlgGetPathFromFileID(byval $b: ptr, byval $n: u32, byval $f: ptr) -> ptr
extern proc Qp0lProcessSubtree(byval $p: ptr, byval $s: u32, byval $t: ptr, byval $l: u32, byval $x: ptr, byval $e: u32, byval $u: ptr, byval $i: ptr) -> i32
extern proc __errno() -> ptr
extern proc strerror(byval $e: i32) -> ptr
extern proc perror(byval $s: ptr)
; A return code as the corpus shows it: the value, or -1 and errno.
proc RC(byval $rc: i32) {
L0:
  %r = cvt.i32 $rc
  %bad = cmp.lt %r, 0
  brif %bad, ERR, OK
OK:
  dsply %r
  ret
ERR:
  %ep = callb __errno()
  %e = load [%ep]:i32
  dsply "-1 errno"
  dsply %e
  ret
}
; A pointer result: "ok", or "null" and errno.
proc PTR(byval $p: ptr) {
L0:
  %nul = const.ptr *NULL
  %q = load $p
  %z = cmp.eq %q, %nul
  brif %z, ERR, OK
OK:
  dsply "ok"
  ret
ERR:
  %ep = callb __errno()
  %e = load [%ep]:i32
  dsply "null errno"
  dsply %e
  ret
}
; The big-endian int at an offset of storage.
proc INT(byval $p: ptr, byval $off: i64) -> i32 {
L0:
  %o = cvt.i64 $off
  %q = load $p
  %a = ptradd %q, %o
  %v = load [%a]:i32
  ret %v
}
; The big-endian unsigned short at an offset of storage.
proc SHORT(byval $p: ptr, byval $off: i64) -> i32 {
L0:
  %o = cvt.i64 $off
  %q = load $p
  %a = ptradd %q, %o
  %v = load [%a]:u16
  %w = cvt.i32 %v
  ret %w
}

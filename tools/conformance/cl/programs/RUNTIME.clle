/* Commands on the run-time path: expressions in parameters. */
             PGM
             DCL        VAR(&LIB) TYPE(*CHAR) LEN(10) VALUE('RT')
             DCL        VAR(&N) TYPE(*DEC) LEN(3 0) VALUE(2)
             CRTLIB     LIB(&LIB *TCAT 'LIB') TEXT('number ' *CAT %CHAR(&N))
             DLTLIB     LIB(%SST(&LIB 1 2) *CAT 'X')
             CLRLIB     LIB(&LIB)
             ENDPGM

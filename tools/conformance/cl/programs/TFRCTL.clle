/* TFRCTL hands control to another program. */
             PGM
             SNDPGMMSG  MSG('before transfer') TOPGMQ(*EXT)
             TFRCTL     PGM(QGPL/OTHER) PARM('x')
             SNDPGMMSG  MSG('not reached') TOPGMQ(*EXT)
             ENDPGM

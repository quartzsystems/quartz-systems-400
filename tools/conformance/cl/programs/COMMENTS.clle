/* Comments, continuations and labels in odd places. */
             PGM /* a trailing comment */
             DCL        VAR(&A) TYPE(*CHAR) +
                          LEN(10) +   /* continued with a comment */
                          VALUE('plus')
             DCL        VAR(&B) TYPE(*CHAR) LEN(10) VALUE('min-
us')
 L1:         SNDPGMMSG  MSG(&A *BCAT &B) TOPGMQ(*EXT)
             /* a whole-line comment */
             SNDPGMMSG  MSG('done /* not a comment */') TOPGMQ(*EXT)
             ENDPGM

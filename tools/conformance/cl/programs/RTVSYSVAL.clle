/* RTVSYSVAL and RTVOBJD return values. */
             PGM
             DCL        VAR(&V) TYPE(*CHAR) LEN(10)
             DCL        VAR(&OWN) TYPE(*CHAR) LEN(10)
             DCL        VAR(&TXT) TYPE(*CHAR) LEN(50)
             RTVSYSVAL  SYSVAL(QDATE) RTNVAR(&V)
             SNDPGMMSG  MSG('sysval ' *CAT &V) TOPGMQ(*EXT)
             RTVOBJD    OBJ(QGPL/CUST) OBJTYPE(*FILE) OWNER(&OWN) TEXT(&TXT)
             SNDPGMMSG  MSG('owner ' *CAT &OWN *BCAT %TRIM(&TXT)) TOPGMQ(*EXT)
             ENDPGM

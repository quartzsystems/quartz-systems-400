/* GOTO forward and back. */
             PGM
             DCL        VAR(&I) TYPE(*DEC) LEN(3 0) VALUE(0)
 AGAIN:      CHGVAR     VAR(&I) VALUE(&I + 1)
             IF         COND(&I *LT 3) THEN(GOTO AGAIN)
             SNDPGMMSG  MSG('i=' *CAT %CHAR(&I)) TOPGMQ(*EXT)
             GOTO       CMDLBL(DONE)
             SNDPGMMSG  MSG('skipped') TOPGMQ(*EXT)
 DONE:       SNDPGMMSG  MSG('done') TOPGMQ(*EXT)
             ENDPGM

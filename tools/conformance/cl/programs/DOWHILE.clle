/* DOWHILE with LEAVE and ITERATE. */
             PGM
             DCL        VAR(&I) TYPE(*DEC) LEN(3 0) VALUE(0)
             DOWHILE    COND(&I *LT 10)
               CHGVAR     VAR(&I) VALUE(&I + 1)
               IF         COND(&I *EQ 3) THEN(ITERATE)
               IF         COND(&I *EQ 6) THEN(LEAVE)
               SNDPGMMSG  MSG('i=' *CAT %CHAR(&I)) TOPGMQ(*EXT)
             ENDDO
             SNDPGMMSG  MSG('end ' *CAT %CHAR(&I)) TOPGMQ(*EXT)
             ENDPGM

/* DMPCLPGM leaves a dump. */
             PGM
             DCL        VAR(&X) TYPE(*CHAR) LEN(5) VALUE('dump')
             DMPCLPGM
             SNDPGMMSG  MSG('dumped') TOPGMQ(*EXT)
             ENDPGM

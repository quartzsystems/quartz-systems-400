/* %BIN both ways. */
             PGM
             DCL        VAR(&B2) TYPE(*CHAR) LEN(2)
             DCL        VAR(&B4) TYPE(*CHAR) LEN(4)
             DCL        VAR(&N) TYPE(*DEC) LEN(10 0)
             CHGVAR     VAR(%BIN(&B2)) VALUE(300)
             CHGVAR     VAR(%BIN(&B4)) VALUE(-70000)
             CHGVAR     VAR(&N) VALUE(%BIN(&B2))
             SNDPGMMSG  MSG('b2 ' *CAT %CHAR(&N)) TOPGMQ(*EXT)
             CHGVAR     VAR(&N) VALUE(%BIN(&B4))
             SNDPGMMSG  MSG('b4 ' *CAT %CHAR(&N)) TOPGMQ(*EXT)
             ENDPGM

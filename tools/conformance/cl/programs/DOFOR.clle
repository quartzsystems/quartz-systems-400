/* DOFOR with a step, counting down, and labelled LEAVE. */
             PGM
             DCL        VAR(&I) TYPE(*INT) LEN(4)
             DCL        VAR(&J) TYPE(*INT) LEN(4)
             DCL        VAR(&S) TYPE(*INT) LEN(4) VALUE(0)
             DOFOR      VAR(&I) FROM(1) TO(10) BY(3)
               CHGVAR     VAR(&S) VALUE(&S + &I)
             ENDDO
             SNDPGMMSG  MSG('sum ' *CAT %CHAR(&S)) TOPGMQ(*EXT)
             DOFOR      VAR(&I) FROM(3) TO(1) BY(-1)
               SNDPGMMSG  MSG('down ' *CAT %CHAR(&I)) TOPGMQ(*EXT)
             ENDDO
 OUTER:      DOFOR      VAR(&I) FROM(1) TO(3)
               DOFOR      VAR(&J) FROM(1) TO(3)
                 IF         COND(&J *EQ 2 *AND &I *EQ 2) THEN(LEAVE OUTER)
                 SNDPGMMSG  MSG(%CHAR(&I) *CAT ',' *CAT %CHAR(&J)) TOPGMQ(*EXT)
               ENDDO
             ENDDO
             ENDPGM

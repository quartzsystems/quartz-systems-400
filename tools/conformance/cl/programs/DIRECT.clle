/* Commands on the direct path: constants only, variables patched. */
             PGM
             DCL        VAR(&LIB) TYPE(*CHAR) LEN(10) VALUE('WORKLIB')
             DCL        VAR(&TXT) TYPE(*CHAR) LEN(50) VALUE('made by DIRECT')
             CRTLIB     LIB(FIXED) TEXT('fixed text')
             CRTLIB     LIB(&LIB) TEXT(&TXT)
             DLTLIB     LIB(&LIB)
             CHKOBJ     OBJ(QGPL/CUST) OBJTYPE(*FILE) AUT(*USE)
             CRTDTAARA  DTAARA(QGPL/FLAG) TYPE(*LGL) VALUE('1')
             CRTPF      FILE(QGPL/NEWPF) RCDLEN(80) SIZE(*NOMAX)
             ENDPGM

/* The program ends with an escape to its caller. */
             PGM
             SNDPGMMSG  MSG('about to fail') TOPGMQ(*EXT)
             SNDPGMMSG  MSGID(CPF9898) MSGF(QCPFMSG) MSGDTA('my escape') +
                          MSGTYPE(*ESCAPE)
             SNDPGMMSG  MSG('not reached') TOPGMQ(*EXT)
             ENDPGM

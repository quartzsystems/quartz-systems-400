/* Completion and status messages. */
             PGM
             SNDPGMMSG  MSGID(CPF9897) MSGF(QCPFMSG) MSGDTA('finished') +
                          MSGTYPE(*COMP)
             SNDPGMMSG  MSGID(CPF9898) MSGF(QCPFMSG) MSGDTA('working') +
                          TOPGMQ(*EXT) MSGTYPE(*STATUS)
             SNDPGMMSG  MSG('text only') TOPGMQ(*EXT)
             ENDPGM

/*; fail: CHKOBJ CPF9801 */
/* MONMSG that leaves the statement with GOTO, and the escape left unhandled. */
             PGM
             CHKOBJ     OBJ(QGPL/NOPE) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(GOTO MISSING)
             SNDPGMMSG  MSG('found') TOPGMQ(*EXT)
             RETURN
 MISSING:    SNDPGMMSG  MSG('missing') TOPGMQ(*EXT)
             ENDPGM

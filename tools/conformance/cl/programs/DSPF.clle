/* A display file: SNDRCVF has no display in this job. */
             PGM
             DCLF       FILE(QGPL/KITDSP)
             CHGVAR     VAR(&ANSWER) VALUE('?')
             SNDRCVF    RCDFMT(PROMPT)
             MONMSG     MSGID(CPF4101) EXEC(SNDPGMMSG MSG('no display') TOPGMQ(*EXT))
             ENDPGM

/*; dsply: G yes */
/* SNDUSRMSG with a reply. */
             PGM
             DCL        VAR(&REPLY) TYPE(*CHAR) LEN(1)
             DCL        VAR(&WORD) TYPE(*CHAR) LEN(10)
             SNDUSRMSG  MSG('Continue? (G C)') VALUES(G C) DFT(C) MSGRPY(&REPLY)
             SNDPGMMSG  MSG('reply ' *CAT &REPLY) TOPGMQ(*EXT)
             SNDUSRMSG  MSG('Say something') MSGRPY(&WORD)
             SNDPGMMSG  MSG('word ' *CAT &WORD) TOPGMQ(*EXT)
             SNDUSRMSG  MSG('just a note') MSGTYPE(*INFO)
             ENDPGM

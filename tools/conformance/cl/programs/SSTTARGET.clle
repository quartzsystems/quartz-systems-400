/* %SST on the left of CHGVAR. */
             PGM
             DCL        VAR(&A) TYPE(*CHAR) LEN(10) VALUE('0000000000')
             CHGVAR     VAR(%SST(&A 3 2)) VALUE('XY')
             SNDPGMMSG  MSG(&A) TOPGMQ(*EXT)
             CHGVAR     VAR(%SST(&A 9 2)) VALUE('ZZZZ')
             SNDPGMMSG  MSG(&A) TOPGMQ(*EXT)
             ENDPGM

/* %SWITCH against the job switches (all off in the kit). */
             PGM
             IF         COND(%SWITCH(0XXXXXXX)) THEN(SNDPGMMSG MSG('switch 1 off') +
                          TOPGMQ(*EXT))
             IF         COND(%SWITCH(1XXXXXXX)) THEN(SNDPGMMSG MSG('switch 1 on') +
                          TOPGMQ(*EXT))
             ELSE       CMD(SNDPGMMSG MSG('switch 1 not on') TOPGMQ(*EXT))
             ENDPGM

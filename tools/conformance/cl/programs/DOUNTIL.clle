/* DOUNTIL runs its body once before the test. */
             PGM
             DCL        VAR(&I) TYPE(*DEC) LEN(3 0) VALUE(100)
             DOUNTIL    COND(&I *GT 50)
               SNDPGMMSG  MSG('once') TOPGMQ(*EXT)
               CHGVAR     VAR(&I) VALUE(&I + 1)
             ENDDO
             DOUNTIL    COND(&I *GE 104)
               CHGVAR     VAR(&I) VALUE(&I + 1)
               SNDPGMMSG  MSG('i=' *CAT %CHAR(&I)) TOPGMQ(*EXT)
             ENDDO
             ENDPGM

/* SNDMSG, SNDBRKMSG and SNDUSRMSG to a queue go to their doubles. */
             PGM
             SNDMSG     MSG('a note') TOUSR(*SYSOPR)
             SNDBRKMSG  MSG('break') TOMSGQ(QSYS/QSYSOPR)
             CHGJOB     LOG(4 00 *SECLVL) LOGCLPGM(*YES)
             ENDPGM

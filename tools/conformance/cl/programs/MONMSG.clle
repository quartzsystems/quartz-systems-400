/*; fail: CRTLIB CPF2111 */
/* Command-level MONMSG with EXEC, then without. */
             PGM
             CRTLIB     LIB(MYLIB)
             MONMSG     MSGID(CPF2111) EXEC(SNDPGMMSG MSG('exists') TOPGMQ(*EXT))
             CRTLIB     LIB(MYLIB)
             MONMSG     MSGID(CPF0000)
             SNDPGMMSG  MSG('ignored') TOPGMQ(*EXT)
             CRTLIB     LIB(MYLIB)
             MONMSG     MSGID(CPF2111) EXEC(DO)
               SNDPGMMSG  MSG('group one') TOPGMQ(*EXT)
               SNDPGMMSG  MSG('group two') TOPGMQ(*EXT)
             ENDDO
             ENDPGM

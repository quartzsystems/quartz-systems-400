/* Errors: a command the compiler cannot find stops creation. */
             PGM
             MYCMD      PARM1(abc) PARM2(12)
             MONMSG     MSGID(CPF0006) EXEC(SNDPGMMSG MSG('no such command') +
                          TOPGMQ(*EXT))
             ENDPGM

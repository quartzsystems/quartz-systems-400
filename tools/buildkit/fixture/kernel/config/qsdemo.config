# QSDEMO's kernel fragment, merged onto x86_64_defconfig after the
# pipeline's baseline (EFI stub, baked command line, embedded initramfs,
# no modules). Only what that leaves out.

# The disk under QEMU, and the data partition's file system.
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_XFS_FS=y

# The protected set as a block device served by PID 1's child.
CONFIG_BLK_DEV_UBLK=y
CONFIG_IO_URING=y

# The panel on the firmware's framebuffer, through simpledrm.
CONFIG_FB=y
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y
# CONFIG_FB_EFI is not set
